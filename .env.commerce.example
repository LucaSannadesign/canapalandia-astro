# Commerce stays fail-closed unless explicitly enabled.
PUBLIC_COMMERCE_PROVIDER=disabled

# Spreadshop Europe — leave blank until a real shop/account is approved.
PUBLIC_SPREADSHOP_ENABLED=false
PUBLIC_SPREADSHOP_STOREFRONT_URL=
PUBLIC_SPREADSHOP_LOCALE=it_IT

# Legacy/future embedded-Shop path.
# The 2026 new Spreadshop storefront does not currently support embedded shops,
# so this must stay false unless Spreadshop explicitly restores support and we re-QA it.
PUBLIC_SPREADSHOP_EMBED_ENABLED=false
PUBLIC_SPREADSHOP_SHOP_NAME=
PUBLIC_SPREADSHOP_PREFIX=
