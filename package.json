{
  "name": "canapalandia-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/production-guard.mjs build && rm -rf .astro dist .vercel/output node_modules/.vite node_modules/.astro && node scripts/generate-sitemap-pages.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "guard:production": "node scripts/production-guard.mjs monitor",
    "test:production-guard": "node --test tests/production-guard.test.mjs",
    "astro": "astro",
    "migrate:wp": "node scripts/migrate-wp-to-content.mjs",
    "mirror:media": "node scripts/mirror-media.mjs",
    "export:db": "node scripts/export-db-to-content.mjs",
    "export:content": "node scripts/export-db-to-content.mjs",
    "cover": "node scripts/generate-cover.mjs",
    "auto-post:dry": "node scripts/auto-post.mjs --dry-run",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./tests/support/register-ts.mjs --test \"tests/**/*.test.ts\"",
    "smoke:search": "node scripts/search-smoke.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "seo:serve": "node scripts/vercel-output-server.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:check": "npm run i18n:audit && npm run build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.1",
    "@supabase/supabase-js": "^2.90.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.3.1",
    "astro": "^6.0.8",
    "he": "^1.2.0",
    "mysql2": "^3.16.0"
  },
  "devDependencies": {
    "@astrojs/mdx": "^5.0.2",
    "@astrojs/vercel": "^10.0.2",
    "dotenv": "^16.6.1",
    "sharp": "^0.34.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
