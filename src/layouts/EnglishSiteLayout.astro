---
import "../styles/app.css";
import "../styles/footer-refinement.css";
import {
  EN_FOOTER_EXPLORE_NAVIGATION,
  EN_PRIMARY_NAVIGATION,
  EN_UTILITY_NAVIGATION,
} from "../config/navigation.en";

const THEME_STORAGE_KEY = "canapalandia_theme";
const {
  title: titleProp,
  description: descriptionProp,
  canonical: canonicalProp,
  metadata,
  robots: robotsProp,
  ogImage: ogImageProp,
  ogType: ogTypeProp,
  shell = true,
  alternateIt,
  yoastHeadHtml,
} = Astro.props;

const titleFinal = titleProp ?? metadata?.title ?? "Canapalandia";
const descriptionFinal = descriptionProp ?? metadata?.description ?? "";
const canonicalRaw = canonicalProp ?? metadata?.canonical;
const robotsRaw = robotsProp ?? metadata?.robots;
const SITE_URL = import.meta.env.SITE || "https://canapalandia.com";
const currentPath = Astro.url.pathname;

function normalizeRobots(robots: unknown): string {
  if (typeof robots === "string") return robots;
  if (robots && typeof robots === "object" && "index" in robots && "follow" in robots) {
    const r = robots as { index?: boolean; follow?: boolean };
    return `${r.index === false ? "noindex" : "index"},${r.follow === false ? "nofollow" : "follow"}`;
  }
  return "index,follow";
}

function isProductionEnvironment(): boolean {
  const hostname = Astro.url.hostname;
  if (hostname.endsWith(".vercel.app") || hostname.includes("vercel.app")) return false;
  if (hostname === "localhost" || hostname.startsWith("127.0.0.1")) return false;
  if (["canapalandia.com", "www.canapalandia.com"].includes(hostname)) return true;
  return import.meta.env.VERCEL_ENV === "production";
}

function normalizePath(pathname: string): string {
  if (!pathname || pathname === "/") return "/";
  if (/\.[a-z0-9]+$/i.test(pathname)) return pathname;
  return `${pathname.replace(/\/+$/, "")}/`;
}

function absoluteUrl(value: string | undefined): string | undefined {
  if (!value) return undefined;
  if (/^https?:\/\//i.test(value)) return value;
  return new URL(normalizePath(value), SITE_URL).toString();
}

const canonicalFinal = absoluteUrl(canonicalRaw ?? currentPath);
const robotsFinal = isProductionEnvironment() ? normalizeRobots(robotsRaw) : "noindex,nofollow";
const ogImage = absoluteUrl(ogImageProp ?? metadata?.ogImage ?? "/images/logo-canapalandia_1024.webp");
const ogType = ogTypeProp ?? metadata?.ogType ?? "website";
const itHref = absoluteUrl(alternateIt);
const enHref = canonicalFinal;
const hasExternalHreflang = typeof yoastHeadHtml === "string" && yoastHeadHtml.includes("hreflang=");

function isCurrent(path: string): boolean {
  return currentPath === path || (path !== "/en/" && currentPath.startsWith(path));
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicons/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Canapalandia RSS" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
      rel="stylesheet"
    />

    <title>{titleFinal}</title>
    {descriptionFinal ? <meta name="description" content={descriptionFinal} /> : null}
    {canonicalFinal ? <link rel="canonical" href={canonicalFinal} /> : null}
    <meta name="robots" content={robotsFinal} />
    {!hasExternalHreflang && itHref && enHref ? (
      <>
        <link rel="alternate" hreflang="it" href={itHref} />
        <link rel="alternate" hreflang="en" href={enHref} />
        <link rel="alternate" hreflang="x-default" href={itHref} />
      </>
    ) : null}
    {yoastHeadHtml ? <Fragment set:html={yoastHeadHtml} /> : null}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Canapalandia" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={titleFinal} />
    {descriptionFinal ? <meta property="og:description" content={descriptionFinal} /> : null}
    {canonicalFinal ? <meta property="og:url" content={canonicalFinal} /> : null}
    {ogImage ? <meta property="og:image" content={ogImage} /> : null}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titleFinal} />
    {descriptionFinal ? <meta name="twitter:description" content={descriptionFinal} /> : null}
    {ogImage ? <meta name="twitter:image" content={ogImage} /> : null}

    <script is:inline define:vars={{ THEME_STORAGE_KEY }}>
      (() => {
        let theme = "dark";
        try {
          const saved = localStorage.getItem(THEME_STORAGE_KEY);
          if (saved === "dark" || saved === "light") theme = saved;
        } catch {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>

  <body>
    <div id="top" tabindex="-1" aria-hidden="true"></div>
    <a class="skip" href="#content">Skip to content</a>

    <header class="site-header" data-overlay>
      <div class="container header-inner">
        <a class="brand" href="/en/" aria-label="Canapalandia, English home">
          <img class="brand-logo" src="/images/logo-canapalandia.svg" alt="Canapalandia" height="28" loading="eager" decoding="async" />
          <span class="sr-only">Canapalandia</span>
        </a>

        <nav class="nav" aria-label="Main navigation">
          {EN_PRIMARY_NAVIGATION.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>

        <div class="header-actions">
          <button type="button" class="menu-toggle" data-menu-toggle aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu-en">
            <span class="sr-only">Open menu</span>
            <svg class="menu-toggle__icon menu-toggle__icon--hamburger" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 12h18M3 6h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            <svg class="menu-toggle__icon menu-toggle__icon--close" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>

          <a class="search" href={EN_UTILITY_NAVIGATION[0].href} aria-label="Search the site">Search</a>

          {itHref ? (
            <nav class="global-language" aria-label="Site language">
              <a href={itHref} hreflang="it" lang="it">IT</a>
              <span aria-current="page">EN</span>
            </nav>
          ) : null}

          <button type="button" class="theme-toggle__btn" data-theme-toggle aria-label="Change theme">
            <span class="sr-only">Change theme</span>
            <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z" stroke="currentColor" stroke-width="2"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 13.2A8.5 8.5 0 1 1 10.8 3a6.8 6.8 0 0 0 10.2 10.2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>

          <a class="header-cta" href="/en/advertising/"><span class="header-cta__mark" aria-hidden="true"></span>Advertising</a>
        </div>
      </div>
    </header>

    <nav class="mobile-menu" id="mobile-menu-en" aria-label="Mobile menu" aria-hidden="true">
      <div class="mobile-menu__overlay" data-menu-close></div>
      <div class="mobile-menu__content">
        {EN_PRIMARY_NAVIGATION.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="/en/search/">Search</a>
        <a href="/en/advertising/">Advertising</a>
        {itHref ? <a href={itHref} hreflang="it" lang="it">Italiano</a> : null}
        <button type="button" class="mobile-menu__toggle-theme" data-theme-toggle aria-label="Change theme">Change theme</button>
      </div>
    </nav>

    <main id="content">
      {shell ? <div class="container page-shell"><slot /></div> : <slot />}
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <section class="footer-col footer-brand" aria-label="Canapalandia brand">
          <a class="footer-logo" href="/en/" aria-label="Canapalandia, English home">
            <img src="/images/logo-canapalandia.svg" alt="Canapalandia" class="footer-logo__img" height="32" loading="lazy" decoding="async" />
          </a>
          <p class="footer-tagline">Independent reporting and culture on hemp, CBD, cannabis and policy.</p>
          <p class="footer-credits">Website by <a href="https://www.lswebagency.com/" target="_blank" rel="noopener noreferrer">LS Web Agency</a></p>
        </section>

        <nav class="footer-col footer-menu" aria-label="Explore">
          <h2 class="footer-title">Explore</h2>
          <div class="footer-links">
            {EN_FOOTER_EXPLORE_NAVIGATION.map((item) => <a href={item.href}>{item.label}</a>)}
            <a href="/rss.xml">RSS</a>
          </div>
        </nav>

        <section class="footer-col footer-menu" aria-label="Support and information">
          <h2 class="footer-title">Information</h2>
          <nav class="footer-links" aria-label="Information links">
            <a href="/en/search/">Search</a>
            <a href="/en/support/">Support us</a>
            <a href="/en/about/">About us</a>
            <a href="/en/contact/">Contact</a>
            <a href="/en/advertising/">Guest posts and collaborations</a>
            <a href="/en/disclaimer/">Disclaimer</a>
            <a href="/en/privacy/">Privacy</a>
            <a href="/en/cookies/">Cookies</a>
            <a href="/en/terms/">Terms</a>
          </nav>

          <nav class="social-links footer-social" aria-label="Canapalandia social channels">
            <a href="https://www.facebook.com/canapalandia.official" target="_blank" rel="noopener noreferrer" aria-label="Canapalandia on Facebook"><img src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/facebook.svg" alt="" aria-hidden="true" /></a>
            <a href="https://www.instagram.com/canapalandia.official/" target="_blank" rel="noopener noreferrer" aria-label="Canapalandia on Instagram"><img src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/instagram.svg" alt="" aria-hidden="true" /></a>
            <a href="https://www.youtube.com/@canapalandia" target="_blank" rel="noopener noreferrer" aria-label="Canapalandia on YouTube"><img src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/youtube.svg" alt="" aria-hidden="true" /></a>
            <a href="https://www.linkedin.com/company/canapalandia/" target="_blank" rel="noopener noreferrer" aria-label="Canapalandia on LinkedIn"><img src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/linkedin.svg" alt="" aria-hidden="true" /></a>
          </nav>
        </section>

        <div class="footer-copy">© {new Date().getFullYear()} Canapalandia. All rights reserved.</div>
      </div>
    </footer>

    <a href="#top" class="scroll-to-top" aria-label="Back to top" aria-hidden="true"><span aria-hidden="true">↑</span><span class="sr-only">Back to top</span></a>

    <script is:inline define:vars={{ THEME_STORAGE_KEY }}>
      (() => {
        const menu = document.getElementById("mobile-menu-en");
        const toggle = document.querySelector("[data-menu-toggle]");
        const close = document.querySelector("[data-menu-close]");
        const setMenu = (open) => {
          if (!menu || !toggle) return;
          menu.setAttribute("aria-hidden", open ? "false" : "true");
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
          document.documentElement.classList.toggle("menu-open", open);
        };
        toggle?.addEventListener("click", () => setMenu(toggle.getAttribute("aria-expanded") !== "true"));
        close?.addEventListener("click", () => setMenu(false));

        document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
          button.addEventListener("click", () => {
            const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
            document.documentElement.dataset.theme = next;
            try { localStorage.setItem(THEME_STORAGE_KEY, next); } catch {}
          });
        });

        const top = document.querySelector(".scroll-to-top");
        const updateTop = () => {
          if (!top) return;
          const visible = window.scrollY > 350;
          top.classList.toggle("is-visible", visible);
          top.setAttribute("aria-hidden", visible ? "false" : "true");
        };
        window.addEventListener("scroll", updateTop, { passive: true });
        updateTop();
      })();
    </script>
  </body>
</html>

<style is:global>
  .global-language {
    display: inline-flex;
    align-items: center;
    gap: .1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: .2rem;
    font: 600 .78rem/1 Archivo, sans-serif;
  }
  .global-language a,
  .global-language span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    min-height: 2rem;
    padding: 0 .45rem;
    border-radius: 999px;
    text-decoration: none;
  }
  .global-language span[aria-current="page"] {
    background: var(--brand);
    color: #0d2717;
  }
  @media (max-width: 900px) {
    .header-actions > .global-language { display: none; }
  }
</style>
