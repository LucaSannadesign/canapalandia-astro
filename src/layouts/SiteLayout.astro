---
import "../styles/app.css";
import AdSlot from "../components/AdSlot.astro";
import Newsletter from "../components/widgets/Newsletter.astro";
import CookieBanner from "../components/CookieBanner.astro";

const THEME_STORAGE_KEY = "canapalandia_theme";
const { title, canonical, yoastHeadHtml, shell = true } = Astro.props;

const GA4_ID = import.meta.env.PUBLIC_GA4_ID;

// Protezione SEO: noindex per ambienti non-produzione
const isProduction = Astro.url.origin === "https://canapalandia.com";
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicons/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <!-- RSS feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Canapalandia RSS"
      href="/rss.xml"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Google Analytics 4 - caricato solo dopo consenso -->

    <!-- AdSense Script Global - caricato condizionalmente dopo consenso cookie -->
    <script is:inline>
      (() => {
        const STORAGE_KEY = "canapalandia_cookie_consent";
        const ADSENSE_CLIENT = "ca-pub-6462363788506395";
        // Rileva dev mode: localhost o vercel preview
        const isDev = window.location.hostname === "localhost" || window.location.hostname.includes("vercel.app");

        // Verifica consenso (ads = analytics true)
        const checkConsent = () => {
          try {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
              const consent = JSON.parse(saved);
              return consent.analytics === true;
            }
          } catch {}
          // Se non c'è cookie banner, carica comunque AdSense (compatibilità retroattiva)
          return true;
        };

        // Funzione per caricare script AdSense (una sola volta)
        const loadAdSense = () => {
          // Evita doppio caricamento
          if (window.__adsenseLoaded) {
            if (isDev) console.log("[AdSense] Script already loaded, skipping");
            return;
          }

          // Verifica che lo script non sia già presente nel DOM
          if (document.querySelector(`script[src*="googlesyndication.com/pagead/js/adsbygoogle.js"]`)) {
            if (isDev) console.log("[AdSense] Script tag already exists in DOM");
            window.__adsenseLoaded = true;
            window.dispatchEvent(new CustomEvent("adsense:script-loaded"));
            return;
          }

          // Crea e carica script
          const script = document.createElement("script");
          script.async = true;
          script.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`;
          script.crossOrigin = "anonymous";
          
          // Log quando lo script viene caricato (solo in dev)
          script.onload = () => {
            window.__adsenseLoaded = true;
            if (isDev) {
              console.log("[AdSense] Script loaded successfully");
            }
            window.dispatchEvent(new CustomEvent("adsense:script-loaded"));
          };

          script.onerror = () => {
            console.error("[AdSense] Failed to load script");
          };

          document.head.appendChild(script);
          window.__adsenseLoaded = true; // Set subito per evitare race condition
        };

        // Carica se c'è consenso salvato
        if (checkConsent()) {
          loadAdSense();
        }

        // Ascolta evento consenso cookie
        window.addEventListener("canapalandia:cookie-consent", (e) => {
          if (e.detail && e.detail.analytics === true) {
            if (!window.__adsenseLoaded) {
              loadAdSense();
            } else {
              // Script già caricato, emetti evento per componenti in attesa
              window.dispatchEvent(new CustomEvent("adsense:script-loaded"));
            }
          }
        });
      })();
    </script>

    {
      yoastHeadHtml ? (
        <Fragment set:html={yoastHeadHtml} />
      ) : (
        <>
          <title>{title}</title>
          {canonical ? <link rel="canonical" href={canonical} /> : null}
          <meta name="robots" content={isProduction ? "index,follow" : "noindex,nofollow"} />
        </>
      )
    }

    <!-- Imposta subito il tema (evita flash) -->
    <script is:inline define:vars={{ THEME_STORAGE_KEY }}>
      (() => {
        const key = THEME_STORAGE_KEY;
        // Default brand: dark, salvo scelta esplicita dell'utente.
        let theme = "dark";
        try {
          const saved = localStorage.getItem(key);
          if (saved === "dark" || saved === "light") theme = saved;
        } catch {}

        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#contenuto">Salta al contenuto</a>

    <header class="site-header" data-overlay>
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Canapalandia, Home">
          <img
            class="brand-logo"
            src="/images/logo-canapalandia.svg"
            alt="Canapalandia"
            height="28"
            loading="eager"
            decoding="async"
          />
          <span class="sr-only">Canapalandia</span>
        </a>

        <nav class="nav" aria-label="Navigazione principale">
          <a href="/#percorsi">Temi</a>
          <a href="/#in-evidenza">In evidenza</a>
          <a href="/#ultimi">Ultimi</a>
          <a href="/blog/">Blog</a>
          <a href="/ribaltatore/">Ribaltatore AI</a>
          <a href="/frasi-ribaltate/">Frasi Ribaltate</a>
          <a href="/contatti/">Contatti</a>
        </nav>

        <div class="header-actions">
          <button
            type="button"
            class="menu-toggle"
            data-menu-toggle
            aria-label="Apri menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <span class="sr-only">Apri menu</span>
            <svg
              class="menu-toggle__icon menu-toggle__icon--hamburger"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M3 12h18M3 6h18M3 18h18"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
            </svg>
            <svg
              class="menu-toggle__icon menu-toggle__icon--close"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M18 6L6 18M6 6l12 12"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>

          <a class="search" href="/cerca/" aria-label="Cerca nel sito">Cerca</a>

          <button
            type="button"
            class="theme-toggle__btn"
            data-theme-toggle
            aria-label="Cambia tema"
          >
            <span class="sr-only">Cambia tema</span>

            <!-- Sole: visibile quando sei in DARK -->
            <svg
              class="theme-toggle__icon theme-toggle__icon--sun"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"></path>
            </svg>

            <!-- Luna: visibile quando sei in LIGHT -->
            <svg
              class="theme-toggle__icon theme-toggle__icon--moon"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M21 13.2A8.5 8.5 0 1 1 10.8 3a6.8 6.8 0 0 0 10.2 10.2Z"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Menu mobile -->
      <nav class="mobile-menu" id="mobile-menu" aria-label="Menu mobile" aria-hidden="true">
        <div class="mobile-menu__content">
          <a href="/#percorsi">Temi</a>
          <a href="/#in-evidenza">In evidenza</a>
          <a href="/#ultimi">Ultimi</a>
          <a href="/blog/">Blog</a>
          <a href="/ribaltatore/">Ribaltatore AI</a>
          <a href="/frasi-ribaltate/">Frasi Ribaltate</a>
          <a href="/contatti/">Contatti</a>
          <a href="/cerca/">Cerca</a>
        </div>
      </nav>

      <!-- AdSense Banner in Header -->
      <div
        class="container"
        style="padding-top: 1rem; padding-bottom: 0.5rem; display: flex; justify-content: center;"
      >
        <AdSlot label="Pubblicità" />
      </div>
    </header>

    <main id="contenuto">
      {
        shell ? (
          <div class="container page-shell">
            <slot />
          </div>
        ) : (
          <slot />
        )
      }
    </main>

    <div class="container">
      <Newsletter />
    </div>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-top">
          <div class="footer-brand">
            <a class="footer-logo" href="/" aria-label="Canapalandia, Home">
              <img
                src="/images/logo-canapalandia.svg"
                alt="Canapalandia"
                class="footer-logo__img"
                height="32"
                loading="lazy"
                decoding="async"
              />
            </a>

            <p class="footer-tagline">
              Informazione e cultura su cannabis light, CBD e canapa legale in
              Italia.
            </p>

            <p class="footer-credits">
              Sito realizzato da{" "}
              <a
                href="https://www.lswebagency.com/"
                target="_blank"
                rel="noopener noreferrer"
              >
                LS Web Agency
              </a>
            </p>
          </div>
        </div>

        <nav class="footer-links footer-nav" aria-label="Link utili">
          <a href="/blog/">Blog</a>
          <a href="/ribaltatore/">Ribaltatore AI</a>
          <a href="/frasi-ribaltate/">Frasi Ribaltate</a>
          <a href="/cerca/">Cerca</a>
          <a href="/partner-selezionati/">Partner</a>
          <a href="/sostieni-la-nostra-causa/">Sostieni</a>
          <a href="/rss.xml">RSS</a>
        </nav>

        <div class="footer-copy">
          © {new Date().getFullYear()} Canapalandia. Tutti i diritti riservati.
        </div>
      </div>
    </footer>

    <!-- Toggle click -->
    <script is:inline define:vars={{ THEME_STORAGE_KEY }}>
      (() => {
        const key = THEME_STORAGE_KEY;
        const root = document.documentElement;
        const btn = document.querySelector("[data-theme-toggle]");
        if (!btn) return;

        const safeGet = () => {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        };
        const safeSet = (v) => {
          try {
            localStorage.setItem(key, v);
          } catch {}
        };

        const systemPref = () =>
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";

        const normalize = (v) => (v === "dark" || v === "light" ? v : null);

        const apply = (theme) => {
          root.dataset.theme = theme;
          btn.setAttribute(
            "aria-label",
            theme === "dark"
              ? "Passa a modalità chiara"
              : "Passa a modalità scura",
          );
        };

        // tema iniziale (dataset > saved > system)
        apply(
          normalize(root.dataset.theme) || normalize(safeGet()) || systemPref(),
        );

        btn.addEventListener("click", () => {
          const current = root.dataset.theme === "dark" ? "dark" : "light";
          const next = current === "dark" ? "light" : "dark";
          apply(next);
          safeSet(next);
        });
      })();
    </script>

    <button
      id="scrollTop"
      class="scroll-top"
      type="button"
      aria-label="Torna su"
      title="Torna su"
    >
      ↑
    </button>

    <script is:inline>
      (() => {
        const btn = document.getElementById("scrollTop");
        if (!btn) return;

        const prefersReduced = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        const toggle = () => {
          const y = window.scrollY || document.documentElement.scrollTop || 0;
          btn.classList.toggle("is-visible", y > 600);
        };

        toggle();
        window.addEventListener("scroll", toggle, { passive: true });

        btn.addEventListener("click", () => {
          window.scrollTo({
            top: 0,
            behavior: prefersReduced ? "auto" : "smooth",
          });
        });
      })();
    </script>

    <CookieBanner />

    <!-- Header scroll animation -->
    <script is:inline>
      (() => {
        const header = document.querySelector(".site-header");
        if (!header) return;

        const SCROLL_THRESHOLD = 12;
        const prefersReduced = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        const updateHeader = () => {
          const scrollY = window.scrollY || document.documentElement.scrollTop || 0;
          const isScrolled = scrollY > SCROLL_THRESHOLD;
          header.classList.toggle("is-scrolled", isScrolled);
        };

        // Aggiorna subito per evitare flash
        updateHeader();

        // Usa passive listener per performance
        window.addEventListener("scroll", updateHeader, { passive: true });
      })();
    </script>

    <!-- Menu mobile toggle -->
    <script is:inline>
      (() => {
        const menuToggle = document.querySelector("[data-menu-toggle]");
        const mobileMenu = document.getElementById("mobile-menu");

        if (!menuToggle || !mobileMenu) return;

        const closeMenu = () => {
          menuToggle.setAttribute("aria-expanded", "false");
          menuToggle.setAttribute("aria-label", "Apri menu");
          mobileMenu.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
        };

        const openMenu = () => {
          menuToggle.setAttribute("aria-expanded", "true");
          menuToggle.setAttribute("aria-label", "Chiudi menu");
          mobileMenu.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
        };

        const toggleMenu = () => {
          const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
          if (isExpanded) {
            closeMenu();
          } else {
            openMenu();
          }
        };

        menuToggle.addEventListener("click", toggleMenu);

        // Chiudi menu quando clicchi sull'overlay
        mobileMenu.addEventListener("click", (e) => {
          if (e.target === mobileMenu) {
            closeMenu();
          }
        });

        // Chiudi menu quando clicchi su un link
        const menuLinks = mobileMenu.querySelectorAll("a");
        menuLinks.forEach((link) => {
          link.addEventListener("click", () => {
            closeMenu();
          });
        });

        // Chiudi menu con ESC
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && menuToggle.getAttribute("aria-expanded") === "true") {
            closeMenu();
            menuToggle.focus();
          }
        });
      })();
    </script>

    {GA4_ID ? (
      <script is:inline define:vars={{ GA4_ID }}>
        (() => {
          const STORAGE_KEY = "canapalandia_cookie_consent";
          const GA_ID = GA4_ID;

          // Flag per evitare doppi caricamenti
          if (window.__gaLoaded) {
            return;
          }

          // Funzione per inizializzare GA4
          const initGA4 = () => {
            if (window.__gaLoaded) {
              return;
            }

            // Carica script gtag solo se non esiste già
            if (!document.querySelector(`script[src*="googletagmanager.com/gtag/js?id=${GA_ID}"]`)) {
              const script = document.createElement("script");
              script.async = true;
              script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
              document.head.appendChild(script);
            }

            // Inizializza dataLayer e gtag
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            window.gtag = window.gtag || gtag;

            gtag("js", new Date());
            gtag("config", GA_ID, {
              anonymize_ip: true,
            });

            window.__gaLoaded = true;
          };

          // Verifica consenso
          const checkConsent = () => {
            try {
              const saved = localStorage.getItem(STORAGE_KEY);
              if (saved) {
                const consent = JSON.parse(saved);
                return consent.analytics === true;
              }
            } catch {}
            return false;
          };

          // Carica GA4 se c'è già consenso salvato
          if (checkConsent()) {
            initGA4();
          }

          // Ascolta evento consenso cookie
          window.addEventListener("canapalandia:cookie-consent", (e) => {
            if (e.detail && e.detail.analytics === true && !window.__gaLoaded) {
              initGA4();
            }
            // Se analytics è false, non fare nulla (GA4 non sarà caricato)
          });
        })();
      </script>
    ) : null}

  </body>
</html>
