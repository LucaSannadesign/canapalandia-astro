---
import "../styles/app.css";
import AdSlot from "../components/AdSlot.astro";
import Newsletter from "../components/widgets/Newsletter.astro";
import CookieBanner from "../components/CookieBanner.astro";
import GATag from "../components/GATag.astro";
import { ADS_SLOT_TOP, ADS_EXCLUDED_ROUTES, ADSENSE_CLIENT } from "../lib/consts";

const THEME_STORAGE_KEY = "canapalandia_theme";
const { 
  title: titleProp, 
  description: descriptionProp,
  canonical: canonicalProp, 
  yoastHeadHtml, 
  shell = true, 
  robots: robotsProp,
  metadata 
} = Astro.props;

// Supporto metadata object: se presente, usa quello, altrimenti props dirette
const titleFinal = titleProp ?? metadata?.title ?? "Canapalandia";
const descriptionFinal = descriptionProp ?? metadata?.description ?? "";
const canonicalRaw = canonicalProp ?? metadata?.canonical;
const robotsRaw = robotsProp ?? metadata?.robots;

// Normalizza robots: oggetto -> stringa
function normalizeRobots(robots: unknown): string {
  if (typeof robots === "string") return robots;
  if (robots && typeof robots === "object" && "index" in robots && "follow" in robots) {
    const r = robots as { index?: boolean; follow?: boolean };
    const index = r.index === false ? "noindex" : "index";
    const follow = r.follow === false ? "nofollow" : "follow";
    return `${index},${follow}`;
  }
  return "";
}

const robotsNormalized = normalizeRobots(robotsRaw);

// Default robots: index,follow
const robotsDefault = "index,follow";

// Detection production: hostname-based (robusto, indipendente da VERCEL_ENV)
function isProductionEnvironment(): boolean {
  const hostname = Astro.url.hostname;
  
  // PRIORITÀ 1: Blocca preview Vercel e localhost (indipendente da VERCEL_ENV)
  // Se hostname termina con ".vercel.app" o contiene "vercel.app" => NON production
  if (hostname.endsWith(".vercel.app") || hostname.includes("vercel.app")) {
    return false;
  }
  // Blocca localhost e 127.0.0.1
  if (hostname === "localhost" || hostname.startsWith("127.0.0.1")) {
    return false;
  }
  
  // PRIORITÀ 2: Verifica se hostname è nella allowlist production
  const productionHostnames = ["canapalandia.com", "www.canapalandia.com"];
  if (productionHostnames.includes(hostname)) {
    return true;
  }
  
  // PRIORITÀ 3: Fallback VERCEL_ENV (solo se hostname non è riconosciuto)
  const vercelEnv = import.meta.env.VERCEL_ENV;
  if (vercelEnv === "production") return true;
  if (vercelEnv === "preview" || vercelEnv === "development") return false;
  
  // Default: non production (sicurezza)
  return false;
}

const isProduction = isProductionEnvironment();

// Calcola robotsFinal: sempre presente, dinamico in base all'hostname
// - Preview Vercel (*.vercel.app) e localhost => "noindex,nofollow"
// - Production (canapalandia.com) => usa robotsNormalized o "index,follow"
const robotsFinal = isProduction 
  ? (robotsNormalized || robotsDefault)
  : "noindex,nofollow";

// Normalizza canonical: se relativo, rendilo assoluto
function normalizeCanonical(canonical: string | undefined): string | undefined {
  if (!canonical) return undefined;
  // Se già assoluto (inizia con http:// o https://), ritorna così
  if (canonical.startsWith("http://") || canonical.startsWith("https://")) {
    return canonical;
  }
  // Se relativo, rendilo assoluto usando SITE o origin
  const base = import.meta.env.SITE || Astro.url.origin;
  // Assicura trailing slash se necessario
  const canonicalPath = canonical.startsWith("/") ? canonical : `/${canonical}`;
  return `${base}${canonicalPath}`;
}

// Calcola canonicalFinal: usa canonical fornito, altrimenti SITE + pathname
const canonicalFinal = canonicalRaw 
  ? normalizeCanonical(canonicalRaw)
  : normalizeCanonical(`${import.meta.env.SITE || "https://canapalandia.com"}${Astro.url.pathname}`);

// Pulizia yoastHeadHtml: rimuovi title, canonical, robots duplicati
function cleanYoastHead(html: string | undefined): string {
  if (!html) return "";
  let cleaned = html;
  // Rimuovi <title>...</title>
  cleaned = cleaned.replace(/<title[^>]*>[\s\S]*?<\/title>/gi, "");
  // Rimuovi <link rel="canonical" ...>
  cleaned = cleaned.replace(/<link[^>]*rel=["']canonical["'][^>]*>/gi, "");
  // Rimuovi <meta name="robots" ...>
  cleaned = cleaned.replace(/<meta[^>]*name=["']robots["'][^>]*>/gi, "");
  return cleaned.trim();
}

const yoastHeadCleaned = cleanYoastHead(yoastHeadHtml);

// Determina se mostrare ads: escludi route "low-value"
const currentPath = Astro.url.pathname;
const shouldShowAds = !ADS_EXCLUDED_ROUTES.some((route) => 
  currentPath === route || currentPath.startsWith(route + "/")
);
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicons/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <!-- RSS feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Canapalandia RSS"
      href="/rss.xml"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Google Consent Mode v2 - DEVE essere PRIMA di AdSense/GA4 -->
    <!-- Permette "Limited ads" quando consenso è denied -->
    <!-- Configura in AdSense UI: Account > Privacy & messaging > EU user consent > Enable "Non-personalized ads" -->
    <script is:inline>
      (() => {
        // Inizializza gtag/Consent Mode con default "denied"
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function(...args) {
          window.dataLayer.push(args);
        };
        window.gtag("js", new Date());
        
        // Imposta default "denied" per permettere "Limited ads" senza consenso
        window.gtag("consent", "default", {
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
          analytics_storage: "denied",
          wait_for_update: 500, // Attendi aggiornamenti consenso fino a 500ms
        });

        // Funzione globale per aggiornare consenso (chiamata da CookieBanner)
        window.canapalandiaUpdateConsent = function(granted) {
          const status = granted ? "granted" : "denied";
          window.gtag("consent", "update", {
            ad_storage: status,
            ad_user_data: status,
            ad_personalization: status,
            analytics_storage: status,
          });
        };

        // Leggi consenso salvato e aggiorna Consent Mode se presente
        try {
          const saved = localStorage.getItem("canapalandia_cookie_consent");
          if (saved) {
            const consent = JSON.parse(saved);
            const granted = consent.analytics === true || consent.ads === true;
            if (granted) {
              window.gtag("consent", "update", {
                ad_storage: "granted",
                ad_user_data: "granted",
                ad_personalization: "granted",
                analytics_storage: "granted",
              });
            }
          }
        } catch {}
      })();
    </script>

    <!-- Google Analytics 4 -->
    <GATag />

    <!-- CMP Script Placeholder -->
    <!-- CMP script goes here -->
    <!-- <script src="https://cmp.example.com/cmp.js"></script> -->

    <!-- AdSense Consent Gating: funzione globale per CMP TCF -->
    <script is:inline>
      (() => {
        // Cache per risultato TCF (evita polling continuo)
        let tcfConsentCache = null;
        let tcfCacheTimestamp = 0;
        const TCF_CACHE_TTL = 5000; // 5 secondi

        // Funzione globale per verificare consenso ads (CMP-ready)
        // Supporta TCF 2.x e stato interno
        window.canapalandiaHasAdConsent = function() {
          // 1) Verifica CMP TCF (Google-certified)
          if (typeof window.__tcfapi !== "undefined") {
            const now = Date.now();
            // Usa cache se valida
            if (tcfConsentCache !== null && (now - tcfCacheTimestamp) < TCF_CACHE_TTL) {
              return tcfConsentCache;
            }

            // Interroga TCF (asincrono, ma ritorniamo risultato cached o false)
            try {
              window.__tcfapi("getTCData", 2, (tcData, success) => {
                if (success && tcData) {
                  // Purpose 1 = Store and/or access information on a device (consenso base ads)
                  // Verifica Purpose 1
                  let hasConsent = false;
                  if (tcData.purpose && tcData.purpose.consents) {
                    hasConsent = tcData.purpose.consents[1] === true;
                  }
                  tcfConsentCache = hasConsent;
                  tcfCacheTimestamp = Date.now();
                  
                  // Se consenso cambia, emetti evento per ricaricare AdSense
                  if (hasConsent && !window.__adsenseLoaded) {
                    window.dispatchEvent(new CustomEvent("canapalandia:ad-consent-granted"));
                  }
                } else {
                  tcfConsentCache = false;
                  tcfCacheTimestamp = Date.now();
                }
              });
            } catch (err) {
              console.warn("[CMP] TCF API error:", err);
              tcfConsentCache = false;
              tcfCacheTimestamp = Date.now();
            }

            // Se abbiamo cache, ritorna quello, altrimenti false (conservativo)
            return tcfConsentCache !== null ? tcfConsentCache : false;
          }

          // 2) Fallback: stato interno (localStorage) - solo se TCF non esiste
          try {
            const STORAGE_KEY = "canapalandia_cookie_consent";
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
              const consent = JSON.parse(saved);
              // Richiede consenso esplicito per ads
              return consent.ads === true || consent.analytics === true;
            }
          } catch (err) {
            console.warn("[CMP] Storage error:", err);
          }

          // 3) Nessun consenso: ritorna false (NON permissivo)
          return false;
        };

        // Placeholder per aprire CMP
        window.canapalandiaOpenConsent = function() {
          // Se CMP TCF è disponibile, apri modal
          if (typeof window.__tcfapi !== "undefined") {
            try {
              window.__tcfapi("showConsentModal", 2, () => {
                // Invalida cache quando si apre modal
                tcfConsentCache = null;
              });
            } catch (err) {
              console.warn("[CMP] Error opening consent modal:", err);
            }
          } else {
            // Fallback: apri cookie banner se disponibile
            const event = new CustomEvent("canapalandia:open-cookie-banner");
            window.dispatchEvent(event);
          }
        };
      })();
    </script>

    <!-- AdSense: Initializer globale robusto e minimale -->
    <script is:inline define:vars={{ clientId: ADSENSE_CLIENT }}>
      (() => {
        "use strict";
        
        const ADSENSE_SCRIPT_URL = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js";
        const MIN_SLOT_WIDTH = 300;
        const RESIZE_TIMEOUT = 8000; // 8s timeout per ResizeObserver
        const DEBUG = localStorage.getItem("ADS_DEBUG") === "1";
        
        // Registro globale WeakSet per tracciare slot inizializzati (evita doppi push)
        if (!window.__adsenseInitialized) {
          window.__adsenseInitialized = new WeakSet();
        }

        // 1) Carica script una sola volta
        if (!window.__adsenseLoaded) {
          const existingScript = document.querySelector(`script[src*="adsbygoogle.js"]`);
          if (!existingScript) {
            const script = document.createElement("script");
            script.async = true;
            script.src = `${ADSENSE_SCRIPT_URL}?client=${clientId}`;
            script.crossOrigin = "anonymous";
            script.onload = () => {
              window.__adsenseLoaded = true;
              if (DEBUG) console.log("[AdSense] Script loaded");
              scan();
            };
            script.onerror = () => console.error("[AdSense] Script failed");
            document.head.appendChild(script);
          } else {
            window.__adsenseLoaded = true;
          }
        }

        // 2) initAds: push SOLO se condizioni soddisfatte
        function initAds(el) {
          // a) Connesso al DOM
          if (!el || !el.isConnected || !el.classList?.contains("adsbygoogle")) {
            return false;
          }

          // b) Display non è none
          const style = window.getComputedStyle(el);
          if (style.display === "none" || style.visibility === "hidden") {
            if (DEBUG) {
              const slot = el.getAttribute("data-ad-slot");
              console.log(`[initAds] Slot ${slot} hidden (display: ${style.display}), skip`);
            }
            return false;
          }

          // c) width >= 300 E parent width >= 300
          const rect = el.getBoundingClientRect();
          const width = rect.width || el.offsetWidth || 0;
          const parent = el.parentElement;
          const parentWidth = parent ? (parent.getBoundingClientRect().width || parent.offsetWidth || 0) : width;
          
          if (width < MIN_SLOT_WIDTH || parentWidth < MIN_SLOT_WIDTH) {
            if (DEBUG) {
              const slot = el.getAttribute("data-ad-slot");
              console.log(`[initAds] Slot ${slot} too narrow (w: ${Math.round(width)}, parent: ${Math.round(parentWidth)}), skip`);
            }
            return false;
          }

          // d) Non già inizializzato (WeakSet + dataset + status)
          if (window.__adsenseInitialized.has(el) || el.dataset.adsInit === "1") {
            if (DEBUG) {
              const slot = el.getAttribute("data-ad-slot");
              console.log(`[initAds] Slot ${slot} already in registry, skip`);
            }
            return false;
          }

          const status = el.getAttribute("data-adsbygoogle-status");
          if (status === "done" || status === "filled") {
            window.__adsenseInitialized.add(el);
            el.dataset.adsInit = "1";
            return false;
          }

          // Verifica script caricato
          if (!window.__adsenseLoaded || !window.adsbygoogle?.push) {
            if (DEBUG) console.log("[initAds] Script not ready");
            return false;
          }

          // Push
          try {
            window.__adsenseInitialized.add(el);
            el.dataset.adsInit = "1";
            (window.adsbygoogle = window.adsbygoogle || []).push({});
            
            if (DEBUG) {
              const slot = el.getAttribute("data-ad-slot");
              console.log(`[initAds] ✓ Slot ${slot} pushed (w: ${Math.round(width)})`);
            }
            return true;
          } catch (e) {
            window.__adsenseInitialized.delete(el);
            el.dataset.adsInit = "0";
            if (DEBUG) {
              const slot = el.getAttribute("data-ad-slot");
              console.error(`[initAds] ✗ Error slot ${slot}:`, e);
            }
            return false;
          }
        }

        // 3) ResizeObserver con timeout (8s)
        function setupResizeObserver(el) {
          if (!el || el.dataset.resizeObserverSetup === "1") return;
          
          el.dataset.resizeObserverSetup = "1";
          const adSlot = el.getAttribute("data-ad-slot");
          const startTime = Date.now();
          let timeoutId = setTimeout(() => {
            resizeObserver.disconnect();
            delete el.dataset.resizeObserverSetup;
            if (DEBUG) console.log(`[ResizeObserver] Slot ${adSlot} timeout after 8s`);
          }, RESIZE_TIMEOUT);

          const resizeObserver = new ResizeObserver((entries) => {
            for (const entry of entries) {
              const newWidth = entry.contentRect.width;
              
              if (newWidth >= MIN_SLOT_WIDTH && 
                  el.isConnected &&
                  !window.__adsenseInitialized.has(el) &&
                  el.getAttribute("data-adsbygoogle-status") !== "done") {
                
                clearTimeout(timeoutId);
                resizeObserver.disconnect();
                delete el.dataset.resizeObserverSetup;
                
                if (DEBUG) {
                  console.log(`[ResizeObserver] Slot ${adSlot} ready (w: ${Math.round(newWidth)}), retry`);
                }
                
                requestAnimationFrame(() => {
                  requestAnimationFrame(() => initAds(el));
                });
                return;
              }
            }
          });

          const wrapper = el.closest(".adslot-wrapper");
          resizeObserver.observe(wrapper || el.parentElement || el);
        }

        // 4) scan: solo slot nuovi non gestiti
        function scan() {
          if (!window.__adsenseLoaded || !window.adsbygoogle?.push) {
            if (DEBUG) console.log("[scan] Script not ready");
            return;
          }

          const adElements = document.querySelectorAll("ins.adsbygoogle");
          if (adElements.length === 0) return;

          let initialized = 0;
          let skipped = 0;

          adElements.forEach((el) => {
            // Setup observer solo per slot non inizializzati
            if (!window.__adsenseInitialized.has(el) && 
                el.dataset.adsInit !== "1" && 
                el.getAttribute("data-adsbygoogle-status") !== "done") {
              setupResizeObserver(el);
            }

            const result = initAds(el);
            if (result) initialized++;
            else skipped++;
          });

          if (DEBUG && (initialized > 0 || skipped > 0)) {
            console.log(`[scan] ${initialized} init, ${skipped} skip`);
          }
        }

        // 5) MutationObserver: solo slot nuovi
        const mutationObserver = new MutationObserver((mutations) => {
          let hasNew = false;
          mutations.forEach((m) => {
            m.addedNodes.forEach((node) => {
              if (node.nodeType === 1) {
                if (node.classList?.contains("adsbygoogle") || 
                    node.querySelectorAll?.("ins.adsbygoogle").length > 0) {
                  hasNew = true;
                }
              }
            });
          });
          if (hasNew) {
            if (DEBUG) console.log("[MutationObserver] New slots detected");
            setTimeout(() => scan(), 100);
          }
        });

        // Avvio
        const startInit = () => {
          if (!window.__adsenseLoaded) {
            const existingScript = document.querySelector(`script[src*="adsbygoogle.js"]`);
            if (!existingScript) {
              const script = document.createElement("script");
              script.async = true;
              script.src = `${ADSENSE_SCRIPT_URL}?client=${clientId}`;
              script.crossOrigin = "anonymous";
              script.onload = () => {
                window.__adsenseLoaded = true;
                if (DEBUG) console.log("[AdSense] Script loaded");
                scan();
              };
              script.onerror = () => console.error("[AdSense] Script failed");
              document.head.appendChild(script);
            } else {
              window.__adsenseLoaded = true;
            }
          }

          mutationObserver.observe(document.documentElement, { childList: true, subtree: true });
          scan();
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", startInit);
        } else {
          startInit();
        }

        window.addEventListener("load", () => {
          if (DEBUG) console.log("[AdSense] Window load");
          scan();
        });

        document.addEventListener("astro:page-load", () => {
          if (DEBUG) console.log("[AdSense] astro:page-load");
          setTimeout(() => scan(), 100);
        });

        document.addEventListener("astro:after-swap", () => {
          if (DEBUG) console.log("[AdSense] astro:after-swap");
          setTimeout(() => scan(), 100);
        });

        window.addEventListener("canapalandia:cookie-consent", (e) => {
          if (e.detail?.ads || e.detail?.analytics) {
            if (!window.__adsenseLoaded) startInit();
            else scan();
          }
        });

        if (typeof window.__tcfapi !== "undefined") {
          window.__tcfapi("addEventListener", 2, (tcData, success) => {
            if (success && window.canapalandiaHasAdConsent?.()) {
              if (!window.__adsenseLoaded) startInit();
              else scan();
            }
          });
        }
      })();
    </script>

    {/* Renderizza SEMPRE title, canonical, robots, description */}
    <title>{titleFinal}</title>
    {descriptionFinal ? <meta name="description" content={descriptionFinal} /> : null}
    {canonicalFinal ? <link rel="canonical" href={canonicalFinal} /> : null}
    <meta name="robots" content={robotsFinal} />
    
    {/* Se c'è yoastHeadHtml, inietta il resto (già ripulito da title/canonical/robots) */}
    {yoastHeadCleaned ? (
      <Fragment set:html={yoastHeadCleaned} />
    ) : null}

    <!-- Imposta subito il tema (evita flash) -->
    <script is:inline define:vars={{ THEME_STORAGE_KEY }}>
      (() => {
        const key = THEME_STORAGE_KEY;
        // Default brand: dark, salvo scelta esplicita dell'utente.
        let theme = "dark";
        try {
          const saved = localStorage.getItem(key);
          if (saved === "dark" || saved === "light") theme = saved;
        } catch {}

        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#contenuto">Salta al contenuto</a>

    <header class="site-header" data-overlay>
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Canapalandia, Home">
          <img
            class="brand-logo"
            src="/images/logo-canapalandia.svg"
            alt="Canapalandia"
            height="28"
            loading="eager"
            decoding="async"
          />
          <span class="sr-only">Canapalandia</span>
        </a>

        <nav class="nav" aria-label="Navigazione principale">
          <a href="/#percorsi">Temi</a>
          <a href="/#in-evidenza">In evidenza</a>
          <a href="/#ultimi">Ultimi</a>
          <a href="/blog/">Blog</a>
          <a href="/ribaltatore/">Ribaltatore AI</a>
          <a href="/frasi-ribaltate/">Frasi Ribaltate</a>
          <a href="/contatti/">Contatti</a>
        </nav>

        <div class="header-actions">
          <button
            type="button"
            class="menu-toggle"
            data-menu-toggle
            aria-label="Apri menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <span class="sr-only">Apri menu</span>
            <svg
              class="menu-toggle__icon menu-toggle__icon--hamburger"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M3 12h18M3 6h18M3 18h18"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
            </svg>
            <svg
              class="menu-toggle__icon menu-toggle__icon--close"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M18 6L6 18M6 6l12 12"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>

          <a class="search" href="/cerca/" aria-label="Cerca nel sito">Cerca</a>

          <button
            type="button"
            class="theme-toggle__btn"
            data-theme-toggle
            aria-label="Cambia tema"
          >
            <span class="sr-only">Cambia tema</span>

            <!-- Sole: visibile quando sei in DARK -->
            <svg
              class="theme-toggle__icon theme-toggle__icon--sun"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"></path>
            </svg>

            <!-- Luna: visibile quando sei in LIGHT -->
            <svg
              class="theme-toggle__icon theme-toggle__icon--moon"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M21 13.2A8.5 8.5 0 1 1 10.8 3a6.8 6.8 0 0 0 10.2 10.2Z"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Menu mobile (fuori dall'header per evitare stacking context) -->
    <nav class="mobile-menu" id="mobile-menu" aria-label="Menu mobile" aria-hidden="true">
      <div class="mobile-menu__overlay"></div>
      <div class="mobile-menu__content">
        <a href="/#percorsi">Temi</a>
        <a href="/#in-evidenza">In evidenza</a>
        <a href="/#ultimi">Ultimi</a>
