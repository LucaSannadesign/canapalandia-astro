        const adbar = document.querySelector("[data-adbar]");
        if (!header) return;

        const SCROLL_THRESHOLD = 12;
        const DIRECTION_THRESHOLD = 4;
        const ADBAR_HIDE_THRESHOLD = 120;
        const ADBAR_SHOW_THRESHOLD = 60;
        const prefersReduced = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        let lastY = 0;
        let ticking = false;

        const updateHeader = () => {
          const scrollY = window.scrollY || document.documentElement.scrollTop || 0;
          const isScrolled = scrollY > SCROLL_THRESHOLD;
          
          // Calcola direzione
          let direction = "none";
          if (scrollY > lastY + DIRECTION_THRESHOLD) {
            direction = "down";
          } else if (scrollY < lastY - DIRECTION_THRESHOLD) {
            direction = "up";
          }
          
          // Aggiorna attributi header
          header.setAttribute("data-scrolled", isScrolled ? "true" : "false");
          if (direction !== "none") {
            header.setAttribute("data-dir", direction);
          }
          
          // Mantieni compatibilità con classe esistente
          header.classList.toggle("is-scrolled", isScrolled);
          
          // Gestisci adbar
          if (adbar) {
            const isHidden = adbar.getAttribute("data-hidden") === "true";
            
            // Nascondi se: scroll > 120px OPPURE (scroll > 60px E direzione = down)
            if (scrollY > ADBAR_HIDE_THRESHOLD || (scrollY > ADBAR_SHOW_THRESHOLD && direction === "down")) {
              if (!isHidden) {
                adbar.setAttribute("data-hidden", "true");
              }
            }
            // Mostra se: scroll < 60px OPPURE direzione = up
            else if (scrollY < ADBAR_SHOW_THRESHOLD || direction === "up") {
              if (isHidden) {
                adbar.setAttribute("data-hidden", "false");
              }
            }
          }
          
          lastY = scrollY;
          ticking = false;
        };

        const onScroll = () => {
          if (!ticking) {
            requestAnimationFrame(updateHeader);
            ticking = true;
          }
        };

        // Aggiorna subito per evitare flash
        updateHeader();

        // Usa passive listener per performance
        window.addEventListener("scroll", onScroll, { passive: true });
      })();
    </script>

    <!-- Menu mobile toggle -->
    <script is:inline>
      (() => {
        const menuToggle = document.querySelector("[data-menu-toggle]");
        const mobileMenu = document.getElementById("mobile-menu");
        const overlay = mobileMenu?.querySelector(".mobile-menu__overlay");
        const menuContent = mobileMenu?.querySelector(".mobile-menu__content");
        const menuLinks = mobileMenu?.querySelectorAll("a");

        if (!menuToggle || !mobileMenu) return;

        // Salva il primo link per focus trap
        const firstLink = menuLinks?.[0];

        const closeMenu = () => {
          menuToggle.setAttribute("aria-expanded", "false");
          menuToggle.setAttribute("aria-label", "Apri menu");
          mobileMenu.setAttribute("aria-hidden", "true");
          document.documentElement.classList.remove("menu-open");
          document.body.classList.remove("menu-open");
          // Ritorna focus al toggle button
          menuToggle.focus();
        };

        const openMenu = () => {
          menuToggle.setAttribute("aria-expanded", "true");
          menuToggle.setAttribute("aria-label", "Chiudi menu");
          mobileMenu.setAttribute("aria-hidden", "false");
          document.documentElement.classList.add("menu-open");
          document.body.classList.add("menu-open");
          // Focus trap: metti focus al primo link
          if (firstLink) {
            requestAnimationFrame(() => {
              firstLink.focus();
            });
          }
        };

        const toggleMenu = () => {
          const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
          if (isExpanded) {
            closeMenu();
          } else {
            openMenu();
          }
        };

        menuToggle.addEventListener("click", toggleMenu);

        // Chiudi menu quando clicchi sull'overlay
        if (overlay) {
          overlay.addEventListener("click", closeMenu);
        }

        // Chiudi menu quando clicchi su un link
        if (menuLinks) {
          menuLinks.forEach((link) => {
            link.addEventListener("click", closeMenu);
          });
        }

        // Chiudi menu con ESC
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && menuToggle.getAttribute("aria-expanded") === "true") {
            closeMenu();
          }
        });

        // Focus trap: mantieni focus dentro il menu quando è aperto
        if (menuContent) {
          menuContent.addEventListener("keydown", (e) => {
            if (e.key !== "Tab" || menuToggle.getAttribute("aria-expanded") !== "true") {
              return;
            }

            const focusableElements = menuContent.querySelectorAll(
              'a, button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
            );
            const firstElement = focusableElements[0];
            const lastElement = focusableElements[focusableElements.length - 1];

            if (e.shiftKey) {
              // Shift + Tab
              if (document.activeElement === firstElement) {
                e.preventDefault();
                lastElement?.focus();
              }
            } else {
              // Tab
              if (document.activeElement === lastElement) {
                e.preventDefault();
                firstElement?.focus();
              }
            }
          });
        }
      })();
    </script>

    {GA4_ID ? (
      <script is:inline define:vars={{ GA4_ID }}>
        (() => {
          const STORAGE_KEY = "canapalandia_cookie_consent";
          const GA_ID = GA4_ID;

          // Flag per evitare doppi caricamenti
          if (window.__gaLoaded) {
            return;
          }

          // Funzione per inizializzare GA4
          const initGA4 = () => {
            if (window.__gaLoaded) {
              return;
            }

            // Carica script gtag solo se non esiste già
            if (!document.querySelector(`script[src*="googletagmanager.com/gtag/js?id=${GA_ID}"]`)) {
              const script = document.createElement("script");
              script.async = true;
              script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
              document.head.appendChild(script);
            }

            // Inizializza dataLayer e gtag
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            window.gtag = window.gtag || gtag;

            gtag("js", new Date());
            gtag("config", GA_ID, {
              anonymize_ip: true,
            });

            window.__gaLoaded = true;
          };

          // Verifica consenso
          const checkConsent = () => {
            try {
              const saved = localStorage.getItem(STORAGE_KEY);
              if (saved) {
                const consent = JSON.parse(saved);
                return consent.analytics === true;
              }
            } catch {}
            return false;
          };

          // Carica GA4 se c'è già consenso salvato
          if (checkConsent()) {
            initGA4();
          }

          // Ascolta evento consenso cookie
          window.addEventListener("canapalandia:cookie-consent", (e) => {
            if (e.detail && e.detail.analytics === true && !window.__gaLoaded) {
              initGA4();
            }
            // Se analytics è false, non fare nulla (GA4 non sarà caricato)
          });
      })();
    </script>
    ) : null}

    <!-- Gestisci consenso link handler -->
    <script is:inline>
      (() => {
