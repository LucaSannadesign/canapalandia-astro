---
import { toPlainText } from "../lib/utils";

const { href, img, date, title, excerpt } = Astro.props;

// Sanitizza excerpt: converte qualsiasi tipo in stringa pulita
const excerptSafe = toPlainText(excerpt);
---

<article class="card post-card">
    <a class="cardLink" href={href}>
        <div class="thumb">
            {
                img ? (
                    <img
                        src={img}
                        alt={title || ""}
                        loading="lazy"
                        decoding="async"
                    />
                ) : null
            }
        </div>

        <div class="cardBody">
            <p class="cardMeta">{date}</p>
            <h3 class="cardTitle" set:html={title} />
            {excerptSafe ? (
                <p class="cardExcerpt">{excerptSafe}</p>
            ) : null}
            <span class="cardCta">Apri →</span>
        </div>
    </a>
</article>
