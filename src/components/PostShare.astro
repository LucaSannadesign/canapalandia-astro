---
interface Props {
  url: string;
  title: string;
  showShare?: boolean;
  lang?: "it" | "en";
}

const { url, title, showShare = true, lang = "it" } = Astro.props as Props;

if (showShare === false) {
  return null;
}

const isEnglish = lang === "en";
const labels = isEnglish
  ? {
      region: "Share this article",
      heading: "Share this article",
      shareOn: "Share on",
      copy: "Copy link",
      copied: "Link copied!",
    }
  : {
      region: "Condividi questo articolo",
      heading: "Condividi questo articolo",
      shareOn: "Condividi su",
      copy: "Copia link",
      copied: "Link copiato!",
    };

function getShareUrl(platform: string, shareUrl: string, shareTitle: string): string {
  const encodedUrl = encodeURIComponent(shareUrl);
  const encodedTitle = encodeURIComponent(shareTitle);

  switch (platform) {
    case "facebook":
      return `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
    case "telegram":
      return `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`;
    case "whatsapp":
      return `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`;
    case "linkedin":
      return `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
    default:
      return "#";
  }
}

const shareUrl = url;
const shareTitle = title;
const copiedLabel = labels.copied;
---

<div class="post-share" role="region" aria-label={labels.region}>
  <p class="post-share__label">{labels.heading}</p>
  <div class="post-share__buttons">
    <a
      href={getShareUrl("facebook", shareUrl, shareTitle)}
      target="_blank"
      rel="noopener noreferrer"
      class="post-share__button"
      aria-label={`${labels.shareOn} Facebook`}
    >
      <svg class="post-share__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
      </svg>
      <span class="post-share__text">Facebook</span>
    </a>

    <a
      href={getShareUrl("telegram", shareUrl, shareTitle)}
      target="_blank"
      rel="noopener noreferrer"
      class="post-share__button"
      aria-label={`${labels.shareOn} Telegram`}
    >
      <svg class="post-share__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 2 11 13"></path><path d="m22 2-7 20-4-9-9-4Z"></path>
      </svg>
      <span class="post-share__text">Telegram</span>
    </a>

    <a
      href={getShareUrl("whatsapp", shareUrl, shareTitle)}
      target="_blank"
      rel="noopener noreferrer"
      class="post-share__button"
      aria-label={`${labels.shareOn} WhatsApp`}
    >
      <svg class="post-share__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 21l1.65-3.8A9 9 0 1 1 8 20.1L3 21"></path><path d="M9 10c1.5 3 3 4.5 6 6"></path>
      </svg>
      <span class="post-share__text">WhatsApp</span>
    </a>

    <a
      href={getShareUrl("linkedin", shareUrl, shareTitle)}
      target="_blank"
      rel="noopener noreferrer"
      class="post-share__button"
      aria-label={`${labels.shareOn} LinkedIn`}
    >
      <svg class="post-share__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path>
        <rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle>
      </svg>
      <span class="post-share__text">LinkedIn</span>
    </a>

    <button
      type="button"
      class="post-share__button post-share__button--copy"
      aria-label={labels.copy}
      data-copy-link
    >
      <svg class="post-share__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span class="post-share__text">{labels.copy}</span>
    </button>
  </div>
</div>

<script define:vars={{ shareUrl, copiedLabel }}>
  (() => {
    "use strict";
    const copyBtn = document.querySelector("[data-copy-link]");
    if (!copyBtn) return;

    const showCopied = () => {
      const text = copyBtn.querySelector(".post-share__text");
      if (!text) return;
      const original = text.textContent;
      text.textContent = copiedLabel;
      setTimeout(() => {
        if (text) text.textContent = original;
      }, 2000);
    };

    const fallbackCopy = () => {
      const textarea = document.createElement("textarea");
      textarea.value = shareUrl;
      textarea.style.position = "fixed";
      textarea.style.opacity = "0";
      document.body.appendChild(textarea);
      textarea.select();
      try {
        document.execCommand("copy");
        showCopied();
      } catch {}
      document.body.removeChild(textarea);
    };

    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(shareUrl);
        showCopied();
      } catch {
        fallbackCopy();
      }
    });
  })();
</script>

<style>
  .post-share {
    margin: 2.5rem 0;
    padding: 1.5rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
  }

  .post-share__label {
    margin: 0 0 1rem 0;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-share__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .post-share__button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    color: var(--text);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .post-share__button:hover,
  .post-share__button:focus-visible {
    background: var(--panel-2);
    border-color: var(--border-strong);
    color: var(--text);
    outline: none;
    box-shadow: var(--shadow-sm);
  }

  .post-share__button:active { transform: translateY(1px); }

  .post-share__icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--muted);
  }

  .post-share__text { white-space: nowrap; }

  @media (max-width: 640px) {
    .post-share { padding: 1rem; }
    .post-share__button {
      padding: 0.5rem 0.75rem;
      font-size: var(--text-xs);
    }
    .post-share__icon { width: 16px; height: 16px; }
  }
</style>
