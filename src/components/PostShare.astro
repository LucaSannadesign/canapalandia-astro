---
interface Props {
  url: string;
  title: string;
  showShare?: boolean;
}

const { url, title, showShare = true } = Astro.props;

// Se disabilitato via frontmatter, non renderizzare
if (showShare === false) {
  return null;
}

// Helper per costruire URL di condivisione
function getShareUrl(platform: string, shareUrl: string, shareTitle: string): string {
  const encodedUrl = encodeURIComponent(shareUrl);
  const encodedTitle = encodeURIComponent(shareTitle);
  
  switch (platform) {
    case "facebook":
      return `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
    case "telegram":
      return `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`;
    case "whatsapp":
      return `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`;
    case "linkedin":
      return `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
    default:
      return "#";
  }
}

const shareUrl = url;
const shareTitle = title;
---

<div class="post-share" role="region" aria-label="Condividi questo articolo">
  <p class="post-share__label">Condividi questo articolo</p>
  <div class="post-share__buttons">
    <a
      href={getShareUrl("facebook", shareUrl, shareTitle)}
      target="_blank"
      rel="noopener noreferrer"
      class="post-share__button"
      aria-label="Condividi su Facebook"
    >
      <svg
        class="post-share__icon"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
      </svg>
      <span class="post-share__text">Facebook</span>
    </a>

    <a
      href={getShareUrl("telegram", shareUrl, shareTitle)}
      target="_blank"
      rel="noopener noreferrer"
      class="post-share__button"
      aria-label="Condividi su Telegram"
    >
      <svg
        class="post-share__icon"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
      </svg>
      <span class="post-share__text">Telegram</span>
    </a>

    <a
      href={getShareUrl("whatsapp", shareUrl, shareTitle)}
      target="_blank"
      rel="noopener noreferrer"
      class="post-share__button"
      aria-label="Condividi su WhatsApp"
    >
      <svg
        class="post-share__icon"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path>
        <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"></path>
        <path d="M8 14l-1-1 1-1 1 1-1 1z"></path>
        <path d="M16 14l-1-1 1-1 1 1-1 1z"></path>
      </svg>
      <span class="post-share__text">WhatsApp</span>
    </a>

    <a
      href={getShareUrl("linkedin", shareUrl, shareTitle)}
      target="_blank"
      rel="noopener noreferrer"
      class="post-share__button"
      aria-label="Condividi su LinkedIn"
    >
      <svg
        class="post-share__icon"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
        <rect x="2" y="9" width="4" height="12"></rect>
        <circle cx="4" cy="4" r="2"></circle>
      </svg>
      <span class="post-share__text">LinkedIn</span>
    </a>

    <button
      type="button"
      class="post-share__button post-share__button--copy"
      aria-label="Copia link"
      data-copy-link
    >
      <svg
        class="post-share__icon"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span class="post-share__text">Copia link</span>
    </button>
  </div>
</div>

<script define:vars={{ shareUrl }}>
  (() => {
    "use strict";
    const copyBtn = document.querySelector("[data-copy-link]");
    if (!copyBtn) return;

    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(shareUrl);
        const originalText = copyBtn.querySelector(".post-share__text");
        if (originalText) {
          const original = originalText.textContent;
          originalText.textContent = "Link copiato!";
          setTimeout(() => {
            if (originalText) originalText.textContent = original;
          }, 2000);
        }
      } catch (err) {
        // Fallback per browser senza Clipboard API
        const textarea = document.createElement("textarea");
        textarea.value = shareUrl;
        textarea.style.position = "fixed";
        textarea.style.opacity = "0";
        document.body.appendChild(textarea);
        textarea.select();
        try {
          document.execCommand("copy");
          const originalText = copyBtn.querySelector(".post-share__text");
          if (originalText) {
            const original = originalText.textContent;
            originalText.textContent = "Link copiato!";
            setTimeout(() => {
              if (originalText) originalText.textContent = original;
            }, 2000);
          }
        } catch {}
        document.body.removeChild(textarea);
      }
    });
  })();
</script>

<style>
  .post-share {
    margin: 2.5rem 0;
    padding: 1.5rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
  }

  .post-share__label {
    margin: 0 0 1rem 0;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-share__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .post-share__button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    color: var(--text);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .post-share__button:hover,
  .post-share__button:focus-visible {
    background: var(--panel-2);
    border-color: var(--border-strong);
    color: var(--text);
    outline: none;
    box-shadow: var(--shadow-sm);
  }

  .post-share__button:active {
    transform: translateY(1px);
  }

  .post-share__icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--muted);
  }

  .post-share__text {
    white-space: nowrap;
  }

  /* Mobile: pulsanti più compatti */
  @media (max-width: 640px) {
    .post-share {
      padding: 1rem;
    }

    .post-share__button {
      padding: 0.5rem 0.75rem;
      font-size: var(--text-xs);
    }

    .post-share__icon {
      width: 16px;
      height: 16px;
    }
  }
</style>
