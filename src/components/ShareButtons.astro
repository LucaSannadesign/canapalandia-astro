---
interface Props {
  url: string; // URL assoluto
  text: string; // Testo della frase
  title?: string;
}

const { url, text, title = "Frase Ribaltata" } = Astro.props;

// Encode per URL
const encodedText = encodeURIComponent(text);
const encodedUrl = encodeURIComponent(url);

// URL di share per ogni piattaforma
const shareUrls = {
  whatsapp: `https://wa.me/?text=${encodedText}%0A${encodedUrl}`,
  telegram: `https://t.me/share/url?url=${encodedUrl}&text=${encodedText}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
  twitter: `https://twitter.com/intent/tweet?text=${encodedText}&url=${encodedUrl}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
};
---

<div class="sharebar" role="group" aria-label="Condividi">
  <a
    href={shareUrls.whatsapp}
    target="_blank"
    rel="noopener noreferrer"
    class="sharebtn"
    aria-label="Condividi su WhatsApp"
  >
    WhatsApp
  </a>
  <a
    href={shareUrls.telegram}
    target="_blank"
    rel="noopener noreferrer"
    class="sharebtn"
    aria-label="Condividi su Telegram"
  >
    Telegram
  </a>
  <a
    href={shareUrls.facebook}
    target="_blank"
    rel="noopener noreferrer"
    class="sharebtn"
    aria-label="Condividi su Facebook"
  >
    Facebook
  </a>
  <a
    href={shareUrls.twitter}
    target="_blank"
    rel="noopener noreferrer"
    class="sharebtn"
    aria-label="Condividi su X (Twitter)"
  >
    X
  </a>
  <a
    href={shareUrls.linkedin}
    target="_blank"
    rel="noopener noreferrer"
    class="sharebtn"
    aria-label="Condividi su LinkedIn"
  >
    LinkedIn
  </a>
  <button
    type="button"
    class="sharebtn sharebtn--copy"
    data-copy-url={url}
    aria-label="Copia link"
  >
    Copia link
  </button>
</div>

<script>
  // Handler per bottone "Copia link"
  document.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest("button[data-copy-url]");
    if (!btn) return;

    e.preventDefault();
    const url = btn.getAttribute("data-copy-url");
    if (!url) return;

    const originalText = btn.textContent || "Copia link";

    try {
      // Prova navigator.clipboard
      if (navigator.clipboard && navigator.clipboard.writeText) {
        await navigator.clipboard.writeText(url);
        btn.textContent = "Copiato ✓";
        btn.classList.add("sharebtn--copied");
        
        setTimeout(() => {
          btn.textContent = originalText;
          btn.classList.remove("sharebtn--copied");
        }, 1200);
      } else {
        // Fallback: window.prompt
        const textarea = document.createElement("textarea");
        textarea.value = url;
        textarea.style.position = "fixed";
        textarea.style.opacity = "0";
        document.body.appendChild(textarea);
        textarea.select();
        
        try {
          document.execCommand("copy");
          btn.textContent = "Copiato ✓";
          btn.classList.add("sharebtn--copied");
          
          setTimeout(() => {
            btn.textContent = originalText;
            btn.classList.remove("sharebtn--copied");
          }, 1200);
        } catch (err) {
          // Ultimo fallback: prompt
          window.prompt("Copia questo link:", url);
        }
        
        document.body.removeChild(textarea);
      }
    } catch (err) {
      // Fallback finale: prompt
      window.prompt("Copia questo link:", url);
    }
  });
</script>

<style>
  .sharebar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .sharebtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text, #e8f5ec);
    background: transparent;
    border: 1px solid var(--border, rgba(125, 255, 180, 0.12));
    border-radius: 9999px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    min-height: 36px;
  }

  .sharebtn:hover {
    transform: translateY(-1px);
    border-color: var(--border-strong, rgba(125, 255, 180, 0.22));
    background: var(--gold-subtle, rgba(200, 169, 90, 0.15));
  }

  .sharebtn:focus {
    outline: none;
  }

  .sharebtn:focus-visible {
    outline: 2px solid var(--gold, #c8a95a);
    outline-offset: 2px;
  }

  .sharebtn--copy {
    background: var(--brand-subtle, rgba(34, 197, 94, 0.15));
  }

  .sharebtn--copy:hover {
    background: var(--gold-subtle, rgba(200, 169, 90, 0.2));
  }

  .sharebtn--copied {
    background: var(--gold-subtle, rgba(200, 169, 90, 0.25));
    border-color: var(--gold, #c8a95a);
    color: var(--gold, #c8a95a);
  }

  @media (max-width: 767px) {
    .sharebar {
      gap: 0.375rem;
    }

    .sharebtn {
      padding: 0.5rem 0.875rem;
      font-size: 0.8125rem;
      min-height: 34px;
    }
  }
</style>
