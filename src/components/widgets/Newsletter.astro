---
/* Componente Newsletter con stile premium e moderno */
---

<section class="newsletter-widget" aria-label="Iscrizione Newsletter">
    <div class="newsletter-content">
        <div class="newsletter-header">
            <h3 class="newsletter-title">Resta aggiornato su Canapalandia</h3>
            <p class="newsletter-desc">
                Ricevi le ultime notizie su cannabis light, normative e curiosità
                direttamente nella tua email. Niente spam, solo qualità.
            </p>
        </div>

        <form class="newsletter-form" id="newsletterForm" method="POST" action="/api/newsletter">
            <div class="input-group">
                <label for="newsletter-email" class="sr-only">Indirizzo email</label>
                <input
                    id="newsletter-email"
                    type="email"
                    name="email"
                    placeholder="La tua email..."
                    autocomplete="email"
                    required
                    aria-label="Indirizzo email"
                    aria-describedby="formFeedback legalText"
                />
                <button type="submit" class="btn-submit">Iscriviti</button>
            </div>
            <p class="form-feedback" id="formFeedback" role="status" aria-live="polite"></p>
            <p class="newsletter-legal" id="legalText">
                Inviando questo form, accetti la nostra <a href="/privacy-policy/">Privacy Policy</a> e 
                la <a href="/cookie-policy/">Cookie Policy</a>.
            </p>
        </form>
    </div>
</section>

<style>
    .newsletter-widget {
        margin: 3rem 0;
        position: relative;
    }

    .newsletter-content {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 22px;
        padding: 2.5rem 2rem;
        box-shadow: var(--shadow-soft);
        position: relative;
        overflow: hidden;
        text-align: center;
    }

    /* Accento visivo: glow discreto in alto */
    .newsletter-content::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, transparent, var(--brand), transparent);
        opacity: 0.6;
    }

    /* Tema light: glow più visibile */
    html[data-theme="light"] .newsletter-content::before {
        opacity: 0.8;
        background: linear-gradient(90deg, transparent, var(--brand), transparent);
    }

    .newsletter-header {
        margin-bottom: 1.75rem;
    }

    .newsletter-title {
        margin: 0 0 0.75rem;
        font-size: clamp(1.4rem, 2.5vw, 1.75rem);
        font-weight: 800;
        line-height: 1.2;
        color: var(--text);
        letter-spacing: -0.02em;
    }

    .newsletter-desc {
        margin: 0 auto;
        max-width: 48ch;
        color: var(--muted);
        font-size: 1rem;
        line-height: 1.6;
        opacity: 0.9;
    }

    .newsletter-form {
        max-width: 500px;
        margin: 0 auto;
    }

    .input-group {
        display: flex;
        gap: 12px;
        align-items: stretch;
    }

    input[type="email"] {
        flex: 1;
        min-width: 0;
        height: 50px;
        padding: 0 20px;
        border-radius: 12px;
        border: 1.5px solid var(--border);
        background: var(--panel-2);
        color: var(--text);
        font-size: 1rem;
        font-family: var(--font-sans);
        transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    input[type="email"]::placeholder {
        color: var(--muted);
        opacity: 0.6;
    }

    input[type="email"]:focus {
        outline: none;
        border-color: var(--brand);
        background: var(--panel);
        box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.15);
    }

    input[type="email"]:focus-visible {
        outline: 2px solid var(--brand);
        outline-offset: 2px;
    }

    /* Tema light: input più contrastato */
    html[data-theme="light"] input[type="email"] {
        background: var(--panel-2);
        border-color: var(--border);
    }

    html[data-theme="light"] input[type="email"]:focus {
        border-color: var(--brand);
        box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.12);
    }

    .btn-submit {
        height: 50px;
        padding: 0 28px;
        border-radius: 12px;
        border: none;
        background: linear-gradient(135deg, var(--brand), var(--brand-2));
        color: #fff;
        font-weight: 700;
        font-size: 1rem;
        font-family: var(--font-sans);
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        box-shadow: 0 2px 8px rgba(34, 197, 94, 0.2);
        white-space: nowrap;
    }

    .btn-submit:hover {
        background: linear-gradient(135deg, var(--brand-2), #15803d);
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(34, 197, 94, 0.35);
    }

    .btn-submit:active {
        transform: translateY(0);
    }

    .btn-submit:focus-visible {
        outline: 2px solid var(--brand);
        outline-offset: 2px;
        box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.25);
    }

    .form-feedback {
        margin-top: 14px;
        font-size: 0.9rem;
        min-height: 1.4em;
        opacity: 0;
        transition: opacity 0.3s ease;
        line-height: 1.5;
    }

    .form-feedback.visible {
        opacity: 1;
    }

    .form-feedback.success {
        color: var(--brand);
    }

    html[data-theme="light"] .form-feedback.success {
        color: var(--brand-2);
    }

    .form-feedback.error {
        color: #ef4444;
    }

    html[data-theme="light"] .form-feedback.error {
        color: #dc2626;
    }

    .newsletter-legal {
        margin: 1rem auto 0;
        max-width: 500px;
        font-size: 0.85rem;
        line-height: 1.5;
        color: var(--muted);
        opacity: 0.8;
    }

    .newsletter-legal a {
        color: var(--brand);
        text-decoration: underline;
        text-underline-offset: 2px;
        transition: color 0.2s ease;
    }

    .newsletter-legal a:hover {
        color: var(--brand-2);
    }

    /* Mobile: layout in colonna */
    @media (max-width: 640px) {
        .newsletter-content {
            padding: 2rem 1.5rem;
            border-radius: 20px;
        }

        .newsletter-title {
            font-size: 1.4rem;
        }

        .newsletter-desc {
            font-size: 0.95rem;
        }

        .input-group {
            flex-direction: column;
            gap: 10px;
        }

        input[type="email"],
        .btn-submit {
            width: 100%;
            height: 48px;
        }

        .btn-submit {
            padding: 0 24px;
        }
    }

    /* Screen reader only label */
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
</style>

<script>
    const form = document.getElementById("newsletterForm") as HTMLFormElement;
    const feedback = document.getElementById("formFeedback");

    if (form && feedback) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            const email = formData.get("email") as string;

            if (!email) {
                feedback.textContent = "Inserisci un indirizzo email valido.";
                feedback.className = "form-feedback visible error";
                return;
            }

            // Reset UI
            feedback.textContent = "Iscrizione in corso...";
            feedback.className = "form-feedback visible";
            const submitBtn = form.querySelector(".btn-submit") as HTMLButtonElement;
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = "In corso...";
            }

            try {
                const res = await fetch("/api/newsletter", {
                    method: "POST",
                    body: JSON.stringify({ email }),
                    headers: { "Content-Type": "application/json" },
                });

                const data = await res.json();

                if (res.ok) {
                    feedback.textContent = "Grazie per esserti iscritto! Controlla la tua email per confermare.";
                    feedback.className = "form-feedback visible success";
                    form.reset();
                } else {
                    feedback.textContent = data.message || "Qualcosa è andato storto. Riprova.";
                    feedback.className = "form-feedback visible error";
                }
            } catch (err) {
                feedback.textContent = "Errore di connessione. Riprova più tardi.";
                feedback.className = "form-feedback visible error";
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = "Iscriviti";
                }
            }
        });
    }
</script>
