---
/* Componente Newsletter con stile Glassmorphism */
---

<section class="newsletter-widget" aria-label="Iscrizione Newsletter">
    <div class="newsletter-content">
        <h3 class="newsletter-title">Resta aggiornato su Canapalandia</h3>
        <p class="newsletter-desc">
            Ricevi le ultime notizie su cannabis light, normative e curiosità
            direttamente nella tua email. Niente spam, solo qualità.
        </p>

        <form class="newsletter-form" id="newsletterForm">
            <div class="input-group">
                <input
                    type="email"
                    name="email"
                    placeholder="La tua email..."
                    required
                    aria-label="Indirizzo email"
                />
                <button type="submit" class="btn-submit"> Iscriviti </button>
            </div>
            <p class="form-feedback" id="formFeedback"></p>
        </form>
    </div>
</section>

<style>
    .newsletter-widget {
        margin: 3rem 0;
        padding: 2px; /* Border gradient wrapper */
        border-radius: 16px;
        background: linear-gradient(
            135deg,
            rgba(255, 255, 255, 0.1),
            rgba(255, 255, 255, 0.05)
        );
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    .newsletter-content {
        background: rgba(15, 23, 42, 0.6); /* Semi-transparent dark bg */
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        padding: 2rem;
        border-radius: 14px; /* Slightly less than wrapper */
        text-align: center;
    }

    .newsletter-title {
        margin: 0 0 0.5rem;
        font-size: 1.5rem;
        font-weight: 700;
        background: linear-gradient(90deg, #fff, #cbd5e1);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .newsletter-desc {
        margin: 0 auto 1.5rem;
        max-width: 42ch;
        color: var(--muted);
        font-size: 0.95rem;
    }

    .newsletter-form {
        max-width: 400px;
        margin: 0 auto;
        position: relative;
    }

    .input-group {
        display: flex;
        gap: 8px;
    }

    input[type="email"] {
        flex: 1;
        padding: 12px 16px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        background: rgba(0, 0, 0, 0.2);
        color: #fff;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }

    input[type="email"]:focus {
        outline: none;
        border-color: var(--brand);
        background: rgba(0, 0, 0, 0.3);
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
    }

    .btn-submit {
        padding: 12px 24px;
        border-radius: 999px;
        border: none;
        background: var(--brand);
        color: #fff;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-submit:hover {
        background: #16a34a; /* Slightly darker green */
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3);
    }

    .form-feedback {
        margin-top: 10px;
        font-size: 0.85rem;
        min-height: 1.2em;
        opacity: 0;
        transition: opacity 0.3s;
    }
    .form-feedback.visible {
        opacity: 1;
    }
    .form-feedback.success {
        color: #4ade80;
    }
    .form-feedback.error {
        color: #f87171;
    }

    @media (max-width: 500px) {
        .input-group {
            flex-direction: column;
        }
        .btn-submit {
            width: 100%;
        }
    }
</style>

<script>
    const form = document.getElementById("newsletterForm") as HTMLFormElement;
    const feedback = document.getElementById("formFeedback");

    if (form && feedback) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            const email = formData.get("email");

            // Reset UI
            feedback.textContent = "Iscrizione in corso...";
            feedback.className = "form-feedback visible";

            try {
                const res = await fetch("/api/newsletter", {
                    method: "POST",
                    body: JSON.stringify({ email }),
                    headers: { "Content-Type": "application/json" },
                });

                if (res.ok) {
                    feedback.textContent = "Grazie per esserti iscritto!";
                    feedback.className = "form-feedback visible success";
                    form.reset();
                } else {
                    throw new Error("Errore durante l'iscrizione");
                }
            } catch (err) {
                feedback.textContent = "Qualcosa è andato storto. Riprova.";
                feedback.className = "form-feedback visible error";
            }
        });
    }
</script>
