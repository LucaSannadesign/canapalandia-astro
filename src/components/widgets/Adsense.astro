---
interface Props {
    slotId: string;
    format?: "auto" | "fluid" | "rectangle" | "vertical" | "horizontal";
    responsive?: boolean;
    style?: string;
    label?: string;
}

const {
    slotId,
    format = "auto",
    responsive = true,
    style = "display:block",
    label,
} = Astro.props;

const PUBLISHER_ID = import.meta.env.PUBLIC_ADSENSE_ID;
---

{PUBLISHER_ID ? (
    <div class="adsense-container" data-adsense-slot-id={slotId}>
        {label && (
            <p class="adsense-label">{label}</p>
        )}

        <ins
            class="adsbygoogle"
            style={style}
            data-ad-client={PUBLISHER_ID}
            data-ad-slot={slotId}
            data-ad-format={format}
            data-full-width-responsive={responsive ? "true" : "false"}
        >
        </ins>
    </div>
) : null}

<style>
    .adsense-container {
        margin: 2rem 0;
        text-align: center;
        min-height: 100px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .adsense-label {
        font-size: 0.75rem;
        color: var(--muted);
        text-transform: uppercase;
        margin: 0 0 0.5rem;
        opacity: 0.7;
    }

    .adsbygoogle {
        display: block;
        width: 100%;
    }
</style>

<script define:vars={{ slotId }}>
    (() => {
        const STORAGE_KEY = "canapalandia_cookie_consent";
        const container = document.querySelector(`[data-adsense-slot-id="${slotId}"]`);
        if (!container) return;

        const adSlot = container.querySelector(".adsbygoogle");
        if (!adSlot) return;

        let pushed = false;

        const checkConsent = () => {
            try {
                const saved = localStorage.getItem(STORAGE_KEY);
                if (saved) {
                    const consent = JSON.parse(saved);
                    return consent.analytics === true;
                }
            } catch {}
            return false;
        };

        const pushAd = () => {
            if (pushed) return;
            if (!window.adsbygoogle) {
                console.warn("[AdSense] Script not loaded yet");
                return;
            }

            try {
                (window.adsbygoogle = window.adsbygoogle || []).push({});
                pushed = true;
            } catch (err) {
                console.error("[AdSense] Error pushing ad:", err);
            }
        };

        // Push ad se c'è consenso e script è già caricato
        if (checkConsent()) {
            if (window.__adsenseLoaded) {
                pushAd();
            } else {
                // Aspetta che lo script si carichi
                window.addEventListener("adsense:script-loaded", pushAd, { once: true });
            }
        }

        // Ascolta evento consenso cookie
        window.addEventListener("canapalandia:cookie-consent", (e) => {
            if (e.detail && e.detail.analytics === true && !pushed) {
                if (window.__adsenseLoaded) {
                    pushAd();
                } else {
                    window.addEventListener("adsense:script-loaded", pushAd, { once: true });
                }
            }
        });
    })();
</script>
