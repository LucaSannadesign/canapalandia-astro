---
interface Props {
    slot?: string;
    label?: string;
    client?: string;
}

const {
    slot = "7168595886",
    label,
    client = "ca-pub-6462363788506395", // Default, può essere override via prop o env
} = Astro.props;

// Usa env se disponibile, altrimenti prop, altrimenti default
const AD_CLIENT = import.meta.env.PUBLIC_ADSENSE_CLIENT || client;
const isDev = import.meta.env.DEV;
---

<div class="adslot-container" data-adslot-id={slot}>
    {label && (
        <p class="adslot-label">{label}</p>
    )}

    <ins
        class="adsbygoogle"
        data-ad-client={AD_CLIENT}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
        style="display:block"
    >
    </ins>
</div>

<style>
    .adslot-container {
        width: 100%;
        max-width: 970px;
        min-height: 90px;
        margin: 2rem 0;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .adslot-label {
        font-size: 0.75rem;
        color: var(--muted);
        text-transform: uppercase;
        margin: 0 0 0.5rem;
        opacity: 0.7;
    }

    .adsbygoogle {
        display: block;
        min-height: 90px;
        width: 100%;
    }

    /* Responsive: aumenta min-height su mobile */
    @media (max-width: 767px) {
        .adslot-container {
            min-height: 100px;
        }

        .adsbygoogle {
            min-height: 100px;
        }
    }

    /* Mobile molto piccolo: ancora più spazio */
    @media (max-width: 480px) {
        .adslot-container {
            min-height: 120px;
        }

        .adsbygoogle {
            min-height: 120px;
        }
    }
</style>

<script define:vars={{ slot, isDev }}>
    (() => {
        // WeakSet globale per tracciare elementi già inizializzati (evita duplicati)
        if (!window.__adsenseInitialized) {
            window.__adsenseInitialized = new WeakSet();
        }

        const adSlotId = slot;

        // Trova container e elemento ad (solo se nel DOM)
        const container = document.querySelector(`[data-adslot-id="${adSlotId}"]`);
        if (!container) {
            if (isDev) console.warn(`[AdSlot ${adSlotId}] Container not found`);
            return;
        }

        const adElement = container.querySelector(".adsbygoogle");
        if (!adElement) {
            if (isDev) console.warn(`[AdSlot ${adSlotId}] Ad element not found`);
            return;
        }

        // Evita doppio push: controlla WeakSet e dataset flag
        if (window.__adsenseInitialized.has(adElement) || adElement.dataset.adsInitialized === "1") {
            if (isDev) console.warn(`[AdSlot ${adSlotId}] Already initialized, skipping`);
            return;
        }

        // Verifica consenso usando funzione globale CMP-ready
        const checkConsent = () => {
            if (window.canapalandiaHasAdConsent && typeof window.canapalandiaHasAdConsent === "function") {
                return window.canapalandiaHasAdConsent();
            }
            // Fallback: se funzione non esiste, ritorna false (NON permissivo)
            return false;
        };

        // Poll per aspettare che adsbygoogle esista (max 3s, più generoso)
        const pollForAdSense = (callback, maxAttempts = 30, interval = 100) => {
            let attempts = 0;
            const poll = () => {
                if (window.adsbygoogle && typeof window.adsbygoogle.push === "function") {
                    callback();
                } else if (attempts < maxAttempts) {
                    attempts++;
                    setTimeout(poll, interval);
                } else {
                    if (isDev) {
                        console.warn(`[AdSlot ${adSlotId}] adsbygoogle not loaded after ${maxAttempts * interval}ms`);
                    }
                }
            };
            poll();
        };

        // Push ad slot (protetto e idempotente)
        const pushAd = () => {
            // Double-check: evita push multipli
            if (window.__adsenseInitialized.has(adElement) || adElement.dataset.adsInitialized === "1") {
                return;
            }

            // Verifica che l'elemento sia ancora nel DOM
            if (!document.contains(adElement)) {
                if (isDev) console.warn(`[AdSlot ${adSlotId}] Element removed from DOM`);
                return;
            }

            // Verifica che adsbygoogle sia disponibile
            if (!window.adsbygoogle || typeof window.adsbygoogle.push !== "function") {
                if (isDev) console.warn(`[AdSlot ${adSlotId}] adsbygoogle.push not available`);
                return;
            }

            try {
                // Usa requestAnimationFrame per assicurarsi che il DOM sia pronto
                requestAnimationFrame(() => {
                    try {
                        (window.adsbygoogle = window.adsbygoogle || []).push({});
                        window.__adsenseInitialized.add(adElement);
                        adElement.dataset.adsInitialized = "1";
                        if (isDev) {
                            console.log(`[AdSlot ${adSlotId}] AdSense push executed for slot ${adSlotId}`);
                        }
                    } catch (err) {
                        console.error(`[AdSlot ${adSlotId}] Error pushing ad:`, err);
                    }
                });
            } catch (err) {
                console.error(`[AdSlot ${adSlotId}] Error in pushAd:`, err);
            }
        };

        // Funzione principale: inizializza ad se c'è consenso
        const initAd = () => {
            if (!checkConsent()) {
                if (isDev) console.log(`[AdSlot ${adSlotId}] No consent, waiting...`);
                return;
            }

            if (window.__adsenseLoaded) {
                // Script già caricato, aspetta che adsbygoogle esista
                pollForAdSense(pushAd);
            } else {
                // Aspetta che lo script si carichi
                const handler = () => {
                    pollForAdSense(pushAd);
                };
                window.addEventListener("adsense:script-loaded", handler, { once: true });
            }
        };

        // Inizializza subito se c'è consenso
        initAd();

        // Ascolta evento consenso cookie (per utenti che accettano dopo)
        window.addEventListener("canapalandia:cookie-consent", (e) => {
            if (e.detail && (e.detail.ads === true || e.detail.analytics === true)) {
                // Verifica consenso con funzione globale
                if (checkConsent()) {
                    // Verifica che non sia già inizializzato
                    if (!window.__adsenseInitialized.has(adElement) && adElement.dataset.adsInitialized !== "1") {
                        if (window.__adsenseLoaded) {
                            pollForAdSense(pushAd);
                        } else {
                            window.addEventListener("adsense:script-loaded", () => {
                                pollForAdSense(pushAd);
                            }, { once: true });
                        }
                    }
                }
            }
        });

        // Ascolta evento consenso ads da CMP
        window.addEventListener("canapalandia:ad-consent-granted", () => {
            if (checkConsent()) {
                if (!window.__adsenseInitialized.has(adElement) && adElement.dataset.adsInitialized !== "1") {
                    if (window.__adsenseLoaded) {
                        pollForAdSense(pushAd);
                    } else {
                        window.addEventListener("adsense:script-loaded", () => {
                            pollForAdSense(pushAd);
                        }, { once: true });
                    }
                }
            }
        });
    })();
</script>
