---
/**
 * Spazio pubblicitario proprietario. INATTIVO per impostazione predefinita:
 * con ADS_ENABLED diverso da "true" non produce markup, non carica moduli di database
 * e non esegue query. Anche con l'interruttore acceso mostra qualcosa solo se esiste un
 * posizionamento `active`, nel periodo, con checklist completa e creatività approvata.
 * Stili e script sono inline nel ramo condizionale: a slot spento il peso aggiunto alla pagina è zero.
 */
import { isAdsEnabled, readAdsEnv } from "../lib/ads/config";
import type { ServedAd } from "../lib/ads/handlers";
import type { AdPosition } from "../lib/ads/types";

interface Props {
  slug: string;
  position?: AdPosition;
  lang?: "it" | "en";
}

const { slug, position = "article_end", lang = "it" } = Astro.props;

let ad: ServedAd | null = null;
if (isAdsEnabled(readAdsEnv())) {
  const [{ getServableAd }, { runtimeAdsDeps }] = await Promise.all([
    import("../lib/ads/handlers"),
    import("../lib/ads/runtime"),
  ]);
  ad = await getServableAd(slug, position, runtimeAdsDeps());
}

const label = lang === "en" ? "Sponsored" : ad?.sponsorLabel ?? "Contenuto sponsorizzato";
---

{ad && (
  <aside class="ad-slot" aria-label={label} data-ad-slot data-ad-placement={ad.placementId}>
    <p class="ad-slot__label">{label} · {ad.advertiserName}</p>
    <a class="ad-slot__link" href={ad.clickHref} rel="sponsored noopener" target="_blank">
      {ad.imagePath && ad.imageWidth && ad.imageHeight && (
        <img
          class="ad-slot__image"
          src={ad.imagePath}
          width={ad.imageWidth}
          height={ad.imageHeight}
          alt={ad.altText}
          loading="lazy"
          decoding="async"
        />
      )}
      {ad.headline && <span class="ad-slot__headline">{ad.headline}</span>}
      {ad.body && <span class="ad-slot__body">{ad.body}</span>}
      <span class="ad-slot__cta">{ad.ctaLabel ?? (lang === "en" ? "Visit" : "Visita")} → {ad.destinationHost}</span>
    </a>
    <script is:inline>
      (() => {
        const slot = document.currentScript && document.currentScript.closest("[data-ad-slot]");
        if (!slot || !("IntersectionObserver" in window) || !navigator.sendBeacon) return;
        const placement = slot.getAttribute("data-ad-placement");
        let timer = 0;
        let sent = false;
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting && entry.intersectionRatio >= 0.5 && !sent) {
                timer = window.setTimeout(() => {
                  sent = true;
                  io.disconnect();
                  navigator.sendBeacon("/api/ads/event/", JSON.stringify({ type: "impression", placement }));
                }, 1000);
              } else {
                window.clearTimeout(timer);
              }
            }
          },
          { threshold: [0, 0.5] },
        );
        io.observe(slot);
      })();
    </script>
    <style is:inline>
      .ad-slot {
        margin: 2rem 0;
        padding: 1rem 1.25rem 1.25rem;
        border: 1px solid var(--border);
        border-radius: var(--r-md);
        background: var(--card-bg);
      }
      .ad-slot__label {
        margin: 0 0 0.75rem;
        font: 600 11px/1.3 var(--font-ui, "Archivo", sans-serif);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .ad-slot__link {
        display: grid;
        gap: 0.5rem;
        color: var(--text);
        text-decoration: none;
      }
      .ad-slot__link:focus-visible {
        outline: 2px solid var(--brand);
        outline-offset: 4px;
        border-radius: var(--r-sm, 4px);
      }
      .ad-slot__image {
        width: 100%;
        height: auto;
        border-radius: var(--r-sm, 4px);
      }
      .ad-slot__headline {
        font: 700 1.1rem/1.3 var(--font-serif, "Source Serif 4", serif);
      }
      .ad-slot__body {
        color: var(--muted);
        font-size: 0.95rem;
      }
      .ad-slot__cta {
        font-weight: 600;
        color: var(--brand);
      }
    </style>
  </aside>
)}
