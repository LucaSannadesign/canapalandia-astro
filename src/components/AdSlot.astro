---
import { ADSENSE_CLIENT } from "../lib/consts";

interface Props {
  slot: string; // REQUIRED: no default, must be provided
  client?: string;
  label?: string;
  format?: string;
  responsive?: boolean;
}

const {
  slot,
  client = ADSENSE_CLIENT,
  label = "Pubblicità",
  format = "auto",
  responsive = true,
} = Astro.props as Props;

// Validazione: slot è obbligatorio
if (!slot || typeof slot !== "string" || slot.trim() === "") {
  console.error("[AdSlot] ERROR: 'slot' prop is required and must be a non-empty string");
  // In produzione, non renderizzare nulla se slot mancante
}

// Validazione: client è obbligatorio
if (!client || typeof client !== "string" || client.trim() === "") {
  console.error("[AdSlot] ERROR: 'client' prop is required and must be a non-empty string");
}

// id univoco per questa istanza (build-time)
const instanceId =
  (globalThis.crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(16).slice(2)}`);
---

{slot && client ? (
  <div class="adslot-wrapper">
    <div class="adslot-container" data-adslot-instance={instanceId} data-adslot-id={slot}>
      {label ? <p class="adslot-label">{label}</p> : null}
      <ins
        class="adsbygoogle"
        data-ad-client={client}
        data-ad-slot={slot}
        data-ad-format={format}
        data-full-width-responsive={String(responsive)}
        style="display:block"
      ></ins>
    </div>
  </div>
) : null}

<!-- 
  Nota: l'inizializzazione è gestita centralmente da initAllSlots() nel layout.
  Non fare push diretti qui per evitare doppie inizializzazioni.
  Gli Observer (ResizeObserver + IntersectionObserver) gestiranno l'init quando lo slot è layout-ready.
-->

<style>
  /* Wrapper esterno: previene collasso a width=0 */
  .adslot-wrapper {
    display: block;
    width: 100%;
    min-height: 120px; /* Altezza minima per evitare collasso */
  }

  /* Negli articoli, garantisci min-width:300px (ma evita che in layout stretti diventi 0) */
  .post-main .adslot-wrapper,
  article .adslot-wrapper {
    min-width: 300px;
  }

  /* Evita che wrapper collassi in flex/grid */
  .adslot-wrapper {
    flex-shrink: 0;
  }

  .adslot-container {
    width: 100%;
    display: block;
  }

  .adslot-label {
    font-size: 0.75rem;
    color: var(--muted, rgba(255, 255, 255, 0.6));
    text-transform: uppercase;
    margin: 0 0 0.5rem;
    text-align: center;
  }

  .adsbygoogle {
    display: block;
    width: 100%;
  }
</style>
