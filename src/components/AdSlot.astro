---
import { ADSENSE_CLIENT } from "../lib/consts";

interface Props {
  slot: string; // REQUIRED: no default, must be provided
  client?: string;
  label?: string;
  format?: string;
  responsive?: boolean;
}

const {
  slot,
  client = ADSENSE_CLIENT,
  label = "Pubblicità",
  format = "auto",
  responsive = true,
} = Astro.props as Props;

// Validazione: slot è obbligatorio
if (!slot || typeof slot !== "string" || slot.trim() === "") {
  console.error("[AdSlot] ERROR: 'slot' prop is required and must be a non-empty string");
  // In produzione, non renderizzare nulla se slot mancante
}

// Validazione: client è obbligatorio
if (!client || typeof client !== "string" || client.trim() === "") {
  console.error("[AdSlot] ERROR: 'client' prop is required and must be a non-empty string");
}

// id univoco per questa istanza (build-time)
const instanceId =
  (globalThis.crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(16).slice(2)}`);
---

{slot && client ? (
  <div class="adslot-container" data-adslot-instance={instanceId} data-adslot-id={slot}>
    {label ? <p class="adslot-label">{label}</p> : null}
    <ins
      class="adsbygoogle"
      data-ad-client={client}
      data-ad-slot={slot}
      data-ad-format={format}
      data-full-width-responsive={String(responsive)}
      style="display:block"
    ></ins>
  </div>
) : null}

<script is:inline define:vars={{ instanceId, slot, client }}>
(() => {
  // Validazione slot duplicati: traccia slot già usati in questa pagina
  if (!window.__adsenseUsedSlots) {
    window.__adsenseUsedSlots = new Set();
  }

  // Se questo slot è già stato usato, logga warning (non bloccare, ma avvisa)
  if (window.__adsenseUsedSlots.has(slot)) {
    console.warn(`[AdSlot] WARNING: Slot "${slot}" is used multiple times on this page. Each AdSlot should have a unique slot ID.`);
  } else {
    window.__adsenseUsedSlots.add(slot);
  }

  // Nota: l'inizializzazione vera e propria sarà gestita da initAds() globale
  // che viene chiamata su astro:page-load e astro:after-swap
})();
</script>
