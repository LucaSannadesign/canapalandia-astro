---
interface ActionLink {
  href: string;
  label: string;
  isPrimary?: boolean;
}

interface ActionCard {
  meta: string;
  badge: string;
  title: string;
  description: string;
  links: ActionLink[];
  mediaHref: string;
  mediaAlt: string;
  mediaImage: string;
  mediaAriaLabel: string;
}

const cards: ActionCard[] = [
  {
    meta: "Tool",
    badge: "Ribaltatore",
    title: "Ribaltatore AI",
    description: "Scrivi una frase proibizionista e ottieni una risposta ironica e antiproibizionista, pronta da copiare e condividere.",
    links: [
      { href: "/ribaltatore/", label: "Provalo ora", isPrimary: true },
      { href: "/frasi-ribaltate", label: "Archivio frasi" }
    ],
    mediaHref: "/ribaltatore/",
    mediaImage: "/images/home/ribaltatore-ai-banner-640x360.webp",
    mediaAlt: "Ribaltatore AI",
    mediaAriaLabel: "Vai al Ribaltatore"
  },
  {
    meta: "Bottega",
    badge: "In test",
    title: "Bottega Canapalandia",
    description: "Stiamo testando l'interesse per un possibile primo prodotto alimentare a base di semi di canapa. Nessun ordine o pagamento.",
    links: [
      { href: "/bottega/", label: "Vedi il test", isPrimary: true },
      { href: "/blog/canapa-alimentare-semi-farina-olio-proteine/", label: "Guida alla canapa alimentare" }
    ],
    mediaHref: "/bottega/",
    mediaImage: "/images/canapa-alimentare-semi-farina-olio-proteine.webp",
    mediaAlt: "Canapa alimentare: semi, farina, olio e proteine",
    mediaAriaLabel: "Vai al test Bottega Canapalandia"
  },
  {
    meta: "Community",
    badge: "Supporto",
    title: "Supporta Canapalandia",
    description: "Se trovi utile il progetto, puoi sostenerlo o scoprire i partner selezionati.",
    links: [
      { href: "/sostieni-la-nostra-causa/", label: "Sostienici", isPrimary: true }
    ],
    mediaHref: "/sostieni-la-nostra-causa/",
    mediaImage: "/images/home/supporta-canapalandia-banner-640x360.webp",
    mediaAlt: "Supporta Canapalandia",
    mediaAriaLabel: "Sostieni Canapalandia"
  }
];
---

<section class="action-cards-section">
  <div class="container">
    <div class="action-cards-grid">
      {cards.map((card) => (
        <article class="action-card">
          <div class="action-card__body">
            <div class="action-card__meta">
              <p class="action-card__meta-label">{card.meta}</p>
              <span class="action-card__badge">{card.badge}</span>
            </div>

            <h2 class="action-card__title">{card.title}</h2>

            <p class="action-card__description">{card.description}</p>

            <div class="action-card__links">
              {card.links.map((link) => (
                <a
                  href={link.href}
                  class={`action-card__link ${link.isPrimary ? 'action-card__link--primary' : 'action-card__link--secondary'}`}
                >
                  {link.label}
                  <span aria-hidden="true">→</span>
                </a>
              ))}
            </div>

            <a
              href={card.mediaHref}
              class="action-card__media"
              aria-label={card.mediaAriaLabel}
            >
              <img
                src={card.mediaImage}
                alt={card.mediaAlt}
                loading="lazy"
                decoding="async"
                class="action-card__media-img"
              />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .action-cards-section {
    padding-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .action-cards-section {
      padding-bottom: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .action-cards-section {
      padding-bottom: 4rem;
    }
  }

  .action-cards-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .action-cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
    }
  }

  @media (min-width: 1280px) {
    .action-cards-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .action-card {
    border-radius: var(--r-md);
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    overflow: hidden;
    transition: all 0.3s ease-out;
  }

  .action-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
  }

  .action-card__body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    height: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .action-card__body {
      padding: 2rem;
    }
  }

  .action-card__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .action-card__meta-label {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }

  .action-card__badge {
    display: inline-flex;
    align-items: center;
    border-radius: var(--r-full);
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.8);
  }

  .action-card__title {
    margin: 1rem 0 0;
    font-size: 1.875rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: white;
  }

  @media (min-width: 768px) {
    .action-card__title {
      font-size: 2.25rem;
    }
  }

  .action-card__description {
    margin: 1rem 0 0;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
  }

  .action-card__links {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .action-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border-radius: var(--r-md);
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease-out;
  }

  .action-card__link:focus {
    outline: none;
  }

  .action-card__link:focus-visible {
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.4);
  }

  .action-card__link:hover {
    text-decoration: none;
  }

  .action-card__link--primary {
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.08);
    color: white;
  }

  .action-card__link--primary:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .action-card__link--primary span {
    color: rgba(255, 255, 255, 0.8);
  }

  html[data-theme="light"] .action-card__link--primary {
    color: #f0faf3;
  }

  html[data-theme="light"] .action-card__link--primary:hover {
    color: #f0faf3;
  }

  html[data-theme="light"] .action-card__link--primary span {
    color: inherit;
  }

  .action-card__link--secondary {
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: transparent;
    color: rgba(255, 255, 255, 0.8);
  }

  .action-card__link--secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.25);
    color: white;
  }

  .action-card__link--secondary span {
    color: rgba(255, 255, 255, 0.6);
  }

  .action-card__media {
    display: block;
    width: 100%;
    margin-top: auto;
    overflow: hidden;
    border-radius: var(--r-sm);
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.2);
    height: 240px;
    transition: all 0.3s ease-out;
  }

  @media (min-width: 640px) {
    .action-card__media {
      height: 280px;
    }
  }

  @media (min-width: 768px) {
    .action-card__media {
      height: 320px;
    }
  }

  @media (min-width: 1024px) {
    .action-card__media {
      height: 350px;
    }
  }

  @media (min-width: 1280px) {
    .action-card__media {
      height: 270px;
    }
  }

  .action-card:hover .action-card__media {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(0, 0, 0, 0.3);
  }

  .action-card__media:focus {
    outline: none;
  }

  .action-card__media:focus-visible {
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.3);
  }

  .action-card__media-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease-out;
  }

  .action-card:hover .action-card__media-img {
    transform: scale(1.03);
  }
</style>
