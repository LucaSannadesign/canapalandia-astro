---
// CookieBanner: banner di consenso cookie leggero e mobile-first
---

<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Gestione cookie" aria-hidden="true">
  <div class="cookie-banner__content">
    <p class="cookie-banner__text">
      Utilizziamo cookie tecnici e, con il tuo consenso, cookie di analytics per migliorare la tua esperienza. 
      <a href="/cookie-policy/">Maggiori informazioni</a>.
    </p>
    <div class="cookie-banner__actions">
      <button type="button" class="cookie-banner__btn cookie-banner__btn--accept" data-cookie-accept>
        Accetta
      </button>
      <button type="button" class="cookie-banner__btn cookie-banner__btn--reject" data-cookie-reject>
        Rifiuta
      </button>
      <button type="button" class="cookie-banner__btn cookie-banner__btn--prefs" data-cookie-prefs>
        Preferenze
      </button>
    </div>
  </div>
</div>

<div id="cookie-prefs" class="cookie-prefs" role="dialog" aria-label="Preferenze cookie" aria-hidden="true">
  <div class="cookie-prefs__overlay" data-cookie-prefs-close></div>
  <div class="cookie-prefs__panel">
    <div class="cookie-prefs__header">
      <h2 class="cookie-prefs__title">Preferenze Cookie</h2>
      <button type="button" class="cookie-prefs__close" data-cookie-prefs-close aria-label="Chiudi">
        ×
      </button>
    </div>
    <div class="cookie-prefs__body">
      <div class="cookie-prefs__item">
        <div class="cookie-prefs__label">
          <label for="cookie-analytics">Cookie Analytics</label>
          <p class="cookie-prefs__desc">Permettono di analizzare l'utilizzo del sito per migliorare l'esperienza utente.</p>
        </div>
        <label class="cookie-prefs__toggle">
          <input type="checkbox" id="cookie-analytics" data-cookie-toggle="analytics" />
          <span class="cookie-prefs__slider"></span>
        </label>
      </div>
    </div>
    <div class="cookie-prefs__footer">
      <button type="button" class="cookie-prefs__save btn primary" data-cookie-save>
        Salva preferenze
      </button>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 16px max(var(--pad), env(safe-area-inset-left)) 16px max(var(--pad), env(safe-area-inset-right));
    padding-bottom: max(16px, env(safe-area-inset-bottom));
    background: var(--panel);
    border-top: 1px solid var(--border);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.2);
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }

  .cookie-banner[aria-hidden="false"] {
    transform: translateY(0);
  }

  .cookie-banner__content {
    max-width: var(--container);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cookie-banner__text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text);
  }

  .cookie-banner__text a {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cookie-banner__actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .cookie-banner__btn {
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--panel-2);
    color: var(--text);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .cookie-banner__btn:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-1px);
  }

  html[data-theme="light"] .cookie-banner__btn:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  .cookie-banner__btn--accept {
    background: var(--brand);
    color: #fff;
    border-color: transparent;
  }

  .cookie-banner__btn--accept:hover {
    background: var(--brand-2);
  }

  /* Preferenze panel */
  .cookie-prefs {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .cookie-prefs[aria-hidden="false"] {
    opacity: 1;
    pointer-events: auto;
  }

  .cookie-prefs__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  .cookie-prefs__panel {
    position: relative;
    max-width: 500px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--r);
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
  }

  .cookie-prefs__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 20px 16px;
    border-bottom: 1px solid var(--border);
  }

  .cookie-prefs__title {
    margin: 0;
    font-size: 1.3rem;
  }

  .cookie-prefs__close {
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    color: var(--text);
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }

  .cookie-prefs__close:hover {
    background: var(--panel-2);
  }

  .cookie-prefs__body {
    padding: 20px;
    flex: 1;
    overflow-y: auto;
  }

  .cookie-prefs__item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }

  .cookie-prefs__item:last-child {
    border-bottom: none;
  }

  .cookie-prefs__label {
    flex: 1;
  }

  .cookie-prefs__label label {
    display: block;
    font-weight: 600;
    margin-bottom: 4px;
    color: var(--text);
  }

  .cookie-prefs__desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .cookie-prefs__toggle {
    position: relative;
    display: inline-block;
    width: 48px;
    height: 26px;
    flex-shrink: 0;
  }

  .cookie-prefs__toggle input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .cookie-prefs__slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.2);
    transition: 0.3s;
    border-radius: 26px;
    border: 1px solid var(--border);
  }

  .cookie-prefs__slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 3px;
    bottom: 3px;
    background-color: #fff;
    transition: 0.3s;
    border-radius: 50%;
  }

  .cookie-prefs__toggle input:checked + .cookie-prefs__slider {
    background-color: var(--brand);
    border-color: var(--brand);
  }

  .cookie-prefs__toggle input:checked + .cookie-prefs__slider:before {
    transform: translateX(22px);
  }

  .cookie-prefs__footer {
    padding: 16px 20px 20px;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    .cookie-banner__actions {
      flex-direction: column;
    }

    .cookie-banner__btn {
      width: 100%;
    }

    .cookie-prefs__panel {
      max-width: 100%;
      max-height: 100vh;
      border-radius: 0;
    }
  }
</style>

<script>
  (() => {
    const STORAGE_KEY = "canapalandia_cookie_consent";
    const banner = document.getElementById("cookie-banner");
    const prefsPanel = document.getElementById("cookie-prefs");
    const analyticsToggle = document.getElementById("cookie-analytics");

    if (!banner || !prefsPanel) return;

    // Leggi consenso salvato
    const getConsent = () => {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          return JSON.parse(saved);
        }
      } catch {}
      return null;
    };

    // Salva consenso
    const saveConsent = (analytics: boolean) => {
      try {
        const consent = {
          analytics: analytics === true,
          decidedAt: new Date().toISOString(),
        };
        localStorage.setItem(STORAGE_KEY, JSON.stringify(consent));
        return consent;
      } catch {
        return null;
      }
    };

    // Mostra banner se non c'è consenso
    const consent = getConsent();
    if (!consent) {
      banner.setAttribute("aria-hidden", "false");
    }

    // Accetta tutto
    const acceptBtn = banner.querySelector("[data-cookie-accept]");
    if (acceptBtn) {
      acceptBtn.addEventListener("click", () => {
        saveConsent(true);
        banner.setAttribute("aria-hidden", "true");
        // Trigger evento per GA4
        window.dispatchEvent(new CustomEvent("cookieConsentChanged", { detail: { analytics: true } }));
      });
    }

    // Rifiuta tutto
    const rejectBtn = banner.querySelector("[data-cookie-reject]");
    if (rejectBtn) {
      rejectBtn.addEventListener("click", () => {
        saveConsent(false);
        banner.setAttribute("aria-hidden", "true");
        window.dispatchEvent(new CustomEvent("cookieConsentChanged", { detail: { analytics: false } }));
      });
    }

    // Apri preferenze
    const prefsBtn = banner.querySelector("[data-cookie-prefs]");
    if (prefsBtn) {
      prefsBtn.addEventListener("click", () => {
        const current = getConsent();
        if (analyticsToggle && analyticsToggle instanceof HTMLInputElement) {
          analyticsToggle.checked = current?.analytics === true;
        }
        prefsPanel.setAttribute("aria-hidden", "false");
      });
    }

    // Chiudi preferenze
    const closePrefs = () => {
      prefsPanel.setAttribute("aria-hidden", "true");
    };
    const closeBtns = prefsPanel.querySelectorAll("[data-cookie-prefs-close]");
    closeBtns.forEach((btn) => btn.addEventListener("click", closePrefs));

    // Salva preferenze
    const saveBtn = prefsPanel.querySelector("[data-cookie-save]");
    if (saveBtn) {
      saveBtn.addEventListener("click", () => {
        let analytics = false;
        if (analyticsToggle && analyticsToggle instanceof HTMLInputElement) {
          analytics = analyticsToggle.checked === true;
        }
        saveConsent(analytics);
        banner.setAttribute("aria-hidden", "true");
        closePrefs();
        window.dispatchEvent(new CustomEvent("cookieConsentChanged", { detail: { analytics } }));
      });
    }
  })();
</script>
