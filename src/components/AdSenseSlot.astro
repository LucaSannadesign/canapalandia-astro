---
interface Props {
  slot: string;
  minWidth?: number;
  minHeight?: number;
}

const { slot, minWidth = 300, minHeight = 250 } = Astro.props;
---

<div class="adsense-slot-wrapper">
  <div class="adsense-slot-container">
    <ins
      class="adsbygoogle"
      data-ad-client="ca-pub-6462363788506395"
      data-ad-slot={slot}
      style={`display:block; min-width:${minWidth}px; min-height:${minHeight}px;`}
    ></ins>
  </div>
</div>

<!-- 
  Nota: l'inizializzazione è gestita centralmente da setupAdSense() nel layout.
  Non fare push diretti qui per evitare doppie inizializzazioni.
-->

<style>
  .adsense-slot-wrapper {
    width: 100%;
    min-width: 250px; /* Minimum width per AdSense */
    display: block;
    flex: 1 1 auto; /* Previene shrink in flex containers */
  }

  .adsense-slot-container {
    width: 100%;
    max-width: 360px;
    margin: 0 auto;
    text-align: center;
    overflow: hidden;
  }

  .adsbygoogle {
    display: block;
    width: 100%;
    overflow: hidden;
  }
</style>
