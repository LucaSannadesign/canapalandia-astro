---
/**
 * Google Analytics 4 (GA4) Tag Component
 * 
 * Inietta gtag.js e script di configurazione GA4 nel <head>.
 * Utilizza PUBLIC_GA_ID come variabile d'ambiente.
 * 
 * Se PUBLIC_GA_ID non è definita, non renderizza nulla.
 */

const GA_ID = import.meta.env.PUBLIC_GA_ID;

// Se non c'è GA_ID, non renderizzare nulla
if (!GA_ID) {
  return null;
}

// Script inline con configurazione GA4
// Usa set:html per garantire interpolazione corretta dell'ID
const inlineScript = `
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '${GA_ID}');
`;
---

{GA_ID ? (
  <>
    <!-- Google Analytics 4 -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline set:html={inlineScript} />
  </>
) : null}
