---
interface Props {
  publishDate: Date | string | number | null | undefined;
  updatedDate?: Date | string | number | null | undefined;
  slug: string;
  lang?: "it" | "en";
}

const { publishDate, updatedDate, slug, lang = "it" } = Astro.props as Props;
const locale = lang === "en" ? "en-GB" : "it-IT";
const updatedLabel = lang === "en" ? "Updated" : "Aggiornato il";

function toDate(value: Date | string | number | null | undefined): Date | null {
  if (!value) return null;
  if (value instanceof Date) return Number.isNaN(value.getTime()) ? null : value;
  const d = new Date(String(value));
  return Number.isNaN(d.getTime()) ? null : d;
}

function formatDate(value: Date | string | number | null | undefined): string {
  const d = toDate(value);
  if (!d) return "";
  return d.toLocaleDateString(locale, { year: "numeric", month: "long", day: "numeric" });
}

function getDateTime(value: Date | string | number | null | undefined): string {
  const d = toDate(value);
  if (!d) return "";
  return d.toISOString().split("T")[0];
}

const pubDate = toDate(publishDate);
const updDate = toDate(updatedDate);
const showUpdated = Boolean(updDate && pubDate && updDate.getTime() > pubDate.getTime());

const formattedPublishDate = formatDate(publishDate);
const publishDateTime = getDateTime(publishDate);
const formattedUpdatedDate = showUpdated ? formatDate(updatedDate) : "";
const updatedDateTime = showUpdated ? getDateTime(updatedDate) : "";
---

<div class="post-meta">
  <div class="post-meta__item">
    <svg
      class="post-meta__icon"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
    <time class="post-meta__date" datetime={publishDateTime}>
      {formattedPublishDate}
    </time>
  </div>

  {showUpdated ? (
    <div class="post-meta__item">
      <svg
        class="post-meta__icon"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"></path>
      </svg>
      <span class="post-meta__label">{updatedLabel}</span>
      <time class="post-meta__date" datetime={updatedDateTime}>
        {formattedUpdatedDate}
      </time>
    </div>
  ) : null}
</div>

<style>
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    margin: 1rem 0 1.5rem;
    padding: 0.75rem 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .post-meta__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .post-meta__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: var(--muted);
    opacity: 0.7;
  }

  .post-meta__date {
    color: var(--text);
    font-weight: var(--font-medium);
  }

  .post-meta__label {
    color: var(--muted);
    font-weight: var(--font-normal);
  }

  @media (max-width: 640px) {
    .post-meta {
      gap: 1rem;
      font-size: var(--text-xs);
    }
  }

  .post-meta__date:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
    border-radius: var(--r-md);
  }
</style>
