---
interface Props {
  publishDate: Date | string | number | null | undefined;
  updatedDate?: Date | string | number | null | undefined;
  slug: string; // Mantenuto per compatibilità futura (pageviews)
}

const { publishDate, updatedDate, slug } = Astro.props;

// TODO: Reintrodurre pageviews quando il tracking sarà stabile
// Feature flag suggerito: SHOW_PAGEVIEWS (env/config) o showPageviews (frontmatter)
// const SHOW_PAGEVIEWS = false; // Configurazione futura

// Helper per convertire in Date | null
function toDate(value: Date | string | number | null | undefined): Date | null {
  if (!value) return null;
  if (value instanceof Date) {
    return Number.isNaN(value.getTime()) ? null : value;
  }
  const d = new Date(String(value));
  return Number.isNaN(d.getTime()) ? null : d;
}

// Helper per formattare data
function formatDate(value: Date | string | number | null | undefined): string {
  const d = toDate(value);
  if (!d) return "";
  return d.toLocaleDateString("it-IT", { year: "numeric", month: "long", day: "numeric" });
}

// Helper per ottenere datetime ISO (YYYY-MM-DD)
function getDateTime(value: Date | string | number | null | undefined): string {
  const d = toDate(value);
  if (!d) return "";
  return d.toISOString().split("T")[0];
}

// Helper per confrontare solo le date (ignora l'orario)
function isSameDate(date1: Date | null, date2: Date | null): boolean {
  if (!date1 || !date2) return false;
  return (
    date1.getFullYear() === date2.getFullYear() &&
    date1.getMonth() === date2.getMonth() &&
    date1.getDate() === date2.getDate()
  );
}

// Normalizza le date
const pubDate = toDate(publishDate);
const updDate = toDate(updatedDate);

// Mostra "Aggiornato il..." solo se updatedDate esiste ed è diversa da publishDate
const showUpdated = updDate && pubDate && !isSameDate(pubDate, updDate);

const formattedPublishDate = formatDate(publishDate);
const publishDateTime = getDateTime(publishDate);
const formattedUpdatedDate = showUpdated ? formatDate(updatedDate) : "";
const updatedDateTime = showUpdated ? getDateTime(updatedDate) : "";
---

<div class="post-meta" itemscope itemtype="https://schema.org/Article">
  <div class="post-meta__item">
    <svg
      class="post-meta__icon"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
    <time
      class="post-meta__date"
      datetime={publishDateTime}
      itemprop="datePublished"
    >
      {formattedPublishDate}
    </time>
  </div>
  
  {showUpdated ? (
    <div class="post-meta__item">
      <svg
        class="post-meta__icon"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"></path>
      </svg>
      <span class="post-meta__label">Aggiornato il</span>
      <time
        class="post-meta__date"
        datetime={updatedDateTime}
        itemprop="dateModified"
      >
        {formattedUpdatedDate}
      </time>
    </div>
  ) : null}
  
  {/* TODO: Reintrodurre pageviews quando il tracking sarà stabile
      Blocco rimosso temporaneamente per inaffidabilità dei dati.
