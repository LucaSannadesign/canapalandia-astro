<style>
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    margin: 1rem 0 1.5rem;
    padding: 0.75rem 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .post-meta__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .post-meta__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: var(--muted);
    opacity: 0.7;
  }

  .post-meta__date {
    color: var(--text);
    font-weight: var(--font-medium);
  }

  .post-meta__label {
    color: var(--muted);
    font-weight: var(--font-normal);
  }

  /* TODO: CSS per pageviews - da riattivare quando il tracking sarà stabile
  .post-meta__views {
    color: var(--muted);
  }

  .post-meta__views-placeholder {
    color: var(--muted);
    font-weight: var(--font-medium);
  }
  */

  /* Mobile: stack verticale se spazio limitato */
  @media (max-width: 640px) {
    .post-meta {
      gap: 1rem;
      font-size: var(--text-xs);
    }
  }

  /* Accessibilità: focus visible */
  .post-meta__date:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
    border-radius: var(--r-md);
  }
</style>
