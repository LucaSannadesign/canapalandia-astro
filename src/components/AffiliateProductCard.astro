---
interface Props {
  title: string;
  format?: string;
  reason: string;
  href?: string;
  merchant?: string;
  ctaLabel?: string;
}

const {
  title,
  format,
  reason,
  href,
  merchant = "rivenditore esterno",
  ctaLabel = "Vedi il prodotto selezionato",
} = Astro.props;

const isActive = typeof href === "string" && /^https?:\/\//i.test(href);
---

<aside class="affiliate-card" aria-label={`Selezione Canapalandia: ${title}`}>
  <p class="affiliate-card__eyebrow">
    <span class="affiliate-card__dot" aria-hidden="true"></span>
    Selezione Canapalandia
  </p>

  <h3 class="affiliate-card__title">{title}</h3>
  {format ? <p class="affiliate-card__format">{format}</p> : null}
  <p class="affiliate-card__reason">{reason}</p>

  {isActive ? (
    <a
      class="affiliate-card__cta"
      href={href}
      target="_blank"
      rel="sponsored nofollow noopener noreferrer"
    >
      {ctaLabel} <span aria-hidden="true">→</span>
    </a>
  ) : (
    <span class="affiliate-card__cta affiliate-card__cta--disabled" aria-disabled="true">
      Link disponibile dopo approvazione
    </span>
  )}

  {isActive ? (
    <p class="affiliate-card__disclosure">
      <strong>Pubblicità — link affiliato.</strong> Il collegamento porta a {merchant}. Se acquisti tramite
      questo link, Canapalandia può ricevere una commissione senza costi aggiuntivi per te.
    </p>
  ) : (
    <p class="affiliate-card__disclosure">
      Spazio predisposto per una futura affiliazione. Nessun collegamento commerciale è attivo in questa versione.
    </p>
  )}
</aside>

<style>
  .affiliate-card {
    margin: 1.5rem 0 2rem;
    padding: 1.15rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: color-mix(in oklab, var(--panel) 94%, var(--brand) 6%);
    box-shadow: 0 8px 24px rgba(7, 24, 14, 0.05);
  }

  .affiliate-card__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.6rem;
    color: var(--brand);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .affiliate-card__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: currentColor;
  }

  .affiliate-card__title {
    margin: 0;
    color: var(--text);
    font-family: var(--font-ui);
    font-size: clamp(1.08rem, 2vw, 1.25rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .affiliate-card__format {
    margin: 0.35rem 0 0;
    color: var(--muted, var(--text));
    font-size: 0.84rem;
    opacity: 0.78;
  }

  .affiliate-card__reason {
    margin: 0.85rem 0 1rem;
    color: var(--text);
    line-height: 1.6;
  }

  .affiliate-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 42px;
    padding: 0.68rem 0.95rem;
    border: 1px solid var(--brand);
    border-radius: 999px;
    background: var(--brand);
    color: #fff;
    font-family: var(--font-ui);
    font-size: 0.86rem;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
  }

  .affiliate-card__cta:hover {
    filter: brightness(1.04);
    transform: translateY(-1px);
  }

  .affiliate-card__cta--disabled {
    border-color: var(--border);
    background: transparent;
    color: var(--text);
    cursor: default;
    opacity: 0.62;
  }

  .affiliate-card__disclosure {
    margin: 0.85rem 0 0;
    color: var(--text);
    font-size: 0.75rem;
    line-height: 1.5;
    opacity: 0.68;
  }

  @media (max-width: 640px) {
    .affiliate-card {
      padding: 1rem;
    }

    .affiliate-card__cta {
      width: 100%;
    }
  }
</style>
