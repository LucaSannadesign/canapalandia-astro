---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PostMeta from "../../components/PostMeta.astro";
import PostShare from "../../components/PostShare.astro";
import SupportCTA from "../../components/SupportCTA.astro";
import PreviewContent from "../../preview/can-260918.mdx";

export const prerender = false;

if (!import.meta.env.DEV) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const slug = "terpeni-canapa-cosa-sono";
const title = "Terpeni della canapa: cosa sono, perché cambiano e cosa non possono dimostrare";
const description = "Cosa sono i terpeni della canapa, perché il profilo cambia tra cultivar e lotti e perché una lista di terpeni non dimostra effetti clinici.";
const canonical = `https://canapalandia.com/blog/${slug}/`;
const metadata = {
  title: `[PREVIEW] ${title}`,
  description,
  canonical,
  robots: { index: false, follow: false },
  ogType: "article",
  ogSiteName: "Canapalandia",
  twitterCard: "summary_large_image",
};
---

<SiteLayout metadata={metadata} newsletter={false}>
  <div class="container page-shell">
    <article class="preview-post">
      <aside class="preview-banner">
        <strong>ANTEPRIMA LOCALE — BOZZA NON PUBBLICATA</strong>
        <span>Route DEV-only. Non viene generata né servita in produzione.</span>
      </aside>

      <h1>{title}</h1>

      <div class="post-meta-row">
        <PostMeta publishDate="2026-09-18" updatedDate="2026-09-14" slug={slug} lang="it" />
        <p class="post-author" aria-label="Autore articolo">Di <strong>Canapalandia</strong></p>
      </div>

      <aside class="hero-gate">
        <strong>Hero non ancora collegata</strong>
        <p>La pubblicazione resta bloccata finché l’immagine approvata non è presente nel repository, collegata al frontmatter e verificata in locale.</p>
      </aside>

      <div class="post-content" data-post-content>
        <PreviewContent />
      </div>

      <aside class="post-editorial-note" aria-label="Nota editoriale">
        <p>
          Canapalandia è un progetto editoriale indipendente dedicato a canapa, CBD, cannabis light e normativa in Italia. I contenuti hanno finalità informative e non costituiscono consulenza legale o medica.
          <a href="/disclaimer-legale-canapalandia/"> Leggi il disclaimer legale.</a>
        </p>
      </aside>

      <PostShare url={canonical} title={title} showShare={true} lang="it" />
      <SupportCTA supportUrl="/sostieni-la-nostra-causa/" showSupportCta={true} />
    </article>
  </div>
</SiteLayout>

<style>
  .preview-post {
    width: min(100%, 860px);
    margin: 0 auto;
    padding: 2rem 0 4rem;
  }
  .preview-banner,
  .hero-gate {
    margin: 0 0 1.5rem;
    padding: 0.95rem 1rem;
    border: 1px solid color-mix(in oklab, var(--gold) 55%, var(--border));
    border-radius: var(--r-md);
    background: var(--panel);
    font-family: var(--font-ui);
  }
  .preview-banner strong,
  .preview-banner span,
  .hero-gate strong,
  .hero-gate p { display: block; }
  .preview-banner strong,
  .hero-gate strong { margin-bottom: 0.25rem; }
  .preview-banner span,
  .hero-gate p { margin: 0; color: var(--muted); font-size: var(--text-sm); line-height: 1.5; }
  .post-content {
    max-width: 72ch;
    width: 100%;
    font-size: clamp(1.0625rem, 0.4vw + 1rem, 1.1875rem);
    line-height: 1.7;
  }
  .post-content :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1.5rem 0 2rem;
    font-family: var(--font-ui);
    font-size: 0.94rem;
  }
  .post-content :global(th),
  .post-content :global(td) {
    padding: 0.72rem 0.8rem;
    border: 1px solid var(--border);
    vertical-align: top;
    text-align: left;
  }
  .post-content :global(th) { background: var(--panel); }
  .post-content :global(h2) { margin-top: 2.5rem; }
  .post-content :global(h3) { margin-top: 2rem; }
</style>
