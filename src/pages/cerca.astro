---
export const prerender = false;

import { getCollection } from "astro:content";
import MigratedLayout from "../layouts/MigratedLayout.astro";
import { blogPublishDate } from "../lib/blogVisibility";
import {
  SEARCH_MAX_QUERY_LENGTH,
  SEARCH_RESULTS_LIMIT,
  postHref,
  readSearchQuery,
  searchPosts,
  searchablePosts,
  tokenizeSearchQuery,
} from "../lib/search";

const q = readSearchQuery(Astro.url);

// SEO: la ricerca interna è una pagina di servizio. Non deve competere nelle SERP;
// i link ai risultati restano seguibili e il canonical resta stabile su /cerca/.
const robots = "noindex,follow";
const canonical = `${import.meta.env.SITE || "https://canapalandia.com"}/cerca/`;
const title = "Cerca nel magazine | Canapalandia";
const description =
  "Cerca articoli, guide e approfondimenti pubblicati su Canapalandia per tema, parola chiave o argomento.";

// Stessa fonte e stesso gate editoriale di /blog/: solo articoli IT pubblicati,
// esclusi bozze, contenuti futuri e quarantena `legacy-review`.
const posts = searchablePosts(await getCollection("blog"), "it");
const latest = posts.slice(0, 9);

const tokens = tokenizeSearchQuery(q);
const matches = searchPosts(posts, tokens);
const results = matches.slice(0, SEARCH_RESULTS_LIMIT);
const resultsLabel =
  matches.length === 1
    ? "1 risultato"
    : matches.length > results.length
      ? `Primi ${results.length} di ${matches.length} risultati`
      : `${matches.length} risultati`;

const dateFormatter = new Intl.DateTimeFormat("it-IT", { day: "numeric", month: "long", year: "numeric" });
const dateOf = (entry: (typeof posts)[number]) => {
  const d = blogPublishDate(entry);
  return d ? { iso: d.toISOString().slice(0, 10), label: dateFormatter.format(d) } : null;
};
---

<MigratedLayout title={title} description={description} robots={robots} canonical={canonical}>
  <section class="container">
    <header class="search-head">
      <h1>Cerca</h1>
      <p class="muted" id="q-hint">Cerca negli articoli del magazine: anche parole parziali, senza badare ad accenti o maiuscole.</p>

      <form class="search-form" method="get" action="/cerca/" role="search">
        <label class="sr-only" for="q">Cerca nel magazine</label>
        <input
          id="q"
          name="q"
          type="search"
          placeholder="Es. CBD, decreto sicurezza, terpeni…"
          value={q}
          maxlength={SEARCH_MAX_QUERY_LENGTH}
          autocomplete="off"
          enterkeyhint="search"
          aria-describedby="q-hint"
        />
        <button type="submit">Cerca</button>
      </form>
    </header>

    <div aria-live="polite">
      {tokens.length ? (
        results.length ? (
          <section class="results" aria-labelledby="results-title">
            <h2 id="results-title">
              {resultsLabel} per «{q}»
            </h2>
            <div class="grid">
              {results.map((e) => {
                const date = dateOf(e);
                return (
                  <article class="card">
                    <h3><a href={postHref(e)}>{e.data.title}</a></h3>
                    {e.data.description ? <p class="muted">{e.data.description}</p> : null}
                    {date ? <p class="meta"><time datetime={date.iso}>{date.label}</time></p> : null}
                  </article>
                );
              })}
            </div>
          </section>
        ) : (
          <section class="results" aria-labelledby="results-title">
            <h2 id="results-title">Nessun risultato per «{q}»</h2>
            <p class="muted">Prova con un termine più breve o diverso. Qui sotto trovi gli ultimi articoli.</p>
          </section>
        )
      ) : q ? (
        <section class="results">
          <h2>Query troppo corta</h2>
          <p class="muted">Scrivi almeno due lettere per cercare. Qui sotto trovi gli ultimi articoli.</p>
        </section>
      ) : null}
    </div>

    {!results.length ? (
      <section class="latest" aria-labelledby="latest-title">
        <h2 id="latest-title">Ultimi articoli</h2>
        <div class="grid">
          {latest.map((p) => {
            const date = dateOf(p);
            return (
              <article class="card">
                <h3><a href={postHref(p)}>{p.data.title}</a></h3>
                {p.data.description ? <p class="muted">{p.data.description}</p> : null}
                {date ? <p class="meta"><time datetime={date.iso}>{date.label}</time></p> : null}
              </article>
            );
          })}
        </div>
      </section>
    ) : null}
  </section>

  <style>
    .container { max-width: 1120px; margin: 0 auto; padding: 24px 20px 56px; }
    .search-head { margin-bottom: 18px; }
    .muted { opacity: .78; }
    .search-form { display:flex; gap: 10px; margin-top: 12px; }
    .search-form input { flex:1; min-width: 0; min-height: 44px; font-size: 16px; padding: 12px 14px; border-radius: var(--r-md); border: 1px solid rgba(255,255,255,.14); background: rgba(0,0,0,.18); }
    .search-form button { min-height: 44px; padding: 12px 16px; border-radius: var(--r-md); border: 0; background: #2ea043; font-weight: 700; cursor: pointer; }
    .grid { display:grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
    .card { padding: 16px; border-radius: var(--r-md); border: 1px solid rgba(255,255,255,.10); background: rgba(0,0,0,.18); overflow: hidden; }
    .card h3 { margin: 0 0 8px; font-size: 18px; line-height: 1.25; }
    .card a { text-decoration: none; }
    .meta { margin-top: 10px; font-size: 12px; opacity: .7; }
    .sr-only { position:absolute; left:-9999px; }
    @media (max-width: 980px){ .grid{ grid-template-columns: repeat(2, minmax(0,1fr)); } }
    @media (max-width: 640px){ .grid{ grid-template-columns: 1fr; } .search-form{ flex-direction: column; } }
  </style>
</MigratedLayout>