---
export const prerender = false;

import { getCollection } from "astro:content";
import CardPost from "../components/CardPost.astro";
import MigratedLayout from "../layouts/MigratedLayout.astro";
import { blogPublishDate } from "../lib/blogVisibility";
import {
  SEARCH_MAX_QUERY_LENGTH,
  SEARCH_RESULTS_LIMIT,
  postHref,
  postImageSrc,
  readSearchQuery,
  searchPosts,
  searchablePosts,
  tokenizeSearchQuery,
} from "../lib/search";

const q = readSearchQuery(Astro.url);

// SEO: la ricerca interna è una pagina di servizio. Non deve competere nelle SERP;
// i link ai risultati restano seguibili e il canonical resta stabile su /cerca/.
const robots = "noindex,follow";
const canonical = `${import.meta.env.SITE || "https://canapalandia.com"}/cerca/`;
const title = "Cerca nel magazine | Canapalandia";
const description =
  "Cerca articoli, guide e approfondimenti pubblicati su Canapalandia per tema, parola chiave o argomento.";

// Stessa fonte e stesso gate editoriale di /blog/: solo articoli IT pubblicati,
// esclusi bozze, contenuti futuri e quarantena `legacy-review`.
const posts = searchablePosts(await getCollection("blog"), "it");
const latest = posts.slice(0, 9);

const tokens = tokenizeSearchQuery(q);
const matches = searchPosts(posts, tokens);
const results = matches.slice(0, SEARCH_RESULTS_LIMIT);
const resultsLabel =
  matches.length === 1
    ? "1 risultato"
    : matches.length > results.length
      ? `Primi ${results.length} di ${matches.length} risultati`
      : `${matches.length} risultati`;

const dateFormatter = new Intl.DateTimeFormat("it-IT", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const dateLabel = (entry: (typeof posts)[number]) => {
  const d = blogPublishDate(entry);
  return d ? dateFormatter.format(d) : "";
};
---

<MigratedLayout title={title} description={description} robots={robots} canonical={canonical}>
  <section class="container">
    <header class="search-head">
      <h1>Cerca</h1>
      <p class="muted" id="q-hint">
        Cerca negli articoli del magazine: anche parole parziali, senza badare ad accenti o maiuscole.
      </p>

      <form class="search-form" method="get" action="/cerca/" role="search">
        <label class="sr-only" for="q">Cerca nel magazine</label>
        <input
          id="q"
          name="q"
          type="search"
          placeholder="Es. CBD, decreto sicurezza, terpeni…"
          value={q}
          maxlength={SEARCH_MAX_QUERY_LENGTH}
          autocomplete="off"
          enterkeyhint="search"
          aria-describedby="q-hint"
        />
        <button type="submit">Cerca</button>
      </form>
    </header>

    <div aria-live="polite">
      {tokens.length ? (
        results.length ? (
          <section class="results" aria-labelledby="results-title">
            <div class="results-head">
              <h2 id="results-title">{resultsLabel} per «{q}»</h2>
              <p class="muted">Articoli ordinati per pertinenza.</p>
            </div>
            <div class="results-grid">
              {results.map((entry) => (
                <CardPost
                  href={postHref(entry)}
                  img={postImageSrc(entry) || undefined}
                  date={dateLabel(entry)}
                  publishDate={entry.data.publishDate}
                  updatedDate={entry.data.updatedDate}
                  title={entry.data.title}
                  excerpt={entry.data.description}
                  category={entry.data.category || null}
                />
              ))}
            </div>
          </section>
        ) : (
          <section class="results empty-state" aria-labelledby="results-title">
            <h2 id="results-title">Nessun risultato per «{q}»</h2>
            <p class="muted">Prova con un termine più breve o diverso. Qui sotto trovi gli ultimi articoli.</p>
          </section>
        )
      ) : q ? (
        <section class="results empty-state">
          <h2>Query troppo corta</h2>
          <p class="muted">Scrivi almeno due lettere per cercare. Qui sotto trovi gli ultimi articoli.</p>
        </section>
      ) : null}
    </div>

    {!results.length ? (
      <section class="latest" aria-labelledby="latest-title">
        <div class="results-head">
          <h2 id="latest-title">Ultimi articoli</h2>
          <p class="muted">Le pubblicazioni più recenti di Canapalandia.</p>
        </div>
        <div class="results-grid">
          {latest.map((entry) => (
            <CardPost
              href={postHref(entry)}
              img={postImageSrc(entry) || undefined}
              date={dateLabel(entry)}
              publishDate={entry.data.publishDate}
              updatedDate={entry.data.updatedDate}
              title={entry.data.title}
              excerpt={entry.data.description}
              category={entry.data.category || null}
            />
          ))}
        </div>
      </section>
    ) : null}
  </section>

  <style>
    .container { max-width: 1180px; margin: 0 auto; padding: 32px 20px 64px; }
    .search-head { max-width: 900px; margin-bottom: 32px; }
    .search-head h1 { margin-bottom: 8px; }
    .muted { color: var(--muted); }
    .search-form { display:flex; gap: 10px; margin-top: 18px; }
    .search-form input {
      flex:1;
      min-width: 0;
      min-height: 44px;
      font-size: 16px;
      padding: 12px 14px;
      border-radius: var(--r-md);
      border: 1px solid rgba(255,255,255,.14);
      background: rgba(0,0,0,.18);
      color: inherit;
    }
    .search-form button {
      min-height: 44px;
      padding: 12px 18px;
      border-radius: var(--r-md);
      border: 0;
      background: var(--brand, #2ea043);
      color: #102b19;
      font-weight: 800;
      cursor: pointer;
    }
    .results,
    .latest { margin-top: 32px; }
    .results-head { margin-bottom: 18px; }
    .results-head h2,
    .empty-state h2 { margin: 0 0 6px; }
    .results-head p,
    .empty-state p { margin: 0; }
    .results-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
      align-items: stretch;
    }
    .sr-only {
      position:absolute;
      width:1px;
      height:1px;
      padding:0;
      margin:-1px;
      overflow:hidden;
      clip:rect(0,0,0,0);
      white-space:nowrap;
      border:0;
    }
    @media (max-width: 980px){
      .results-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
    }
    @media (max-width: 640px){
      .container { padding-inline: 16px; }
      .results-grid { grid-template-columns: 1fr; gap: 18px; }
      .search-form { flex-direction: column; }
      .search-form button { width: 100%; }
    }
  </style>
</MigratedLayout>
