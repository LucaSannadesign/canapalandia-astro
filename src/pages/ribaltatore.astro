---
/**
 * Pagina principale Ribaltatore AI
 * Replica ESATTAMENTE il comportamento del PHP page-ribaltatore.php
 * 
 * Comportamento:
 * - Form con campo frase (textarea, min 3 / max 400 caratteri)
 * - Honeypot email_trap (nascosto)
 * - Submit via fetch POST a /api/ribalta-ai
 * - UI: loading state, error state, risultato con copy e share
 */
import SiteLayout from "@/layouts/SiteLayout.astro";

const title = "🧠 Ribalta con l'AI | Canapalandia";
const canonical = `${import.meta.env.SITE || "https://canapalandia.com"}/ribaltatore/`;
---

<SiteLayout title={title} canonical={canonical}>
  <main id="contenuto">
    <div class="container">
      <div class="ribaltatore-page">
        <h1 class="ribaltatore-title">
          🧠 Ribalta con l'AI
        </h1>
        <p class="ribaltatore-subtitle">
          Inserisci uno slogan proibizionista e guarda come viene ribaltato con ironia dal nostro Ribaltatore AI.
        </p>

        <form id="form-ribalta" class="ribaltatore-form">
 
          <label for="frase" class="ribaltatore-label">
            ✍️ Inserisci lo slogan proibizionista:
          </label>
          <textarea
            id="frase"
            name="frase"
            required
            minlength="3"
            maxlength="400"
            rows="4"
            class="ribaltatore-textarea"
            placeholder="Es: Chi fuma canne è un delinquente"
          ></textarea>
          
          <!-- Honeypot (nascosto) -->
          <input
            type="text"
            name="email_trap"
            class="ribaltatore-trap"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div class="ribaltatore-submit">
            <button type="submit" class="ribaltatore-button" id="submit-btn">
              📎 RIBALTA ORA!
            </button>
          </div>
        </form>

        <div id="risultato-ribaltato" class="ribaltatore-result" aria-live="polite"></div>

        <div class="ribaltatore-cta">
          <a href="/frasi-ribaltate/" class="ribaltatore-button ribaltatore-button--secondary">
            👀 GUARDA TUTTE LE FRASI RIBALTATE
          </a>
        </div>

        <p class="ribaltatore-description">
          ✊ Questo non è un semplice generatore di frasi. È un <strong>ribaltatore di propaganda</strong>, un'arma di satira di distruzione di massa.
          Inserisci uno slogan proibizionista, guarda come si contorce sotto il peso dell'intelligenza artificiale (e del buonsenso)
          e <strong>trasformalo in verità con un click</strong>. Da condividere ovunque: nei social, nei gruppi, nei cessi dei bar, dove vuoi.
          <em>Perché se non puoi sconfiggere l'assurdo… ribaltalo.</em>
        </p>
      </div>
    </div>
  </main>
</SiteLayout>

<style>
  .ribaltatore-page {
    max-width: 850px;
    margin: 60px auto;
    padding: 0 var(--gutter, 24px);
  }

  .ribaltatore-title {
    text-align: center;
    font-size: clamp(1.8rem, 4vw, 2.2rem);
    margin-bottom: 10px;
    line-height: 1.2;
  }

  .ribaltatore-subtitle {
    text-align: center;
    font-size: 1.1rem;
    margin-bottom: 35px;
    color: var(--muted);
  }

  .ribaltatore-form {
    margin-bottom: 40px;
  }

  .ribaltatore-label {
    font-size: 1.2rem;
    font-weight: 600;
    display: block;
    margin-bottom: 10px;
    color: var(--text);
  }

  .ribaltatore-textarea {
    width: 100%;
    padding: 12px 16px;
    font-size: 16px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--panel);
    color: var(--text);
    font-family: inherit;
    resize: vertical;
    min-height: 100px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .ribaltatore-textarea:focus {
    outline: none;
    border-color: var(--brand);
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.1);
  }

  .ribaltatore-trap {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  .ribaltatore-submit {
    margin-top: 20px;
  }

  .ribaltatore-button {
    padding: 12px 25px;
    background: var(--brand);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.1s ease;
    text-decoration: none;
    display: inline-block;
    min-height: 44px;
  }

  .ribaltatore-button:hover:not(:disabled) {
    background: var(--brand-2);
    transform: translateY(-1px);
  }

  .ribaltatore-button:active:not(:disabled) {
    transform: translateY(0);
  }

  .ribaltatore-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .ribaltatore-button--secondary {
    background: var(--brand);
    color: white;
  }

  .ribaltatore-cta {
    text-align: center;
    margin-top: 40px;
  }

  .ribaltatore-description {
    text-align: center;
    margin-top: 40px;
    font-size: 1.05rem;
    color: var(--muted);
    line-height: 1.6;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .ribaltatore-description strong {
    color: var(--text);
    font-weight: 600;
  }

  .ribaltatore-description em {
    font-style: italic;
    color: var(--brand);
  }

  .ribaltatore-result {
    margin-top: 40px;
    min-height: 100px;
  }

  /* Risultato card */
  .risultato-card {
    max-width: 850px;
    margin: 40px auto;
    padding: 32px 28px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--panel);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .risultato-card__title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 24px;
    color: var(--text);
    text-align: center;
  }

  /* Box quote per ribaltata */
  .risultato-card__quote {
    margin: 24px 0;
    padding: 24px 28px;
    border-left: 4px solid var(--brand);
    border-radius: 8px;
    background: rgba(34, 197, 94, 0.05);
    border-color: var(--brand);
  }

  html[data-theme="light"] .risultato-card__quote {
    background: rgba(22, 163, 74, 0.04);
  }

  .risultato-card__quote-content {
    font-size: 1.4rem;
    line-height: 1.7;
    color: var(--text);
    font-weight: 500;
    margin: 0;
  }

  /* Sezione social collapsible */
  .risultato-card__social-section {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .risultato-card__toggle-social {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    transition: all 0.2s ease;
  }

  .risultato-card__toggle-social:hover {
    background: rgba(34, 197, 94, 0.05);
    border-color: var(--brand);
  }

  .risultato-card__toggle-icon {
    transition: transform 0.2s ease;
    font-size: 0.8rem;
  }

  .risultato-card__social-content {
    margin-top: 16px;
    padding: 20px;
    background: rgba(34, 197, 94, 0.03);
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  html[data-theme="light"] .risultato-card__social-content {
    background: rgba(22, 163, 74, 0.02);
  }

  .risultato-card__social-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text);
    margin-bottom: 16px;
    white-space: pre-line;
  }

  .risultato-card__copy-btn {
    padding: 12px 24px;
    background: var(--brand);
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background 0.2s ease, transform 0.1s ease;
    min-height: 44px;
  }

  .risultato-card__copy-btn:hover {
    background: var(--brand-2);
    transform: translateY(-1px);
  }

  .risultato-card__copy-btn:active {
    transform: translateY(0);
  }

  .risultato-card__copiato {
    margin-left: 12px;
    color: var(--brand);
    font-weight: 600;
    font-size: 0.9rem;
    display: none;
  }

  .risultato-card__copiato.is-visible {
    display: inline;
  }

  /* Link actions (prima dei share buttons) */
  .risultato-card__link-actions {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  /* Azioni: share buttons (in fondo) */
  .risultato-card__actions {
    margin-top: 16px;
  }

  .risultato-card__share-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .risultato-card__share-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s ease;
    min-height: 36px;
    cursor: pointer;
  }

  .risultato-card__share-btn:hover {
    background: rgba(34, 197, 94, 0.1);
    border-color: var(--brand);
    transform: translateY(-1px);
  }

  .risultato-card__share-btn svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .risultato-card__share-btn span {
    font-size: 0.875rem;
  }

  .risultato-card__link-btn {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    background: var(--brand);
    color: white;
    border: none;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: background 0.2s ease, transform 0.1s ease;
    min-height: 44px;
    cursor: pointer;
  }

  .risultato-card__link-btn:hover {
    background: var(--brand-2);
    transform: translateY(-1px);
  }

  .risultato-card__link-btn:active {
    transform: translateY(0);
  }

  .risultato-card__loading {
    text-align: center;
    font-size: 1.2rem;
    color: var(--muted);
    padding: 40px 20px;
  }

  .risultato-card__error {
    text-align: center;
    color: #ef4444;
    padding: 20px;
    background: rgba(239, 68, 68, 0.1);
    border-radius: 8px;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .risultato-card__internal-links {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .risultato-card__internal-link {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    background: var(--bg, rgba(0, 0, 0, 0.18));
    border: 1px solid var(--border, rgba(255, 255, 255, 0.1));
    border-radius: 6px;
    color: var(--text);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .risultato-card__internal-link:hover {
    background: var(--panel, rgba(0, 0, 0, 0.25));
    border-color: var(--brand, rgba(34, 197, 94, 0.3));
    transform: translateY(-1px);
  }

  @media (max-width: 767px) {
    .ribaltatore-page {
      margin: 40px auto;
      padding: 0 var(--gutter, 10px);
    }

    .risultato-card {
      padding: 24px 20px;
    }

    .risultato-card__quote-content {
      font-size: 1.2rem;
    }

    .risultato-card__share-buttons {
      gap: 6px;
    }

    .risultato-card__share-btn {
      flex: 1 1 calc(50% - 3px);
      min-width: 0;
      font-size: 0.8rem;
      padding: 6px 10px;
    }

    .risultato-card__link-actions {
      flex-direction: column;
    }

    .risultato-card__link-btn {
      width: 100%;
      justify-content: center;
    }

    .risultato-card__internal-links {
      flex-direction: column;
    }

    .risultato-card__internal-link {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  (() => {
    const form = document.getElementById("form-ribalta") as HTMLFormElement;
    const fraseInput = document.getElementById("frase") as HTMLTextAreaElement;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
    const risultatoDiv = document.getElementById("risultato-ribaltato") as HTMLDivElement;

    if (!form || !fraseInput || !submitBtn || !risultatoDiv) return;

    // Formattazione frase ribaltata: sostituisci punteggiatura con break (come PHP)
    function formatRibaltata(text: string): string {
      // Sostituisci [.!?] seguito da spazio con <br><br>
      return text.replace(/([.!?])(\s+)/g, "$1<br><br>");
    }

    // Genera testo share-ready
    function getShareText(originale: string, ribaltata: string, id: number | null): string {
      const publicUrl = id ? `${window.location.origin}/ribaltate-ai/${id}/` : window.location.origin;
      return `Proibizionista: "${originale}"\nRibaltata: "${ribaltata}"\n🔗 ${publicUrl}\n#LegalizeIt #TeamCBD`;
    }

    // Genera testo completo per social (formato esteso)
    function getTestoCondivisibile(originale: string, ribaltata: string, id: number | null): string {
      const publicUrl = id ? `${window.location.origin}/ribaltate-ai/${id}/` : window.location.origin;
      return `🔒 Frase proibizionista: "${originale}"\n🔁 Ribaltata con l'AI: "${ribaltata}"\n\n👉 Scopri il Ribaltatore AI su ${window.location.origin}/ribaltatore/\n#cannabislight #canapa #satira #antiproibizionismo #canapalandia`;
    }

    // Genera URL share
    function getShareUrl(platform: string, originale: string, ribaltata: string, id: number | null): string {
      const publicUrl = id ? `${window.location.origin}/ribaltate-ai/${id}/` : window.location.origin;
      const url = encodeURIComponent(publicUrl);
      const shareText = getShareText(originale, ribaltata, id);
      const text = encodeURIComponent(shareText);

      switch (platform) {
        case "whatsapp":
          return `https://wa.me/?text=${text}`;
        case "telegram":
          return `https://t.me/share/url?url=${url}&text=${text}`;
        case "twitter":
          return `https://twitter.com/intent/tweet?text=${text}`;
        case "facebook":
          return `https://www.facebook.com/sharer/sharer.php?u=${url}`;
        case "linkedin":
          return `https://www.linkedin.com/sharing/share-offsite/?url=${url}`;
        default:
          return "";
      }
    }

    // Pulisce frasi da caratteri escapati (equivalente a cleanPhrase server-side)
    function cleanPhraseClient(phrase: string, preserveNewlines = false): string {
      if (typeof phrase !== "string") return "";
      
      let cleaned = phrase;
      
      // Converti \\" in "
      cleaned = cleaned.replace(/\\"/g, '"');
      
      // Converti \\n in spazio o newline
      if (preserveNewlines) {
        cleaned = cleaned.replace(/\\n/g, '\n');
      } else {
        cleaned = cleaned.replace(/\\n/g, ' ');
      }
      
      // Converti altri escape comuni
      cleaned = cleaned.replace(/\\t/g, ' '); // tab → spazio
      cleaned = cleaned.replace(/\\r/g, '');  // carriage return → rimosso
      
      // Normalizza spazi multipli (ma preserva newline se preserveNewlines)
      if (preserveNewlines) {
        cleaned = cleaned.replace(/[ \t]+/g, ' ');
        cleaned = cleaned.replace(/\n{3,}/g, '\n\n');
      } else {
        cleaned = cleaned.replace(/\s+/g, ' ');
      }
      
      return cleaned.trim();
    }

    // Render risultato HTML (Result Card migliorata)
    function renderRisultato(originale: string, ribaltata: string, id: number | null): string {
      // Pulisci frasi da caratteri escapati prima di renderizzare
      const originalePulita = cleanPhraseClient(originale);
      const ribaltataPulita = cleanPhraseClient(ribaltata, true); // Preserva newline per formattazione
      
      const testoCondivisibile = getTestoCondivisibile(originalePulita, ribaltataPulita, id);
      const shareText = getShareText(originalePulita, ribaltataPulita, id);
      // URL assoluto per share (necessario per social)
      const publicUrlAbsolute = id ? `${window.location.origin}/ribaltate-ai/${id}/` : null;
      // Path relativo per link interno "Apri"
      const publicPath = id ? `/ribaltate-ai/${id}/` : null;
      
      // Escape HTML per sicurezza (no innerHTML non sanificato)
      function escapeHtml(text: string): string {
        const div = document.createElement("div");
        div.textContent = text;
        return div.innerHTML;
      }

      const ribaltataEscaped = escapeHtml(ribaltataPulita);
      const originaleEscaped = escapeHtml(originalePulita);
      const testoCondivisibileEscaped = escapeHtml(testoCondivisibile);

      return `
        <div class="risultato-card">
          <h2 class="risultato-card__title">Risposta ribaltata</h2>
          
          <div class="risultato-card__quote">
            <div class="risultato-card__quote-content">${ribaltataEscaped.replace(/\n/g, "<br>").replace(/<br><br>/g, "<br>")}</div>
          </div>

          <div class="risultato-card__social-section">
            <button type="button" class="risultato-card__toggle-social" id="toggle-social" aria-expanded="false">
              <span>Testo per i social</span>
              <span class="risultato-card__toggle-icon">▼</span>
            </button>
            <div class="risultato-card__social-content" id="social-content" style="display: none;">
              <div class="risultato-card__social-text">${testoCondivisibileEscaped.replace(/\n/g, "<br>")}</div>
              <button type="button" class="risultato-card__copy-btn" id="btn-copia-tutto">
                📋 Copia tutto
              </button>
              <span class="risultato-card__copiato" id="msg-copiato-tutto">✅ Copiato!</span>
            </div>
          </div>

          ${publicPath ? `
          <div class="risultato-card__link-actions">
            <a href="${publicPath}" class="risultato-card__link-btn">
              🔗 Apri pagina frase
            </a>
            <button type="button" class="risultato-card__link-btn" id="btn-copia-link" data-url="${publicUrlAbsolute}">
              📋 Copia link
            </button>
            <span class="risultato-card__copiato" id="msg-copiato-link">✅ Copiato!</span>
          </div>
          ` : ""}

          <div class="risultato-card__internal-links">
            <a href="/frasi-ribaltate/" class="risultato-card__internal-link">
              📚 Vedi tutte le frasi
            </a>
            <a href="/cerca/?q=${encodeURIComponent(originalePulita.split(/\s+/).slice(0, 3).join(" "))}" class="risultato-card__internal-link">
              🔍 Cerca frasi simili
            </a>
          </div>

          <div class="risultato-card__actions">
            <div class="risultato-card__share-buttons">
              <a href="${getShareUrl("whatsapp", originalePulita, ribaltataPulita, id)}" target="_blank" rel="noopener noreferrer" class="risultato-card__share-btn" aria-label="Condividi su WhatsApp">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
                <span>WhatsApp</span>
              </a>
              <a href="${getShareUrl("telegram", originalePulita, ribaltataPulita, id)}" target="_blank" rel="noopener noreferrer" class="risultato-card__share-btn" aria-label="Condividi su Telegram">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.562 8.161l-1.97 9.272c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.295-.6.295-.002 0-.003 0-.005 0l.213-3.054 5.56-5.022c.24-.213-.054-.334-.373-.12l-6.87 4.326-2.96-.924c-.64-.203-.658-.64.135-.954l11.566-4.458c.538-.196 1.006.128.832.941z"/>
                </svg>
                <span>Telegram</span>
              </a>
              <a href="${getShareUrl("twitter", originalePulita, ribaltataPulita, id)}" target="_blank" rel="noopener noreferrer" class="risultato-card__share-btn" aria-label="Condividi su X (Twitter)">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
                <span>X</span>
              </a>
              <a href="${getShareUrl("facebook", originalePulita, ribaltataPulita, id)}" target="_blank" rel="noopener noreferrer" class="risultato-card__share-btn" aria-label="Condividi su Facebook">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                <span>Facebook</span>
              </a>
              <a href="${getShareUrl("linkedin", originalePulita, ribaltataPulita, id)}" target="_blank" rel="noopener noreferrer" class="risultato-card__share-btn" aria-label="Condividi su LinkedIn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                <span>LinkedIn</span>
              </a>
              <button type="button" class="risultato-card__share-btn" id="btn-share-native" aria-label="Condividi">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="18" cy="5" r="3"></circle>
                  <circle cx="6" cy="12" r="3"></circle>
                  <circle cx="18" cy="19" r="3"></circle>
                  <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                  <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                </svg>
                <span>Condividi…</span>
              </button>
            </div>
          </div>
        </div>
      `;
    }

    // Gestione submit form
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const frase = fraseInput.value.trim();
      if (!frase || frase.length < 3 || frase.length > 400) {
        risultatoDiv.innerHTML = '<div class="risultato-card__error">❌ Frase deve essere tra 3 e 400 caratteri</div>';
        return;
      }

      // Disabilita submit
      submitBtn.disabled = true;
      submitBtn.textContent = "⏳ Elaborazione...";

      // Mostra loading
      risultatoDiv.innerHTML = '<div class="risultato-card__loading">💭 Sto pensando... Dammi un secondo!</div>';

      // Honeypot
      const emailTrap = (form.querySelector('input[name="email_trap"]') as HTMLInputElement)?.value || "";

      try {
        const formData = new FormData();
        formData.append("frase", frase);
        formData.append("email_trap", emailTrap);

        // Usa URL assoluto per garantire funzionamento corretto in dev e produzione
        const apiUrl = new URL("/api/ribalta-ai", window.location.origin).href;

        const response = await fetch(apiUrl, {
          method: "POST",
          body: formData,
        });

        // Leggi risposta come testo prima di parsare
        const responseText = await response.text();
        const contentType = response.headers.get("content-type") || "";

        // Verifica status HTTP
        if (!response.ok) {
          let errorMessage = `Errore ${response.status}: ${response.statusText}`;
          
          // Log dettagli in DEV per debugging
          const isDev = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";
          if (isDev) {
            console.error(`[ribaltatore] API Error:`, {
              status: response.status,
              statusText: response.statusText,
              url: apiUrl,
              contentType,
              body: responseText.slice(0, 500),
            });
          }
          
          // Prova a parsare JSON se content-type corretto
          if (contentType.includes("application/json")) {
            try {
              const errorData = JSON.parse(responseText);
              errorMessage = errorData.error || errorData.ribaltata || errorMessage;
            } catch {
              // Se non è JSON valido, usa il testo
              if (responseText && responseText.length < 200) {
                errorMessage = responseText;
              }
            }
          } else if (responseText && responseText.length < 200) {
            errorMessage = responseText;
          }
          
          throw new Error(errorMessage);
        }

        // Parse JSON solo se content-type include application/json
        let data: any;
        if (contentType.includes("application/json")) {
          try {
            data = JSON.parse(responseText);
          } catch (parseError) {
            throw new Error(`Errore nel parsing della risposta JSON: ${responseText.slice(0, 100)}`);
          }
        } else {
          throw new Error(`Risposta non valida: content-type ${contentType} non è application/json. Risposta: ${responseText.slice(0, 100)}`);
        }

        // Verifica ok:false
        if (data.ok === false) {
          throw new Error(data.error || "Errore nella generazione");
        }

        // Fallback chiavi multiple per ribaltata
        const ribaltataRaw = data.ribaltata ?? data.frase_ribaltata ?? data.answer ?? data.output ?? data.data?.ribaltata;
        const id = data.id ?? data.data?.id ?? 0;

        // Se ribaltata manca, mostra JSON ricevuto
        if (!ribaltataRaw) {
          throw new Error(`Risposta non valida: campo ribaltata mancante. JSON ricevuto: ${JSON.stringify(data)}`);
        }

        // Pulisci frasi da caratteri escapati
        const originaleRaw = data.originale || frase;
        const ribaltata = cleanPhraseClient(ribaltataRaw, true); // Preserva newline
        const originale = cleanPhraseClient(originaleRaw);

        // Render risultato
        risultatoDiv.innerHTML = renderRisultato(originale, ribaltata, id);

        // Setup toggle sezione social
        const toggleSocial = document.getElementById("toggle-social");
        const socialContent = document.getElementById("social-content");
        if (toggleSocial && socialContent) {
          toggleSocial.addEventListener("click", () => {
            const isExpanded = toggleSocial.getAttribute("aria-expanded") === "true";
            toggleSocial.setAttribute("aria-expanded", String(!isExpanded));
            socialContent.style.display = isExpanded ? "none" : "block";
            const icon = toggleSocial.querySelector(".risultato-card__toggle-icon");
            if (icon) icon.textContent = isExpanded ? "▼" : "▲";
          });
        }

        // Setup copy tutto
        const copyTuttoBtn = document.getElementById("btn-copia-tutto");
        const copyTuttoMsg = document.getElementById("msg-copiato-tutto");
        if (copyTuttoBtn && copyTuttoMsg) {
          const testoCompleto = getTestoCondivisibile(originale, ribaltata, id);
          copyTuttoBtn.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(testoCompleto);
              copyTuttoMsg.classList.add("is-visible");
              setTimeout(() => {
                copyTuttoMsg.classList.remove("is-visible");
              }, 2000);
            } catch {
              // Fallback per browser senza clipboard API
              const textarea = document.createElement("textarea");
              textarea.value = testoCompleto;
              document.body.appendChild(textarea);
              textarea.select();
              document.execCommand("copy");
              document.body.removeChild(textarea);
              copyTuttoMsg.classList.add("is-visible");
              setTimeout(() => {
                copyTuttoMsg.classList.remove("is-visible");
              }, 2000);
            }
          });
        }

        // Setup copy link (se id esiste)
        const copyLinkBtn = document.getElementById("btn-copia-link");
        const copyLinkMsg = document.getElementById("msg-copiato-link");
        if (copyLinkBtn && copyLinkMsg) {
          const url = copyLinkBtn.getAttribute("data-url") || "";
          copyLinkBtn.addEventListener("click", async () => {
            if (!url) return;
            try {
              await navigator.clipboard.writeText(url);
              copyLinkMsg.classList.add("is-visible");
              setTimeout(() => {
                copyLinkMsg.classList.remove("is-visible");
              }, 2000);
            } catch {
              // Fallback
              const textarea = document.createElement("textarea");
              textarea.value = url;
              document.body.appendChild(textarea);
              textarea.select();
              document.execCommand("copy");
              document.body.removeChild(textarea);
              copyLinkMsg.classList.add("is-visible");
              setTimeout(() => {
                copyLinkMsg.classList.remove("is-visible");
              }, 2000);
            }
          });
        }

        // Setup share nativo (navigator.share)
        const shareNativeBtn = document.getElementById("btn-share-native");
        if (shareNativeBtn && navigator.share) {
          shareNativeBtn.addEventListener("click", async () => {
            try {
              const shareText = getShareText(data.originale || frase, ribaltata, id);
              const publicUrl = id ? `${window.location.origin}/ribaltate-ai/${id}/` : window.location.origin;
              await navigator.share({
                title: "Ribaltatore AI",
                text: shareText,
                url: publicUrl,
              });
            } catch (err: any) {
              // Se l'utente annulla o errore, fallback su WhatsApp
              if (err.name !== "AbortError") {
                const whatsappUrl = getShareUrl("whatsapp", data.originale || frase, ribaltata, id);
                window.open(whatsappUrl, "_blank", "noopener,noreferrer");
              }
            }
          });
        } else if (shareNativeBtn) {
          // Fallback: se navigator.share non disponibile, usa WhatsApp
          shareNativeBtn.addEventListener("click", () => {
            const whatsappUrl = getShareUrl("whatsapp", data.originale || frase, ribaltata, id);
            window.open(whatsappUrl, "_blank", "noopener,noreferrer");
          });
        }

        // Scroll a risultato
        risultatoDiv.scrollIntoView({ behavior: "smooth", block: "nearest" });
      } catch (err: any) {
        console.error("[ribaltatore] Errore:", err);
        risultatoDiv.innerHTML = `<div class="risultato-card__error">❌ ${err.message || "Errore nella generazione. Riprova."}</div>`;
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "📎 RIBALTA ORA!";
      }
    });
  })();
</script>
