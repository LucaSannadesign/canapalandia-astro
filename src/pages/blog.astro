---
import CardPost from "../components/CardPost.astro";
import Layout from "../layouts/MigratedLayout.astro";
import postsJson from "../../data/wp/out/posts.json";
import { toParams } from "../lib/wp";

export const prerender = false;

const posts = Array.isArray(postsJson) ? postsJson : [];

const postTitle = (p: any) => p?.title?.rendered || p?.title || "";
const stripHtml = (s: any) =>
  String(s || "")
    .replace(/<[^>]*>/g, " ")
    .replace(/\s+/g, " ")
    .trim();
const excerpt = (p: any) =>
  stripHtml(p?.excerpt?.rendered || p?.excerpt || "").slice(0, 180);
const sortDesc = (a: any, b: any) =>
  (Date.parse(b?.date || b?.modified || "") || 0) -
  (Date.parse(a?.date || a?.modified || "") || 0);
const og = (p: any) =>
  p?.yoast_head_json?.og_image?.[0]?.url ||
  p?.yoast_head_json?.og_image?.[0]?.src ||
  "";
const href = (p: any) => {
  const url = p?.yoast_head_json?.canonical || p?.link || p?.slug || "";
  const path = toParams(url);
  return path ? `/${path}/` : "#";
};
const fmt = (iso: any) =>
  iso
    ? new Date(iso).toLocaleDateString("it-IT", {
        year: "numeric",
        month: "long",
        day: "2-digit",
      })
    : "";

/* ---------------------------
   Categorie (WP REST: _embedded["wp:term"]) 
   NOTE: se l'export non contiene _embedded, i filtri non possono popolarsi.
--------------------------- */
function categoriesOf(p: any): { slug: string; name: string }[] {
  const wpTerm = p?._embedded?.["wp:term"];
  if (!Array.isArray(wpTerm)) return [];

  // wp:term è un array di array (categorie, tag, ecc.)
  const flat = wpTerm.flat().flat();
  const cats = flat
    .filter(
      (t: any) =>
        t &&
        t.taxonomy === "category" &&
        typeof t.slug === "string" &&
        typeof t.name === "string",
    )
    .map((t: any) => ({ slug: String(t.slug), name: String(t.name) }));

  // unique by slug
  const m = new Map<string, { slug: string; name: string }>();
  for (const c of cats) if (!m.has(c.slug)) m.set(c.slug, c);
  return Array.from(m.values());
}

function allCategories(list: any[]): { slug: string; name: string }[] {
  const m = new Map<string, { slug: string; name: string }>();
  for (const p of list) {
    for (const c of categoriesOf(p)) {
      if (!m.has(c.slug)) m.set(c.slug, c);
    }
  }
  return Array.from(m.values()).sort((a, b) =>
    a.name.localeCompare(b.name, "it"),
  );
}

// Lista ampia per rendere utili i filtri
const latestAll = posts.slice().sort(sortDesc).slice(0, 60);

// Flag: abbiamo davvero categorie nei dati?
const hasEmbeddedTerms = latestAll.some((p: any) =>
  Array.isArray(p?._embedded?.["wp:term"]),
);
const cats = hasEmbeddedTerms ? allCategories(latestAll) : [];

// filtro attivo: /blog/?cat=slug
const activeCat = (Astro.url.searchParams.get("cat") || "").trim();

const latest =
  activeCat && hasEmbeddedTerms
    ? latestAll.filter((p: any) =>
        categoriesOf(p).some((c) => c.slug === activeCat),
      )
    : latestAll;

const activeCatName = activeCat
  ? cats.find((c) => c.slug === activeCat)?.name || activeCat
  : "Tutte";

// Pagina iniziale 12 post, poi scroll infinito
const initialPosts = hasEmbeddedTerms
  ? latest.slice(0, 12)
  : latest.slice(0, 12);

const title = "Blog — Canapalandia";
const canonical = "https://canapalandia.com/blog/";
const canonicalFinal = canonical;

const initialPage = 1;
const totalPosts = latest.length; // Totale filtrato
---

<Layout title={title} canonical={canonicalFinal}>
  <section class="hero">
    <div class="container hero-inner">
      <p class="kicker">Blog</p>
      <h1>Articoli e guide</h1>
      <p class="lead">Scorri gli ultimi contenuti o filtra per categoria.</p>

      <div
        class="meta"
        style="display:flex; gap:10px; flex-wrap:wrap; margin-top:14px;"
      >
        <a class="btn" href="/">Home</a>
        <a class="btn btn-ghost" href="/cerca/">Cerca</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        hasEmbeddedTerms && cats.length ? (
          <nav class="modern-filters" aria-label="Filtri Categorie">
            <div class="modern-filters__track">
              <a
                class={`filter-chip ${!activeCat ? "is-active" : ""}`}
                href="/blog/"
              >
                Tutte
              </a>
              {cats.map((c) => (
                <a
                  class={`filter-chip ${activeCat === c.slug ? "is-active" : ""}`}
                  href={`/blog/?cat=${encodeURIComponent(c.slug)}`}
                >
                  {c.name}
                </a>
              ))}
            </div>
          </nav>
        ) : (
          <div class="card" style="padding:16px; margin-bottom:16px;">
            <p style="margin:0; color: var(--muted);">
              <strong>Filtri categoria non disponibili</strong>: nel file{" "}
              <code>posts.json</code> non risultano presenti i termini embed (
              <code>_embedded[\"wp:term\"]</code>).
            </p>
          </div>
        )
      }

      <div id="posts" aria-hidden="true"></div>

      {
        initialPosts.length ? (
          <>
            <div class="grid" id="blog-grid">
              {initialPosts.map((p: any) => (
                <CardPost
                  href={href(p)}
                  img={og(p)}
                  date={fmt(p?.date || p?.modified)}
                  title={postTitle(p)}
                  excerpt={excerpt(p)}
                />
              ))}
            </div>

            {/* Sentinel for Infinite Scroll */}
            <div
              id="scroll-sentinel"
              style="margin-top: 2rem; text-align: center; color: var(--muted);"
            >
              {totalPosts > 12 && <span>Caricamento altri articoli...</span>}
            </div>
          </>
        ) : (
          <div class="card" style="padding:18px;">
            <h2 style="margin:0 0 6px;">Nessun risultato</h2>
            <p style="margin:0; color: var(--muted);">
              Prova un’altra categoria oppure torna a{" "}
              <a href="/blog/" style="text-decoration:underline;">
                tutte le categorie
              </a>
              .
            </p>
          </div>
        )
      }
    </div>
  </section>
</Layout>

<script define:vars={{ initialPage, activeCat }}>
  let page = initialPage;
  let loading = false;
  const grid = document.getElementById("blog-grid");
  const sentinel = document.getElementById("scroll-sentinel");

  if (grid && sentinel) {
    const observer = new IntersectionObserver(
      async (entries) => {
        // Se stiamo già caricando o non intercettiamo, esci
        if (loading || !entries[0].isIntersecting) return;

        loading = true;
        page++;

        const catParam = activeCat
          ? `&cat=${encodeURIComponent(activeCat)}`
          : "";
        const url = `/partials/blog-results/?page=${page}${catParam}`;

        try {
          const res = await fetch(url);
          if (res.status === 404 || res.status === 204) {
            // Fine dei post
            sentinel.innerHTML = "Hai letto tutto!";
            observer.disconnect();
            return;
          }

          const html = await res.text();
          if (!html.trim()) {
            sentinel.innerHTML = "Hai letto tutto!";
            observer.disconnect();
            return;
          }

          // Add new HTML to grid (Astro partial returns just the cards)
          const temp = document.createElement("div");
          temp.innerHTML = html;

          // Append valid elements
          while (temp.firstChild) {
            grid.appendChild(temp.firstChild);
          }

          loading = false;
        } catch (err) {
          console.error("Error loading posts:", err);
          sentinel.textContent = "Errore nel caricamento.";
          observer.disconnect();
        }
      },
      {
        rootMargin: "200px", // Triggera il caricamento 200px prima di arrivare in fondo
      },
    );

    observer.observe(sentinel);
  }
</script>
```
