---
import { getCollection } from "astro:content";
import CardPost from "../components/CardPost.astro";
import Layout from "../layouts/MigratedLayout.astro";
import Callout from "../components/editorial/Callout.astro";
import RibaltatoreCTA from "../components/editorial/RibaltatoreCTA.astro";
import BlogFilters from "../components/blog/BlogFilters.astro";

export const prerender = false;

// Helper per formattare data
function formatDate(date: Date): string {
  return date.toLocaleDateString("it-IT", {
    year: "numeric",
    month: "long",
    day: "2-digit",
  });
}

// Carica tutti i post dalla collection
const postsAll = await getCollection("blog");

// Estrai categorie uniche da tutti i post
// Usa un Set per tracciare gli slug già visti
const categorySet = new Set<string>();
for (const post of postsAll) {
  const cat = post.data.category;
  if (cat && typeof cat === "string" && cat.trim()) {
    categorySet.add(cat.trim());
  }
}

// Converti in array con slug e nome umanizzato, ordina per nome
const cats = Array.from(categorySet)
  .map((slug) => ({
    slug,
    name: slug
      .split("-")
      .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(" "),
  }))
  .sort((a, b) => a.name.localeCompare(b.name, "it"));

// Filtro attivo: /blog/?cat=slug
const activeCat = (Astro.url.searchParams.get("cat") || "").trim();

// Filtra post per categoria se attivo
const filteredPosts = activeCat
  ? postsAll.filter((p) => (p.data.category || "") === activeCat)
  : postsAll;

// Ordina per publishDate DESC
const latest = filteredPosts
  .slice()
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

// Pagina iniziale 12 post, poi scroll infinito
const initialPosts = latest.slice(0, 12);

const title = "Blog — Canapalandia";
const canonical = `${import.meta.env.SITE || "https://canapalandia.com"}/blog/`;
const canonicalFinal = canonical;

const initialPage = 1;
const totalPosts = latest.length; // Totale filtrato
---

<Layout title={title} canonical={canonicalFinal}>
  <section class="hero">
    <div class="container hero-inner">
      <p class="kicker">Blog</p>
      <h1>Articoli e guide</h1>
      <p class="lead">Scorri gli ultimi contenuti o filtra per categoria.</p>

      <div
        class="meta"
        style="display:flex; gap:10px; flex-wrap:wrap; margin-top:14px;"
      >
        <a class="btn" href="/">Home</a>
        <a class="btn btn-ghost" href="/cerca/">Cerca</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        cats.length > 0 ? (
          <BlogFilters
            items={cats}
            active={activeCat}
            baseUrl="/blog/"
            includeAll={true}
          />
        ) : null
      }

      <div id="posts" aria-hidden="true"></div>

      {
        initialPosts.length > 0 ? (
          <>
            <div class="grid" id="blog-grid">
              {initialPosts.map((p) => (
                <CardPost
                  href={`/${p.data.slug}/`}
                  img={p.data.coverImage || undefined}
                  date={formatDate(p.data.publishDate)}
                  title={p.data.title}
                  excerpt={p.data.description}
                  category={p.data.category || null}
                />
              ))}
            </div>

            {/* Sentinel for Infinite Scroll */}
            <div
              id="scroll-sentinel"
              style="margin-top: 2rem; text-align: center; color: var(--muted);"
            >
              {totalPosts > 12 && <span>Caricamento altri articoli...</span>}
            </div>

            {/* Esempio componenti editoriali */}
            <div style="margin-top: 3rem; max-width: 75ch;">
              <Callout type="myth" title="La cannabis light è una scusa per vendere droga">
                <p>
                  Alcuni sostengono che la cannabis light sia solo un modo per aggirare le leggi e vendere sostanze psicoattive.
                </p>
              </Callout>

              <Callout type="reality" title="La cannabis light è legale e regolamentata">
                <p>
                  La cannabis light in Italia è legale se rispetta il limite di THC dello 0,2% (o 0,6% per la coltivazione). 
                  È un prodotto agricolo regolamentato, non una "scusa" ma una realtà normativa precisa.
                </p>
              </Callout>

              <RibaltatoreCTA />
            </div>
          </>
        ) : (
          <div class="card" style="padding:18px;">
            <h2 style="margin:0 0 6px;">Nessun risultato</h2>
            <p style="margin:0; color: var(--muted);">
              Prova un’altra categoria oppure torna a{" "}
              <a href="/blog/" style="text-decoration:underline;">
                tutte le categorie
              </a>
              .
            </p>
          </div>
        )
      }
    </div>
  </section>
</Layout>

<script define:vars={{ initialPage, activeCat }}>
  let page = initialPage;
  let loading = false;
  const grid = document.getElementById("blog-grid");
  const sentinel = document.getElementById("scroll-sentinel");

  if (grid && sentinel) {
    const observer = new IntersectionObserver(
      async (entries) => {
        // Se stiamo già caricando o non intercettiamo, esci
        if (loading || !entries[0].isIntersecting) return;

        loading = true;
        page++;

        const catParam = activeCat
          ? `&cat=${encodeURIComponent(activeCat)}`
          : "";
        const url = `/partials/blog-results/?page=${page}${catParam}`;

        try {
          const res = await fetch(url);
          if (res.status === 404 || res.status === 204) {
            // Fine dei post
            sentinel.innerHTML = "Hai letto tutto!";
            observer.disconnect();
            return;
          }

          const html = await res.text();
          if (!html.trim()) {
            sentinel.innerHTML = "Hai letto tutto!";
            observer.disconnect();
            return;
          }

          // Add new HTML to grid (Astro partial returns just the cards)
          const temp = document.createElement("div");
          temp.innerHTML = html;

          // Append valid elements
          while (temp.firstChild) {
            grid.appendChild(temp.firstChild);
          }

          loading = false;
        } catch (err) {
          console.error("Errore nel caricamento dei post:", err);
          sentinel.textContent = "Errore nel caricamento.";
          observer.disconnect();
        }
      },
      {
        rootMargin: "200px", // Triggera il caricamento 200px prima di arrivare in fondo
      },
    );

    observer.observe(sentinel);
  }
</script>
```
