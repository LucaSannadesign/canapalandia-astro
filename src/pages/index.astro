      transform: translateY(-1px);
    }

    html[data-theme="light"] #in-evidenza a.in-evidenza__main:hover {
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.65) inset,
        0 22px 50px rgba(2, 6, 23, 0.11);
