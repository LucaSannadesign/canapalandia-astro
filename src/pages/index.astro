---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../layouts/MigratedLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import CardPost from "../components/CardPost.astro";
import HomeActionCards from "../components/HomeActionCards.astro";
import { ADS_SLOT_HOME, ADS_SLOT_TOP } from "../lib/consts";

/* ---------------------------
   Helpers: date
--------------------------- */

// Unica funzione per normalizzare una data (elimina dateOf e dateValue duplicate)
function getPostDate(post: CollectionEntry<"blog">): Date | null {
  const raw = post.data.updatedDate ?? post.data.publishDate;
  if (!raw) return null;
  const d = raw instanceof Date ? raw : new Date(String(raw));
  return Number.isNaN(d.getTime()) ? null : d;
}

function dateValue(post: CollectionEntry<"blog">): number {
  return getPostDate(post)?.getTime() ?? 0;
}

const formatDate = (d: Date | null): string => {
  if (!d) return "";
  return d.toLocaleDateString("it-IT", { year: "numeric", month: "long", day: "numeric" });
};

/* ---------------------------
   Helpers: slug / immagine
--------------------------- */

function getSlug(post: CollectionEntry<"blog">): string {
  return post.slug ?? post.data.slug ?? "";
}

// FIX: tipizzato correttamente, niente più `any`
function postHref(entry: CollectionEntry<"blog">): string {
  const slug = getSlug(entry);
  if (!slug) throw new Error(`Missing slug for post: ${entry.data.title}`);
  return `/blog/${slug}/`;
}

function normalizeImgSrc(src: unknown): string {
  const s = typeof src === "string" ? src.trim() : "";
  if (!s) return "/images/placeholder.svg";
  if (s.startsWith("http://") || s.startsWith("https://")) return s;
  if (s.startsWith("/")) return s;
  return `/${s}`;
}

function normalizeImage(entry: CollectionEntry<"blog">): string {
  const raw = entry.data.image || entry.data.coverImage || "";
  // FIX: type guard pulito, niente cast a `any`
  const srcValue =
    raw && typeof raw === "object" && "src" in raw
      ? (raw as Record<string, unknown>)["src"]
      : raw;
  return normalizeImgSrc(srcValue);
}

/* ---------------------------
   Helpers: selezione post
--------------------------- */

function pickUnique(
  posts: CollectionEntry<"blog">[],
  usedSet: Set<string>,
  n: number
): CollectionEntry<"blog">[] {
  const result: CollectionEntry<"blog">[] = [];
  for (const post of posts) {
    if (result.length >= n) break;
    const slug = getSlug(post);
    if (slug && !usedSet.has(slug)) {
      result.push(post);
      usedSet.add(slug);
    }
  }
  return result;
}

/* ---------------------------
   Data: carica e ordina post
--------------------------- */

let postsAll: CollectionEntry<"blog">[] = [];
try {
  postsAll = await getCollection("blog");
} catch {
  console.warn("[index] Nessun contenuto trovato in Content Collections");
}

const sortedPosts = postsAll
  .slice()
  .sort((a, b) => dateValue(b) - dateValue(a));

/* ---------------------------
   Filtro: solo post dal 2025 in poi
--------------------------- */

const MIN_DATE = new Date("2025-01-01T00:00:00.000Z");

const eligiblePosts = sortedPosts.filter((p) => {
  const d = getPostDate(p);
  return d !== null && d >= MIN_DATE;
});

/* ---------------------------
   Categorie (singolo ciclo su postsAll)
--------------------------- */

type CategoryData = {
  slug: string;
  name: string;
  count: number;
  description?: string;
};

const categoryMap = new Map<string, CategoryData>();
for (const post of postsAll) {
  const cat = post.data.category;
  if (cat && typeof cat === "string" && cat.trim()) {
    const slug = cat.trim();
    const existing = categoryMap.get(slug);
    categoryMap.set(slug, {
      slug,
      name: slug.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" "),
      count: (existing?.count ?? 0) + 1,
    });
  }
}

/* Home: 2 pilastri editoriali + fino a 4 filoni compatti (stessi slug / categoryMap) */
const PERCORSI_PRIMARY_SLUGS = ["normative-aspetti-legali", "cbd"] as const;
const PERCORSI_SECONDARY_SLUGS = [
  "cannabis-news-it",
  "salute-benessere",
  "guide-tutorial",
  "coltivazione-legale",
] as const;

const percorsiPrimary = PERCORSI_PRIMARY_SLUGS.map((slug) => categoryMap.get(slug)).filter(
  (c): c is CategoryData => c !== undefined && c.count > 0,
);
const percorsiSecondary = PERCORSI_SECONDARY_SLUGS.map((slug) => categoryMap.get(slug)).filter(
  (c): c is CategoryData => c !== undefined && c.count > 0,
);

/** Una riga editoriale se il CMS non espone description sulla categoria */
const PERCORSI_FALLBACK_BLURB: Record<string, string> = {
  "normative-aspetti-legali": "Cosa è legale oggi: riferimenti e aggiornamenti per orientarti in Italia.",
  cbd: "Cannabidiolo, prodotti in commercio e quadro normativo nazionale.",
  "cannabis-news-it": "Notizie e sviluppi sul tema cannabis nel nostro paese.",
  "salute-benessere": "Approfondimenti prudenti su benessere, ricerca e uso responsabile.",
  "guide-tutorial": "Passo passo su termini, prodotti e buone pratiche.",
  "coltivazione-legale": "Filiera e coltivazione nel rispetto delle norme vigenti.",
};

function percorsiBlurb(cat: CategoryData, maxLen: number): string {
  const raw = cat.description?.trim();
  if (raw) {
    return raw.length > maxLen ? `${raw.slice(0, maxLen).trimEnd()}…` : raw;
  }
  return PERCORSI_FALLBACK_BLURB[cat.slug] ?? "Articoli e guide su questo tema.";
}

/* ---------------------------
   Selezione "In evidenza"
--------------------------- */

// Candidati manuali (homeFeatured === true)
const featuredCandidatesManual = eligiblePosts
  .filter((p) => p.data.homeFeatured === true)
  .sort((a, b) => {
    const rankA = a.data.homeFeaturedRank ?? 999;
    const rankB = b.data.homeFeaturedRank ?? 999;
    if (rankA !== rankB) return rankA - rankB;
    return dateValue(b) - dateValue(a);
  });

// Candidati automatici: categoria "cannabis-news-it", non già manuali
const manualSlugs = new Set(featuredCandidatesManual.map(getSlug));
const featuredCandidatesAuto = eligiblePosts
  .filter((p) => p.data.category === "cannabis-news-it" && !manualSlugs.has(getSlug(p)))
  .sort((a, b) => dateValue(b) - dateValue(a));

// Pool deduplicato: manuali prima, poi auto
const featuredPool: CollectionEntry<"blog">[] = [];
const featuredPoolSlugs = new Set<string>();
for (const post of [...featuredCandidatesManual, ...featuredCandidatesAuto]) {
  const slug = getSlug(post);
  if (slug && !featuredPoolSlugs.has(slug)) {
    featuredPool.push(post);
    featuredPoolSlugs.add(slug);
  }
}

// FIX: selezione unificata — prima pick 4, poi split in main+side
// Così il fallback su eligiblePosts funziona anche per featuredMain
const featuredIds = new Set<string>();

// Prova a prendere 4 dal pool; se non bastano, completa con eligiblePosts
const poolPick = pickUnique(featuredPool, featuredIds, 4);

if (poolPick.length < 4) {
  const fallback = eligiblePosts.filter((p) => {
    const slug = getSlug(p);
    return slug && !featuredIds.has(slug);
  });
  pickUnique(fallback, featuredIds, 4 - poolPick.length).forEach((p) => poolPick.push(p));
}

const featuredMain = poolPick[0] ?? null;
const featuredSide = poolPick.slice(1, 4);

// "Ultimi articoli": post eligibili non già in evidenza
const latestPosts = eligiblePosts
  .filter((p) => {
    const slug = getSlug(p);
    return slug && !featuredIds.has(slug);
  })
  .slice(0, 6);

/* ---------------------------
   Icone SVG categorie
--------------------------- */

const iconSvg = (paths: string): string =>
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;

function getCategoryIcon(slug: string): string {
  const iconMap: Record<string, string> = {
    "normative-aspetti-legali": iconSvg(`<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>`),
    "salute-benessere": iconSvg(`<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/>`),
    "cannabis-news-it": iconSvg(`<path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-8"/><rect width="8" height="4" x="10" y="6" rx="1"/>`),
    "coltivazione-legale": iconSvg(`<path d="M7 20h10"/><path d="M10 20c5.5-2.5 7.5-8 7.5-12A7.5 7.5 0 0 0 12 2C10 2 8 3 6 4c-1 1-1.5 2.5-1.5 4 0 5.5 2 9.5 7.5 12Z"/>`),
    "guide-tutorial": iconSvg(`<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>`),
    "partner-e-affiliazioni": iconSvg(`<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`),
    "canapa-e-ambiente": iconSvg(`<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 3.53 2 5.47 0 2.34-1.95 5.12-4.78 5.47 2-1.96 1.85-4.27 1.85-4.27L11 20Z"/>`),
    "cbd": iconSvg(`<path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.9S3 11.2 3 12.25c0 2.22 1.8 4.05 4 4.05z"/>`),
  };
  return iconMap[slug] ?? iconSvg(`<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>`);
}

/* ---------------------------
   Page meta
--------------------------- */

const title = "Canapalandia — Cannabis light, CBD e canapa legale in Italia";
const canonical = `${import.meta.env.SITE || "https://canapalandia.com"}/`;
---

<Layout title={title} canonical={canonical} shell={false}>
  <div class="page-home">
  <section class="hero hero--home" aria-labelledby="hero-title">
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="container header-inner">
      <div class="hero--home__grid">
        <div class="hero--home__main">
          <header class="hero--home__masthead">
            <p class="hero--home__badge">
              <span class="hero--home__badge-dot" aria-hidden="true"></span>
              <span class="hero--home__badge-text">
                <span class="hero--home__badge-line">Guida legale aggiornata</span>
                <span class="hero--home__badge-sep" aria-hidden="true">·</span>
                <span class="hero--home__badge-line">Italia</span>
              </span>
            </p>

            <h1 id="hero-title" class="hero--home__title">
              Cannabis light e CBD in Italia: capirci con ordine
            </h1>

            <p class="lead hero--home__lead">
              <span class="hero--home__lead-line hero--home__lead-strong">
                Normativa, attualità, notizie e guide organizzate per tema.
              </span>
              <span class="hero--home__lead-line hero--home__lead-rest">
                Per orientarti in modo diretto e sensato, senza toni confusi.
              </span>
            </p>
          </header>

          <div class="hero--home__actions">
            <div class="hero--home__cta-block">
              <div class="hero--home__cta-row">
                <div class="hero--home__primary-block">
                  <a class="btn primary large hero--home__btn-primary" href="/#percorsi">
                    Apri il percorso tematico
                  </a>
                </div>
                <a class="btn ghost hero--home__btn-secondary" href="/#ultimi">
                  Sfoglia le ultime notizie
                </a>
              </div>
            </div>

            <div class="hero--home__below-cta">
              <p class="hero--home__quick-label" id="hero-quick-label">Link rapidi</p>
              <nav class="hero--home__quick" aria-labelledby="hero-quick-label">
                <a class="hero--home__pill" href="/categoria/normative-aspetti-legali/">Normativa</a>
                <a class="hero--home__pill" href="/categoria/cbd/">CBD</a>
                <a class="hero--home__pill" href="/categoria/cannabis-news-it/">Notizie Italia</a>
                <a class="hero--home__pill" href="/#percorsi">Tutti i percorsi</a>
              </nav>
            </div>
          </div>
        </div>

        <aside class="hero--home__aside" aria-label="In sintesi: cosa trovi sul sito">
          <div class="hero--home__panel">
            <p class="hero--home__panel-eyebrow">In sintesi</p>
            <p class="hero--home__panel-title" id="hero-panel-title">
              Cosa trovi su Canapalandia
            </p>
            <ul class="hero--home__panel-list" aria-labelledby="hero-panel-title">
              <li>Approfondimenti sul quadro normativo e sul mercato <strong>in Italia</strong></li>
              <li>Notizie con contesto: perché conta e cosa resta da chiarire</li>
              <li>Raccolte per argomento (normativa, CBD, guide…), aggiornate nel tempo</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="inizia-da-qui" aria-labelledby="inizia-da-qui-title">
    <div class="container">
      <h2 id="inizia-da-qui-title" class="inizia-da-qui__title">Inizia da qui</h2>
      <p class="inizia-da-qui__subtitle">Tre scorciatoie utili per orientarti subito</p>
      <nav class="inizia-da-qui__links">
        <a class="btn ghost" href="/categoria/normative-aspetti-legali/">Cosa è legale oggi</a>
        <a class="btn ghost" href="/#ultimi">Ultime novità in Italia</a>
        <a class="btn ghost" href="/categoria/guide-tutorial/">Guide su prodotti e normativa</a>
      </nav>
    </div>
  </section>

  <!-- Banner AdsSense: sotto hero e sotto i quick links -->
  <div class="adbar" data-adbar>
    <div class="container">
      <AdSlot slot={ADS_SLOT_TOP} label="Pubblicità" />
    </div>
  </div>

  <section id="percorsi" class="section percorsi-section" aria-labelledby="percorsi-title">
    <div class="container">
      <div class="section-head percorsi-section__head">
        <h2 id="percorsi-title">Percorsi tematici</h2>
        <p class="section-lead percorsi-section__lead">
          Sei percorsi per orientarti: in alto due aree guida (normativa e CBD), sotto quattro filoni
          compatti. Ogni scheda conduce alla raccolta di articoli del tema; il catalogo completo delle
          categorie resta nel Blog.
        </p>
      </div>

      <div class="percorsi-section__layout">
        {
          percorsiPrimary.length > 0 && (
            <div class="percorsi-section__primary" aria-label="Percorsi principali">
              {percorsiPrimary.map((cat) => (
                <a
                  class="card card--topic percorsi-section__card percorsi-section__card--primary"
                  href={cat.slug ? `/categoria/${cat.slug}/` : "/"}
                  aria-label={
                    cat.count > 0
                      ? `${cat.name}, ${cat.count} articoli — percorso principale`
                      : `${cat.name} — percorso principale`
                  }
                >
                  <span class="card-icon" aria-hidden="true" set:html={getCategoryIcon(cat.slug)}></span>
                  <div class="card--topic__content">
                    <div class="card--topic__header">
                      <h3 class="card--topic__title">{cat.name}</h3>
                      {cat.count > 0 && (
                        <span class="card--topic__count" title={`${cat.count} articoli in questa categoria`}>
                          {cat.count}
                          <span class="card--topic__count-suffix" aria-hidden="true">
                            articoli
                          </span>
                        </span>
                      )}
                    </div>
                    <p class="card--topic__desc">{percorsiBlurb(cat, 118)}</p>
                    <span class="card--topic__cta">
                      Apri la raccolta
                      <span class="card--topic__cta-icon" aria-hidden="true">→</span>
                    </span>
                  </div>
                </a>
              ))}
            </div>
          )
        }

        {
          percorsiSecondary.length > 0 && (
            <div class="percorsi-section__secondary-block">
              <p class="percorsi-section__secondary-label">Altri filoni</p>
              <div class="percorsi-section__secondary" aria-label="Altri percorsi">
                {percorsiSecondary.map((cat) => (
                  <a
                    class="card card--topic percorsi-section__card percorsi-section__card--secondary"
                    href={cat.slug ? `/categoria/${cat.slug}/` : "/"}
                    aria-label={
                      cat.count > 0
                        ? `${cat.name}, ${cat.count} articoli`
                        : `${cat.name}`
                    }
                  >
                    <span class="card-icon" aria-hidden="true" set:html={getCategoryIcon(cat.slug)}></span>
                    <div class="card--topic__content">
                      <div class="card--topic__header">
                        <h3 class="card--topic__title">{cat.name}</h3>
                        {cat.count > 0 && (
                          <span class="card--topic__count" title={`${cat.count} articoli in questa categoria`}>
                            {cat.count}
                            <span class="card--topic__count-suffix" aria-hidden="true"> articoli</span>
                          </span>
                        )}
                      </div>
                      <p class="card--topic__desc">{percorsiBlurb(cat, 88)}</p>
                      <span class="card--topic__cta">
                        Apri
                        <span class="card--topic__cta-icon" aria-hidden="true">→</span>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <div class="percorsi-section__footer-cta">
        <a href="/blog/" class="btn ghost percorsi-section__cta-all">Vedi tutti i temi</a>
      </div>
    </div>
  </section>

  <div class="container">
    <AdSlot slot={ADS_SLOT_HOME} label="Pubblicità" />
  </div>

  <section id="in-evidenza" class="section alt in-evidenza-section" aria-labelledby="in-evidenza-title">
    <div class="container">
      <div class="section-head in-evidenza-section__head">
        <h2 id="in-evidenza-title">In evidenza</h2>
        <p class="section-lead in-evidenza-section__lead">
          Una guida "pilastro" e tre letture correlate per farti un quadro completo.
        </p>
      </div>

      {eligiblePosts.length > 0 ? (
        <div class="grid featured in-evidenza__grid">
          {featuredMain ? (
            <a class="feature-main in-evidenza__main" href={postHref(featuredMain)}>
              <p class="badge in-evidenza__badge">Tema caldo</p>

              <figure class="in-evidenza__figure">
                {/* FIX: width/height espliciti per evitare CLS */}
                <img
                  class="feature-img"
                  src={normalizeImage(featuredMain)}
                  alt={featuredMain.data.coverAlt || featuredMain.data.title}
                  width="800"
                  height="450"
                  loading="eager"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  onerror="this.onerror=null;this.src='/images/placeholder.svg';"
                />
              </figure>

              <div class="in-evidenza__main-body">
                <h3 class="feature-title">{featuredMain.data.title}</h3>
                <p class="feature-excerpt">{featuredMain.data.description}</p>
                <span class="btn primary in-evidenza__cta">Leggi l'articolo</span>
              </div>
            </a>
          ) : (
            <div class="feature-main in-evidenza__main in-evidenza__main--empty">
              <p>Selezione in evidenza in arrivo.</p>
            </div>
          )}

          <aside class="feature-side in-evidenza__side" aria-label="Letture correlate">
            {featuredSide.map((p) => (
              <a class="mini in-evidenza__mini" href={postHref(p)}>
                {/* FIX: width/height espliciti per evitare CLS */}
                <img
                  class="mini-img"
                  src={normalizeImage(p)}
                  alt={p.data.coverAlt || p.data.title}
                  width="400"
                  height="225"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  onerror="this.onerror=null;this.src='/images/placeholder.svg';"
                />
                <div class="mini-body">
                  <h3 class="mini-title">{p.data.title}</h3>
                  <p class="mini-excerpt">{(p.data.description || "").slice(0, 90)}</p>
                  <span class="mini-link">Leggi</span>
                </div>
              </a>
            ))}
          </aside>
        </div>
      ) : (
        <div class="card">
          <p>Contenuti in importazione. Torna presto!</p>
        </div>
      )}
    </div>
  </section>

  <section id="ultimi" class="section ultimi-section">
    <div class="container">
      <div class="section-head ultimi-section__head">
        <h2>Ultimi articoli</h2>
        <p class="section-lead ultimi-section__lead">
          Aggiornamenti e analisi. Scegli cosa leggere in base al tema.
        </p>
      </div>

      {latestPosts.length > 0 ? (
        <div class="grid ultimi-section__grid">
          {latestPosts.map((p) => (
            <CardPost
              href={postHref(p)}
              img={normalizeImage(p) || undefined}
              date={formatDate(getPostDate(p))}
              title={p.data.title}
              excerpt={p.data.description}
              category={p.data.category || null}
            />
          ))}
        </div>
      ) : (
        <div class="card">
          <p>Contenuti in importazione. Torna presto!</p>
        </div>
      )}
    </div>
  </section>

  <HomeActionCards />

  </div>

  <style>
    /* ----- Homepage: dark editoriale (token locali + header/nav tramite .page-home) ----- */

    :global(html:has(.page-home)) {
      /* Mantieni il font globale del progetto (Sora) anche in hero */
      --font-display: var(--font-sans);
      --home-gold: #c8a95a;
    }

    :global(html[data-theme="dark"]:has(.page-home)) {
      /* Dark homepage più aperto: verde bosco, non quasi nero */
      --bg: #13241A;
      --panel: #183126;
      --panel-2: #1D392C;
      --card-solid: #1D392C;
      --card-bg: #1D392C;
      --border: #315744;
      --border-subtle: rgba(49, 87, 68, 0.35);
      --border-strong: #315744;
      --text: #EEF4EC;
      --muted: #B1BEB3;
      --card-text: #EEF4EC;
      --card-muted: #B1BEB3;
    }

    :global(html[data-theme="light"]:has(.page-home)) {
      --bg: #f7f4ec;
      --text: #142018;
      --muted: #4a5c52;
      --card-solid: #fffdf8;
      --panel: #fffdf8;
      --panel-2: #f0ebe0;
      --card-bg: #fffdf8;
      --border: rgba(20, 32, 24, 0.11);
      --border-subtle: rgba(20, 32, 24, 0.07);
      --border-strong: rgba(20, 32, 24, 0.16);
      --brand: #2d8f56;
      --brand-2: #247a48;
      --brand-subtle: rgba(45, 143, 86, 0.12);
      --home-gold: #9a7b38;
      --header-bg: rgba(255, 253, 248, 0.94);
      --header-border: rgba(20, 32, 24, 0.09);
    }

    :global(html:has(.page-home) body) {
      background: var(--bg);
    }

    :global(body:has(.page-home) .site-header) {
      border-bottom-color: color-mix(in oklab, var(--header-border) 85%, transparent);
    }

    :global(body:has(.page-home) .nav a) {
      font-weight: 500;
      letter-spacing: 0.01em;
    }

    :global(body:has(.page-home) .nav a:hover) {
      background: color-mix(in oklab, var(--brand) 16%, transparent);
      color: var(--text);
      box-shadow: 0 4px 16px rgba(82, 194, 122, 0.12);
    }

    :global(html[data-theme="light"] body:has(.page-home) .nav a:hover) {
      background: color-mix(in oklab, var(--brand) 12%, transparent);
      color: var(--text);
      box-shadow: 0 4px 14px rgba(45, 143, 86, 0.1);
    }

    :global(body:has(.page-home) .mobile-menu__content) {
      background: var(--panel);
      border: 1px solid var(--border-subtle);
    }

    :global(body:has(.page-home) .mobile-menu__content a:hover) {
      background: color-mix(in oklab, var(--brand) 12%, transparent);
    }

    :global(body:has(.page-home) .action-card) {
      border-radius: var(--r-lg);
      border: 1px solid color-mix(in oklab, var(--border) 80%, var(--home-gold) 15%);
      background: color-mix(in oklab, var(--panel) 88%, var(--brand) 4%);
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.28);
    }

    :global(body:has(.page-home) .action-card:hover) {
      border-color: color-mix(in oklab, var(--brand) 32%, var(--border));
      box-shadow: 0 22px 56px rgba(0, 0, 0, 0.32);
    }

    :global(body:has(.page-home) .action-card__badge) {
      border-color: color-mix(in oklab, var(--home-gold) 35%, var(--border));
      color: color-mix(in oklab, var(--text) 70%, var(--home-gold));
      background: color-mix(in oklab, var(--panel-2) 70%, transparent);
    }

    :global(body:has(.page-home) .action-card__title) {
      font-family: var(--font-display);
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--text);
    }

    :global(body:has(.page-home) .action-card__meta-label) {
      color: color-mix(in oklab, var(--muted) 88%, var(--home-gold));
    }

    :global(body:has(.page-home) .action-card__description) {
      color: color-mix(in oklab, var(--muted) 92%, var(--text));
    }

    :global(body:has(.page-home) .action-card__link--primary) {
      border-color: color-mix(in oklab, var(--brand) 40%, var(--border));
      background: color-mix(in oklab, var(--brand) 22%, var(--panel-2));
      color: var(--text);
    }

    :global(body:has(.page-home) .action-card__link--secondary) {
      border-color: var(--border-subtle);
      color: color-mix(in oklab, var(--muted) 75%, var(--text));
    }

    :global(body:has(.page-home) .action-card__media) {
      border-color: color-mix(in oklab, var(--border) 85%, var(--home-gold) 10%);
    }

    :global(body:has(.page-home) #ultimi) :global(.post-card) {
      border-radius: var(--r-lg);
      border: 1px solid color-mix(in oklab, var(--border) 82%, var(--home-gold) 12%);
      box-shadow:
        0 1px 0 color-mix(in oklab, var(--text) 6%, transparent) inset,
        0 14px 40px rgba(0, 0, 0, 0.22);
    }

    :global(body:has(.page-home) #ultimi) :global(.post-card:hover) {
      border-color: color-mix(in oklab, var(--brand) 28%, var(--border));
    }

    /* ----- Hero home: gerarchia editoriale, respiro, CTA chiare ----- */

    .page-home .hero-overlay {
      background:
        radial-gradient(880px 520px at 18% 18%, rgba(82, 194, 122, 0.18), transparent 58%),
        radial-gradient(640px 480px at 92% 22%, rgba(200, 169, 90, 0.1), transparent 58%),
        linear-gradient(180deg, rgba(0, 0, 0, 0.52) 0%, transparent 64%);
    }

    html[data-theme="light"] .page-home .hero-overlay {
      background:
        radial-gradient(920px 500px at 14% 12%, rgba(45, 143, 86, 0.12), transparent 58%),
        radial-gradient(720px 420px at 90% 8%, rgba(154, 123, 56, 0.1), transparent 55%),
        linear-gradient(180deg, rgba(247, 244, 236, 0.85) 0%, transparent 65%);
    }

    .hero.hero--home {
      /* meno "vuoto" prima del contenuto: hero immediatamente sotto header */
      padding: clamp(1.85rem, 3.6vw, 2.7rem) 0 clamp(1.95rem, 4vw, 2.85rem);
    }

    /* La hero usa lo stesso wrapper strutturale dell'header.
       Qui neutralizziamo il `display:flex` dell'header-inner perché dentro
       abbiamo una griglia (non elementi header separati). */
    .page-home .hero--home > .container.header-inner {
      display: block;
    }

    .hero--home__grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(16.5rem, 19rem);
      gap: clamp(1.2rem, 3vw, 2.2rem);
      /* box laterale "agganciato" all'altezza della colonna principale */
      align-items: stretch;
    }

    .hero--home__main {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: clamp(1.75rem, 3.5vw, 2.75rem);
    }

    .hero--home__masthead {
      display: flex;
      flex-direction: column;
      gap: clamp(1.05rem, 2.4vw, 1.55rem);
      max-width: min(40rem, 100%);
    }

    .hero--home__badge {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      margin: 0;
      padding: 0.5rem 1rem 0.5rem 0.75rem;
      width: fit-content;
      max-width: 100%;
      font-size: var(--text-xs);
      font-weight: var(--font-semibold);
      letter-spacing: 0.06em;
      line-height: 1.35;
      text-transform: uppercase;
      color: color-mix(in oklab, var(--text) 72%, var(--muted));
      border: 1px solid color-mix(in oklab, var(--border-subtle) 55%, var(--brand) 22%);
      border-radius: var(--r-full);
      background: color-mix(in oklab, var(--panel-2) 78%, rgba(82, 194, 122, 0.04));
      box-shadow:
        0 1px 0 color-mix(in oklab, var(--text) 7%, transparent) inset,
        0 12px 32px rgba(0, 0, 0, 0.12);
    }

    html[data-theme="light"] .hero--home__badge {
      background: color-mix(in oklab, var(--panel-2) 55%, transparent);
      box-shadow: 0 1px 0 rgba(255, 255, 255, 0.35) inset;
    }

    .hero--home__badge-text {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.35rem 0.5rem;
      max-width: 100%;
    }

    .hero--home__badge-line {
      white-space: nowrap;
    }

    @media (max-width: 380px) {
      .hero--home__badge-line {
        white-space: normal;
      }
    }

    .hero--home__badge-sep {
      color: color-mix(in oklab, var(--home-gold) 65%, var(--muted));
      font-weight: var(--font-bold);
    }

    .hero--home__badge-dot {
      flex-shrink: 0;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: linear-gradient(145deg, var(--brand), var(--home-gold));
      box-shadow:
        0 0 0 3px color-mix(in oklab, var(--brand) 22%, transparent),
        0 0 14px color-mix(in oklab, var(--home-gold) 22%, transparent);
    }

    .hero--home__title {
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(1.95rem, 4.5vw, 3.05rem);
      font-weight: 600;
      line-height: 1.06;
      letter-spacing: -0.022em;
      color: var(--text);
      text-wrap: balance;
      max-width: 17em;
    }

    .hero--home__lead {
      margin: 0;
      max-width: 48ch;
      font-size: clamp(1.02rem, 1.35vw, 1.14rem);
      line-height: 1.62;
      color: var(--muted);
      opacity: 0.98;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .hero--home__lead-line {
      display: block;
    }

    .hero--home__lead-strong {
      font-weight: var(--font-semibold);
      color: color-mix(in oklab, var(--text) 88%, var(--muted));
      letter-spacing: 0.008em;
      font-size: 1.05em;
      line-height: 1.45;
    }

    .hero--home__lead-rest {
      font-weight: var(--font-normal);
      max-width: 46ch;
      line-height: 1.65;
    }

    html[data-theme="light"] .hero--home__lead {
      opacity: 1;
      color: color-mix(in oklab, var(--muted) 88%, var(--text) 12%);
    }

    .hero--home__actions {
      display: flex;
      flex-direction: column;
      gap: clamp(1.35rem, 3vw, 2rem);
      max-width: min(40rem, 100%);
      padding-top: 0.15rem;
    }

    .hero--home__cta-block {
      padding-top: clamp(0.35rem, 1.5vw, 0.65rem);
      border-top: 1px solid color-mix(in oklab, var(--border-subtle) 85%, var(--brand) 15%);
    }

    .hero--home__cta-row {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: clamp(0.85rem, 2vw, 1.15rem) clamp(1.15rem, 3vw, 1.85rem);
    }

    .hero--home__primary-block {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.55rem;
      min-width: min(100%, 16rem);
    }

    .hero--home__cta-hint {
      font-size: var(--text-xs);
      font-weight: var(--font-semibold);
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: color-mix(in oklab, var(--home-gold) 48%, var(--brand) 52%);
    }

    .hero--home__btn-primary {
      min-height: 3rem;
      border-radius: var(--r-full);
      padding-inline: clamp(1.25rem, 3vw, 1.65rem);
      font-weight: var(--font-semibold);
      letter-spacing: 0.015em;
      /* sobrietà: glow controllato (hover gestito da .btn:hover) */
      box-shadow: none;
      text-shadow: none;
      background: #74C47E;
      border-color: #5AA764;
      color: #0F2115;
    }

    .hero--home__btn-primary:hover:not(:disabled) {
      box-shadow: none;
      background: #63B66E;
      border-color: #5AA764;
      color: #0F2115;
    }

    .hero--home__btn-secondary {
      border-color: #5AA764;
      background: rgba(116, 196, 126, 0.06);
      color: var(--text);
      font-weight: var(--font-semibold);
      font-size: var(--text-lg);
      padding-block: var(--space-lg);
      padding-inline: clamp(1.25rem, 3vw, 1.65rem);
      min-height: 3rem;
      border-radius: var(--r-full);
    }

    .hero--home__btn-secondary:hover:not(:disabled) {
      border-color: #63B66E;
      background: rgba(116, 196, 126, 0.14);
      color: var(--text);
    }

    /* Light mode: aumenta contrasto e percezione interattività */
    html[data-theme="light"] .page-home .hero--home__btn-secondary {
      border-color: #8FB08E;
      background: #DCE9D7;
      color: #16301F;
    }

    html[data-theme="light"] .page-home .hero--home__btn-secondary:hover:not(:disabled) {
      border-color: #6F966F;
      background: #CFE2C8;
      color: #16301F;
    }

    html[data-theme="light"] .page-home .hero--home__btn-secondary:focus-visible {
      outline: 2px solid #6F966F;
      outline-offset: 3px;
    }

    .hero--home__below-cta {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }

    .hero--home__quick-label {
      margin: 0;
      font-size: var(--text-xs);
      font-weight: var(--font-semibold);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: color-mix(in oklab, var(--muted) 92%, var(--text));
    }

    .hero--home__quick {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 0.55rem;
      align-items: center;
    }

    .hero--home__pill {
      display: inline-flex;
      align-items: center;
      padding: 0.38rem 0.85rem;
      font-size: var(--text-xs);
      font-weight: var(--font-medium);
      letter-spacing: 0.03em;
      color: color-mix(in oklab, var(--muted) 88%, var(--text));
      text-decoration: none;
      border-radius: var(--r-full);
      border: 1px solid color-mix(in oklab, var(--border-subtle) 80%, var(--brand) 12%);
      background: color-mix(in oklab, var(--panel-2) 52%, transparent);
      transition:
        border-color 0.18s ease,
        color 0.18s ease,
        background 0.18s ease;
    }

    .hero--home__pill:hover {
      color: var(--text);
      border-color: color-mix(in oklab, var(--brand) 30%, var(--border));
      background: color-mix(in oklab, var(--panel) 58%, var(--brand-subtle));
    }

    .hero--home__pill:focus-visible {
      outline: 2px solid color-mix(in oklab, var(--brand) 70%, transparent);
      outline-offset: 2px;
    }

    html[data-theme="light"] .page-home .hero--home__pill {
      color: #16301F;
      border-color: #8FB08E;
      background: #DCE9D7;
    }

    html[data-theme="light"] .page-home .hero--home__pill:hover,
    html[data-theme="light"] .page-home .hero--home__pill:active {
      border-color: #6F966F;
      background: #CFE2C8;
      color: #16301F;
    }

    html[data-theme="light"] .page-home .hero--home__pill:focus-visible {
      outline: 2px solid #6F966F;
      outline-offset: 2px;
    }

    /* ----- Pannello destro (orientamento / fiducia) ----- */

    .hero--home__aside {
      min-width: 0;
      align-self: stretch;
    }

    .hero--home__panel {
      height: 100%;
      display: flex;
      flex-direction: column;
      flex: 1;
      gap: 0.75rem;
      padding: clamp(1.25rem, 2.5vw, 1.6rem);
      border-radius: var(--r-md);
      border: 1px solid color-mix(in oklab, var(--border-subtle) 30%, transparent);
      background: color-mix(in oklab, var(--panel-2) 55%, rgba(82, 194, 122, 0.02));
      /* Superficie più integrata: niente shadow "card" */
      box-shadow: 0 1px 0 color-mix(in oklab, var(--text) 6%, transparent) inset;
    }

    /* Allineamento laterale su mobile:
       main#contenuto aggiunge padding-inline (app.css), header-inner aggiunge padding-inline extra.
       Rimuoviamo quello di main e applichiamo lo stesso extra alla hero. */
    @media (max-width: 767px) {
      :global(main#contenuto:has(.page-home)) {
        padding-inline: 0 !important;
      }
    }

    /* Coerenza mobile con l'header: su mobile l'header-inner ha padding-inline extra. */
    @media (max-width: 768px) {
      .page-home .hero--home > .container.header-inner {
        padding-inline: 10px;
      }
    }

    html[data-theme="light"] .hero--home__panel {
      box-shadow: 0 1px 0 rgba(255, 255, 255, 0.5) inset;
    }

    .hero--home__panel-eyebrow {
      margin: 0;
      font-size: var(--text-xs);
      font-weight: var(--font-semibold);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: color-mix(in oklab, var(--home-gold) 45%, var(--brand) 55%);
    }

    .hero--home__panel-title {
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(1.15rem, 2vw, 1.35rem);
      font-weight: 600;
      letter-spacing: -0.018em;
      line-height: 1.25;
      color: var(--text);
    }

    .hero--home__panel-list {
      margin: 0.15rem 0 0;
      padding: 0 0 0 1.15rem;
      list-style: disc;
      color: color-mix(in oklab, var(--muted) 90%, var(--text));
      font-size: var(--text-sm);
      line-height: 1.55;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }

    .hero--home__panel-list li::marker {
      color: color-mix(in oklab, var(--brand) 75%, var(--home-gold));
    }

    .hero--home__panel-list strong {
      font-weight: var(--font-semibold);
      color: color-mix(in oklab, var(--text) 85%, var(--brand));
    }

    .hero--home__panel-divider {
      height: 1px;
      margin: 0.35rem 0 0.15rem;
      background: linear-gradient(
        90deg,
        transparent,
        color-mix(in oklab, var(--border) 70%, var(--brand) 18%),
        transparent
      );
    }

    .hero--home__proofs-label {
      margin: 0;
      font-size: var(--text-xs);
      font-weight: var(--font-semibold);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: color-mix(in oklab, var(--muted) 85%, var(--text));
    }

    .hero--home__panel-proofs {
      margin: 0;
      padding: 0;
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }

    .hero--home__panel-proofs li {
      display: grid;
      grid-template-columns: 5.75rem minmax(0, 1fr);
      gap: 0.5rem 0.65rem;
      align-items: start;
      font-size: var(--text-sm);
      line-height: 1.45;
    }

    .hero--home__proof-k {
      font-size: 0.68rem;
      font-weight: var(--font-bold);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: color-mix(in oklab, var(--home-gold) 55%, var(--muted));
      padding-top: 0.2em;
    }

    .hero--home__proof-v {
      color: color-mix(in oklab, var(--muted) 88%, var(--text));
    }

    .hero--home__panel-note {
      margin: auto 0 0;
      padding-top: 0.65rem;
      font-size: 0.72rem;
      line-height: 1.45;
      letter-spacing: 0.02em;
      color: color-mix(in oklab, var(--muted) 95%, var(--text));
      border-top: 1px solid var(--border-subtle);
    }

    @media (max-width: 959px) {
      .hero--home__grid {
        grid-template-columns: 1fr;
        gap: clamp(1.65rem, 4vw, 2.35rem);
      }

      .hero--home__aside {
        max-width: min(28rem, 100%);
        margin-inline: auto;
        width: 100%;
      }

      .hero--home__panel-proofs li {
        grid-template-columns: 5.25rem minmax(0, 1fr);
      }
    }

    @media (max-width: 639px) {
      .hero.hero--home {
        padding: 2.35rem 0 2.15rem;
      }

      .hero--home__title {
        max-width: none;
      }

      .hero--home__cta-row {
        flex-direction: column;
        align-items: stretch;
      }

      .hero--home__primary-block {
        align-items: stretch;
      }

      .hero--home__primary-block .btn.large {
        width: 100%;
        justify-content: center;
      }

      .hero--home__btn-secondary {
        justify-content: center;
        width: 100%;
      }

      .hero--home__panel-proofs li {
        grid-template-columns: 1fr;
        gap: 0.15rem;
      }

      .hero--home__proof-k {
        padding-top: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero--home__pill {
        transition: none;
      }
    }

    /* ----- Ultimi articoli (home): griglia più ariosa, scansione più chiara ----- */

    #ultimi.ultimi-section {
      padding: clamp(2rem, 4vw, 2.75rem) 0;
    }

    .page-home #ultimi .ultimi-section__head h2 {
      font-family: var(--font-display);
      font-weight: 600;
      letter-spacing: -0.02em;
    }

    #ultimi .ultimi-section__head {
      margin-bottom: clamp(1.15rem, 3vw, 1.65rem);
    }

    #ultimi .ultimi-section__lead {
      max-width: 52ch;
      line-height: var(--leading-relaxed);
    }

    #ultimi .ultimi-section__grid {
      gap: clamp(1.2rem, 2.4vw, 1.85rem);
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 272px), 1fr));
      align-items: stretch;
    }

    @media (max-width: 639px) {
      #ultimi .ultimi-section__grid {
        gap: 1.05rem;
        grid-template-columns: 1fr;
      }
    }

    .page-home .inizia-da-qui {
      padding: clamp(1.35rem, 3.5vw, 2rem) 0;
    }

    .page-home .inizia-da-qui .container {
      padding: clamp(1.15rem, 2.5vw, 1.65rem) var(--pad, 20px);
      border-radius: var(--r-lg);
      border: 1px solid var(--border-subtle);
      background: color-mix(in oklab, var(--panel-2) 72%, transparent);
      box-shadow: 0 18px 44px rgba(0, 0, 0, 0.12);
    }

    html[data-theme="light"] .page-home .inizia-da-qui .container {
      box-shadow: 0 12px 32px rgba(20, 32, 24, 0.06);
    }

    .inizia-da-qui {
      padding: var(--space-lg) 0;
    }
    .inizia-da-qui__title {
      margin: 0 0 var(--space-sm);
      font-size: var(--text-base);
      font-family: var(--font-display);
      font-weight: 600;
      color: color-mix(in oklab, var(--muted) 75%, var(--home-gold));
    }
    .inizia-da-qui__subtitle {
      margin: 0 0 var(--space-md);
      font-size: var(--text-sm);
      color: var(--muted);
      opacity: 0.95;
    }
    .inizia-da-qui__links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-md) var(--space-xl);
    }
    .inizia-da-qui__links .btn {
      flex-shrink: 0;
    }

    /* Light mode: ghost buttons "Inizia da qui" più leggibili/cliccabili */
    html[data-theme="light"] .page-home .inizia-da-qui__links .btn.ghost,
    html[data-theme="light"] .page-home .inizia-da-qui__links .btn-ghost {
      border-color: #8FB08E;
      background: #DCE9D7;
      color: #16301F;
    }

    html[data-theme="light"] .page-home .inizia-da-qui__links .btn.ghost:hover:not(:disabled),
