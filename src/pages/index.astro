---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../layouts/MigratedLayout.astro";
import HomeActionCards from "../components/HomeActionCards.astro";
import { PRIMARY_NAVIGATION } from "../config/navigation";

type Post = CollectionEntry<"blog">;

/* ============================================================
   Home "magazine" — implementazione del design
   `Canapalandia Homepage.dc.html` (Claude Design, opzione 1a/1b/1c).
   Superficie carta, titoli Newsreader, UI Archivo, radius 3px,
   divider a filo, nessuna ombra. I token sono locali alla home.
   ============================================================ */

/* ---------- Date ---------- */

function getPublishDate(post: Post): Date | null {
  const raw = post.data.publishDate;
  if (!raw) return null;
  const d = raw instanceof Date ? raw : new Date(String(raw));
  return Number.isNaN(d.getTime()) ? null : d;
}

function dateValue(post: Post): number {
  return getPublishDate(post)?.getTime() ?? 0;
}

const formatDateLong = (d: Date | null): string =>
  d ? d.toLocaleDateString("it-IT", { year: "numeric", month: "long", day: "numeric" }) : "";

/** "12 mag 2026" */
const formatDateShort = (d: Date | null): string =>
  d ? d.toLocaleDateString("it-IT", { year: "numeric", month: "short", day: "numeric" }) : "";

/** "12 mag" — usata nelle liste compatte */
const formatDayMonth = (d: Date | null): string =>
  d ? d.toLocaleDateString("it-IT", { month: "short", day: "numeric" }) : "";

/** "MAG 2026" — cronologia normativa */
const formatMonthYear = (d: Date | null): string =>
  d
    ? d
        .toLocaleDateString("it-IT", { year: "numeric", month: "short" })
        .replace(".", "")
        .toUpperCase()
    : "";

/* ---------- Slug, link, immagini ---------- */

function getSlug(post: Post): string {
  return post.slug ?? post.data.slug ?? "";
}

/** Identificatore stabile (percorso file): usato per deduplicare le sezioni. */
function getKey(post: Post): string {
  return post.id;
}

function postHref(post: Post): string {
  return `/blog/${getSlug(post)}/`;
}

function normalizeImgSrc(src: unknown): string {
  const s = typeof src === "string" ? src.trim() : "";
  if (!s) return "/images/placeholder.svg";
  if (s.startsWith("http://") || s.startsWith("https://")) return s;
  if (s.startsWith("/")) return s;
  return `/${s}`;
}

function normalizeImage(post: Post): string {
  const raw = post.data.image || post.data.coverImage || "";
  const srcValue =
    raw && typeof raw === "object" && "src" in raw
      ? (raw as Record<string, unknown>)["src"]
      : raw;
  return normalizeImgSrc(srcValue);
}

function imageAlt(post: Post): string {
  return post.data.coverAlt || post.data.title;
}

/** Tempo di lettura stimato dal corpo dell'articolo (200 parole/minuto). */
function readingMinutes(post: Post): number {
  const words = String(post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 200));
}

/** Ripulisce una riga Markdown/MDX lasciando il solo testo leggibile. */
function stripInlineMarkdown(line: string): string {
  return line
    .replace(/`{1,3}[^`]*`{1,3}/g, "")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/<[^>]+>/g, "")
    .replace(/[*_]{1,3}([^*_]+)[*_]{1,3}/g, "$1")
    .replace(/\s+/g, " ")
    .trim();
}

/** Righe che non appartengono al corpo discorsivo dell'articolo. */
function isProseLine(line: string): boolean {
  const l = line.trim();
  if (!l) return false;
  return !/^(#{1,6}\s|>|[-*+]\s|\d+\.\s|\||:::|import\s|export\s|<)/.test(l);
}

const ABSTRACT_MIN = 250;
const ABSTRACT_MAX = 350;

/**
 * Abstract editoriale per l'apertura: i primi paragrafi discorsivi
 * dell'articolo, ripuliti dal Markdown e tagliati su un confine di frase.
 * Salta il paragrafo che ripete il sommario già mostrato sopra.
 */
function editorialAbstract(post: Post): string {
  const dek = String(post.data.description ?? "").toLowerCase().slice(0, 40);
  const paragraphs: string[] = [];
  let current: string[] = [];
  let inCode = false;

  for (const raw of String(post.body ?? "").split(/\r?\n/)) {
    if (/^\s*```/.test(raw)) {
      inCode = !inCode;
      continue;
    }
    if (inCode) continue;
    if (isProseLine(raw)) {
      current.push(raw);
      continue;
    }
    if (current.length) {
      paragraphs.push(current.join(" "));
      current = [];
    }
  }
  if (current.length) paragraphs.push(current.join(" "));

  let text = "";
  for (const paragraph of paragraphs) {
    const clean = stripInlineMarkdown(paragraph);
    if (clean.length < 40) continue;
    if (dek && clean.toLowerCase().startsWith(dek)) continue;
    text = text ? `${text} ${clean}` : clean;
    if (text.length >= ABSTRACT_MIN) break;
  }

  if (text.length < 80) return "";
  if (text.length <= ABSTRACT_MAX) return text;

  // Taglio su fine frase; in mancanza, su confine di parola.
  const window = text.slice(0, ABSTRACT_MAX);
  const sentenceEnd = Math.max(
    window.lastIndexOf(". "),
    window.lastIndexOf("! "),
    window.lastIndexOf("? "),
  );
  if (sentenceEnd > ABSTRACT_MIN - 60) return window.slice(0, sentenceEnd + 1);
  return `${window.slice(0, window.lastIndexOf(" "))}…`;
}

/* ---------- Etichette categoria ---------- */

const CATEGORY_BADGE: Record<string, string> = {
  "cannabis-news-it": "Cannabis news",
  Normativa: "Normativa",
  "cbd-alimentazione": "CBD",
  "canapa-e-ambiente": "Canapa",
  "salute-benessere": "Salute",
  "guide-tutorial": "Guide",
  "cannabis-e-innovazione": "Innovazione",
  Attualità: "Attualità",
  Ricerca: "Ricerca",
  "cbd-bellezza-cura-pelle": "CBD e pelle",
};

function prettifySlug(slug: string): string {
  return slug
    .split("-")
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
}

function categoryLabel(slug: unknown): string {
  if (typeof slug !== "string" || !slug.trim()) return "";
  const key = slug.trim();
  return CATEGORY_BADGE[key] ?? prettifySlug(key);
}

/* ---------- Caricamento e filtri ---------- */

let postsAll: Post[] = [];
try {
  postsAll = await getCollection("blog");
} catch {
  console.warn("[index] Nessun contenuto trovato in Content Collections");
}

const NOW = new Date();

function isPublished(post: Post): boolean {
  const { draft, status, editorialStatus } = post.data;
  if (draft === true) return false;
  if (status === "draft" || status === "test") return false;
  if (editorialStatus === "legacy-review") return false;
  const d = getPublishDate(post);
  return d !== null && d.getTime() <= NOW.getTime();
}

/**
 * Le traduzioni inglesi vivono nella stessa collection ma con categorie
 * dedicate: la home è italiana, quindi le escludiamo esplicitamente.
 */
const EN_CATEGORIES = new Set([
  "cannabis-news",
  "cannabis-legalization",
  "cbd-and-nutrition",
  "cannabis-and-innovation",
  "medical-cannabis",
  "hemp-sustainability",
  "health-wellness",
]);

function isItalian(post: Post): boolean {
  const category = post.data.category;
  return !(typeof category === "string" && EN_CATEGORIES.has(category));
}

/** Tutti i post italiani pubblicabili e linkabili, dal più recente. */
const published = postsAll
  .filter((p) => isPublished(p) && isItalian(p) && getSlug(p) !== "")
  .sort((a, b) => dateValue(b) - dateValue(a));

/** Finestra editoriale principale: dal 2025 in poi. `published` resta il fallback. */
const MIN_DATE = new Date("2025-01-01T00:00:00.000Z");
const recent = published.filter((p) => (getPublishDate(p) as Date) >= MIN_DATE);

/**
 * Le sezioni tematiche sono archivi, non cronologie: attingono a tutto lo
 * storico pubblicato, così restano piene anche quando le sezioni di apertura
 * hanno già consumato gli articoli più recenti della stessa categoria.
 */
function byCategory(slug: string): Post[] {
  return published.filter((p) => p.data.category === slug);
}

/* ---------- Selezione editoriale (deduplicata) ---------- */

const used = new Set<string>();

/**
 * Prende `n` post attingendo alle sorgenti in ordine di priorità e saltando
 * quanto già assegnato a una sezione precedente. `recent` e `published`
 * chiudono sempre la catena, così nessun blocco resta vuoto.
 */
function takeFrom(n: number, ...sources: Post[][]): Post[] {
  const out: Post[] = [];
  for (const source of sources) {
    for (const post of source) {
      if (out.length >= n) return out;
      const key = getKey(post);
      if (!used.has(key)) {
        used.add(key);
        out.push(post);
      }
    }
  }
  return out;
}

/**
 * Come `takeFrom`, ma con la cronologia generale in coda: le sezioni non
 * tematiche (hero, ultime notizie) non devono mai restare vuote.
 */
function take(n: number, ...sources: Post[][]): Post[] {
  return takeFrom(n, ...sources, recent, published);
}

// Pool "in evidenza": prima le scelte manuali, poi le notizie.
const featuredManual = published
  .filter((p) => p.data.homeFeatured === true)
  .sort((a, b) => {
    const rankA = a.data.homeFeaturedRank ?? 999;
    const rankB = b.data.homeFeaturedRank ?? 999;
    if (rankA !== rankB) return rankA - rankB;
    return dateValue(b) - dateValue(a);
  });
const news = byCategory("cannabis-news-it");

// L'ordine di queste chiamate definisce la priorità: ogni sezione prende i
// contenuti più recenti ancora liberi. Le sezioni tematiche usano `takeFrom`,
// così non pescano mai fuori dalla loro area editoriale.

// 1. Hero
const hero = take(1, featuredManual, news)[0] ?? null;
const heroSide = take(2, featuredManual, news);

// 2. "In aggiornamento" (rotazione) e "Ultima ora": cronologia pura
const ticker = take(3);
const ultimaOra = take(3);

// 3. In evidenza
const evidenzaLead = take(1, featuredManual, news)[0] ?? null;
const evidenzaList = take(3);

// 4. Ultime notizie
const ultime = take(4);

// 5. Osservatorio normativa
const normativa = byCategory("Normativa");
const normLead = takeFrom(1, normativa)[0] ?? null;
const normLinks = takeFrom(2, normativa);
const normTimeline = takeFrom(4, normativa);

// 6. CBD
const cbdPosts = takeFrom(3, byCategory("cbd-alimentazione"), byCategory("cbd-bellezza-cura-pelle"));

// 7. Canapa
const canapa = byCategory("canapa-e-ambiente");
const canapaMain = takeFrom(2, canapa);
const canapaList = takeFrom(4, canapa);

// 8. Approfondimenti e guide: contenuti lunghi, non cronologia
const guide = takeFrom(
  4,
  byCategory("guide-tutorial"),
  byCategory("salute-benessere"),
  byCategory("cbd-alimentazione"),
  byCategory("canapa-e-ambiente"),
);

/* ---------- Apertura: abstract e metadata dell'articolo di testa ---------- */

const heroAbstract = hero ? editorialAbstract(hero) : "";

/** "Aggiornato il …" quando la revisione è successiva alla pubblicazione. */
function heroDateLabel(post: Post): string {
  const published = getPublishDate(post);
  const rawUpdated = post.data.updatedDate;
  const updated = rawUpdated
    ? rawUpdated instanceof Date
      ? rawUpdated
      : new Date(String(rawUpdated))
    : null;
  const isNewer =
    updated !== null &&
    !Number.isNaN(updated.getTime()) &&
    published !== null &&
    updated.getTime() - published.getTime() > 86_400_000;
  return isNewer
    ? `Aggiornato il ${formatDateLong(updated)}`
    : formatDateLong(published);
}

/* ---------- Meta ---------- */

const title =
  "Cannabis light, CBD e canapa in Italia | Notizie, normativa e guide - Canapalandia";
const description =
  "Osservatorio editoriale su cannabis light, CBD e canapa in Italia: normativa, notizie, guide e analisi per orientarti senza sensazionalismi.";
const canonical = `${import.meta.env.SITE || "https://canapalandia.com"}/`;
const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "Canapalandia",
      url: "https://canapalandia.com/",
      description: "Osservatorio editoriale su cannabis light, CBD e canapa in Italia",
      inLanguage: "it-IT",
    },
    {
      "@type": "Organization",
      name: "Canapalandia",
      url: "https://canapalandia.com/",
      description: "Osservatorio editoriale su cannabis light, CBD e canapa in Italia",
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Canapalandia",
          item: "https://canapalandia.com/",
        },
      ],
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  shell={false}
  newsletter={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(homeJsonLd)} />

  <div class="cl">
    <!-- ===== UTILITY BAR (livello 2: deve quasi sparire) ===== -->
    <div class="cl-strip">
      <div class="cl-wrap cl-strip__inner">
        <p class="cl-strip__tag">
          Magazine indipendente su cannabis, canapa, CBD e normativa
        </p>
        <p class="cl-strip__links">
          <a href="#newsletter">Newsletter</a>
          <span class="cl-strip__sep" aria-hidden="true">·</span>
          <a href="/chi-siamo/">Chi siamo</a>
        </p>
      </div>
    </div>

    <!-- ===== IN AGGIORNAMENTO (una notizia alla volta) ===== -->
    {ticker.length > 0 && (
      <section class="cl-brief" aria-label="Ultimi aggiornamenti" data-brief>
        <div class="cl-wrap cl-brief__inner">
          <p class="cl-brief__label">
            <span class="cl-dot cl-dot--ocra" aria-hidden="true"></span>
            In aggiornamento
          </p>

          <div class="cl-brief__viewport" data-brief-viewport aria-live="off">
            <ul class="cl-brief__list">
              {ticker.map((p, i) => (
                <li class="cl-brief__item" data-brief-item hidden={i !== 0}>
                  <a class="cl-brief__link" href={postHref(p)}>{p.data.title}</a>
                </li>
              ))}
            </ul>
          </div>

          {ticker.length > 1 && (
            <p class="cl-brief__nav">
              <span class="cl-brief__count" data-brief-count>
                01 / {String(ticker.length).padStart(2, "0")}
              </span>
              <button
                type="button"
                class="cl-brief__btn"
                data-brief-prev
                aria-label="Aggiornamento precedente"
              >
                <span aria-hidden="true">←</span>
              </button>
              <button
                type="button"
                class="cl-brief__btn"
                data-brief-next
                aria-label="Aggiornamento successivo"
              >
                <span aria-hidden="true">→</span>
              </button>
            </p>
          )}
        </div>
      </section>
    )}

    <!-- ===== HERO ===== -->
    {hero && (
      <section class="cl-hero" aria-labelledby="hero-title">
        <div class="cl-wrap cl-hero__grid">
          <article class="cl-lead">
            <a class="cl-lead__media" href={postHref(hero)} tabindex="-1" aria-hidden="true">
              <img
                src={normalizeImage(hero)}
                alt=""
                width="880"
                height="495"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                referrerpolicy="no-referrer"
                onerror="this.onerror=null;this.src='/images/placeholder.svg';"
              />
            </a>
            {categoryLabel(hero.data.category) && (
              <p class="cl-lead__kicker">
                <span class="cl-badge">{categoryLabel(hero.data.category)}</span>
              </p>
            )}
            <h1 id="hero-title" class="cl-lead__title">
              <a href={postHref(hero)}>{hero.data.title}</a>
            </h1>
            {hero.data.description && <p class="cl-lead__dek">{hero.data.description}</p>}
            {heroAbstract && <p class="cl-lead__abstract">{heroAbstract}</p>}
            <p class="cl-lead__meta cl-metaline">
              {readingMinutes(hero)} min di lettura · {heroDateLabel(hero)}
            </p>
            <p class="cl-lead__foot">
              <a class="cl-btn cl-btn--primary" href={postHref(hero)}>
                Leggi l'articolo <span aria-hidden="true">→</span>
              </a>
              <span class="cl-byline">di {hero.data.author || "Redazione Canapalandia"}</span>
            </p>
          </article>

          <aside class="cl-rail" aria-label="Altre letture">
            {heroSide[0] && (
              <article class="cl-rail__top">
                <a class="cl-rail__media" href={postHref(heroSide[0])} tabindex="-1" aria-hidden="true">
                  <img
                    src={normalizeImage(heroSide[0])}
                    alt=""
                    width="372"
                    height="248"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    onerror="this.onerror=null;this.src='/images/placeholder.svg';"
                  />
                </a>
                <p class="cl-kicker">{categoryLabel(heroSide[0].data.category)}</p>
                <h2 class="cl-rail__title">
                  <a href={postHref(heroSide[0])}>{heroSide[0].data.title}</a>
                </h2>
                <p class="cl-metaline">{formatDateLong(getPublishDate(heroSide[0]))}</p>
              </article>
            )}

            {heroSide[1] && (
              <article class="cl-rail__second">
                <p class="cl-kicker">{categoryLabel(heroSide[1].data.category)}</p>
                <h2 class="cl-rail__title">
                  <a href={postHref(heroSide[1])}>{heroSide[1].data.title}</a>
                </h2>
                {heroSide[1].data.description && (
                  <p class="cl-rail__dek">{heroSide[1].data.description}</p>
                )}
                <p class="cl-metaline">{formatDateLong(getPublishDate(heroSide[1]))}</p>
              </article>
            )}

            {ultimaOra.length > 0 && (
              <div class="cl-flash">
                <p class="cl-flash__head">
                  <span class="cl-dot cl-dot--lime" aria-hidden="true"></span>
                  Ultima ora
                </p>
                <ul class="cl-flash__list">
                  {ultimaOra.map((p) => (
                    <li class="cl-flash__item">
                      <a href={postHref(p)}>
                        <span class="cl-flash__date">{formatDayMonth(getPublishDate(p))}</span>
                        <span class="cl-flash__title">{p.data.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </aside>
        </div>
      </section>
    )}

    <!-- ===== IN EVIDENZA ===== -->
    {evidenzaLead && (
      <section id="in-evidenza" class="cl-highlight" aria-labelledby="highlight-title">
        <div class="cl-wrap">
          <div class="cl-sechead cl-sechead--rule">
            <h2 id="highlight-title" class="cl-sechead__title">In evidenza</h2>
            <span class="cl-sechead__aside">Da leggere insieme</span>
          </div>

          <div class="cl-highlight__grid">
            <article class="cl-inchiesta">
              <a class="cl-inchiesta__media" href={postHref(evidenzaLead)} tabindex="-1" aria-hidden="true">
                <img
                  src={normalizeImage(evidenzaLead)}
                  alt=""
                  width="760"
                  height="326"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  onerror="this.onerror=null;this.src='/images/placeholder.svg';"
                />
              </a>
              <div class="cl-inchiesta__body">
                <div>
                  <p class="cl-kicker cl-kicker--ocra">
                    {categoryLabel(evidenzaLead.data.category) || "Approfondimento"}
                  </p>
                  <h3 class="cl-inchiesta__title">
                    <a href={postHref(evidenzaLead)}>{evidenzaLead.data.title}</a>
                  </h3>
                </div>
                {evidenzaLead.data.description && (
                  <p class="cl-inchiesta__dek">{evidenzaLead.data.description}</p>
                )}
              </div>
            </article>

            <ul class="cl-stack">
              {evidenzaList.map((p) => (
                <li class="cl-stack__item">
                  <a class="cl-stack__link" href={postHref(p)}>
                    <span class="cl-stack__thumb">
                      <img
                        src={normalizeImage(p)}
                        alt=""
                        width="104"
                        height="104"
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                        onerror="this.onerror=null;this.src='/images/placeholder.svg';"
                      />
                    </span>
                    <span class="cl-stack__body">
                      <span class="cl-kicker">{categoryLabel(p.data.category)}</span>
                      <span class="cl-stack__title">{p.data.title}</span>
                      <span class="cl-metaline">{formatDateLong(getPublishDate(p))}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    <!-- ===== ULTIME NOTIZIE ===== -->
    {ultime.length > 0 && (
      <section id="ultime" class="cl-latest" aria-labelledby="latest-title">
        <div class="cl-wrap">
          <div class="cl-sechead">
            <h2 id="latest-title" class="cl-sechead__title">Ultime notizie</h2>
            <a class="cl-morelink" href="/blog/">Tutte le notizie →</a>
          </div>

          <div class="cl-grid4">
            {ultime.map((p) => (
              <article class="cl-card">
                <a class="cl-card__media" href={postHref(p)} tabindex="-1" aria-hidden="true">
                  <img
                    src={normalizeImage(p)}
                    alt=""
                    width="300"
                    height="225"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    onerror="this.onerror=null;this.src='/images/placeholder.svg';"
                  />
                </a>
                <p class="cl-kicker">{categoryLabel(p.data.category)}</p>
                <h3 class="cl-card__title">
                  <a href={postHref(p)}>{p.data.title}</a>
                </h3>
                <p class="cl-metaline">
                  {formatDateShort(getPublishDate(p))} · {readingMinutes(p)} min
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ===== OSSERVATORIO NORMATIVA ===== -->
    {normLead && (
      <section id="normativa" class="cl-observatory" aria-labelledby="observatory-title">
        <div class="cl-wrap">
          <div class="cl-observatory__head">
            <div>
              <p class="cl-kicker cl-kicker--lime">Osservatorio</p>
              <h2 id="observatory-title" class="cl-observatory__title">Normativa</h2>
            </div>
            <p class="cl-observatory__intro">
              Leggi italiane, sentenze, regolamenti europei. Aggiornato dalla redazione con i
              riferimenti ufficiali.
            </p>
          </div>

          <div class="cl-observatory__grid">
            <div class="cl-observatory__col">
              <article class="cl-observatory__lead">
                <h3 class="cl-observatory__leadTitle">
                  <a href={postHref(normLead)}>{normLead.data.title}</a>
                </h3>
                {normLead.data.description && (
                  <p class="cl-observatory__dek">{normLead.data.description}</p>
                )}
                <p class="cl-observatory__meta">
                  Aggiornato · {formatDateLong(getPublishDate(normLead))}
                </p>
              </article>

              {normLinks.length > 0 && (
                <ul class="cl-observatory__links">
                  {normLinks.map((p) => (
                    <li>
