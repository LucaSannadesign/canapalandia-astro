      font-weight: 600;
      letter-spacing: -0.02em;
    }

    #in-evidenza .in-evidenza__badge {
      border: 1px solid color-mix(in oklab, var(--home-gold) 40%, var(--border));
      background: color-mix(in oklab, var(--panel-2) 65%, rgba(200, 169, 90, 0.12));
      color: color-mix(in oklab, var(--text) 62%, var(--home-gold));
      letter-spacing: 0.08em;
