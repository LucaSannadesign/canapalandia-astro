---
import { Image } from "astro:assets";
import Layout from "../layouts/MigratedLayout.astro";
import Adsense from "../components/widgets/Adsense.astro";
import { loadWp } from "../lib/wp";
import {
  textFromHtml,
  excerptFromHtml,
  entryHref,
  resolveWpMediaSrc,
} from "../lib/utils";
import { WP_HOST } from "../lib/consts";

/* ---------------------------
   Helpers: imported from ../lib/utils
--------------------------- */

/* ---------------------------
   Media resolution (mirror / hotlink)
--------------------------- */

function featuredImage(p: any): { src: string; alt: string } | null {
  const direct = p?.featuredImage ?? p?.featured_image ?? p?.image ?? null;

  if (typeof direct === "string" && direct.trim()) {
    return { src: resolveWpMediaSrc(direct.trim()), alt: "" };
  }

  if (direct && typeof direct === "object") {
    const src =
      (direct as any)?.src ??
      (direct as any)?.url ??
      (direct as any)?.source_url;

    const alt = (direct as any)?.alt ?? (direct as any)?.alt_text ?? "";

    if (typeof src === "string" && src.trim()) {
      return { src: resolveWpMediaSrc(src.trim()), alt: String(alt ?? "") };
    }
  }

  const fm = p?.raw?._embedded?.["wp:featuredmedia"]?.[0];
  const srcRaw =
    fm?.media_details?.sizes?.medium_large?.source_url ||
    fm?.media_details?.sizes?.large?.source_url ||
    fm?.media_details?.sizes?.full?.source_url ||
    fm?.source_url;

  const alt = fm?.alt_text || fm?.title?.rendered || "";

  if (typeof srcRaw === "string" && srcRaw.trim()) {
    return { src: resolveWpMediaSrc(srcRaw.trim()), alt: String(alt ?? "") };
  }

  return null;
}

/* ---------------------------
   Data: WP headless
--------------------------- */

const { entries: wpEntries = [] } = await loadWp();
const entries: any[] = Array.isArray(wpEntries) ? wpEntries : [];

const posts = entries.filter(
  (e) => typeof e?.title === "string" && typeof e?.html === "string",
);

const getTime = (p: any) => {
  const raw = p?.date ?? p?.modified ?? p?.modifiedGmt ?? "";
  const t = Date.parse(String(raw));
  return Number.isFinite(t) ? t : 0;
};

const sortedPosts = posts.slice().sort((a, b) => getTime(b) - getTime(a));
const latestPosts = sortedPosts.slice(0, 6);
const featured = sortedPosts[0];
const featuredSide = sortedPosts.slice(1, 4);

/* ---------------------------
   Page meta
--------------------------- */

const heroBgVar = "none";
const title = "Canapalandia — Cannabis light, CBD e canapa legale in Italia";
const canonical = `${WP_HOST}/`;
---

<Layout title={title} canonical={canonical} shell={false}>
  <section class="hero" style={`--hero-bg:${heroBgVar}`}>
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="container hero-inner">
      <p class="kicker">Cannabis legale • CBD • Canapa industriale</p>

      <h1>
        Cannabis light, CBD e canapa legale in Italia: informazione chiara e
        verificabile
      </h1>

      <p class="lead">
        Notizie, normative e guide pratiche per orientarti tra leggi, prodotti,
        ricerca e filiera. Focus Italia, aggiornamenti continui, zero
        sensazionalismo.
      </p>

      <div class="hero-cta">
        <a class="btn primary" href="/#percorsi">Inizia dai percorsi</a>
        <a class="btn ghost" href="/#ultimi">Leggi le ultime notizie</a>
      </div>

      <ul class="trust" aria-label="Punti chiave">
        <li>Focus Italia</li>
        <li>Fonti e contesto</li>
        <li>Aggiornato</li>
        <li>No promozione illegalità</li>
      </ul>
    </div>
  </section>

  <section id="percorsi" class="section">
    <div class="container">
      <div class="section-head">
        <h2>Percorsi tematici</h2>
        <p class="section-lead">
          Entra subito nell’area giusta: normative, benessere, filiera e
          approfondimenti.
        </p>
      </div>

      <div class="grid cards">
        <a class="card card--topic" href="/categoria/normative-aspetti-legali/">
          <span class="card-icon" aria-hidden="true">
            <!-- Bilancia -->
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 3v18"></path>
              <path d="M6 7h12"></path>
              <path d="M7 7l-3 6h6l-3-6z"></path>
              <path d="M17 7l-3 6h6l-3-6z"></path>
              <path d="M6 21h12"></path>
            </svg>
          </span>
          <h3>Normativa e aspetti legali</h3>
          <p>Leggi, sentenze, decreti e cosa cambia davvero in Italia.</p>
        </a>

        <a class="card card--topic" href="/categoria/salute-benessere/">
          <span class="card-icon" aria-hidden="true">
            <!-- Goccia -->
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 2s7 7 7 13a7 7 0 0 1-14 0c0-6 7-13 7-13z"></path>
              <path d="M9.5 14.5c1 1.2 4 1.2 5 0"></path>
            </svg>
          </span>
          <h3>CBD e benessere</h3>
          <p>Uso consapevole, ricerca, qualità, sicurezza e limiti.</p>
        </a>

        <a class="card card--topic" href="/categoria/cannabis-news-it/">
          <span class="card-icon" aria-hidden="true">
            <!-- Giornale -->
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M6 4h11a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"
              ></path>
              <path d="M8 8h7"></path>
              <path d="M8 12h8"></path>
              <path d="M8 16h6"></path>
            </svg>
          </span>
          <h3>Cannabis news</h3>
          <p>Attualità selezionata, senza panico morale né clickbait.</p>
        </a>

        <a class="card card--topic" href="/categoria/coltivazione-legale/">
          <span class="card-icon" aria-hidden="true">
            <!-- Fabbrica/filiera -->
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 21h18"></path>
              <path d="M5 21V9l6 3V9l8 4v8"></path>
              <path d="M9 21v-6h3v6"></path>
            </svg>
          </span>
          <h3>Canapa industriale</h3>
          <p>Filiera, economia, sostenibilità e applicazioni reali.</p>
        </a>

        <a class="card card--topic" href="/categoria/guide-tutorial/">
          <span class="card-icon" aria-hidden="true">
            <!-- Checklist -->
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M7 3h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"
              ></path>
              <path d="M8 8h8"></path>
              <path d="M8 12h6"></path>
              <path d="M8 16h7"></path>
              <path d="M7 8l.8.8L10 6.6"></path>
            </svg>
          </span>
          <h3>Guide pratiche</h3>
          <p>
            Glossario, come leggere un COA, cosa guardare prima di acquistare.
          </p>
        </a>

        <a class="card card--topic" href="/categoria/partner-e-affiliazioni/">
          <span class="card-icon" aria-hidden="true">
            <!-- Stretta di mano semplificata -->
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M8 12l2 2a2 2 0 0 0 3 0l1-1"></path>
              <path d="M3 12l4-4 5 5"></path>
              <path d="M21 12l-4-4-3 3"></path>
              <path d="M7 8l-2 2"></path>
            </svg>
          </span>
          <h3>Partner selezionati</h3>
          <p>
            Collaborazioni trasparenti e risorse utili per supportare il
            progetto.
          </p>
        </a>
      </div>
    </div>
  </section>

  <div class="container">
    <Adsense slotId="HOME_MID_ID" label="Pubblicità" />
  </div>

  <section id="in-evidenza" class="section alt">
    <div class="container">
      <div class="section-head">
        <h2>In evidenza</h2>
        <p class="section-lead">
          Una guida “pilastro” e tre letture correlate per farti un quadro
          completo.
        </p>
      </div>

      <div class="grid featured">
        {
          featured ? (
            <a class="feature-main" href={entryHref(featured)}>
              <p class="badge">Approfondimento</p>

              {(() => {
                const fi = featuredImage(featured);
                return fi ? (
                  fi.src.startsWith("http") ? (
                    <Image
                      class="feature-img"
                      src={fi.src}
                      alt={fi.alt || textFromHtml(featured.title)}
                      inferSize={true}
                      loading="eager"
                      decoding="async"
                    />
                  ) : (
                    <img
                      class="feature-img"
                      src={fi.src}
                      alt={fi.alt || textFromHtml(featured.title)}
                      loading="eager"
                      decoding="async"
                    />
                  )
                ) : (
                  <div
                    class="feature-img feature-img--placeholder"
                    aria-hidden="true"
                  />
                );
              })()}

              <h3 class="feature-title" set:html={featured.title} />
              <p class="feature-excerpt">
                {excerptFromHtml(featured.html, 180)}
              </p>
              <span class="btn small">Leggi</span>
            </a>
          ) : (
            <div class="feature-main">
              <p>Selezione in evidenza in arrivo.</p>
            </div>
          )
        }

        <div class="feature-side">
          {
            featuredSide.map((p) => (
              <a class="mini" href={entryHref(p)}>
                {(() => {
                  const fi = featuredImage(p);
                  return fi ? (
                    fi.src.startsWith("http") ? (
                      <Image
                        class="mini-img"
                        src={fi.src}
                        alt={fi.alt || textFromHtml(p.title)}
                        inferSize={true}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <img
                        class="mini-img"
                        src={fi.src}
                        alt={fi.alt || textFromHtml(p.title)}
                        loading="lazy"
                        decoding="async"
                      />
                    )
                  ) : (
                    <div
                      class="mini-img mini-img--placeholder"
                      aria-hidden="true"
                    />
                  );
                })()}

                <div class="mini-body">
                  <h3 class="mini-title" set:html={p.title} />
                  <p class="mini-excerpt">{excerptFromHtml(p.html, 90)}</p>
                  <span class="mini-link">Leggi</span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="ultimi" class="section">
    <div class="container">
      <div class="section-head">
        <h2>Ultimi articoli</h2>
        <p class="section-lead">
          Aggiornamenti e analisi. Scegli cosa leggere in base al tema.
        </p>
      </div>

      <div class="grid">
        {
          latestPosts.map((p) => (
            <article class="card post-card">
              <a class="cardLink" href={entryHref(p)}>
                <div class="thumb">
                  {(() => {
                    const fi = featuredImage(p);
                    return fi ? (
                      fi.src.startsWith("http") ? (
                        <Image
                          src={fi.src}
                          alt={fi.alt || textFromHtml(p.title)}
                          inferSize={true}
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <img
                          src={fi.src}
                          alt={fi.alt || textFromHtml(p.title)}
                          loading="lazy"
                          decoding="async"
                        />
                      )
                    ) : null;
                  })()}
                </div>

                <div class="cardBody">
                  <p class="cardMeta">
                    {(() => {
                      const iso = p?.date ?? p?.modified ?? "";
                      return iso
                        ? new Date(iso).toLocaleDateString("it-IT", {
                            year: "numeric",
                            month: "long",
                            day: "2-digit",
                          })
                        : "";
                    })()}
                  </p>

                  <h3 class="cardTitle" set:html={p.title} />
                  <p class="cardExcerpt">{excerptFromHtml(p.html, 110)}</p>
                  <span class="cardCta">Apri →</span>
                </div>
              </a>
            </article>
          ))
        }
      </div>

      <div class="section-cta">
        <a class="btn ghost" href="/blog/">Vai al blog</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container support">
      <div>
        <h2>Supporta Canapalandia</h2>
        <p class="section-lead">
          Se trovi utile il progetto, puoi sostenerlo o scoprire i partner
          selezionati.
        </p>
      </div>
      <div class="support-cta">
        <a class="btn primary" href="/sostieni-la-nostra-causa/"
          >Sostieni il progetto</a
        >
        <a class="btn ghost" href="/partner-selezionati/">Scopri i partner</a>
      </div>
    </div>
  </section>

  <style>
    /* Percorsi tematici: rollover elegante */
    #percorsi .grid.cards .card--topic {
      position: relative;
      transition:
        transform 0.18s ease,
        box-shadow 0.18s ease,
        border-color 0.18s ease,
        background 0.18s ease;
      will-change: transform;
    }

    #percorsi .grid.cards .card--topic::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: var(--r);
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.18s ease;
      /* glow leggero + “sheen” */
      background:
        radial-gradient(
          700px 220px at 20% 15%,
          rgba(34, 197, 94, 0.14),
          transparent 55%
        ),
        linear-gradient(135deg, rgba(255, 255, 255, 0.06), transparent 40%);
    }

    html[data-theme="light"] #percorsi .grid.cards .card--topic::after {
      background:
        radial-gradient(
          700px 220px at 20% 15%,
          rgba(22, 163, 74, 0.12),
          transparent 55%
        ),
        linear-gradient(135deg, rgba(2, 6, 23, 0.05), transparent 40%);
    }

    #percorsi .grid.cards .card--topic:hover {
      transform: translateY(-3px);
      border-color: rgba(34, 197, 94, 0.3);
      box-shadow:
        0 14px 38px rgba(0, 0, 0, 0.28),
        0 0 0 1px rgba(34, 197, 94, 0.1);
    }

    #percorsi .grid.cards .card--topic:hover::after {
      opacity: 1;
    }

    #percorsi .grid.cards .card--topic:hover .card-icon {
      transform: translateY(-1px);
      background: rgba(34, 197, 94, 0.16);
      border-color: rgba(34, 197, 94, 0.28);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.18);
    }

    #percorsi .card--topic .card-icon {
      transition:
        transform 0.18s ease,
        background 0.18s ease,
        border-color 0.18s ease,
        box-shadow 0.18s ease;
    }

    /* Accessibilità: focus da tastiera */
    #percorsi .grid.cards .card--topic:focus-visible {
      outline: 2px solid rgba(34, 197, 94, 0.55);
      outline-offset: 4px;
    }
  </style>
</Layout>
