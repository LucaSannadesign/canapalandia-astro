      position: relative;
      z-index: 1;
      width: fit-content;
    }

    #in-evidenza .in-evidenza__figure {
      margin: 0;
      padding: 0;
      position: relative;
      border-radius: var(--r-sm);
      overflow: hidden;
      background: var(--panel-2);
