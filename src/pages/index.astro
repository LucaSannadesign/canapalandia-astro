---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../layouts/MigratedLayout.astro";
import HomeActionCards from "../components/HomeActionCards.astro";
import {
  PRIMARY_EDITORIAL_CATEGORY_SLUGS,
  PRIMARY_NAVIGATION,
} from "../config/navigation";

/* ---------------------------
   Helpers: date
--------------------------- */

// Unica funzione per normalizzare una data (elimina dateOf e dateValue duplicate)
function getPublishDate(post: CollectionEntry<"blog">): Date | null {
  const raw = post.data.publishDate;
  if (!raw) return null;
  const d = raw instanceof Date ? raw : new Date(String(raw));
  return Number.isNaN(d.getTime()) ? null : d;
}

function dateValue(post: CollectionEntry<"blog">): number {
  return getPublishDate(post)?.getTime() ?? 0;
}

const formatDate = (d: Date | null): string => {
  if (!d) return "";
  return d.toLocaleDateString("it-IT", { year: "numeric", month: "long", day: "numeric" });
};

/** Data compatta per le card ("31 lug 2026"). */
const formatDateShort = (d: Date | null): string => {
  if (!d) return "";
  return d.toLocaleDateString("it-IT", { year: "numeric", month: "short", day: "numeric" });
};

/* ---------------------------
   Helpers: slug / immagine
--------------------------- */

function getSlug(post: CollectionEntry<"blog">): string {
  return post.slug ?? post.data.slug ?? "";
}

/**
 * Identificatore stabile del contenuto, usato per la deduplicazione tra le sezioni.
 * `entry.id` è generato dal loader della collection (percorso del file) ed è sempre
 * presente: a differenza di `getSlug()` non dipende da un campo del frontmatter.
 */
function getKey(post: CollectionEntry<"blog">): string {
  return post.id;
}

// FIX: tipizzato correttamente, niente più `any`
function postHref(entry: CollectionEntry<"blog">): string {
  const slug = getSlug(entry);
  if (!slug) throw new Error(`Missing slug for post: ${entry.data.title}`);
  return `/blog/${slug}/`;
}

function normalizeImgSrc(src: unknown): string {
  const s = typeof src === "string" ? src.trim() : "";
  if (!s) return "/images/placeholder.svg";
  if (s.startsWith("http://") || s.startsWith("https://")) return s;
  if (s.startsWith("/")) return s;
  return `/${s}`;
}

function normalizeImage(entry: CollectionEntry<"blog">): string {
  const raw = entry.data.image || entry.data.coverImage || "";
  // FIX: type guard pulito, niente cast a `any`
  const srcValue =
    raw && typeof raw === "object" && "src" in raw
      ? (raw as Record<string, unknown>)["src"]
      : raw;
  return normalizeImgSrc(srcValue);
}

/* ---------------------------
   Helpers: selezione post
--------------------------- */

function pickUnique(
  posts: CollectionEntry<"blog">[],
  usedKeys: Set<string>,
  n: number
): CollectionEntry<"blog">[] {
  const result: CollectionEntry<"blog">[] = [];
  for (const post of posts) {
    if (result.length >= n) break;
    const key = getKey(post);
    // lo slug resta necessario per costruire il link, la dedup usa `key`
    if (key && !usedKeys.has(key) && getSlug(post)) {
      result.push(post);
      usedKeys.add(key);
    }
  }
  return result;
}

/**
 * Preleva `n` post attingendo alle sorgenti in ordine di priorità, saltando
 * tutto ciò che è già stato assegnato a una sezione precedente (`usedKeys`).
 */
function takeUnique(
  n: number,
  usedKeys: Set<string>,
  ...sources: CollectionEntry<"blog">[][]
): CollectionEntry<"blog">[] {
  const result: CollectionEntry<"blog">[] = [];
  for (const source of sources) {
    if (result.length >= n) break;
    pickUnique(source, usedKeys, n - result.length).forEach((p) => result.push(p));
  }
  return result;
}

/* ---------------------------
   Data: carica e ordina post
--------------------------- */

let postsAll: CollectionEntry<"blog">[] = [];
try {
  postsAll = await getCollection("blog");
} catch {
  console.warn("[index] Nessun contenuto trovato in Content Collections");
}

const sortedPosts = postsAll
  .slice()
  .sort((a, b) => dateValue(b) - dateValue(a));

/* ---------------------------
   Filtro: solo post dal 2025 in poi
--------------------------- */

const MIN_DATE = new Date("2025-01-01T00:00:00.000Z");

const eligiblePosts = sortedPosts.filter((p) => {
  const d = getPublishDate(p);
  return d !== null && d >= MIN_DATE;
});

/** Post pubblicabile: niente bozze, niente contenuti di test, niente date future. */
const NOW = new Date();

function isPublished(post: CollectionEntry<"blog">): boolean {
  const { draft, status } = post.data;
  if (draft === true) return false;
  if (status === "draft" || status === "test") return false;
  const d = getPublishDate(post);
  return d !== null && d.getTime() <= NOW.getTime();
}

/* ---------------------------
   Categorie (singolo ciclo su postsAll)
--------------------------- */

type CategoryData = {
  slug: string;
  name: string;
  count: number;
  description?: string;
};

const categoryMap = new Map<string, CategoryData>();
for (const post of postsAll) {
  const cat = post.data.category;
  if (cat && typeof cat === "string" && cat.trim()) {
    const slug = cat.trim();
    const existing = categoryMap.get(slug);
    categoryMap.set(slug, {
      slug,
      name: slug.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" "),
      count: (existing?.count ?? 0) + 1,
    });
  }
}

/* Home: usa la stessa ossatura editoriale dell'header e della pagina Blog. */
const percorsi = PRIMARY_EDITORIAL_CATEGORY_SLUGS.map((slug) => categoryMap.get(slug)).filter(
  (c): c is CategoryData => c !== undefined && c.count > 0,
);

/** Una riga editoriale se il CMS non espone description sulla categoria */
const PERCORSI_FALLBACK_BLURB: Record<string, string> = {
  Normativa: "Leggi italiane, sentenze e quadro europeo.",
  "cbd-alimentazione": "Cannabidiolo, prodotti in commercio e uso consapevole.",
  "cannabis-news-it": "Notizie e sviluppi sul tema cannabis in Italia.",
  "canapa-e-ambiente": "Filiera, materiali, agricoltura e sostenibilità.",
};

const EDITORIAL_DISPLAY_NAME: Record<string, string> = {
  "cannabis-news-it": "Notizie",
  Normativa: "Normativa",
  "cbd-alimentazione": "CBD",
  "canapa-e-ambiente": "Canapa",
};

const CATEGORY_DISPLAY_NAME: Record<string, string> = {
  Normativa: "Normativa",
  "cbd-alimentazione": "CBD e alimentazione",
  "cannabis-news-it": "Cannabis News",
  "salute-benessere": "Salute e benessere",
  "guide-tutorial": "Guide e tutorial",
  "coltivazione-legale": "Coltivazione legale",
  "canapa-e-ambiente": "Canapa e ambiente",
};

function prettifySlug(slug: string): string {
  return slug
    .split("-")
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
}

/** Etichetta leggibile di una categoria reale; stringa vuota se assente. */
function categoryLabel(slug: unknown): string {
  if (typeof slug !== "string" || !slug.trim()) return "";
  const key = slug.trim();
  return CATEGORY_DISPLAY_NAME[key] ?? prettifySlug(key);
}

function percorsiDisplayName(cat: CategoryData): string {
  return EDITORIAL_DISPLAY_NAME[cat.slug] ?? cat.name;
}

function percorsiBlurb(cat: CategoryData, maxLen: number): string {
  const raw = cat.description?.trim();
  if (raw) {
    return raw.length > maxLen ? `${raw.slice(0, maxLen).trimEnd()}…` : raw;
  }
  return PERCORSI_FALLBACK_BLURB[cat.slug] ?? "Articoli e guide su questo tema.";
}

/* ---------------------------
   Selezione editoriale
   Candidabili: solo post pubblicati (no bozze, no contenuti di test, no date future)
   e con uno slug utilizzabile per il link.

   `usedKeys` è l'unica fonte di verità anti-duplicazione: è condiviso da tutte le
   sezioni e viene riempito in modo progressivo, così lo stesso `entry.id` non può
   comparire due volte nella pagina.

   Ordine di assegnazione: "In evidenza" per prima (così i post marcati
   `homeFeatured` mantengono la priorità redazionale), poi "In aggiornamento",
   infine "Ultimi articoli".
--------------------------- */

const publishablePosts = eligiblePosts.filter((p) => isPublished(p) && getSlug(p) !== "");

// Candidati manuali (homeFeatured === true): rank crescente, poi più recente
const featuredCandidatesManual = publishablePosts
  .filter((p) => p.data.homeFeatured === true)
  .sort((a, b) => {
    const rankA = a.data.homeFeaturedRank ?? 999;
    const rankB = b.data.homeFeaturedRank ?? 999;
    if (rankA !== rankB) return rankA - rankB;
    return dateValue(b) - dateValue(a);
  });

// Candidati automatici: categoria "cannabis-news-it", non già manuali
const manualKeys = new Set(featuredCandidatesManual.map(getKey));
const featuredCandidatesAuto = publishablePosts
  .filter((p) => p.data.category === "cannabis-news-it" && !manualKeys.has(getKey(p)))
  .sort((a, b) => dateValue(b) - dateValue(a));

// Pool deduplicato: manuali prima, poi auto
const featuredPool: CollectionEntry<"blog">[] = [];
const featuredPoolKeys = new Set<string>();
for (const post of [...featuredCandidatesManual, ...featuredCandidatesAuto]) {
  const key = getKey(post);
  if (key && !featuredPoolKeys.has(key)) {
    featuredPool.push(post);
    featuredPoolKeys.add(key);
  }
}

const usedKeys = new Set<string>();

// 1) In evidenza: 1 articolo principale + 3 correlati
const featuredPick = takeUnique(4, usedKeys, featuredPool, publishablePosts, eligiblePosts);
const featuredMain = featuredPick[0] ?? null;
const featuredSide = featuredPick.slice(1, 4);

// 2) In aggiornamento (hero): 3 titoli recenti non già usati
const updatesPosts = takeUnique(3, usedKeys, publishablePosts, eligiblePosts);

// 3) Ultimi articoli: 6 post non già usati
const latestPosts = takeUnique(6, usedKeys, publishablePosts, eligiblePosts);

/* ---------------------------
   Inizia da qui: gli stessi quattro nuclei editoriali dell'header
--------------------------- */

const START_HERE_META: Record<string, { desc: string; shape: string }> = {
  "/categoria/cannabis-news-it/": {
    desc: "Aggiornamenti e sviluppi sul tema cannabis in Italia.",
    shape: "square",
  },
  "/categoria/normativa/": {
    desc: "Leggi, sentenze e quadro europeo.",
    shape: "circle",
  },
  "/categoria/cbd-alimentazione/": {
    desc: "Prodotti, ricerca, sicurezza e regolamentazione.",
    shape: "diamond",
  },
  "/categoria/canapa-e-ambiente/": {
    desc: "Filiera, materiali, agricoltura e sostenibilità.",
    shape: "bar",
  },
};

const startHere = PRIMARY_NAVIGATION
  .filter((item) => item.href.startsWith("/categoria/"))
  .map((item) => ({
    href: item.href,
    title: item.label,
    ...START_HERE_META[item.href],
  }));

/* ---------------------------
   Page meta
--------------------------- */

const title = "Cannabis light, CBD e canapa in Italia | Notizie, normativa e guide - Canapalandia";
const description =
  "Osservatorio editoriale su cannabis light, CBD e canapa in Italia: normativa, notizie, guide e analisi per orientarti senza sensazionalismi.";
const canonical = `${import.meta.env.SITE || "https://canapalandia.com"}/`;
const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "Canapalandia",
      url: "https://canapalandia.com/",
      description: "Osservatorio editoriale su cannabis light, CBD e canapa in Italia",
      inLanguage: "it-IT",
    },
    {
      "@type": "Organization",
      name: "Canapalandia",
      url: "https://canapalandia.com/",
      description: "Osservatorio editoriale su cannabis light, CBD e canapa in Italia",
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Canapalandia",
          item: "https://canapalandia.com/",
        },
      ],
    },
  ],
};
---

<Layout title={title} description={description} canonical={canonical} shell={false}>
  <script type="application/ld+json" set:html={JSON.stringify(homeJsonLd)} />

  <div class="page-home hm">
    <!-- ===== HERO ===== -->
    <section class="hm-hero" aria-labelledby="hero-title">
      <div class="hm-wrap hm-hero__grid">
        <div class="hm-hero__intro">
          <p class="hm-eyebrow">
            <span class="hm-eyebrow__dot" aria-hidden="true"></span>
            Osservatorio indipendente su canapa e CBD
          </p>

          <h1 id="hero-title" class="hm-hero__title">
            Cannabis light, CBD e canapa, spiegate senza slogan.
          </h1>

          <p class="hm-hero__lead">
            Notizie verificate, normativa italiana ed europea, ricerca scientifica e guide
            pratiche. Quello che è legale oggi, cosa dicono gli studi e cosa resta da chiarire.
          </p>

          <div class="hm-hero__cta">
            <a class="hm-btn hm-btn--primary" href="#ultimi">
              Ultime notizie <span aria-hidden="true">→</span>
            </a>
            <a class="hm-btn hm-btn--ghost" href="#percorsi">Percorsi tematici</a>
          </div>
        </div>

        {updatesPosts.length > 0 && (
          <aside class="hm-updates" aria-labelledby="updates-title">
            <h2 id="updates-title" class="hm-updates__title">In aggiornamento</h2>
            <ul class="hm-updates__list">
              {updatesPosts.map((p) => (
                <li class="hm-updates__item">
                  <a class="hm-updates__link" href={postHref(p)}>
                    {categoryLabel(p.data.category) && (
                      <span class="hm-kicker">{categoryLabel(p.data.category)}</span>
                    )}
                    <span class="hm-updates__headline">{p.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>
    </section>

    <!-- ===== INIZIA DA QUI ===== -->
    <section class="hm-start" aria-labelledby="start-title">
      <div class="hm-wrap">
        <h2 id="start-title" class="hm-overline">Inizia da qui</h2>
        <div class="hm-start__grid">
          {startHere.map((item) => (
            <a class="hm-start__card" href={item.href}>
              <span class="hm-start__icon" aria-hidden="true">
                <span class={`hm-shape hm-shape--${item.shape}`}></span>
              </span>
              <span class="hm-start__body">
                <span class="hm-start__title">{item.title}</span>
                <span class="hm-start__desc">{item.desc}</span>
              </span>
              <span class="hm-start__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== PERCORSI TEMATICI ===== -->
    {percorsi.length > 0 && (
      <section id="percorsi" class="hm-paths" aria-labelledby="paths-title">
        <div class="hm-wrap">
          <div class="hm-paths__head">
            <div>
              <p class="hm-overline hm-overline--gold">Percorsi tematici</p>
              <h2 id="paths-title" class="hm-paths__title">Quattro strade per orientarti</h2>
            </div>
            <a class="hm-paths__all" href="/blog/">
              Esplora tutti gli argomenti <span aria-hidden="true">→</span>
            </a>
          </div>

          <div class="hm-paths__grid">
            {percorsi.map((cat, i) => (
              <a
                class="hm-paths__tile"
                href={`/categoria/${cat.slug}/`}
                aria-label={`${percorsiDisplayName(cat)}, ${cat.count} articoli`}
              >
                <span class="hm-paths__num" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="hm-paths__name">{percorsiDisplayName(cat)}</span>
                <span class="hm-paths__desc">{percorsiBlurb(cat, 88)}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ===== IN EVIDENZA ===== -->
    <section id="in-evidenza" class="hm-featured" aria-labelledby="featured-title">
      <div class="hm-wrap">
        <div class="hm-sechead">
          <h2 id="featured-title" class="hm-sechead__title">In evidenza</h2>
          <span class="hm-sechead__rule" aria-hidden="true"></span>
        </div>

        {featuredMain ? (
          <div class="hm-featured__grid">
            <article class="hm-lead">
              <a class="hm-lead__link" href={postHref(featuredMain)}>
                <span class="hm-lead__media">
                  <img
                    src={normalizeImage(featuredMain)}
                    alt={featuredMain.data.coverAlt || featuredMain.data.title}
                    width="800"
                    height="450"
                    loading="eager"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    onerror="this.onerror=null;this.src='/images/placeholder.svg';"
                  />
                </span>
                <span class="hm-lead__body">
                  <span class="hm-meta">
                    {categoryLabel(featuredMain.data.category) && (
                      <span class="hm-kicker">{categoryLabel(featuredMain.data.category)}</span>
                    )}
                    <span class="hm-meta__dot" aria-hidden="true"></span>
                    <span class="hm-meta__date">{formatDate(getPublishDate(featuredMain))}</span>
                  </span>
                  <span class="hm-lead__title">{featuredMain.data.title}</span>
                  {featuredMain.data.description && (
                    <span class="hm-lead__excerpt">{featuredMain.data.description}</span>
                  )}
                  <span class="hm-readmore">
                    Leggi l'analisi <span aria-hidden="true">→</span>
                  </span>
                </span>
              </a>
            </article>

            {featuredSide.length > 0 && (
              <div class="hm-side">
                <h3 class="hm-overline">Da leggere insieme</h3>
                <ul class="hm-side__list">
                  {featuredSide.map((p) => (
                    <li class="hm-side__item">
                      <a class="hm-side__link" href={postHref(p)}>
                        <span class="hm-side__thumb">
                          <img
                            src={normalizeImage(p)}
                            alt={p.data.coverAlt || p.data.title}
                            width="176"
                            height="132"
                            loading="lazy"
                            decoding="async"
                            referrerpolicy="no-referrer"
                            onerror="this.onerror=null;this.src='/images/placeholder.svg';"
                          />
                        </span>
                        <span class="hm-side__body">
                          {categoryLabel(p.data.category) && (
                            <span class="hm-kicker">{categoryLabel(p.data.category)}</span>
                          )}
                          <span class="hm-side__title">{p.data.title}</span>
                          <span class="hm-side__date">{formatDate(getPublishDate(p))}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ) : (
          <p class="hm-empty">Contenuti in importazione. Torna presto!</p>
        )}
      </div>
    </section>

    <!-- ===== ULTIMI ARTICOLI ===== -->
    <section id="ultimi" class="hm-latest" aria-labelledby="latest-title">
      <div class="hm-wrap">
        <div class="hm-sechead hm-sechead--split">
          <h2 id="latest-title" class="hm-sechead__title">Ultimi articoli</h2>
          <a class="hm-latest__all" href="/blog/">
            Archivio completo <span aria-hidden="true">→</span>
          </a>
        </div>

        {latestPosts.length > 0 ? (
          <div class="hm-latest__grid">
            {latestPosts.map((p) => (
              <article class="hm-card">
                <a class="hm-card__link" href={postHref(p)}>
                  <span class="hm-card__media">
                    <img
                      src={normalizeImage(p)}
                      alt={p.data.coverAlt || p.data.title}
                      width="400"
                      height="225"
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                      onerror="this.onerror=null;this.src='/images/placeholder.svg';"
                    />
                  </span>
                  <span class="hm-card__body">
                    <span class="hm-meta">
                      {categoryLabel(p.data.category) && (
                        <span class="hm-kicker">{categoryLabel(p.data.category)}</span>
                      )}
                      <span class="hm-meta__dot" aria-hidden="true"></span>
                      <span class="hm-meta__date">{formatDateShort(getPublishDate(p))}</span>
                    </span>
                    <span class="hm-card__title">{p.data.title}</span>
                    {p.data.description && (
                      <span class="hm-card__excerpt">{p.data.description}</span>
                    )}
                    <span class="hm-readmore hm-card__more">
                      Leggi <span aria-hidden="true">→</span>
                    </span>
                  </span>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <p class="hm-empty">Contenuti in importazione. Torna presto!</p>
        )}
      </div>
    </section>

    <HomeActionCards />
  </div>

  <style>
    /* ============================================================
       Homepage — design approvato (Claude Design "Canapalandia Homepage")
       Palette crema in light, adattamento verde profondo in dark.
       Tutti i token sono locali alla home: nessuna pagina interna è toccata.
    ============================================================ */

    :global(html:has(.hm)) {
      /* Superfici */
      --hm-bg: #f6f2e7;
      --hm-surface: #fffdf7;
      --hm-surface-2: #ede7d6;
      --hm-band: #1b3d23;
      --hm-band-hover: #23502c;

      /* Bordi */
      --hm-border: #e3dcc9;
      --hm-border-strong: #d6ceb8;
      --hm-rule: #ded6c2;

      /* Testo */
      --hm-heading: #16281a;
      --hm-text: #1c2a1e;
      --hm-body: #4a5a4c;
      --hm-soft: #5f6e60;
      --hm-faint: #62705f;

      /* Accenti */
      --hm-green: #1f4a2c;
      --hm-green-hover: #2b6139;
      --hm-olive: #6e8b3d;
      --hm-olive-text: #55702c;
      --hm-gold: #c6a15b;
      /* Colore dei link testuali: separato dal fondo dei bottoni, così resta
         leggibile anche quando le superfici diventano scure */
      --hm-link: #1f4a2c;
      --hm-link-hover: #55702c;

      /* Testo sulla fascia scura */
      --hm-band-title: #fffdf7;
      --hm-band-body: #bfcdbb;
      --hm-band-num: #9fb79a;
      --hm-band-gold: #d8b978;
      --hm-band-line: rgba(255, 253, 247, 0.16);

      --hm-shadow-sm: 0 1px 2px rgba(28, 42, 30, 0.05);
      --hm-shadow-lg: 0 1px 2px rgba(28, 42, 30, 0.05), 0 18px 40px -28px rgba(28, 42, 30, 0.35);
    }

    /* Dark: stessa struttura su superfici verde profondo (non un'inversione) */
    :global(html[data-theme="dark"]:has(.hm)) {
      --hm-bg: #14261b;
      --hm-surface: #1b3d23;
      --hm-surface-2: #16301c;
      --hm-band: #101e15;
      --hm-band-hover: #17301f;

      --hm-border: #2e4a35;
      --hm-border-strong: #3a5a42;
      --hm-rule: #2e4a35;

      --hm-heading: #f4f2e6;
      --hm-text: #efede0;
      --hm-body: #c6d3c2;
      --hm-soft: #bfcdbb;
      --hm-faint: #9fb79a;

      --hm-green: #2b6139;
      --hm-green-hover: #35744a;
      --hm-olive: #8fb05a;
      --hm-olive-text: #9dc063;
      --hm-gold: #d8b978;
      --hm-link: #9dc063;
      --hm-link-hover: #bcd98a;

      --hm-band-title: #fffdf7;
      --hm-band-body: #bfcdbb;
      --hm-band-num: #9fb79a;
      --hm-band-gold: #d8b978;
      --hm-band-line: rgba(255, 253, 247, 0.14);

      --hm-shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.28);
      --hm-shadow-lg: 0 1px 2px rgba(0, 0, 0, 0.3), 0 18px 40px -28px rgba(0, 0, 0, 0.7);
    }

    /* Sfondo pagina + header allineati alla palette della home */
    :global(html:has(.hm) body) {
      background: var(--hm-bg);
    }

    :global(body:has(.hm) .site-header) {
      background: color-mix(in srgb, var(--hm-bg) 88%, transparent);
      border-bottom-color: var(--hm-border);
    }

    :global(body:has(.hm) .site-header .nav a),
    :global(body:has(.hm) .site-header .search),
    :global(body:has(.hm) .site-header .menu-toggle),
    :global(body:has(.hm) .site-header .theme-toggle__btn) {
      color: var(--hm-text);
    }

    :global(body:has(.hm) .nav a:hover) {
      background: var(--hm-surface-2);
      color: var(--hm-link);
      box-shadow: none;
    }

    /* Su mobile main#contenuto aggiunge padding: la home lo gestisce da sé */
    @media (max-width: 767px) {
      :global(main#contenuto:has(.hm)) {
        padding-inline: 0 !important;
      }
    }

    .hm {
      font-family: var(--font-ui);
      color: var(--hm-text);
      background: var(--hm-bg);
      overflow-x: hidden;
    }

    .hm-wrap {
      max-width: 1200px;
      margin-inline: auto;
      padding-inline: clamp(16px, 4vw, 40px);
    }

    /* ----- Elementi condivisi ----- */

    /* Etichette di servizio: restano in Archivo anche se rese come h2/h3
       (la regola globale su h1-h3 imposta il serif editoriale). */
    .hm-overline,
    .hm-updates__title {
      font-family: var(--font-ui);
    }

    .hm-overline {
      margin: 0 0 16px;
      font-size: 12.5px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--hm-faint);
    }

    .hm-overline--gold {
      margin: 0 0 8px;
      color: var(--hm-band-gold);
    }

    .hm-kicker {
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--hm-olive-text);
    }

    .hm-meta {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
      flex-wrap: wrap;
    }

    .hm-meta__dot {
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: var(--hm-border-strong);
      flex-shrink: 0;
    }

    .hm-meta__date {
      font-size: 11.5px;
      font-weight: 500;
      letter-spacing: 0.04em;
      color: var(--hm-faint);
      white-space: nowrap;
    }

    .hm-readmore {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 14.5px;
      font-weight: 600;
      color: var(--hm-link);
      white-space: nowrap;
    }

    .hm-empty {
      margin: 0;
      padding: 24px;
      border: 1px solid var(--hm-border);
      border-radius: 14px;
      background: var(--hm-surface);
      color: var(--hm-body);
    }

    .hm-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      min-height: 48px;
      padding: 0 22px;
      border-radius: 999px;
      border: 1px solid transparent;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;
      transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    .hm-btn--primary {
      background: var(--hm-green);
      color: #fffdf7;
    }

    .hm-btn--primary:hover {
      background: var(--hm-green-hover);
      color: #fffdf7;
    }

    .hm-btn--ghost {
      background: transparent;
      border-color: var(--hm-border-strong);
      color: var(--hm-link);
    }

    .hm-btn--ghost:hover {
      background: var(--hm-surface-2);
      color: var(--hm-link-hover);
    }

    /* I link della home sono <a>: la regola globale
       `html[data-theme="light"] a:not(.btn)...` di app.css ha specificità
       superiore e forzerebbe il colore del testo a --ink-light. */
    .hm-btn--primary,
    .hm-btn--primary:hover {
      color: #fffdf7 !important;
    }

    .hm-btn--ghost,
    .hm-latest__all {
      color: var(--hm-link) !important;
    }

    .hm-btn--ghost:hover,
    .hm-latest__all:hover {
      color: var(--hm-link-hover) !important;
    }

    .hm-paths__all {
      color: var(--hm-band-gold) !important;
    }

    .hm-paths__all:hover {
      color: #e8d3a4 !important;
    }

    .hm :where(a):focus-visible {
      outline: 2px solid var(--hm-link);
      outline-offset: 3px;
      border-radius: 4px;
    }

    /* ----- Hero ----- */

    .hm-hero {
      padding-block: clamp(36px, 6vw, 76px) clamp(28px, 4vw, 52px);
    }

    .hm-hero__grid {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: clamp(28px, 5vw, 72px);
      align-items: start;
    }

    .hm-eyebrow {
      margin: 0 0 18px;
      display: inline-flex;
      align-items: center;
      gap: 9px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--hm-olive-text);
    }

    .hm-eyebrow__dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--hm-olive);
      display: block;
      flex: 0 0 auto;
    }

    .hm-hero__title {
      margin: 0;
      font-family: var(--font-editorial);
      font-weight: 700;
      font-size: clamp(34px, 4.6vw, 60px);
      line-height: 1.04;
      letter-spacing: -0.024em;
      color: var(--hm-heading);
      max-width: 19ch;
      text-wrap: balance;
    }

    .hm-hero__lead {
      margin: 20px 0 0;
      font-size: clamp(16.5px, 1.3vw, 19px);
      line-height: 1.58;
      color: var(--hm-body);
      max-width: 52ch;
      text-wrap: pretty;
    }

    .hm-hero__cta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 30px;
    }

    .hm-updates {
      background: var(--hm-surface);
      border: 1px solid var(--hm-border);
      border-radius: 16px;
      padding: 22px 24px 8px;
      box-shadow: var(--hm-shadow-sm);
    }

    .hm-updates__title {
      margin: 0 0 4px;
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      color: var(--hm-faint);
    }

    .hm-updates__list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .hm-updates__item {
      border-top: 1px solid var(--hm-surface-2);
      padding: 15px 0;
    }

    .hm-updates__link {
      display: block;
      text-decoration: none;
    }

    .hm-updates__headline {
      display: block;
      margin-top: 5px;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.32;
      letter-spacing: -0.006em;
      color: var(--hm-text);
      text-wrap: pretty;
    }

    .hm-updates__link:hover .hm-updates__headline {
      color: var(--hm-link);
    }

    /* ----- Inizia da qui ----- */

    .hm-start {
      padding-bottom: clamp(40px, 6vw, 76px);
    }

    .hm-start__grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }

    .hm-start__card {
      display: flex;
      align-items: center;
      gap: 14px;
      min-height: 76px;
      padding: 16px 18px;
      background: var(--hm-surface);
      border: 1px solid var(--hm-border);
      border-radius: 12px;
      text-decoration: none;
      transition: border-color 0.2s ease;
    }

    .hm-start__card:hover {
      border-color: var(--hm-olive);
    }

    .hm-start__icon {
      flex: 0 0 auto;
      width: 34px;
      height: 34px;
      border-radius: 9px;
      background: color-mix(in srgb, var(--hm-olive) 16%, var(--hm-surface));
      display: grid;
      place-items: center;
    }

    .hm-shape {
      display: block;
      width: 12px;
      height: 12px;
      border: 2px solid var(--hm-green);
    }

    html[data-theme="dark"] .hm-shape {
      border-color: var(--hm-olive);
    }

    .hm-shape--circle {
      border-radius: 50%;
    }

    .hm-shape--diamond {
      width: 11px;
      height: 11px;
      transform: rotate(45deg);
    }

    .hm-shape--bar {
      width: 14px;
      height: 2px;
      border: 0;
      background: var(--hm-green);
    }

    html[data-theme="dark"] .hm-shape--bar {
      background: var(--hm-olive);
    }

    .hm-start__body {
      flex: 1 1 auto;
      min-width: 0;
    }

    .hm-start__title {
      display: block;
      font-size: 15.5px;
      font-weight: 600;
      color: var(--hm-text);
    }

    .hm-start__desc {
      display: block;
      margin-top: 3px;
      font-size: 13px;
      line-height: 1.4;
      color: var(--hm-soft);
    }

    .hm-start__arrow {
      flex: 0 0 auto;
      color: var(--hm-olive-text);
      font-size: 16px;
    }

    /* ----- Percorsi tematici (fascia scura) ----- */

    .hm-paths {
      background: var(--hm-band);
      padding-block: clamp(44px, 6vw, 72px);
    }

    .hm-paths__head {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: clamp(24px, 3vw, 38px);
    }

    .hm-paths__title {
      margin: 0;
      font-family: var(--font-editorial);
      font-weight: 600;
      font-size: clamp(24px, 2.6vw, 34px);
      line-height: 1.12;
      letter-spacing: -0.012em;
      color: var(--hm-band-title);
    }

    .hm-paths__all {
      font-size: 14.5px;
      font-weight: 600;
      color: var(--hm-band-gold);
      text-decoration: none;
      white-space: nowrap;
    }

    .hm-paths__all:hover {
      color: #e8d3a4;
    }

    .hm-paths__grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1px;
      background: var(--hm-band-line);
    }

    .hm-paths__tile {
      display: block;
      padding: clamp(20px, 2.4vw, 28px) clamp(16px, 2vw, 24px);
      background: var(--hm-band);
      min-height: 150px;
      text-decoration: none;
      transition: background 0.2s ease;
    }

    .hm-paths__tile:hover {
      background: var(--hm-band-hover);
    }

    .hm-paths__num {
      display: block;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: var(--hm-band-num);
    }

    .hm-paths__name {
      display: block;
      margin-top: 12px;
      font-family: var(--font-editorial);
      font-size: 21px;
      font-weight: 600;
      letter-spacing: -0.008em;
      color: var(--hm-band-title);
    }

    .hm-paths__desc {
      display: block;
      margin-top: 8px;
      font-size: 13.5px;
      line-height: 1.5;
      color: var(--hm-band-body);
    }

    /* ----- Intestazioni di sezione ----- */

    .hm-sechead {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: clamp(22px, 3vw, 32px);
    }

    .hm-sechead--split {
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .hm-sechead__title {
      margin: 0;
      font-family: var(--font-editorial);
      font-weight: 600;
      font-size: clamp(25px, 2.7vw, 36px);
      line-height: 1.08;
      letter-spacing: -0.014em;
      color: var(--hm-heading);
    }

    .hm-sechead__rule {
      flex: 1 1 auto;
      height: 1px;
      background: var(--hm-rule);
      display: block;
    }

    /* ----- In evidenza ----- */

    .hm-featured {
      padding-block: clamp(44px, 6vw, 84px) clamp(24px, 3vw, 40px);
    }

    .hm-featured__grid {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: clamp(24px, 3.5vw, 48px);
      align-items: start;
    }

    .hm-lead {
      background: var(--hm-surface);
      border: 1px solid var(--hm-border);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: var(--hm-shadow-lg);
    }

    .hm-lead__link {
      display: block;
      text-decoration: none;
    }

    .hm-lead__media {
      display: block;
      aspect-ratio: 16 / 9;
      background: var(--hm-surface-2);
      overflow: hidden;
    }

    .hm-lead__media img,
    .hm-card__media img,
    .hm-side__thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .hm-lead__body {
      display: block;
      padding: clamp(20px, 2.4vw, 30px);
    }

    .hm-lead__title {
      display: block;
      margin-top: 12px;
      font-family: var(--font-editorial);
      font-size: clamp(24px, 2.4vw, 34px);
      font-weight: 700;
      line-height: 1.14;
      letter-spacing: -0.018em;
      color: var(--hm-heading);
      text-wrap: pretty;
    }

    .hm-lead__excerpt {
      display: block;
      margin-top: 14px;
      font-size: 16.5px;
      line-height: 1.62;
      color: var(--hm-body);
      max-width: 58ch;
      text-wrap: pretty;
    }

    .hm-lead__link:hover .hm-lead__title {
      color: var(--hm-link);
    }

    .hm-lead .hm-readmore {
      margin-top: 18px;
    }

    .hm-side__list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .hm-side__item {
      border-top: 1px solid var(--hm-rule);
      padding: 18px 0;
    }

    .hm-side__item:last-child {
      border-bottom: 1px solid var(--hm-rule);
    }

    .hm-side__link {
      display: flex;
      gap: 14px;
      align-items: flex-start;
      text-decoration: none;
    }

    .hm-side__thumb {
      flex: 0 0 88px;
      aspect-ratio: 4 / 3;
      border-radius: 8px;
      background: var(--hm-surface-2);
      overflow: hidden;
    }

    .hm-side__body {
      flex: 1 1 auto;
      min-width: 0;
    }

    .hm-side__title {
      display: block;
      margin-top: 5px;
      font-size: 15.5px;
      font-weight: 600;
      line-height: 1.34;
      letter-spacing: -0.006em;
      color: var(--hm-text);
      text-wrap: pretty;
    }

    .hm-side__link:hover .hm-side__title {
      color: var(--hm-link);
    }

    .hm-side__date {
      display: block;
      margin-top: 6px;
      font-size: 12.5px;
      color: var(--hm-faint);
    }

    /* ----- Ultimi articoli ----- */

    .hm-latest {
      padding-block: clamp(32px, 4vw, 56px) clamp(40px, 6vw, 76px);
    }

    .hm-latest__all {
      font-size: 14.5px;
      font-weight: 600;
      color: var(--hm-link);
      text-decoration: none;
      white-space: nowrap;
    }

    .hm-latest__all:hover {
      color: var(--hm-link-hover);
    }

    .hm-latest__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(18px, 2.2vw, 28px);
    }

    .hm-card {
      display: flex;
      flex-direction: column;
      background: var(--hm-surface);
      border: 1px solid var(--hm-border);
      border-radius: 14px;
      overflow: hidden;
      box-shadow: var(--hm-shadow-sm);
      transition: border-color 0.2s ease;
    }

    .hm-card:hover {
      border-color: var(--hm-border-strong);
    }

    .hm-card__link {
      display: flex;
      flex-direction: column;
      height: 100%;
      text-decoration: none;
    }

    .hm-card__media {
      display: block;
      aspect-ratio: 16 / 9;
      background: var(--hm-surface-2);
      overflow: hidden;
    }

    .hm-card__body {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
      gap: 10px;
      padding: clamp(18px, 1.8vw, 24px);
    }

    .hm-card__title {
      display: block;
      font-family: var(--font-editorial);
      font-size: 20.5px;
      font-weight: 600;
      line-height: 1.26;
      letter-spacing: -0.011em;
      color: var(--hm-heading);
      text-wrap: pretty;
    }

    .hm-card__link:hover .hm-card__title {
      color: var(--hm-link);
    }

    .hm-card__excerpt {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      font-size: 14.5px;
      line-height: 1.6;
      color: var(--hm-body);
      text-wrap: pretty;
    }

    .hm-card__more {
      margin-top: auto;
      padding-top: 12px;
      font-size: 14px;
    }

    /* ----- Breakpoint ----- */

    @media (max-width: 1023px) {
      .hm-hero__grid {
        grid-template-columns: 1fr;
      }

      .hm-hero__title {
        max-width: 24ch;
      }

      .hm-start__grid,
      .hm-paths__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .hm-featured__grid {
        grid-template-columns: 1fr;
      }

      .hm-latest__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 599px) {
      .hm-hero__title {
        max-width: none;
      }

      .hm-hero__cta {
        flex-direction: column;
        align-items: stretch;
      }

      .hm-start__grid,
      .hm-paths__grid,
      .hm-latest__grid {
        grid-template-columns: 1fr;
      }

      .hm-paths__tile {
        min-height: 0;
      }

      .hm-updates {
        padding: 18px 18px 6px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .hm * {
        transition: none !important;
      }
    }
  </style>
</Layout>
