---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../layouts/MigratedLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import CardPost from "../components/CardPost.astro";
import { ADS_SLOT_HOME } from "../lib/consts";

/* ---------------------------
   Data: Content Collections
--------------------------- */

// Helper per formattare data (accetta Date/string/number/null/undefined, non crasha mai)
const formatDate = (value: Date | string | number | null | undefined): string => {
  if (!value) return "";
  const d = value instanceof Date ? value : new Date(String(value));
  if (Number.isNaN(d.getTime())) return "";
  return d.toLocaleDateString("it-IT", { year: "numeric", month: "long", day: "numeric" });
};

function postHref(entry: any): string {
  const slug = entry?.slug ?? entry?.data?.slug ?? "";
  if (!slug) throw new Error("Missing slug for post link");
  return `/blog/${slug}/`;
}

function dateOf(entry: CollectionEntry<"blog">): Date | null {
  const raw = entry.data.publishDate ?? entry.data.updatedDate;
  if (!raw) return null;
  const d = raw instanceof Date ? raw : new Date(String(raw));
  return Number.isNaN(d.getTime()) ? null : d;
}

// Helper per convertire Date/string/number/null/undefined in timestamp
function dateValue(v: Date | string | number | null | undefined): number {
  if (!v) return 0;
  if (v instanceof Date) return v.getTime();
  const d = new Date(String(v));
  return Number.isNaN(d.getTime()) ? 0 : d.getTime();
}

// Helper per normalizzare URL/path immagine
function normalizeImgSrc(src: unknown): string {
  const s = typeof src === "string" ? src.trim() : "";
  // Se vuota/null: fallback a placeholder
  if (!s) return "/images/placeholder.svg";
  // Se URL assoluto (http/https): restituisci invariato
  if (s.startsWith("http://") || s.startsWith("https://")) return s;
  // Se inizia con "/": ok (path locale)
  if (s.startsWith("/")) return s;
  // Altrimenti: aggiungi "/" davanti (normalizza path relativo)
  return `/${s}`;
}

// Helper per normalizzare immagine post
function normalizeImage(entry: CollectionEntry<"blog">): string {
  // Leggi entry.data.image o entry.data.coverImage
  const raw = entry.data.image || entry.data.coverImage || "";
  
  // Supporta sia stringa sia oggetto con .src (ImageMetadata)
  let srcValue: unknown = raw;
  
  if (raw && typeof raw === "object" && raw !== null && "src" in raw) {
    const srcObj = raw as { src?: unknown };
    srcValue = srcObj.src;
  }
  
  // Applica normalizzazione
  return normalizeImgSrc(srcValue);
}

// Carica tutti i post dalla collection
let postsAll: CollectionEntry<"blog">[] = [];
try {
  postsAll = await getCollection("blog");
} catch (err) {
  // Se non ci sono contenuti, postsAll rimane vuoto
  console.warn("[index] Nessun contenuto trovato in Content Collections");
}

// Ordina per publishDate DESC
const sortedPosts = postsAll
  .slice()
  .sort(
    (a, b) =>
      dateValue(b.data.publishDate ?? b.data.updatedDate) -
      dateValue(a.data.publishDate ?? a.data.updatedDate),
  );

/* ---------------------------
   Filtro "recent only" (2025-2026)
--------------------------- */

// Helper: estrae la data del post (updatedDate o publishDate)
function getPostDate(post: CollectionEntry<"blog">): Date | null {
  const raw = post.data.updatedDate ?? post.data.publishDate;
  if (!raw) return null;
  const d = raw instanceof Date ? raw : new Date(String(raw));
  return Number.isNaN(d.getTime()) ? null : d;
}

// Helper: estrae lo slug del post
function getSlug(post: CollectionEntry<"blog">): string {
  return post.slug ?? post.data.slug ?? "";
}

// Soglia minima: solo post dal 2025 in poi
const MIN_DATE = new Date("2025-01-01T00:00:00.000Z");

// Filtra post eligibili (>= 2025-01-01)
const eligiblePosts = sortedPosts.filter((p) => {
  const postDate = getPostDate(p);
  return postDate && postDate >= MIN_DATE;
});

/* ---------------------------
   Selezione "In evidenza" (editoriale)
--------------------------- */

// Helper: seleziona N post unici da un array, escludendo quelli già usati
function pickUnique(
  posts: CollectionEntry<"blog">[],
  usedSet: Set<string>,
  n: number
): CollectionEntry<"blog">[] {
  const result: CollectionEntry<"blog">[] = [];
  for (const post of posts) {
    if (result.length >= n) break;
    const slug = getSlug(post);
    if (slug && !usedSet.has(slug)) {
      result.push(post);
      usedSet.add(slug);
    }
  }
  return result;
}

// 1) Post con flag editoriale manuale (solo da eligiblePosts)
const featuredCandidatesManual = eligiblePosts
  .filter((p) => p.data.homeFeatured === true)
  .sort((a, b) => {
    // Ordina per homeFeaturedRank (asc, più basso = più importante), poi per data (desc)
    const rankA = a.data.homeFeaturedRank ?? 999;
    const rankB = b.data.homeFeaturedRank ?? 999;
    if (rankA !== rankB) return rankA - rankB;
    const dateA = getPostDate(a);
    const dateB = getPostDate(b);
    if (!dateA || !dateB) return 0;
    return dateB.getTime() - dateA.getTime();
  });

// 2) Fallback automatico: post "hot" (cannabis-news-it, ordinati per data desc)
const featuredCandidatesAuto = eligiblePosts
  .filter((p) => {
    const category = p.data.category;
    return (
      category === "cannabis-news-it" &&
      p.data.homeFeatured !== true // Escludi quelli già manuali
    );
  })
  .sort((a, b) => {
    const dateA = getPostDate(a);
    const dateB = getPostDate(b);
    if (!dateA || !dateB) return 0;
    return dateB.getTime() - dateA.getTime();
  });

// 3) Costruisci pool: manuali prima, poi auto (dedup per slug)
const featuredPool: CollectionEntry<"blog">[] = [];
const featuredPoolSlugs = new Set<string>();
for (const post of [...featuredCandidatesManual, ...featuredCandidatesAuto]) {
  const slug = getSlug(post);
  if (slug && !featuredPoolSlugs.has(slug)) {
    featuredPool.push(post);
    featuredPoolSlugs.add(slug);
  }
}

// 4) Seleziona 4 post unici (1 main + 3 side)
const featuredIds = new Set<string>();
const featuredMain = pickUnique(featuredPool, featuredIds, 1)[0] || null;
const featuredSide = pickUnique(featuredPool, featuredIds, 3);

// 5) Se il pool non basta, completa con i più recenti di eligiblePosts (sempre dedup)
if (featuredIds.size < 4) {
  const remaining = eligiblePosts
    .filter((p) => {
      const slug = getSlug(p);
      return slug && !featuredIds.has(slug);
    })
    .slice(0, 4 - featuredIds.size);
  
  if (!featuredMain && remaining.length > 0) {
    const first = remaining[0];
    const slug = getSlug(first);
    if (slug) {
      featuredIds.add(slug);
    }
  }
  
  for (const post of remaining) {
    if (featuredSide.length >= 3) break;
    const slug = getSlug(post);
    if (slug && !featuredIds.has(slug)) {
      featuredSide.push(post);
      featuredIds.add(slug);
    }
  }
}

// 6) "Ultimi articoli": escludi quelli già in evidenza (solo da eligiblePosts)
const latestPosts = eligiblePosts
  .filter((p) => {
    const slug = getSlug(p);
    return slug && !featuredIds.has(slug);
  })
  .slice(0, 6);

/* ---------------------------
   Mappa icone SVG per categoria
--------------------------- */
function getCategoryIcon(slug: string): string {
  const iconMap: Record<string, string> = {
    "normative-aspetti-legali": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3v18M6 7h12M7 7l-3 6h6l-3-6zM17 7l-3 6h6l-3-6zM6 21h12"></path>
    </svg>`,
    "salute-benessere": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"></path>
    </svg>`,
    "cannabis-news-it": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
      <path d="M8 8h8M8 12h8M8 16h6"></path>
    </svg>`,
    "coltivazione-legale": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2v4M4.93 4.93l2.83 2.83M2 12h4M4.93 19.07l2.83-2.83M12 22v-4M19.07 19.07l-2.83-2.83M22 12h-4M19.07 4.93l-2.83 2.83M12 6a6 6 0 0 1 6 6 6 6 0 0 1-6 6 6 6 0 0 1-6-6 6 6 0 0 1 6-6z"></path>
    </svg>`,
    "guide-tutorial": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
      <path d="M9 10h6M9 14h4"></path>
    </svg>`,
    "partner-e-affiliazioni": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
      <circle cx="9" cy="7" r="4"></circle>
      <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>
    </svg>`,
    "canapa-e-ambiente": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
    </svg>`,
    "cbd": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2s7 7 7 13a7 7 0 0 1-14 0c0-6 7-13 7-13zM9.5 14.5c1 1.2 4 1.2 5 0"></path>
    </svg>`,
  };
  return iconMap[slug] || `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
  </svg>`;
}

/* ---------------------------
   Carica categorie da Content Collections o JSON
--------------------------- */
type CategoryData = {
  slug: string;
  name: string;
  count: number;
  description?: string;
};

// Estrai categorie dai post
const categoryMap = new Map<string, { slug: string; name: string; count: number }>();
for (const post of postsAll) {
  const cat = post.data.category;
  if (cat && typeof cat === "string" && cat.trim()) {
    const slug = cat.trim();
    const existing = categoryMap.get(slug);
    categoryMap.set(slug, {
      slug,
      name: slug.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" "),
      count: (existing?.count || 0) + 1,
    });
  }
}

// Unisci categorie (per ora usa solo quelle dai post, categories.json verrà generato dallo script)
const allCategories = new Map<string, CategoryData>();
for (const [slug, data] of categoryMap) {
  allCategories.set(slug, data);
}

// Categorie principali da mostrare (priorità)
const mainCategorySlugs = [
  "normative-aspetti-legali",
  "salute-benessere",
  "cannabis-news-it",
  "coltivazione-legale",
  "guide-tutorial",
  "partner-e-affiliazioni",
  "canapa-e-ambiente",
  "cbd",
];

const mainCategories: CategoryData[] = [];
for (const slug of mainCategorySlugs) {
  const cat = allCategories.get(slug);
  if (cat) {
    mainCategories.push(cat);
  }
}

// Aggiungi altre categorie con count > 0 (max 10 totali)
const otherCategories = Array.from(allCategories.values())
  .filter((c) => !mainCategorySlugs.includes(c.slug) && c.count > 0)
  .sort((a, b) => b.count - a.count)
  .slice(0, Math.max(0, 10 - mainCategories.length));

const displayCategories = [...mainCategories, ...otherCategories].filter((c) => c.count > 0);

/* ---------------------------
   Page meta
--------------------------- */

const heroBgVar = "none";
const title = "Canapalandia — Cannabis light, CBD e canapa legale in Italia";
const canonical = `${import.meta.env.SITE || "https://canapalandia.com"}/`;
---

<Layout title={title} canonical={canonical} shell={false}>
  <section class="hero" style={`--hero-bg:${heroBgVar}`}>
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="container hero-inner">
      <p class="kicker">Cannabis legale • CBD • Canapa industriale</p>

      <h1>
        Cannabis light e CBD in Italia: guida chiara e legale
      </h1>

      <p class="lead">
        Normative, sentenze e filiera spiegate senza sensazionalismo. Fonti e contesto, sempre.
      </p>

      <div class="hero-cta">
        <a class="btn primary" href="/#percorsi">Inizia dalla guida legale</a>
        <a class="btn ghost" href="/#ultimi">Leggi le ultime notizie</a>
      </div>

      <div class="hero-links">
        <a class="hero-link" href="/blog/">Vai al blog</a>
        <span aria-hidden="true">·</span>
        <a class="hero-link" href="/cerca/">Cerca un argomento</a>
      </div>

      <ul class="trust" aria-label="Punti chiave">
        <li>Focus Italia</li>
        <li>Fonti e contesto</li>
        <li>Aggiornato</li>
        <li>No promozione illegalità</li>
      </ul>
    </div>
  </section>

  <section id="percorsi" class="section">
    <div class="container">
      <div class="section-head">
        <h2>Percorsi tematici</h2>
        <p class="section-lead">
          Entra subito nell’area giusta: normative, benessere, filiera e
          approfondimenti.
        </p>
      </div>

      <div class="grid cards">
        {displayCategories.map((cat) => (
          <a class="card card--topic" href={cat.slug ? `/categoria/${cat.slug}/` : "/"}>
            <span class="card-icon" aria-hidden="true" set:html={getCategoryIcon(cat.slug)}></span>
            <div class="card--topic__content">
              <div class="card--topic__header">
                <h3>{cat.name}</h3>
                {cat.count > 0 ? (
                  <span class="card--topic__count">{cat.count}</span>
                ) : null}
              </div>
              {cat.description ? (
                <p>{cat.description.length > 100 ? cat.description.substring(0, 100) + "..." : cat.description}</p>
              ) : (
                <p>Esplora tutti gli articoli di questa categoria.</p>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="container">
    <AdSlot slot={ADS_SLOT_HOME} label="Pubblicità" />
  </div>

  <section id="in-evidenza" class="section alt">
    <div class="container">
      <div class="section-head">
        <h2>In evidenza</h2>
        <p class="section-lead">
          Una guida “pilastro” e tre letture correlate per farti un quadro
          completo.
        </p>
      </div>

      {eligiblePosts.length > 0 ? (
        <div class="grid featured">
          {featuredMain ? (
            <a class="feature-main" href={postHref(featuredMain)}>
              <p class="badge">Tema caldo</p>

              {(() => {
                const imgSrc = normalizeImage(featuredMain);
                return imgSrc ? (
                  <img
                    class="feature-img"
                    src={imgSrc}
                    alt={featuredMain.data.coverAlt || featuredMain.data.title}
                    loading="eager"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    onerror="this.onerror=null;this.src='/images/placeholder.svg';"
                  />
                ) : (
                  <div
                    class="feature-img feature-img--placeholder"
                    aria-hidden="true"
                  />
                );
              })()}

              <h3 class="feature-title">{featuredMain.data.title}</h3>
              <p class="feature-excerpt">
                {featuredMain.data.description}
              </p>
              <span class="btn small">Leggi</span>
            </a>
          ) : (
            <div class="feature-main">
              <p>
                {eligiblePosts.length === 0
                  ? "Nessun contenuto recente disponibile (2025-2026)."
                  : "Selezione in evidenza in arrivo."}
              </p>
            </div>
          )}

          <div class="feature-side">
            {featuredSide.map((p) => {
              const imgSrc = normalizeImage(p);
              return (
                <a class="mini" href={postHref(p)}>
                  {imgSrc ? (
                    <img
                      class="mini-img"
                      src={imgSrc}
                      alt={p.data.coverAlt || p.data.title}
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                      onerror="this.onerror=null;this.src='/images/placeholder.svg';"
                    />
                  ) : (
                    <div
                      class="mini-img mini-img--placeholder"
                      aria-hidden="true"
                    />
                  )}

                <div class="mini-body">
                  <h3 class="mini-title">{p.data.title}</h3>
                  <p class="mini-excerpt">{(p.data.description || "").slice(0, 90)}</p>
                  <span class="mini-link">Leggi</span>
                </div>
              </a>
            );
            })}
          </div>
        </div>
      ) : (
        <div class="card">
          <p>Contenuti in importazione. Torna presto!</p>
        </div>
      )}
    </div>
  </section>

  <section id="ultimi" class="section">
    <div class="container">
      <div class="section-head">
        <h2>Ultimi articoli</h2>
        <p class="section-lead">
          Aggiornamenti e analisi. Scegli cosa leggere in base al tema.
        </p>
      </div>

      {latestPosts.length > 0 ? (
        <div class="grid">
          {latestPosts.map((p) => {
            const imgSrc = normalizeImage(p);
            return (
              <CardPost
                href={postHref(p)}
                img={imgSrc || undefined}
                date={formatDate(dateOf(p))}
                title={p.data.title}
                excerpt={p.data.description}
                category={p.data.category || null}
              />
            );
          })}
        </div>
      ) : (
        <div class="card">
          <p>Contenuti in importazione. Torna presto!</p>
        </div>
      )}

      <div class="section-cta">
        <a class="btn ghost" href="/blog/">Vai al blog</a>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <h2>Ribaltatore AI</h2>
        <p class="section-lead">
          Scrivi una frase proibizionista e ottieni una risposta ironica e antiproibizionista, pronta da copiare e condividere.
        </p>
      </div>
      <div class="section-cta">
        <a class="btn primary" href="/ribaltatore/">Prova il Ribaltatore</a>
        <a class="btn ghost" href="/frasi-ribaltate/">Leggi le migliori</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container support">
      <div>
        <h2>Supporta Canapalandia</h2>
        <p class="section-lead">
          Se trovi utile il progetto, puoi sostenerlo o scoprire i partner
          selezionati.
        </p>
      </div>
      <div class="support-cta">
        <a class="btn primary" href="/sostieni-la-nostra-causa/"
          >Sostieni il progetto</a
        >
        <a class="btn ghost" href="/partner-selezionati/">Scopri i partner</a>
      </div>
    </div>
  </section>

  <style>
    /* Hero links discreti */
    .hero-links {
      margin-top: 12px;
      display: flex;
      gap: 10px;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      opacity: 0.9;
      font-size: 0.95rem;
    }
    .hero-link {
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    /* Percorsi tematici: rollover elegante */
    #percorsi .grid.cards .card--topic {
      position: relative;
      transition:
        transform 0.18s ease,
        box-shadow 0.18s ease,
        border-color 0.18s ease,
        background 0.18s ease;
      will-change: transform;
    }

    #percorsi .grid.cards .card--topic::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: var(--r);
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.18s ease;
      /* glow leggero + “sheen” */
      background:
        radial-gradient(
          700px 220px at 20% 15%,
          rgba(34, 197, 94, 0.14),
          transparent 55%
        ),
        linear-gradient(135deg, rgba(255, 255, 255, 0.06), transparent 40%);
    }

    html[data-theme="light"] #percorsi .grid.cards .card--topic::after {
      background:
        radial-gradient(
          700px 220px at 20% 15%,
          rgba(22, 163, 74, 0.12),
          transparent 55%
        ),
        linear-gradient(135deg, rgba(2, 6, 23, 0.05), transparent 40%);
    }

    #percorsi .grid.cards .card--topic:hover {
      transform: translateY(-3px);
      border-color: rgba(34, 197, 94, 0.3);
      box-shadow:
        0 14px 38px rgba(0, 0, 0, 0.28),
        0 0 0 1px rgba(34, 197, 94, 0.1);
    }

    #percorsi .grid.cards .card--topic:hover::after {
      opacity: 1;
    }

    #percorsi .grid.cards .card--topic:hover .card-icon {
      transform: translateY(-1px);
      background: rgba(34, 197, 94, 0.16);
      border-color: rgba(34, 197, 94, 0.28);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.18);
    }

    #percorsi .card--topic .card-icon {
      transition:
        transform 0.18s ease,
        background 0.18s ease,
        border-color 0.18s ease,
        box-shadow 0.18s ease;
    }

    /* Accessibilità: focus da tastiera */
    #percorsi .grid.cards .card--topic:focus-visible {
      outline: 2px solid rgba(34, 197, 94, 0.55);
      outline-offset: 4px;
    }
  </style>
</Layout>
