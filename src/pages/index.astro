    html[data-theme="light"] #in-evidenza .in-evidenza__side .in-evidenza__mini:hover {
      border-color: color-mix(in oklab, var(--brand) 26%, var(--border-subtle));
      background: color-mix(in oklab, var(--panel) 90%, var(--brand-subtle));
      box-shadow: 0 8px 18px color-mix(in oklab, var(--brand) 10%, transparent);
    }

    #in-evidenza a.in-evidenza__main:focus-visible {
      outline: 2px solid color-mix(in oklab, var(--gold) 80%, transparent);
      outline-offset: 3px;
    }

    #in-evidenza .in-evidenza__badge {
