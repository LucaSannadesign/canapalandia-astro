    #in-evidenza a.in-evidenza__main {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: clamp(0.75rem, 2vw, 1.05rem);
      padding: clamp(1.2rem, 2.8vw, 1.7rem);
      min-width: 0;
      text-decoration: none;
      color: inherit;
      border-radius: var(--r-md);
      border: 1px solid color-mix(in oklab, var(--gold) 24%, var(--border));
      background: linear-gradient(
        165deg,
        color-mix(in oklab, var(--panel) 90%, var(--gold-subtle)) 0%,
        var(--panel) 48%,
        var(--panel) 100%
      );
      box-shadow:
        0 1px 0 color-mix(in oklab, var(--text) 7%, transparent) inset,
        0 22px 52px rgba(0, 0, 0, 0.24);
      overflow: hidden;
      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        transform 0.2s ease;
    }

    html[data-theme="light"] #in-evidenza a.in-evidenza__main {
