          </span>
        </p>
        <a class="cl-btn cl-btn--outlineOcra" href="/pubblicita/">
          Diventa partner <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </div>
</Layout>

<script>
  /* ---------- In aggiornamento: rotazione di una notizia alla volta ----------
     Nessuna libreria: fade + 6px verticali, 300ms, permanenza 6,5s.
     L'avanzamento automatico si ferma su hover, su focus, quando la scheda
     non è visibile e quando l'utente chiede meno movimento. */
  const brief = document.querySelector<HTMLElement>("[data-brief]");

  if (brief) {
    const items = Array.from(brief.querySelectorAll<HTMLElement>("[data-brief-item]"));
    const viewport = brief.querySelector<HTMLElement>("[data-brief-viewport]");
    const counter = brief.querySelector<HTMLElement>("[data-brief-count]");
    const prev = brief.querySelector<HTMLButtonElement>("[data-brief-prev]");
    const next = brief.querySelector<HTMLButtonElement>("[data-brief-next]");

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const DWELL = 6500;
    const STEP = 300;

    let index = 0;
    let timer: number | undefined;
    let paused = false;

    const pad = (n: number) => String(n).padStart(2, "0");

    const go = (target: number, manual: boolean) => {
      if (items.length < 2) return;
      const nextIndex = (target + items.length) % items.length;
      if (nextIndex === index) return;

      const current = items[index];
      const upcoming = items[nextIndex];

      // Annuncia il cambio solo quando è l'utente a chiederlo: la rotazione
      // automatica resterebbe rumorosa per uno screen reader.
      viewport?.setAttribute("aria-live", manual ? "polite" : "off");

      current.classList.add("is-leave");
      window.setTimeout(() => {
        current.hidden = true;
        current.classList.remove("is-leave");
      }, STEP);

      upcoming.hidden = false;
      upcoming.classList.add("is-enter");
      requestAnimationFrame(() => {
        requestAnimationFrame(() => upcoming.classList.remove("is-enter"));
      });

      index = nextIndex;
      if (counter) counter.textContent = `${pad(index + 1)} / ${pad(items.length)}`;
    };

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (paused || reduceMotion.matches || items.length < 2) return;
      timer = window.setInterval(() => go(index + 1, false), DWELL);
    };

    const setPaused = (value: boolean) => {
      paused = value;
      if (value) stop();
      else start();
    };

    prev?.addEventListener("click", () => {
      go(index - 1, true);
      start();
    });
    next?.addEventListener("click", () => {
      go(index + 1, true);
      start();
    });

    brief.addEventListener("pointerenter", () => setPaused(true));
    brief.addEventListener("pointerleave", () => setPaused(false));
    brief.addEventListener("focusin", () => setPaused(true));
    brief.addEventListener("focusout", () => setPaused(false));
    document.addEventListener("visibilitychange", () => setPaused(document.hidden));
    reduceMotion.addEventListener("change", start);

    start();
  }

  const form = document.getElementById("homeNewsletter") as HTMLFormElement | null;
  const feedback = document.getElementById("homeNewsletterFeedback");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!feedback) return;

    const submit = form.querySelector("button[type=submit]") as HTMLButtonElement | null;
    const payload = Object.fromEntries(new FormData(form).entries());

    feedback.textContent = "Invio in corso…";
    feedback.dataset.state = "pending";
    if (submit) submit.disabled = true;

    try {
      const response = await fetch("/api/newsletter", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await response.json().catch(() => ({}));

      if (response.ok) {
        feedback.textContent = data.message || "Iscrizione registrata. Controlla la tua email.";
        feedback.dataset.state = "ok";
        form.reset();
      } else {
        feedback.textContent = data.message || "Iscrizione non riuscita. Riprova più tardi.";
        feedback.dataset.state = "error";
      }
    } catch {
      feedback.textContent = "Connessione non riuscita. Riprova più tardi.";
      feedback.dataset.state = "error";
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>

<style>
  /* ============================================================
     Token della home — design "Canapalandia Homepage" (1c).
     Verde identitario mantenuto, superficie editoriale = carta.
     Radius 3px, divider a filo, nessuna ombra.
     ============================================================ */

  :global(html:has(.cl)) {
    /* Superfici */
    --cl-surface: #fdfcf8;
    --cl-paper: #f2efe4;
    --cl-mint: #edf0e4;
    --cl-band-dark: #14261a;
    --cl-band-sage: #3f6b4a;

    /* Linee */
    --cl-rule: #dfd9c7;
    --cl-rule-soft: #e4dfd0;
    --cl-rule-strong: #14261a;

    /* Testo */
    --cl-heading: #14261a;
    --cl-text: #23261f;
    --cl-body: #4a4735;
    --cl-body-soft: #5c594a;
    --cl-muted: #6b6858;

    /* Accenti */
    --cl-kicker: #3f6b4a;
    --cl-ocra: #b5762a;
    --cl-lime: #c6e36a;

    /* Etichette e bottoni: il pill verde è lo stesso di `.header-cta` */
    --cl-badge-bg: #14261a;
    --cl-badge-fg: #fdfcf8;
    --cl-btn-bg: #1f4a2c;
    --cl-btn-bg-hover: #2b6139;
    --cl-btn-fg: #fffdf7;

    /* Raggi: derivati dalla scala globale (--r-xs 2 / --r-sm 3 / --r-md 4).
       La pill resta solo sul badge di categoria. */
    --cl-r-hero: var(--r-md);
    --cl-r-media: var(--r-sm);
    --cl-r-thumb: var(--r-xs);
    --cl-r-module: var(--r-md);
    --cl-r-field: var(--r-md);
    --cl-r-pill: var(--r-full);

    /* Spazi: multipli della scala --space-* (8/12/16/24/32/48) del progetto */
    --cl-section: clamp(40px, 5vw, 64px);
    --cl-band: clamp(32px, 4vw, 48px);
    /* Stacco fra la fascia "In aggiornamento" e l'apertura: più corto del
       ritmo fra sezioni, così l'hero sale. */
    --cl-hero-top: clamp(20px, 2.4vw, 32px);
    --cl-col-gap: clamp(24px, 3.4vw, 48px);
    --cl-card-gap: clamp(20px, 2.6vw, 32px);
    --cl-head-gap: var(--space-2xl);

    /* Testo sulle fasce scure: identico nei due temi */
    --cl-on-dark-title: #fdfcf8;
    --cl-on-dark-text: #e9ede4;
    --cl-on-dark-soft: #a7b79f;
    --cl-on-dark-faint: #7e9276;
    --cl-on-dark-line: rgba(255, 255, 255, 0.14);

    --cl-serif: "Newsreader", Georgia, "Times New Roman", serif;
  }

  /* Dark: stessa architettura su superfici verde profondo (non un'inversione) */
  :global(html[data-theme="dark"]:has(.cl)) {
    --cl-surface: #14261b;
    --cl-paper: #122219;
    --cl-mint: #16301c;
    --cl-band-dark: #0e2015;
    --cl-band-sage: #2f5539;

    --cl-rule: #2c4634;
    --cl-rule-soft: #27402f;
    --cl-rule-strong: #3c5c44;

    --cl-heading: #f4f2e6;
    --cl-text: #efede0;
    --cl-body: #c6d3c2;
    --cl-body-soft: #bfcdbb;
    --cl-muted: #9fb79a;

    --cl-kicker: #9dc063;
    --cl-ocra: #d8a05a;

    --cl-badge-bg: #c6e36a;
    --cl-badge-fg: #0e2015;
  }

  /* Header e footer restano i componenti globali: nessuna variante di colore,
     radius o interazione riservata alla home. */

  /* Su mobile main#contenuto aggiunge padding: la home lo gestisce da sé */
  @media (max-width: 767px) {
    :global(main#contenuto:has(.cl)) {
      padding-inline: 0 !important;
    }
  }

  /* ---------- Base ---------- */

  .cl {
    font-family: var(--font-ui);
    color: var(--cl-text);
    background: var(--cl-surface);
    overflow-x: hidden;
  }

  /* app.css colora ogni link con un selettore molto specifico
     (`a:not(.btn):not(.cardLink)…`): lo neutralizziamo una volta sola e
     distribuiamo il colore con una custom property, così ogni blocco può
     dichiarare il proprio link senza rincorrere la specificità. */
  :global(
      .cl.cl
        a:not(.btn):not(.cardLink):not(.blog-filters__link):not(.filter-chip):not(.tax-chip)
    ) {
    color: var(--cl-link, inherit);
    text-decoration: none;
    transition: color 160ms ease;
  }

  :global(
      .cl.cl
        a:not(.btn):not(.cardLink):not(.blog-filters__link):not(.filter-chip):not(.tax-chip):hover
    ) {
    color: var(--cl-link-hover, var(--cl-kicker));
  }

  .cl-wrap {
    max-width: 1240px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 56px);
  }

  /* Le regole di base valgono sui blocchi editoriali della home, non sui
     componenti globali annidati (HomeActionCards), che conservano tipografia,
     raggi e colori del resto del sito. */
  .cl :where(img):not(.cl-actions *) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cl :where(h1, h2, h3, h4):not(.cl-actions *) {
    font-family: var(--cl-serif);
    font-weight: 500;
    color: var(--cl-heading);
    text-wrap: pretty;
    margin: 0;
  }

  /* ---------- Elementi condivisi ---------- */

  .cl-kicker {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cl-kicker);
  }

  .cl-kicker--ocra {
    color: var(--cl-ocra);
  }

  .cl-kicker--lime {
    color: var(--cl-lime);
  }

  .cl-kicker--faint {
    color: var(--cl-muted);
    letter-spacing: 0.16em;
  }

  .cl-badge {
    display: inline-flex;
    align-items: center;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cl-badge-fg);
    background: var(--cl-badge-bg);
    padding: 5px 12px;
    border-radius: var(--cl-r-pill);
  }

  .cl-metaline {
    margin: 0;
    font-size: 11.5px;
    color: var(--cl-muted);
  }

  .cl-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
    flex: none;
  }

  .cl-dot--ocra {
    background: var(--cl-ocra);
  }

  .cl-dot--lime {
    background: var(--cl-lime);
  }

  /* Stessa grammatica di `.header-cta`: Archivo semibold, hover -1px */
  .cl-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    height: 44px;
    padding: 0 var(--space-xl);
    border-radius: var(--r-md);
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: var(--font-semibold);
    line-height: 1;
    white-space: nowrap;
    border: 1px solid transparent;
    transition: background 200ms ease, border-color 200ms ease, transform 150ms ease;
  }

  .cl-btn:hover {
    transform: translateY(-1px);
  }

  .cl-btn--primary {
    background: var(--cl-btn-bg);
    --cl-link: var(--cl-btn-fg);
    --cl-link-hover: var(--cl-btn-fg);
  }

  .cl-btn--primary:hover {
    background: var(--cl-btn-bg-hover);
  }

  .cl-btn--outlineLime {
    border-color: var(--cl-lime);
    --cl-link: var(--cl-lime);
    --cl-link-hover: #0e2015;
  }

  .cl-btn--outlineLime:hover {
    background: var(--cl-lime);
  }

  .cl-btn--outlineOcra {
    height: 42px;
    border-color: var(--cl-ocra);
    font-size: 13px;
    --cl-link: var(--cl-ocra);
    --cl-link-hover: #fff9ef;
  }

  .cl-btn--outlineOcra:hover {
    background: var(--cl-ocra);
  }

  .cl-morelink {
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    --cl-link: var(--cl-kicker);
  }

  .cl-sechead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xl);
    border-bottom: 1px solid var(--cl-rule-strong);
    padding-bottom: var(--space-md);
    margin-bottom: var(--cl-head-gap);
  }

  .cl-sechead--rule {
    border-bottom-width: 2px;
  }

  .cl-sechead__title {
    font-size: clamp(24px, 3vw, 30px);
    letter-spacing: -0.01em;
  }

  .cl-sechead--rule .cl-sechead__title {
    font-size: clamp(25px, 3.2vw, 32px);
  }

  .cl-sechead__aside {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cl-muted);
  }

  .cl-sechead__aside--plain {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  /* ---------- Utility bar ----------
     Livello 2 della gerarchia: deve leggersi come nota di servizio, non
     come seconda navigazione. Superficie di pagina, testo attenuato,
     un solo separatore. */

  .cl-strip {
    background: var(--cl-surface);
    border-bottom: 1px solid var(--cl-rule-soft);
    font-size: 11.5px;
    letter-spacing: 0.01em;
    --cl-link: var(--cl-muted);
    --cl-link-hover: var(--cl-kicker);
  }

  .cl-strip__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: 34px;
    padding-block: 6px;
  }

  .cl-strip p {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--cl-muted);
  }

  .cl-strip__sep {
    opacity: 0.4;
  }

  /* ---------- In aggiornamento ----------
     Una sola notizia per volta: titolo intero, contatore e controlli.
     Fascia compatta e riconoscibile, subordinata all'header. */

  .cl-brief {
    background: var(--cl-paper);
    border-bottom: 1px solid var(--cl-rule);
  }

  .cl-brief__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-xl);
    min-height: 52px;
    padding-block: var(--space-md);
  }

  .cl-brief__label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cl-heading);
    white-space: nowrap;
  }

  .cl-brief__viewport {
    min-width: 0;
  }

  .cl-brief__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cl-brief__item {
    font-size: 14px;
    line-height: 1.4;
    color: var(--cl-body);
    --cl-link: var(--cl-text);
    transition: opacity 300ms ease, transform 300ms ease;
  }

  .cl-brief__item[hidden] {
    display: none;
  }

  /* Stati della transizione: entra dal basso, esce verso l'alto (6px) */
  .cl-brief__item.is-enter {
    opacity: 0;
    transform: translateY(6px);
  }

  .cl-brief__item.is-leave {
    opacity: 0;
    transform: translateY(-6px);
  }

  .cl-brief__nav {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin: 0;
  }

  .cl-brief__count {
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--cl-muted);
  }

  .cl-brief__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--cl-rule);
    border-radius: var(--r-md);
    background: transparent;
    color: var(--cl-body);
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    transition: border-color 200ms ease, color 200ms ease;
  }

  .cl-brief__btn:hover {
    border-color: var(--cl-rule-strong);
    color: var(--cl-heading);
  }

  /* ---------- Hero ---------- */

  .cl-hero {
    padding-block: var(--cl-hero-top) var(--cl-section);
  }

  .cl-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 372px;
    gap: var(--cl-col-gap);
    align-items: start;
  }

  .cl-lead__media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--cl-r-hero);
    background: var(--cl-rule-soft);
  }

  .cl-lead__kicker {
    margin: var(--space-xl) 0 var(--space-md);
  }

  /* Metadata dell'apertura: sotto l'abstract, separati da un filo,
     ancorano la riga di CTA senza creare un box. */
  .cl-lead__meta {
    border-top: 1px solid var(--cl-rule);
    padding-top: var(--space-lg);
    margin: var(--space-xl) 0 0;
  }

  .cl-lead__title {
    font-size: clamp(30px, 4.4vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.022em;
    max-width: 15.5em;
  }

  /* Standfirst: è la voce dell'articolo, primo registro dopo il titolo. */
  .cl-lead__dek {
    font-size: 18.5px;
    line-height: 1.5;
    letter-spacing: -0.005em;
    color: var(--cl-text);
    margin: var(--space-lg) 0 0;
    max-width: 52ch;
    text-wrap: pretty;
  }

  /* Abstract: secondo registro, di servizio. Corpo minore, interlinea più
     ampia, colore attenuato e misura più lunga: si legge come nota, non
     come continuazione del sommario. */
  .cl-lead__abstract {
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--cl-muted);
    margin: var(--space-lg) 0 0;
    max-width: 68ch;
    text-wrap: pretty;
  }

  .cl-lead__foot {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
    margin: var(--space-lg) 0 0;
  }

  .cl-byline {
    font-size: 13px;
    color: var(--cl-muted);
  }

  .cl-rail {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    border-left: 1px solid var(--cl-rule);
    padding-left: clamp(24px, 2.6vw, 32px);
  }

  .cl-rail__media {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--cl-r-media);
    background: var(--cl-rule-soft);
    margin-bottom: var(--space-md);
  }

  .cl-rail__title {
    font-size: 23px;
    line-height: 1.17;
    margin: var(--space-sm) 0 0;
  }

  .cl-rail__title + .cl-metaline {
    margin-top: var(--space-md);
  }

  .cl-rail__dek {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--cl-body-soft);
    margin: var(--space-md) 0 0;
  }

  .cl-rail__second {
    border-top: 1px solid var(--cl-rule);
    padding-top: var(--space-xl);
  }

  .cl-rail__second .cl-metaline {
    margin-top: var(--space-md);
  }

  .cl-flash {
    background: var(--cl-band-dark);
    border-radius: var(--cl-r-module);
    padding: var(--space-xl);
    --cl-link: var(--cl-on-dark-text);
    --cl-link-hover: var(--cl-lime);
  }

  .cl-flash__head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 var(--space-lg);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cl-lime);
  }

  .cl-flash__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cl-flash__item + .cl-flash__item {
    border-top: 1px solid var(--cl-on-dark-line);
  }

  .cl-flash__item a {
    display: grid;
    grid-template-columns: 46px 1fr;
    gap: var(--space-md);
    padding-block: var(--space-md);
    font-size: 14px;
    line-height: 1.35;
  }

  .cl-flash__item:first-child a {
    padding-top: 0;
  }

  .cl-flash__item:last-child a {
    padding-bottom: 0;
  }

  .cl-flash__date {
    font-size: 11px;
    color: var(--cl-on-dark-faint);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- In evidenza ---------- */

  .cl-highlight {
    background: var(--cl-paper);
    border-block: 1px solid var(--cl-rule);
    padding-block: var(--cl-section);
  }

  .cl-highlight__grid {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: var(--cl-col-gap);
    align-items: start;
  }

  .cl-inchiesta__media {
    display: block;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    border-radius: var(--cl-r-hero);
    background: var(--cl-rule-soft);
  }

  .cl-inchiesta__body {
    margin-top: var(--space-xl);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: var(--space-2xl);
    align-items: end;
  }

  .cl-inchiesta__title {
    font-size: clamp(25px, 2.9vw, 37px);
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin-top: var(--space-sm);
  }

  .cl-inchiesta__dek {
    font-size: 14px;
    line-height: 1.6;
    color: var(--cl-body);
    margin: 0;
    border-left: 2px solid var(--cl-lime);
    padding-left: var(--space-lg);
  }

  .cl-stack {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cl-stack__item + .cl-stack__item {
    border-top: 1px solid var(--cl-rule);
  }

  .cl-stack__link {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: start;
    padding-block: var(--space-lg);
  }

  .cl-stack__item:first-child .cl-stack__link {
    padding-top: 0;
  }

  .cl-stack__item:last-child .cl-stack__link {
    padding-bottom: 0;
  }

  .cl-stack__thumb {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--cl-r-thumb);
    background: var(--cl-rule-soft);
  }

  .cl-stack__body {
    display: block;
  }

  .cl-stack__title {
    display: block;
    font-family: var(--cl-serif);
    font-size: 19px;
    line-height: 1.2;
    font-weight: 500;
    color: var(--cl-heading);
    margin: var(--space-sm) 0 var(--space-md);
    text-wrap: pretty;
  }

  .cl-stack__link:hover .cl-stack__title {
    color: var(--cl-kicker);
  }

  /* ---------- Ultime notizie ---------- */

  .cl-latest {
    padding-block: var(--cl-section);
  }

  .cl-grid4 {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--cl-card-gap);
  }

  .cl-card__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--cl-r-media);
    background: var(--cl-rule-soft);
    margin-bottom: var(--space-lg);
  }

  .cl-card__title {
    font-size: 21px;
    line-height: 1.19;
    margin: var(--space-sm) 0 var(--space-md);
  }

  /* ---------- Osservatorio normativa ---------- */

  .cl-observatory {
    background: var(--cl-band-dark);
    color: var(--cl-on-dark-text);
    padding-block: var(--cl-section);
    --cl-link: var(--cl-on-dark-text);
    --cl-link-hover: var(--cl-lime);
  }

  .cl-observatory__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-2xl);
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    padding-bottom: var(--space-lg);
    margin-bottom: var(--cl-head-gap);
  }

  .cl-observatory__title {
    font-size: clamp(26px, 3.4vw, 34px);
    color: var(--cl-on-dark-title);
    margin-top: var(--space-sm);
  }

  .cl-observatory__intro {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--cl-on-dark-soft);
    margin: 0;
    max-width: 42ch;
    text-align: right;
  }

  .cl-observatory__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1.1fr);
    gap: var(--cl-col-gap);
    align-items: start;
  }

  .cl-observatory__divider {
    background: rgba(255, 255, 255, 0.14);
    align-self: stretch;
  }

  .cl-observatory__lead {
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    padding-bottom: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .cl-observatory__leadTitle {
    font-size: clamp(23px, 2.4vw, 29px);
    line-height: 1.13;
    color: var(--cl-on-dark-title);
  }

  .cl-observatory__dek {
    font-size: 14px;
    line-height: 1.6;
    color: var(--cl-on-dark-soft);
    margin: 12px 0 0;
  }

  .cl-observatory__meta {
    font-size: 11.5px;
    color: var(--cl-on-dark-faint);
    margin: 12px 0 0;
  }

  .cl-observatory__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .cl-observatory__links a {
    display: flex;
    gap: 12px;
    font-size: 15px;
    line-height: 1.35;
  }

  .cl-observatory__flag {
    color: var(--cl-lime);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding-top: 3px;
    flex: none;
  }

  .cl-observatory .cl-kicker--faint {
    color: var(--cl-on-dark-faint);
    margin-bottom: var(--space-lg);
  }

  .cl-timeline {
    list-style: none;
    margin: 0 0 var(--space-xl);
    padding: 0;
  }

  .cl-timeline__item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cl-timeline__item:last-child {
    border-bottom: 0;
  }

  .cl-timeline__item a {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: var(--space-lg);
    padding-block: var(--space-lg);
  }

  .cl-timeline__item:first-child a {
    padding-top: 0;
  }

  .cl-timeline__item:last-child a {
    padding-bottom: 0;
  }

  .cl-timeline__when {
    font-size: 12px;
    color: var(--cl-lime);
    font-variant-numeric: tabular-nums;
  }

  .cl-timeline__what {
    font-size: 14.5px;
    line-height: 1.4;
  }

  /* ---------- CBD ---------- */

  .cl-cbd {
    background: var(--cl-surface);
    padding-block: var(--cl-section);
  }

  .cl-cbd__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: var(--cl-col-gap);
    align-items: start;
  }

  .cl-grid3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--cl-card-gap);
  }

  .cl-tall__media {
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--cl-r-media);
    background: var(--cl-rule-soft);
  }

  .cl-tall__title {
    font-size: 20px;
    line-height: 1.2;
    margin: var(--space-lg) 0 var(--space-md);
  }

  .cl-note {
    background: var(--cl-mint);
    border-radius: var(--cl-r-module);
    padding: var(--space-xl);
  }

  .cl-note .cl-kicker {
    margin-bottom: var(--space-lg);
  }

  .cl-note__text {
    font-family: var(--cl-serif);
    font-size: 19px;
    line-height: 1.45;
    color: var(--cl-heading);
    margin: 0;
    text-wrap: pretty;
  }

  .cl-note__link {
    display: inline-block;
    margin-top: var(--space-lg);
    font-size: 12.5px;
    font-weight: 600;
    --cl-link: var(--cl-kicker);
  }

  /* ---------- Canapa ---------- */

  .cl-hemp {
    background: var(--cl-mint);
    border-top: 1px solid var(--cl-rule);
    padding-block: var(--cl-section);
  }

  .cl-hemp__grid {
    display: grid;
    grid-template-columns: 1.2fr 1.2fr 1fr;
    gap: var(--cl-col-gap);
    align-items: start;
  }

  .cl-portrait__media {
    display: block;
    aspect-ratio: 5 / 6;
    overflow: hidden;
    border-radius: var(--cl-r-media);
    background: var(--cl-rule-soft);
    margin-bottom: var(--space-lg);
  }

  .cl-portrait__title {
    font-size: clamp(21px, 2.2vw, 27px);
    line-height: 1.15;
    margin-top: var(--space-sm);
  }

  .cl-hemp__side .cl-kicker--faint {
    color: var(--cl-body-soft);
    margin-bottom: var(--space-lg);
  }

  .cl-linklist {
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--cl-text);
  }

  .cl-linklist li + li {
    border-top: 1px solid var(--cl-rule);
  }

  .cl-linklist a {
    display: block;
    padding-block: var(--space-lg);
    font-size: 15.5px;
    line-height: 1.38;
  }

  .cl-linklist li:first-child a {
    padding-top: 0;
  }

  .cl-linklist li:last-child a {
    padding-bottom: 0;
  }

  /* ---------- Approfondimenti e guide ---------- */

  .cl-guides {
    background: var(--cl-surface);
    padding-block: var(--cl-section);
  }

  .cl-guides__grid {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: var(--cl-col-gap);
    align-items: start;
  }

  .cl-guides__title {
    font-size: clamp(24px, 3vw, 30px);
    margin-bottom: var(--space-lg);
  }

  .cl-guides__text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--cl-body-soft);
    margin: 0 0 var(--space-lg);
  }

  .cl-guides__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--cl-col-gap);
  }

  .cl-guides__item {
    border-bottom: 1px solid var(--cl-rule-soft);
  }

  .cl-guides__item a {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: start;
    padding-block: var(--space-lg);
  }

  .cl-guides__item:nth-child(1) a,
  .cl-guides__item:nth-child(2) a {
    padding-top: 0;
  }

  .cl-guides__num {
    font-family: var(--cl-serif);
    font-size: 19px;
    color: var(--cl-ocra);
  }

  .cl-guides__itemTitle {
    display: block;
    font-family: var(--cl-serif);
    font-size: 21px;
    line-height: 1.2;
    font-weight: 500;
    color: var(--cl-heading);
    margin-bottom: var(--space-sm);
    text-wrap: pretty;
  }

  .cl-guides__item a:hover .cl-guides__itemTitle {
    color: var(--cl-kicker);
  }

  /* ---------- Newsletter ---------- */

  .cl-news {
    background: var(--cl-band-sage);
    padding-block: var(--cl-section);
    --cl-link: var(--cl-lime);
    --cl-link-hover: #fdfcf8;
  }

  .cl-news__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 440px;
    gap: var(--cl-col-gap);
    align-items: center;
  }

  .cl-news__title {
    font-size: clamp(26px, 3.6vw, 36px);
    line-height: 1.13;
    color: var(--cl-on-dark-title);
    max-width: 22ch;
    margin-top: var(--space-lg);
  }

  .cl-news__text {
    font-size: 14.5px;
    line-height: 1.6;
    color: #dce6d5;
    margin: var(--space-lg) 0 0;
    max-width: 56ch;
  }

  .cl-news__form {
    margin: 0;
  }

  .cl-news__hp {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  .cl-news__row {
    display: flex;
    gap: var(--space-md);
  }

  .cl-news__input {
    flex: 1;
    min-width: 0;
    height: 50px;
    padding: 0 20px;
    background: #fdfcf8;
    border: 0;
    border-radius: var(--cl-r-field);
    font-family: var(--font-ui);
    font-size: 14px;
    color: #23261f;
  }

  .cl-news__input::placeholder {
    color: #9a9784;
  }

  .cl-news__submit {
    height: 50px;
    padding: 0 28px;
    background: #14261a;
    color: #f2efe4;
    border: 0;
    border-radius: var(--cl-r-field);
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: var(--font-semibold);
    cursor: pointer;
    white-space: nowrap;
    transition: background 200ms ease, transform 150ms ease;
  }

  .cl-news__submit:hover {
    background: #0e2015;
    transform: translateY(-1px);
  }

  .cl-news__submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .cl-news__consent {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    font-size: 11.5px;
    line-height: 1.5;
    color: #c3d3bb;
  }

  .cl-news__consent a {
    text-decoration: underline;
  }

  .cl-news__consent input {
    margin-top: 2px;
    accent-color: #14261a;
  }

  .cl-news__feedback {
    margin: var(--space-md) 0 0;
    font-size: 12px;
    min-height: 1em;
    color: #dce6d5;
  }

  .cl-news__feedback[data-state="error"] {
    color: #f6d9a8;
  }

  .cl-news__feedback[data-state="ok"] {
    color: var(--cl-lime);
  }

  /* ---------- Strumenti e sostegno ---------- */

  /* HomeActionCards è costruito per una superficie scura (titoli, badge e
     bordi bianchi): la fascia gli restituisce il contrasto per cui è
     disegnato, senza toccare il componente. */
  .cl-actions {
    background: var(--cl-band-dark);
    padding-top: var(--cl-section);
    /* Stesso colore che il componente dichiara per sé in tema chiaro */
    --cl-link: #f0faf3;
    --cl-link-hover: #ffffff;
  }

  /* ---------- Partnership ---------- */

  .cl-partners {
    background: var(--cl-surface);
    border-top: 1px solid var(--cl-rule-soft);
    padding-block: var(--space-2xl);
  }

  .cl-partners__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .cl-partners__label {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .cl-partners__text {
    font-size: 13px;
    color: var(--cl-body-soft);
    max-width: 62ch;
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 1120px) {
    .cl-hero__grid,
    .cl-cbd__grid,
    .cl-news__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .cl-rail {
      border-left: 0;
      border-top: 1px solid var(--cl-rule);
      padding-left: 0;
      padding-top: var(--space-2xl);
    }

    .cl-highlight__grid,
    .cl-guides__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .cl-observatory__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2xl);
    }

    .cl-observatory__divider {
      display: none;
    }

    .cl-observatory__head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-lg);
    }

