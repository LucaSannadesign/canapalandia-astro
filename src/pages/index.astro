  <script is:inline>
    (function () {
      const hero = document.querySelector(".page-home .hero.hero--home");
      if (!hero) return;

      const PARALLAX = 0.14;
      const MAX_PARALLAX_PX = 88;
      const mq = window.matchMedia("(min-width: 1024px)");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
      let ticking = false;
      let initialRef = null;

      function shouldRun() {
        return mq.matches && !reduce.matches;
      }

      function clearParallax() {
        hero.style.backgroundPosition = "";
        initialRef = null;
      }

      function update() {
        ticking = false;
        if (!shouldRun()) {
          clearParallax();
          return;
        }
        const vh = window.innerHeight || document.documentElement.clientHeight;
        const rect = hero.getBoundingClientRect();
        if (rect.bottom <= 0 || rect.top >= vh) {
          clearParallax();
          return;
        }
        if (initialRef == null) {
          initialRef = rect.top;
        }
        const moved = Math.max(0, initialRef - rect.top);
        const y = Math.min(MAX_PARALLAX_PX, moved * PARALLAX);
        hero.style.backgroundPosition = "center calc(50% + " + y + "px)";
      }

      function onScroll() {
        if (!mq.matches) {
          clearParallax();
          return;
        }
        if (reduce.matches) {
          clearParallax();
          return;
        }
        const vh = window.innerHeight || document.documentElement.clientHeight;
        const r = hero.getBoundingClientRect();
        if (r.bottom <= 0 || r.top >= vh) {
          clearParallax();
          return;
        }
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      }

      function onMedia() {
        initialRef = null;
        update();
      }

      if (typeof mq.addEventListener === "function") {
        mq.addEventListener("change", onMedia);
        reduce.addEventListener("change", onMedia);
      } else {
        // Safari < 14: MediaQueryList#addListener
        mq.addListener(onMedia);
        reduce.addListener(onMedia);
      }
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onMedia, { passive: true });
      update();
    })();
  </script>
