---
import { Image } from "astro:assets";
import Layout from "../layouts/MigratedLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import { loadWp } from "../lib/wp";
import {
  textFromHtml,
  excerptFromHtml,
  entryHref,
  resolveWpMediaSrc,
} from "../lib/utils";
import { WP_HOST } from "../lib/consts";
import categoriesJson from "../../data/wp/out/categories.json";

/* ---------------------------
   Helpers: imported from ../lib/utils
--------------------------- */

/* ---------------------------
   Media resolution (mirror / hotlink)
--------------------------- */

function featuredImage(p: any): { src: string; alt: string } | null {
  const direct = p?.featuredImage ?? p?.featured_image ?? p?.image ?? null;

  if (typeof direct === "string" && direct.trim()) {
    return { src: resolveWpMediaSrc(direct.trim()), alt: "" };
  }

  if (direct && typeof direct === "object") {
    const src =
      (direct as any)?.src ??
      (direct as any)?.url ??
      (direct as any)?.source_url;

    const alt = (direct as any)?.alt ?? (direct as any)?.alt_text ?? "";

    if (typeof src === "string" && src.trim()) {
      return { src: resolveWpMediaSrc(src.trim()), alt: String(alt ?? "") };
    }
  }

  const fm = p?.raw?._embedded?.["wp:featuredmedia"]?.[0];
  const srcRaw =
    fm?.media_details?.sizes?.medium_large?.source_url ||
    fm?.media_details?.sizes?.large?.source_url ||
    fm?.media_details?.sizes?.full?.source_url ||
    fm?.source_url;

  const alt = fm?.alt_text || fm?.title?.rendered || "";

  if (typeof srcRaw === "string" && srcRaw.trim()) {
    return { src: resolveWpMediaSrc(srcRaw.trim()), alt: String(alt ?? "") };
  }

  return null;
}

/* ---------------------------
   Data: WP headless
--------------------------- */

const { entries: wpEntries = [] } = await loadWp();
const entries: any[] = Array.isArray(wpEntries) ? wpEntries : [];

const posts = entries.filter(
  (e) => typeof e?.title === "string" && typeof e?.html === "string",
);

const getTime = (p: any) => {
  const raw = p?.date ?? p?.modified ?? p?.modifiedGmt ?? "";
  const t = Date.parse(String(raw));
  return Number.isFinite(t) ? t : 0;
};

const sortedPosts = posts.slice().sort((a, b) => getTime(b) - getTime(a));
const latestPosts = sortedPosts.slice(0, 6);
const featured = sortedPosts[0];
const featuredSide = sortedPosts.slice(1, 4);

/* ---------------------------
   Mappa icone SVG per categoria
--------------------------- */
function getCategoryIcon(slug: string): string {
  const iconMap: Record<string, string> = {
    "normative-aspetti-legali": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3v18M6 7h12M7 7l-3 6h6l-3-6zM17 7l-3 6h6l-3-6zM6 21h12"></path>
    </svg>`,
    "salute-benessere": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"></path>
    </svg>`,
    "cannabis-news-it": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
      <path d="M8 8h8M8 12h8M8 16h6"></path>
    </svg>`,
    "coltivazione-legale": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2v4M4.93 4.93l2.83 2.83M2 12h4M4.93 19.07l2.83-2.83M12 22v-4M19.07 19.07l-2.83-2.83M22 12h-4M19.07 4.93l-2.83 2.83M12 6a6 6 0 0 1 6 6 6 6 0 0 1-6 6 6 6 0 0 1-6-6 6 6 0 0 1 6-6z"></path>
    </svg>`,
    "guide-tutorial": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
      <path d="M9 10h6M9 14h4"></path>
    </svg>`,
    "partner-e-affiliazioni": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
      <circle cx="9" cy="7" r="4"></circle>
      <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>
    </svg>`,
    "canapa-e-ambiente": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
    </svg>`,
    "cbd": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2s7 7 7 13a7 7 0 0 1-14 0c0-6 7-13 7-13zM9.5 14.5c1 1.2 4 1.2 5 0"></path>
    </svg>`,
  };
  return iconMap[slug] || `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
  </svg>`;
}

/* ---------------------------
   Carica categorie con count
--------------------------- */
type CategoryData = {
  slug: string;
  name: string;
  count: number;
  description?: string;
};

const allCategoriesRaw = Array.isArray(categoriesJson) ? categoriesJson : [];
const categoriesMap = new Map<string, CategoryData>();

// Normalizza e filtra categorie (evita duplicati IT/EN)
const categorySlugNormalize = (slug: string): string => {
  // Normalizza slug per evitare duplicati
  return slug.toLowerCase().replace(/[^a-z0-9-]/g, "");
};

for (const cat of allCategoriesRaw) {
  if (!cat.slug || !cat.name || typeof cat.count !== "number") continue;
  const normalizedSlug = categorySlugNormalize(cat.slug);
  
  // Evita duplicati: se già esiste, mantieni quella con più post
  if (!categoriesMap.has(normalizedSlug) || (cat.count > (categoriesMap.get(normalizedSlug)?.count || 0))) {
    categoriesMap.set(normalizedSlug, {
      slug: cat.slug,
      name: typeof cat.name === "string" ? cat.name : "",
      count: cat.count || 0,
      description: typeof cat.description === "string" ? cat.description : undefined,
    });
  }
}

// Categorie principali da mostrare (priorità)
const mainCategorySlugs = [
  "normative-aspetti-legali",
  "salute-benessere",
  "cannabis-news-it",
  "coltivazione-legale",
  "guide-tutorial",
  "partner-e-affiliazioni",
  "canapa-e-ambiente",
  "cbd",
];

const mainCategories: CategoryData[] = [];
for (const slug of mainCategorySlugs) {
  const cat = categoriesMap.get(categorySlugNormalize(slug));
  if (cat) {
    mainCategories.push(cat);
  }
}

// Aggiungi altre categorie con count > 0 (max 10 totali)
const otherCategories = Array.from(categoriesMap.values())
  .filter((c) => !mainCategorySlugs.includes(c.slug) && c.count > 0)
  .sort((a, b) => b.count - a.count)
  .slice(0, Math.max(0, 10 - mainCategories.length));

const displayCategories = [...mainCategories, ...otherCategories].filter((c) => c.count > 0);

/* ---------------------------
   Page meta
--------------------------- */

const heroBgVar = "none";
const title = "Canapalandia — Cannabis light, CBD e canapa legale in Italia";
const canonical = `${WP_HOST}/`;
---

<Layout title={title} canonical={canonical} shell={false}>
  <section class="hero" style={`--hero-bg:${heroBgVar}`}>
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="container hero-inner">
      <p class="kicker">Cannabis legale • CBD • Canapa industriale</p>

      <h1>
        Cannabis light, CBD e canapa legale in Italia: informazione chiara e
        verificabile
      </h1>

      <p class="lead">
        Notizie, normative e guide pratiche per orientarti tra leggi, prodotti,
        ricerca e filiera. Focus Italia, aggiornamenti continui, zero
        sensazionalismo.
      </p>

      <div class="hero-cta">
        <a class="btn primary" href="/#percorsi">Inizia dai percorsi</a>
        <a class="btn ghost" href="/#ultimi">Leggi le ultime notizie</a>
      </div>

      <ul class="trust" aria-label="Punti chiave">
        <li>Focus Italia</li>
        <li>Fonti e contesto</li>
        <li>Aggiornato</li>
        <li>No promozione illegalità</li>
      </ul>
    </div>
  </section>

  <section id="percorsi" class="section">
    <div class="container">
      <div class="section-head">
        <h2>Percorsi tematici</h2>
        <p class="section-lead">
          Entra subito nell’area giusta: normative, benessere, filiera e
          approfondimenti.
        </p>
      </div>

      <div class="grid cards">
        {displayCategories.map((cat) => (
          <a class="card card--topic" href={`/categoria/${cat.slug}/`}>
            <span class="card-icon" aria-hidden="true" set:html={getCategoryIcon(cat.slug)}></span>
            <div class="card--topic__content">
              <div class="card--topic__header">
                <h3>{cat.name}</h3>
                {cat.count > 0 ? (
                  <span class="card--topic__count">{cat.count}</span>
                ) : null}
              </div>
              {cat.description ? (
                <p>{cat.description.length > 100 ? cat.description.substring(0, 100) + "..." : cat.description}</p>
              ) : (
                <p>Esplora tutti gli articoli di questa categoria.</p>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="container">
    <AdSlot label="Pubblicità" />
  </div>

  <section id="in-evidenza" class="section alt">
    <div class="container">
      <div class="section-head">
        <h2>In evidenza</h2>
        <p class="section-lead">
          Una guida “pilastro” e tre letture correlate per farti un quadro
          completo.
        </p>
      </div>

      <div class="grid featured">
        {
          featured ? (
            <a class="feature-main" href={entryHref(featured)}>
              <p class="badge">Approfondimento</p>

              {(() => {
                const fi = featuredImage(featured);
                return fi ? (
                  fi.src.startsWith("http") ? (
                    <Image
                      class="feature-img"
                      src={fi.src}
                      alt={fi.alt || textFromHtml(featured.title)}
                      inferSize={true}
                      loading="eager"
                      decoding="async"
                    />
                  ) : (
                    <img
                      class="feature-img"
                      src={fi.src}
                      alt={fi.alt || textFromHtml(featured.title)}
                      loading="eager"
                      decoding="async"
                    />
                  )
                ) : (
                  <div
                    class="feature-img feature-img--placeholder"
                    aria-hidden="true"
                  />
                );
              })()}

              <h3 class="feature-title" set:html={featured.title} />
              <p class="feature-excerpt">
                {excerptFromHtml(featured.html, 180)}
              </p>
              <span class="btn small">Leggi</span>
            </a>
          ) : (
            <div class="feature-main">
              <p>Selezione in evidenza in arrivo.</p>
            </div>
          )
        }

        <div class="feature-side">
          {
            featuredSide.map((p) => (
              <a class="mini" href={entryHref(p)}>
                {(() => {
                  const fi = featuredImage(p);
                  return fi ? (
                    fi.src.startsWith("http") ? (
                      <Image
                        class="mini-img"
                        src={fi.src}
                        alt={fi.alt || textFromHtml(p.title)}
                        inferSize={true}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <img
                        class="mini-img"
                        src={fi.src}
                        alt={fi.alt || textFromHtml(p.title)}
                        loading="lazy"
                        decoding="async"
                      />
                    )
                  ) : (
                    <div
                      class="mini-img mini-img--placeholder"
                      aria-hidden="true"
                    />
                  );
                })()}

                <div class="mini-body">
                  <h3 class="mini-title" set:html={p.title} />
                  <p class="mini-excerpt">{excerptFromHtml(p.html, 90)}</p>
                  <span class="mini-link">Leggi</span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="ultimi" class="section">
    <div class="container">
      <div class="section-head">
        <h2>Ultimi articoli</h2>
        <p class="section-lead">
          Aggiornamenti e analisi. Scegli cosa leggere in base al tema.
        </p>
      </div>

      <div class="grid">
        {
          latestPosts.map((p) => (
            <article class="card post-card">
              <a class="cardLink" href={entryHref(p)}>
                <div class="thumb">
                  {(() => {
                    const fi = featuredImage(p);
                    return fi ? (
                      fi.src.startsWith("http") ? (
                        <Image
                          src={fi.src}
                          alt={fi.alt || textFromHtml(p.title)}
                          inferSize={true}
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <img
                          src={fi.src}
                          alt={fi.alt || textFromHtml(p.title)}
                          loading="lazy"
                          decoding="async"
                        />
                      )
                    ) : null;
                  })()}
                </div>

                <div class="cardBody">
                  <p class="cardMeta">
                    {(() => {
                      const iso = p?.date ?? p?.modified ?? "";
                      return iso
                        ? new Date(iso).toLocaleDateString("it-IT", {
                            year: "numeric",
                            month: "long",
                            day: "2-digit",
                          })
                        : "";
                    })()}
                  </p>

                  <h3 class="cardTitle" set:html={p.title} />
                  <p class="cardExcerpt">{excerptFromHtml(p.html, 110)}</p>
                  <span class="cardCta">Apri →</span>
                </div>
              </a>
            </article>
          ))
        }
      </div>

      <div class="section-cta">
        <a class="btn ghost" href="/blog/">Vai al blog</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container support">
      <div>
        <h2>Supporta Canapalandia</h2>
        <p class="section-lead">
          Se trovi utile il progetto, puoi sostenerlo o scoprire i partner
          selezionati.
        </p>
      </div>
      <div class="support-cta">
        <a class="btn primary" href="/sostieni-la-nostra-causa/"
          >Sostieni il progetto</a
        >
        <a class="btn ghost" href="/partner-selezionati/">Scopri i partner</a>
      </div>
    </div>
  </section>

  <style>
    /* Percorsi tematici: rollover elegante */
    #percorsi .grid.cards .card--topic {
      position: relative;
      transition:
        transform 0.18s ease,
        box-shadow 0.18s ease,
        border-color 0.18s ease,
        background 0.18s ease;
      will-change: transform;
    }

    #percorsi .grid.cards .card--topic::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: var(--r);
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.18s ease;
      /* glow leggero + “sheen” */
      background:
        radial-gradient(
          700px 220px at 20% 15%,
          rgba(34, 197, 94, 0.14),
          transparent 55%
        ),
        linear-gradient(135deg, rgba(255, 255, 255, 0.06), transparent 40%);
    }

    html[data-theme="light"] #percorsi .grid.cards .card--topic::after {
      background:
        radial-gradient(
          700px 220px at 20% 15%,
          rgba(22, 163, 74, 0.12),
          transparent 55%
        ),
        linear-gradient(135deg, rgba(2, 6, 23, 0.05), transparent 40%);
    }

    #percorsi .grid.cards .card--topic:hover {
      transform: translateY(-3px);
      border-color: rgba(34, 197, 94, 0.3);
      box-shadow:
        0 14px 38px rgba(0, 0, 0, 0.28),
        0 0 0 1px rgba(34, 197, 94, 0.1);
    }

    #percorsi .grid.cards .card--topic:hover::after {
      opacity: 1;
    }

    #percorsi .grid.cards .card--topic:hover .card-icon {
      transform: translateY(-1px);
      background: rgba(34, 197, 94, 0.16);
      border-color: rgba(34, 197, 94, 0.28);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.18);
    }

    #percorsi .card--topic .card-icon {
      transition:
        transform 0.18s ease,
        background 0.18s ease,
        border-color 0.18s ease,
        box-shadow 0.18s ease;
    }

    /* Accessibilità: focus da tastiera */
    #percorsi .grid.cards .card--topic:focus-visible {
      outline: 2px solid rgba(34, 197, 94, 0.55);
      outline-offset: 4px;
    }
  </style>
</Layout>
