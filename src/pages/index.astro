    }

    html[data-theme="light"] #in-evidenza .in-evidenza__badge {
      border-color: color-mix(in oklab, var(--brand) 32%, var(--border));
      background: color-mix(in oklab, var(--panel-2) 68%, var(--brand-subtle));
      color: color-mix(in oklab, var(--text) 58%, var(--brand));
    }

    html[data-theme="light"] #in-evidenza a.in-evidenza__main {
      border-color: color-mix(in oklab, var(--brand) 18%, var(--border));
      background: linear-gradient(
        165deg,
        color-mix(in oklab, var(--panel) 92%, var(--brand-subtle)) 0%,
        var(--panel) 48%,
        var(--panel) 100%
      );
    }

    html[data-theme="light"] #in-evidenza a.in-evidenza__main::before {
      background: linear-gradient(
        90deg,
        transparent,
        color-mix(in oklab, var(--brand) 55%, transparent),
        transparent
      );
    }

    html[data-theme="light"] #in-evidenza .in-evidenza__side .in-evidenza__mini {
      border-color: color-mix(in oklab, var(--brand) 14%, var(--border-subtle));
