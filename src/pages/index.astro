    html[data-theme="light"] #in-evidenza .in-evidenza__cta {
      background: linear-gradient(135deg, var(--brand), var(--brand-2));
      color: #f0faf3;
      border-color: color-mix(in oklab, var(--brand) 56%, rgba(255, 255, 255, 0.18));
      box-shadow: 0 10px 24px color-mix(in oklab, var(--brand) 24%, transparent);
    }

