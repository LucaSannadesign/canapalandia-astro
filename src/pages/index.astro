    #in-evidenza a.in-evidenza__main::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      border-radius: var(--r-lg) var(--r-lg) 0 0;
      background: linear-gradient(
