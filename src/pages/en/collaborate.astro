---
import EnglishSiteLayout from "../../layouts/EnglishSiteLayout.astro";

const contactEmail = "info@canapalandia.com";
const contactSubject = "Canapalandia editorial collaboration proposal";
const mailtoHref = `mailto:${contactEmail}?subject=${encodeURIComponent(contactSubject)}`;
---

<EnglishSiteLayout
  title="Collaborate with Canapalandia | Editorial partnerships"
  description="Propose an editorial collaboration to Canapalandia: guest posts, sponsored content, interviews and selected in-depth work on hemp, CBD, regulation and the supply chain."
  canonical="/en/collaborate/"
  alternateIt="/collabora-con-canapalandia/"
  shell={false}
>
  <div class="collab-page">
    <section class="hero" aria-labelledby="collab-title">
      <div class="wrap hero-grid">
        <div>
          <p class="eyebrow">Selected editorial partnerships</p>
          <h1 id="collab-title">Collaborations that add value, not just visibility.</h1>
          <p class="lead">Canapalandia considers proposals from brands, professionals, associations and projects that fit its editorial focus. Guest posts, sponsored content, interviews and in-depth contributions are considered only when they offer something useful to readers.</p>
          <div class="actions"><a class="primary" href="#proposal-form">Send a proposal</a><a href="#editorial-criteria">Read the criteria</a></div>
        </div>
        <aside class="filter-panel" aria-labelledby="filters-title">
          <p class="panel-label">Before you write</p>
          <h2 id="filters-title">A proposal works when it passes three filters.</h2>
          <ul>
            <li><strong>Relevance</strong><span>The topic must fit Canapalandia and its audience.</span></li>
            <li><strong>Usefulness</strong><span>The content should inform, explain or offer a meaningful perspective.</span></li>
            <li><strong>Transparency</strong><span>Commercial collaborations are disclosed clearly.</span></li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="proof" aria-label="Collaboration principles">
      <div class="wrap proof-grid">
        <div><strong>Manual selection</strong><span>Every proposal is read and evaluated.</span></div>
        <div><strong>Editorial independence</strong><span>A collaboration does not guarantee publication.</span></div>
        <div><strong>No pure link building</strong><span>The content must still be valuable without the backlink.</span></div>
      </div>
    </section>

    <section class="section" aria-labelledby="formats-title">
      <div class="wrap">
        <p class="eyebrow">Formats</p><h2 id="formats-title">What we may consider</h2>
        <p class="intro">There is no mandatory format. What matters is the quality of the proposal, the relevance of the subject and a clear objective.</p>
        <div class="cards">
          <article><span>01</span><h3>Guest posts</h3><p>Original, informative articles, already written or developed together, subject to editorial review before publication.</p></article>
          <article><span>02</span><h3>Sponsored content</h3><p>Commercial projects that fit Canapalandia and are published with clear disclosure of the collaboration.</p></article>
          <article><span>03</span><h3>Interviews</h3><p>Conversations with companies, associations, professionals and organisations with useful experience, data or perspectives.</p></article>
          <article><span>04</span><h3>In-depth features</h3><p>Content on hemp, CBD, regulation, supply chains, sustainability, innovation, traceability and sector culture.</p></article>
        </div>
      </div>
    </section>

    <section id="editorial-criteria" class="section soft" aria-labelledby="criteria-title">
      <div class="wrap criteria-grid">
        <div><p class="eyebrow">Editorial criteria</p><h2 id="criteria-title">Content comes first. Collaboration comes second.</h2><p>Protecting the project's credibility means saying no when necessary. We assess proposals that can stand on Canapalandia editorially, not only commercially.</p></div>
        <div class="criteria-columns">
          <section><h3>We look for</h3><ul><li>Relevant, well-defined subjects.</li><li>Real sources, experience or expertise.</li><li>Original texts that can be edited.</li><li>Clear objectives and audience.</li><li>Transparency about commercial goals.</li></ul></section>
          <section><h3>We do not accept</h3><ul><li>Requests designed only to obtain backlinks.</li><li>Unverifiable medical or legal claims.</li><li>Copied, misleading or superficial content.</li><li>Invitations to bypass or ignore the law.</li><li>Automatically generated text without genuine human review.</li></ul></section>
        </div>
      </div>
    </section>

    <section class="process" aria-labelledby="process-title">
      <div class="wrap"><p class="eyebrow">Process</p><h2 id="process-title">How it works</h2><ol>
        <li><span>1</span><div><h3>You send the proposal</h3><p>Tell us who you are, the topic, the format and the collaboration objective.</p></div></li>
        <li><span>2</span><div><h3>We assess it</h3><p>We check relevance, usefulness, quality and fit with the editorial line.</p></div></li>
        <li><span>3</span><div><h3>We define the details</h3><p>If it fits, we agree on format, editing, disclosure and any commercial terms.</p></div></li>
      </ol></div>
    </section>

    <section id="proposal-form" class="section" aria-labelledby="form-title">
      <div class="wrap form-grid">
        <div>
          <p class="eyebrow">Proposal</p><h2 id="form-title">Tell us what you would like to build together.</h2>
          <p>Precise information is enough. We want to understand who you are, what you propose and why it could be useful to Canapalandia readers.</p>
          <div class="note"><strong>Manual review</strong><p>Submitting this form does not imply acceptance or publication.</p></div>
          <p>Prefer email? <a href={mailtoHref}>{contactEmail}</a></p>
        </div>

        <form class="proposal" method="POST" action="/api/collaborazione">
          <input type="hidden" name="lang" value="en" />
          <input class="honeypot" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <p class="required">Fields marked * are required.</p>

          <fieldset><legend>Who you are</legend><div class="fields">
            <label>Full name *<input name="nome_cognome" type="text" autocomplete="name" required /></label>
            <label>Email *<input name="email" type="email" autocomplete="email" required /></label>
            <label>Company, brand or project *<input name="azienda" type="text" autocomplete="organization" required /></label>
            <label>Website *<input name="sito_web" type="url" inputmode="url" placeholder="https://example.com" required /></label>
          </div></fieldset>

          <fieldset><legend>The proposal</legend><div class="fields">
            <label>Collaboration type *<select name="tipo_contenuto" required><option value="" disabled selected>Select an option</option><option value="Guest post">Guest post</option><option value="Sponsored content">Sponsored content</option><option value="Interview">Interview</option><option value="In-depth feature">In-depth feature</option><option value="Other">Other</option></select></label>
            <label>Proposed title or topic *<input name="argomento" type="text" placeholder="e.g. Traceability in the hemp supply chain" required /></label>
            <label class="full">Link or material to review *<input name="link" type="url" inputmode="url" placeholder="https://example.com/page" required /><small>This can be a website, online draft, product page or reference material.</small></label>
            <label class="full">Describe the proposal and objective *<textarea name="messaggio" rows="7" placeholder="Explain what you propose, why it fits Canapalandia and what value it offers readers." required></textarea></label>
          </div></fieldset>

          <label class="privacy"><input type="checkbox" name="privacy" value="accepted" required /><span>I have read and accept the <a href="/en/privacy/" target="_blank" rel="noopener noreferrer">Privacy Policy</a> and consent to the processing of my data for assessment of this editorial proposal. *</span></label>
          <button type="submit">Send proposal</button>
        </form>
      </div>
    </section>

    <section class="section faq" aria-labelledby="faq-title">
      <div class="wrap faq-grid"><div><p class="eyebrow">FAQ</p><h2 id="faq-title">Before you submit</h2></div><div>
        <details><summary>Do you publish every guest post?</summary><p>No. Every proposal is evaluated for relevance, usefulness, originality and editorial quality.</p></details>
        <details><summary>Can a sponsored article include links?</summary><p>Links may be considered, but they are subject to editorial review and do not override Canapalandia's transparency or quality standards.</p></details>
        <details><summary>Do you accept AI-generated drafts?</summary><p>We do not accept automatically generated material without genuine human review, responsibility and editorial value.</p></details>
        <details><summary>Is this the same as buying advertising?</summary><p>No. For fixed commercial formats and rates, see the <a href="/en/advertising/">Advertising page</a>.</p></details>
      </div></div>
    </section>
  </div>
</EnglishSiteLayout>

<style>
  .collab-page{overflow:clip}.wrap{width:min(1120px,calc(100% - 2.5rem));margin-inline:auto}.hero{padding:clamp(3.5rem,7vw,6rem) 0}.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:3rem;align-items:start}.eyebrow,.panel-label{margin:0 0 .7rem;color:var(--brand);font:700 .76rem/1.2 Archivo,sans-serif;letter-spacing:.11em;text-transform:uppercase}.hero h1{margin:0;font:500 clamp(3rem,6vw,5.3rem)/.95 Newsreader,serif;letter-spacing:-.04em}.lead,.intro,.criteria-grid>div>p,.form-grid>div>p{color:var(--muted);line-height:1.65}.actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.5rem}.actions a{padding:.72rem .95rem;border:1px solid var(--border);border-radius:3px;text-decoration:none;font-weight:800}.actions .primary{background:var(--brand);border-color:var(--brand);color:#102b19}.filter-panel{padding:1.4rem;border:1px solid var(--border);border-radius:var(--r-md);background:var(--panel)}.filter-panel h2{font:500 1.9rem/1.05 Newsreader,serif}.filter-panel ul{list-style:none;padding:0;margin:0}.filter-panel li{display:grid;gap:.2rem;padding:.85rem 0;border-top:1px solid var(--border)}.filter-panel span{color:var(--muted);line-height:1.5}.proof{border-block:1px solid var(--border)}.proof-grid{display:grid;grid-template-columns:repeat(3,1fr)}.proof-grid>div{display:grid;gap:.25rem;padding:1rem;border-right:1px solid var(--border)}.proof-grid>div:last-child{border-right:0}.proof-grid span{color:var(--muted);font-size:.9rem}.section{padding:4rem 0}.section h2,.process h2{margin:.2rem 0 1.5rem;font:500 clamp(2.2rem,4vw,3.7rem)/1 Newsreader,serif}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:2rem}.cards article{border-top:2px solid var(--brand);padding-top:1rem}.cards article>span{color:var(--muted);font-size:.75rem}.cards h3{font:500 1.55rem/1.1 Newsreader,serif}.cards p{color:var(--muted);line-height:1.55}.soft{background:color-mix(in oklab,var(--panel) 65%,transparent)}.criteria-grid,.form-grid,.faq-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:3rem}.criteria-columns{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.criteria-columns section{padding:1.2rem;border:1px solid var(--border);background:var(--bg)}.criteria-columns h3{font:500 1.55rem/1.1 Newsreader,serif}.criteria-columns ul{padding-left:1.1rem}.criteria-columns li{color:var(--muted);line-height:1.55;margin:.55rem 0}.process{padding:4rem 0;background:#102218;color:#fff}.process .eyebrow{color:#d8b978}.process h2{color:#fff}.process ol{display:grid;grid-template-columns:repeat(3,1fr);list-style:none;padding:0;margin:0;border-top:1px solid rgba(255,255,255,.15)}.process li{display:grid;grid-template-columns:auto 1fr;gap:1rem;padding:1.4rem;border-right:1px solid rgba(255,255,255,.15)}.process li>span{color:#9fb79a}.process h3{margin:0 0 .5rem;font:500 1.5rem/1.1 Newsreader,serif}.process p{margin:0;color:#bfcdbb;line-height:1.55}.note{margin-top:1.4rem;padding:1rem;border-left:3px solid var(--brand);background:var(--panel)}.note p{margin:.3rem 0 0!important}.form-grid a,.faq a{color:var(--brand);font-weight:700}.proposal{display:grid;gap:1rem;padding:1.4rem;border:1px solid var(--border);border-radius:var(--r-md);background:var(--panel)}.proposal fieldset{border:0;padding:0;margin:0}.proposal legend{font:700 .78rem/1.2 Archivo,sans-serif;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.75rem}.fields{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.fields label{display:grid;gap:.35rem;font-weight:700}.fields .full{grid-column:1/-1}.fields input,.fields select,.fields textarea{width:100%;padding:.78rem;border:1px solid var(--border);border-radius:3px;background:var(--bg);color:var(--text);font:inherit}.fields small{color:var(--muted);font-weight:400}.privacy{display:flex;gap:.6rem;color:var(--muted);font-size:.88rem;line-height:1.5}.proposal>button{justify-self:start;border:0;border-radius:3px;background:var(--brand);color:#102b19;padding:.8rem 1rem;font-weight:800;cursor:pointer}.honeypot{position:absolute;left:-9999px}.required{margin:0;color:var(--muted);font-size:.84rem}.faq details{padding:1rem 0;border-top:1px solid var(--border)}.faq summary{cursor:pointer;font-weight:800}.faq details p{color:var(--muted);line-height:1.6}@media(max-width:900px){.hero-grid,.criteria-grid,.form-grid,.faq-grid{grid-template-columns:1fr}.cards{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.proof-grid,.cards,.criteria-columns,.process ol,.fields{grid-template-columns:1fr}.proof-grid>div,.process li{border-right:0;border-bottom:1px solid var(--border)}.fields .full{grid-column:auto}}
</style>
