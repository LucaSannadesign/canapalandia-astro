---
/** Legacy compatibility route for /en/categoria/:slug/page/:page/. */
import EnglishSiteLayout from "../../../../../layouts/EnglishSiteLayout.astro";
import { EN_BLOG_CATEGORIES } from "../../../../../lib/localization";

export const prerender = false;

const slug = String(Astro.params.slug ?? "").trim().toLowerCase();
const page = Number.parseInt(String(Astro.params.page ?? ""), 10);
if (!slug || !Number.isInteger(page) || page < 1) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

if (EN_BLOG_CATEGORIES.has(slug)) {
  const destination = page === 1
    ? `/en/category/${slug}/`
    : `/en/category/${slug}/page/${page}/`;
  return Astro.redirect(destination, 301);
}
---

<EnglishSiteLayout
  title={`Legacy category: ${slug} — Page ${page} | Canapalandia`}
  description="Historical English category URL retained for compatibility."
  canonical={`/en/categoria/${slug}/page/${page}/`}
  robots="noindex,follow"
>
  <section class="card">
    <h1>Historical category URL</h1>
    <p>This legacy paginated URL is kept for compatibility and is not part of the current English taxonomy.</p>
    <p><a href="/en/blog/">Browse the current English archive →</a></p>
  </section>
</EnglishSiteLayout>