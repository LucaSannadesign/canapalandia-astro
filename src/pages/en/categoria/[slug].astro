---
/**
 * Legacy compatibility route for historical WordPress-style /en/categoria/:slug URLs.
 * Current English taxonomy lives at /en/category/:slug/.
 */
import EnglishSiteLayout from "../../../layouts/EnglishSiteLayout.astro";
import { EN_BLOG_CATEGORIES } from "../../../lib/localization";

export const prerender = false;

const slug = String(Astro.params.slug ?? "").trim().toLowerCase();
if (!slug) return new Response(null, { status: 404, statusText: "Not Found" });

if (EN_BLOG_CATEGORIES.has(slug)) {
  return Astro.redirect(`/en/category/${slug}/`, 301);
}
---

<EnglishSiteLayout
  title={`Legacy category: ${slug} | Canapalandia`}
  description="Historical English category URL retained for compatibility."
  canonical={`/en/categoria/${slug}/`}
  robots="noindex,follow"
>
  <section class="card">
    <h1>Historical category URL</h1>
    <p>This legacy URL is kept so old links do not disappear, but it is not part of the current English taxonomy.</p>
    <p><a href="/en/blog/">Browse the current English archive →</a></p>
  </section>
</EnglishSiteLayout>