---
/**
 * Route EN categoria: /en/categoria/[slug]/
 * Compatibilità WordPress: assorbe URL storici EN /en/categoria/slug/
 *
 * Se il sito non ha contenuti EN reali, mostra pagina minimale con noindex,follow.
 * Nessun 301 automatico verso /categoria/[slug]/: lo slug EN può non coincidere con `category` IT.
 */
import SiteLayout from "../../../layouts/SiteLayout.astro";

export const prerender = false;

const slug = String(Astro.params.slug ?? "").trim();

// Per ora: pagina minimale con noindex (archivio EN legacy)
// Se in futuro ci sono contenuti EN, aggiornare questa route
const metadata = {
  title: `Category: ${slug} — Canapalandia`,
  description: "English category archive (legacy).",
  canonical: `${import.meta.env.SITE || "https://canapalandia.com"}/en/categoria/${slug}/`,
  robots: { index: false, follow: true },
};
---

<SiteLayout metadata={metadata}>
  <main class="container page-shell">
    <section class="card">
      <h1>Category: {slug}</h1>
      <p>This is a legacy English category archive. The site content is primarily in Italian.</p>
      <p>
        <a href={`/categoria/${slug}/`}>View Italian version</a> | <a href="/blog/">Go to Blog</a>
      </p>
    </section>
  </main>
</SiteLayout>
