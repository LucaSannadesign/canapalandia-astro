---
import EnglishSiteLayout from "../../layouts/EnglishSiteLayout.astro";

const SITE = import.meta.env.SITE || "https://canapalandia.com";
const title = "How to read a COA certificate | Canapalandia Lab";
const description = "Paste the results from a certificate of analysis (COA) and get a simpler reading of cannabinoids, values, units and laboratory abbreviations such as ND, LOD and LOQ.";
const canonical = `${SITE}/en/lab/`;
const structuredData = {
  "@context":"https://schema.org",
  "@graph":[
    {"@type":"WebPage",url:canonical,name:title,description,inLanguage:"en"},
    {"@type":"WebApplication",name:"Canapalandia Lab — COA Reader",url:canonical,description,applicationCategory:"EducationalApplication",operatingSystem:"Any",browserRequirements:"JavaScript in a modern browser",isAccessibleForFree:true}
  ]
};
---

<EnglishSiteLayout title={title} description={description} canonical={canonical} alternateIt="/lab/" shell={false}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g,"\\u003c")} />
  <section class="lab-page" aria-labelledby="lab-title">
    <div class="lab-wrap">
      <header class="lab-hero">
        <p class="lab-kicker">CANAPALANDIA LAB · BETA</p>
        <h1 id="lab-title">Understand your certificate of analysis more easily.</h1>
        <p class="lab-lead">Paste the section of a COA that contains the results. The Lab tries to recognise cannabinoids, values and common laboratory abbreviations and rewrites them in a more readable form.</p>
        <div class="lab-privacy" role="note"><span aria-hidden="true"></span><span>Analysis happens in your browser: the text you paste is not sent to Canapalandia's server by this tool.</span></div>
      </header>

      <div class="lab-grid">
        <section class="lab-panel" aria-labelledby="coa-input-title">
          <div class="lab-panel__head"><div><p class="lab-step">1 · PASTE</p><h2 id="coa-input-title">COA results</h2></div><button class="lab-link-button" id="en-load-example" type="button">Use an example</button></div>
          <label class="sr-only" for="en-coa-input">Certificate of analysis text</label>
          <textarea id="en-coa-input" rows="13" spellcheck="false" autocomplete="off" autocapitalize="off" aria-describedby="en-coa-help" placeholder="Example:\nCBD 12.4 %\nCBDA 0.8 %\nΔ9-THC < LOQ\nCBG 0.18 %\nCBN ND"></textarea>
          <p class="lab-help" id="en-coa-help">Works best when each analyte is on its own line. Recognised: CBD, CBDA, THC/Δ9-THC, THCA, CBG, CBGA, CBC and CBN.</p>
          <div class="lab-actions"><button class="lab-primary" id="en-analyze-coa" type="button">Read results →</button><button class="lab-secondary" id="en-clear-coa" type="button">Clear</button></div>
        </section>

        <section class="lab-panel" aria-labelledby="coa-results-title" aria-live="polite">
          <div class="lab-panel__head"><div><p class="lab-step">2 · UNDERSTAND</p><h2 id="coa-results-title">Plain-language reading</h2></div></div>
          <div id="en-coa-empty" class="lab-empty"><div class="lab-empty__mark" aria-hidden="true">COA</div><p>Paste the results and select <strong>Read results</strong>.</p></div>
          <div id="en-coa-output" class="lab-output" hidden><div id="en-coa-summary" class="lab-summary"></div><div id="en-coa-results" class="lab-result-list"></div><div id="en-coa-terms" class="lab-terms"></div></div>
        </section>
      </div>

      <section class="lab-explainer" aria-labelledby="lab-explainer-title">
        <div><p class="lab-step">WHAT IT ACTUALLY DOES</p><h2 id="lab-explainer-title">A translator, not a verdict.</h2></div>
        <div><p>A COA can be difficult to read because laboratories use abbreviations, analytical thresholds and different units. This tool helps you orient yourself in the data reported by the laboratory.</p><p class="lab-disclaimer"><strong>It does not certify</strong> legality, safety, quality or suitability for consumption and does not replace the laboratory, a healthcare professional or legal advice.</p></div>
      </section>

      <section class="lab-glossary" aria-labelledby="lab-glossary-title">
        <p class="lab-step">MINI GLOSSARY</p><h2 id="lab-glossary-title">Three abbreviations you will often see</h2>
        <div class="lab-glossary__grid">
          <article><span>ND</span><div><h3>Not detected</h3><p>Often means the laboratory did not detect the analyte using its method. Always check the certificate legend for the laboratory's exact definition.</p></div></article>
          <article><span>LOD</span><div><h3>Limit of detection</h3><p>The threshold below which the method cannot reliably distinguish the presence of the analyte.</p></div></article>
          <article><span>LOQ</span><div><h3>Limit of quantification</h3><p>The threshold below which the laboratory may not be able to assign a sufficiently reliable quantity.</p></div></article>
        </div>
      </section>
    </div>
  </section>

  <script is:inline>
    (() => {
      const input = document.getElementById('en-coa-input');
      const analyze = document.getElementById('en-analyze-coa');
      const clear = document.getElementById('en-clear-coa');
      const example = document.getElementById('en-load-example');
      const empty = document.getElementById('en-coa-empty');
      const output = document.getElementById('en-coa-output');
      const summary = document.getElementById('en-coa-summary');
      const results = document.getElementById('en-coa-results');
      const terms = document.getElementById('en-coa-terms');
      const analytes = [
        ['THCA','THCA',/\bTHCA\b/i],
        ['THC','Δ9-THC',/(?:Δ\s*9|DELTA\s*[- ]?9|D\s*9)?\s*[- ]?THC\b|\bTHC\b/i],
        ['CBDA','CBDA',/\bCBDA\b/i],['CBD','CBD',/\bCBD\b/i],['CBGA','CBGA',/\bCBGA\b/i],['CBG','CBG',/\bCBG\b/i],['CBC','CBC',/\bCBC\b/i],['CBN','CBN',/\bCBN\b/i]
      ];
      const descriptions = {
        CBD:'Cannabidiol, one of the cannabinoids most frequently reported in COAs.',
        CBDA:'Cannabidiolic acid, the acidic precursor of CBD.',
        THC:'Delta-9-tetrahydrocannabinol, normally reported separately from THCA.',
        THCA:'Tetrahydrocannabinolic acid, the acidic precursor of THC.',
        CBG:'Cannabigerol, often present at lower concentrations than CBD or THC.',
        CBGA:'Cannabigerolic acid, a biosynthetic precursor of several cannabinoids.',
        CBC:'Cannabichromene, a minor cannabinoid included in some laboratory panels.',
        CBN:'Cannabinol, which can appear in analytical panels at low concentrations.'
      };
      const esc = (v) => String(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');
      const parse = (text) => {
        const found = []; const seen = new Set();
        for (const raw of text.split(/\r?\n/)) {
          const row = analytes.find(([, , re]) => re.test(raw));
          if (!row || seen.has(row[0])) continue;
          const [key,label] = row;
          let status = null;
          if (/<\s*LOQ\b|\bBELOW\s+LOQ\b/i.test(raw)) status='Below LOQ';
          else if (/<\s*LOD\b|\bBELOW\s+LOD\b/i.test(raw)) status='Below LOD';
          else if (/\b(?:ND|N\.D\.|NOT\s+DETECTED)\b/i.test(raw)) status='Not detected';
          const numeric = raw.match(/(?:^|\s|[:=])([0-9]+(?:[.,][0-9]+)?)\s*(%|mg\s*\/\s*g|mg\s*\/\s*ml|µg\s*\/\s*g|μg\s*\/\s*g|ug\s*\/\s*g|ppm)(?=\s|$)/i);
          if (!status && !numeric) continue;
          seen.add(key);
          found.push({ key,label,status,value:numeric ? Number.parseFloat(numeric[1].replace(',','.')) : null,unit:numeric ? numeric[2].replace(/\s+/g,'') : null, raw:raw.trim() });
        }
        return found;
      };
      const render = () => {
        const parsed = parse(input?.value || '');
        if (!parsed.length) {
          if (empty) empty.hidden = true;
          if (output) output.hidden = false;
          if (summary) summary.innerHTML = '<p><strong>No supported results were recognised.</strong></p><p>Try copying the cannabinoid result lines directly from the COA. Check the certificate legend for unusual abbreviations or units.</p>';
          if (results) results.innerHTML = '';
          if (terms) terms.innerHTML = '';
          return;
        }
        if (empty) empty.hidden = true;
        if (output) output.hidden = false;
        if (summary) summary.innerHTML = `<p><strong>${parsed.length} cannabinoid result${parsed.length === 1 ? '' : 's'} recognised.</strong></p><p>These are the values as written in the pasted text; this tool does not assess product compliance.</p>`;
        if (results) results.innerHTML = parsed.map((r) => `<article class="lab-result"><div><strong>${esc(r.label)}</strong><span>${esc(descriptions[r.key] || '')}</span></div><div class="lab-result__value">${r.value !== null ? `${esc(r.value)} ${esc(r.unit || '')}` : esc(r.status || '')}</div><small>${esc(r.raw)}</small></article>`).join('');
        const used = [...new Set(parsed.map(r => r.status).filter(Boolean))];
        if (terms) terms.innerHTML = used.length ? `<p><strong>Threshold terms detected:</strong> ${used.map(esc).join(', ')}. Their exact meaning depends on the laboratory method and certificate legend.</p>` : '';
      };
      example?.addEventListener('click', () => { if (input) input.value = 'CBD 12.4 %\nCBDA 0.8 %\nΔ9-THC < LOQ\nCBG 0.18 %\nCBN ND'; });
      clear?.addEventListener('click', () => { if (input) input.value=''; if (empty) empty.hidden=false; if (output) output.hidden=true; });
      analyze?.addEventListener('click', render);
    })();
  </script>
</EnglishSiteLayout>

<style>
  .lab-page{padding:clamp(3rem,6vw,5rem) 0 6rem}.lab-wrap{width:min(1120px,calc(100% - 2.5rem));margin-inline:auto}.lab-hero{max-width:820px;margin-bottom:2.5rem}.lab-kicker,.lab-step{color:var(--brand);font:700 .76rem/1.2 Archivo,sans-serif;letter-spacing:.1em;text-transform:uppercase}.lab-hero h1{margin:.45rem 0 1rem;font:500 clamp(3rem,7vw,5.8rem)/.94 Newsreader,serif;letter-spacing:-.04em}.lab-lead{color:var(--muted);font-size:1.13rem;line-height:1.65}.lab-privacy{display:flex;gap:.65rem;margin-top:1.2rem;padding:.8rem 1rem;border:1px solid var(--border);border-radius:3px;color:var(--muted);font-size:.9rem}.lab-privacy>span:first-child{width:.55rem;height:.55rem;margin-top:.3rem;border-radius:50%;background:var(--brand);flex:0 0 auto}.lab-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.lab-panel{padding:1.25rem;border:1px solid var(--border);border-radius:var(--r-md);background:var(--panel)}.lab-panel__head{display:flex;justify-content:space-between;gap:1rem;align-items:start}.lab-panel h2,.lab-explainer h2,.lab-glossary h2{margin:.25rem 0 1rem;font:500 clamp(1.7rem,3vw,2.4rem)/1 Newsreader,serif}.lab-link-button,.lab-secondary{border:1px solid var(--border);background:transparent;color:var(--text);border-radius:3px;padding:.55rem .7rem;cursor:pointer}.lab-panel textarea{width:100%;min-height:260px;padding:.9rem;border:1px solid var(--border);border-radius:3px;background:var(--bg);color:var(--text);font:500 .9rem/1.55 ui-monospace,monospace;resize:vertical}.lab-help{color:var(--muted);font-size:.86rem;line-height:1.5}.lab-actions{display:flex;gap:.6rem;margin-top:1rem}.lab-primary{border:0;border-radius:3px;background:var(--brand);color:#102b19;padding:.7rem .9rem;font-weight:800;cursor:pointer}.lab-empty{text-align:center;padding:3rem 1rem;color:var(--muted)}.lab-empty__mark{width:4.5rem;height:4.5rem;margin:0 auto 1rem;display:grid;place-items:center;border:1px solid var(--border);border-radius:50%;font-weight:800}.lab-result{display:grid;grid-template-columns:1fr auto;gap:.35rem 1rem;padding:1rem 0;border-top:1px solid var(--border)}.lab-result>div:first-child{display:grid;gap:.25rem}.lab-result span,.lab-result small,.lab-summary,.lab-terms{color:var(--muted);font-size:.85rem;line-height:1.45}.lab-result__value{font-weight:800}.lab-result small{grid-column:1/-1}.lab-explainer{display:grid;grid-template-columns:.8fr 1.2fr;gap:2.5rem;margin-top:3rem;padding-top:2rem;border-top:1px solid var(--border)}.lab-explainer p{color:var(--muted);line-height:1.65}.lab-disclaimer{padding-left:1rem;border-left:3px solid var(--brand)}.lab-glossary{margin-top:3rem;padding-top:2rem;border-top:1px solid var(--border)}.lab-glossary__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.lab-glossary article{display:grid;grid-template-columns:auto 1fr;gap:1rem;padding:1rem;border:1px solid var(--border);border-radius:var(--r-md)}.lab-glossary article>span{font-weight:900;color:var(--brand)}.lab-glossary h3{margin:0 0 .4rem}.lab-glossary p{margin:0;color:var(--muted);line-height:1.55;font-size:.9rem}@media(max-width:800px){.lab-grid,.lab-explainer{grid-template-columns:1fr}.lab-glossary__grid{grid-template-columns:1fr}}
</style>
