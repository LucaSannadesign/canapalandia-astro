---
export const prerender = false;

import EnglishTopicArchive from "../../../../../components/en/EnglishTopicArchive.astro";
import { EN_BLOG_CATEGORIES } from "../../../../../lib/localization";

const slug = String(Astro.params.slug ?? "").trim().toLowerCase();
const page = Number.parseInt(String(Astro.params.page ?? ""), 10);

if (!slug || !EN_BLOG_CATEGORIES.has(slug) || !Number.isInteger(page) || page < 1) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}
if (page === 1) return Astro.redirect(`/en/category/${slug}/`, 301);

const labels: Record<string, string> = {
  "cannabis-news": "Cannabis News",
  "cannabis-legalization": "Cannabis Legalization & Regulation",
  "cbd-and-nutrition": "CBD & Nutrition",
  "cannabis-and-innovation": "Cannabis & Innovation",
  "medical-cannabis": "Medical Cannabis",
  "hemp-sustainability": "Hemp & Sustainability",
  "health-wellness": "Health & Wellness",
};
const title = labels[slug] ?? slug.replace(/-/g, " ").replace(/\b\w/g, (char) => char.toUpperCase());
---

<EnglishTopicArchive
  title={title}
  eyebrow="Category"
  description={`English-language Canapalandia articles in the ${title} category.`}
  categories={[slug]}
  canonicalPath={`/en/category/${slug}/page/${page}/`}
  basePath={`/en/category/${slug}/`}
  page={page}
/>