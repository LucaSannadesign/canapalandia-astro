---
export const prerender = false;

import { getCollection } from "astro:content";
import EnglishTopicArchive from "../../../components/en/EnglishTopicArchive.astro";
import { isReachableBlogEntry } from "../../../lib/blogVisibility";
import { languageFromCategory } from "../../../lib/localization";

const slug = String(Astro.params.slug ?? "").trim().toLowerCase();
if (!slug) return new Response(null, { status: 404, statusText: "Not Found" });

const all = await getCollection("blog");
const exists = all.some((post) => {
  if (!isReachableBlogEntry(post) || post.data.editorialStatus === "legacy-review") return false;
  if (languageFromCategory(post.data.category) !== "en") return false;
  const tags = Array.isArray(post.data.tags) ? post.data.tags.map((tag) => String(tag).trim().toLowerCase()) : [];
  return tags.includes(slug);
});
if (!exists) return new Response(null, { status: 404, statusText: "Not Found" });

const title = slug.replace(/-/g, " ").replace(/\b\w/g, (char) => char.toUpperCase());
---

<EnglishTopicArchive
  title={title}
  eyebrow="Tag"
  description={`English-language Canapalandia articles tagged “${title}”.`}
  tags={[slug]}
  canonicalPath={`/en/tag/${slug}/`}
  basePath={`/en/tag/${slug}/`}
  robots="noindex,follow"
/>