---
export const prerender = false;

import EnglishTopicArchive from "../../../../components/en/EnglishTopicArchive.astro";
import { EN_BLOG_CATEGORIES } from "../../../../lib/localization";

const section = String(Astro.params.section ?? "").trim().toLowerCase();
const page = Number.parseInt(String(Astro.params.page ?? ""), 10);

const sections: Record<string, { title: string; eyebrow: string; description: string; categories: string[] }> = {
  blog: {
    title: "Canapalandia in English",
    eyebrow: "English archive",
    description: "All current English-language Canapalandia articles on cannabis, hemp, CBD, regulation, health, sustainability and innovation.",
    categories: Array.from(EN_BLOG_CATEGORIES),
  },
  news: {
    title: "Cannabis & Hemp News",
    eyebrow: "News",
    description: "English-language reporting from Canapalandia on cannabis, hemp, CBD, research, markets and the developments shaping the sector in Italy and Europe.",
    categories: ["cannabis-news", "cannabis-and-innovation"],
  },
  policy: {
    title: "Cannabis Policy & Regulation",
    eyebrow: "Policy",
    description: "Laws, court decisions, European regulation and medical-cannabis policy explained in English, with a focus on Italy and the wider European context.",
    categories: ["cannabis-legalization", "medical-cannabis"],
  },
  cbd: {
    title: "CBD, Nutrition & Wellness",
    eyebrow: "CBD",
    description: "Evidence-aware English coverage of CBD, hemp foods, nutrition and wellness. We separate established facts from uncertainty and avoid medical promises.",
    categories: ["cbd-and-nutrition", "health-wellness"],
  },
  hemp: {
    title: "Hemp, Sustainability & Innovation",
    eyebrow: "Hemp",
    description: "English articles on industrial hemp, sustainability, materials, agriculture and innovation, with attention to what the evidence supports and where the limits are.",
    categories: ["hemp-sustainability", "cannabis-and-innovation"],
  },
};

const config = sections[section];
if (!config || !Number.isInteger(page) || page < 1) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

if (page === 1) {
  return Astro.redirect(`/en/${section}/`, 301);
}
---

<EnglishTopicArchive
  title={config.title}
  eyebrow={config.eyebrow}
  description={config.description}
  categories={config.categories}
  canonicalPath={`/en/${section}/page/${page}/`}
  basePath={`/en/${section}/`}
  page={page}
/>