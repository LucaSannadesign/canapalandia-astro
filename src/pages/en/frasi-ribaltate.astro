---
import EnglishSiteLayout from "../../layouts/EnglishSiteLayout.astro";
import { listRibaltate } from "../../lib/repositories/ribaltatoreRepo";
import { cleanPhrase } from "../../lib/utils";

export const prerender = false;

const pageSize = 20;
const currentPage = Math.max(1, Number(Astro.url.searchParams.get("page")) || 1);
let items: any[] = [];
let totalPages = 0;
let total = 0;
let errorMessage: string | null = null;

try {
  const result = await listRibaltate({ page: currentPage, pageSize });
  items = result.items || [];
  totalPages = result.totalPages || 0;
  total = result.total || 0;
} catch (err: any) {
  console.error("[en/reframed-phrases] DB error:", err);
  errorMessage = err?.message || "Unable to load the archive";
}

const SITE = Astro.site?.origin ?? "https://canapalandia.com";
---

<EnglishSiteLayout
  title="Reframed phrases | Canapalandia"
  description="Archive of phrases generated by Canapalandia's AI Reframer, with copy and sharing tools."
  canonical="/en/frasi-ribaltate/"
  alternateIt="/frasi-ribaltate/"
>
  <section class="archive">
    <header>
      <p class="eyebrow">AI Reframer archive</p>
      <h1>🧠 Reframed phrases</h1>
      <p>Responses generated by Canapalandia's satirical AI Reframer. Older archive entries may be in Italian because they were created before the English edition.</p>
    </header>

    {errorMessage ? (
      <div class="error" role="alert">⚠️ Unable to load the archive: {errorMessage}</div>
    ) : items.length ? (
      <div class="cards">
        {items.map((frase, index) => {
          const original = cleanPhrase(frase.frase_originale);
          const reframed = cleanPhrase(frase.frase_ribaltata, true);
          const anchorId = frase.id ? `r-${frase.id}` : `r-${index + 1}`;
          const shareUrl = `${SITE}/en/frasi-ribaltate/#${anchorId}`;
          return (
            <article id={anchorId} class="card">
              <p class="date">{new Date(frase.created_at).toLocaleDateString("en-GB", { year:"numeric", month:"short", day:"numeric" })}</p>
              <p class="original"><strong>Original:</strong> <em>{original}</em></p>
              <blockquote>{reframed}</blockquote>
              <div class="actions">
                <button type="button" data-copy={reframed}>Copy</button>
                <button type="button" data-share-url={shareUrl} data-share-text={reframed}>Share</button>
              </div>
            </article>
          );
        })}
      </div>
    ) : <p class="empty">No reframed phrases have been found yet.</p>}

    {totalPages > 1 ? (
      <nav class="pagination" aria-label="Archive pagination">
        {currentPage > 1 ? <a href={`/en/frasi-ribaltate/?page=${currentPage - 1}`}>← Previous</a> : <span></span>}
        <span>Page {currentPage} of {totalPages} · {total} phrases</span>
        {currentPage < totalPages ? <a href={`/en/frasi-ribaltate/?page=${currentPage + 1}`}>Next →</a> : <span></span>}
      </nav>
    ) : null}

    <div class="cta"><a href="/en/ribaltatore/">🔥 Try the AI Reframer</a></div>
    <p id="archive-copy-status" class="status" aria-live="polite"></p>
  </section>

  <script is:inline>
    (() => {
      const status = document.getElementById('archive-copy-status');
      document.querySelectorAll('[data-copy]').forEach((button) => {
        button.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(button.getAttribute('data-copy') || ''); if (status) status.textContent = 'Copied.'; }
          catch { if (status) status.textContent = 'Copying is not available in this browser.'; }
        });
      });
      document.querySelectorAll('[data-share-url]').forEach((button) => {
        button.addEventListener('click', async () => {
          const text = button.getAttribute('data-share-text') || '';
          const url = button.getAttribute('data-share-url') || location.href;
          if (navigator.share) { try { await navigator.share({ text, url }); } catch {} }
          else { try { await navigator.clipboard.writeText(`${text}\n${url}`); if (status) status.textContent = 'Share text copied.'; } catch {} }
        });
      });
    })();
  </script>
</EnglishSiteLayout>

<style>
  .archive{max-width:940px;margin:0 auto;padding:3rem 0 5rem}.archive header{text-align:center;max-width:720px;margin:0 auto 2.5rem}.eyebrow{color:var(--brand);font:700 .76rem/1.2 Archivo,sans-serif;letter-spacing:.1em;text-transform:uppercase}.archive h1{margin:.4rem 0 .7rem;font:500 clamp(3rem,7vw,5rem)/.95 Newsreader,serif}.archive header>p:last-child{color:var(--muted);line-height:1.6}.cards{display:grid;gap:1rem}.card{padding:1.25rem;border:1px solid var(--border);border-radius:var(--r-md);background:var(--panel)}.date{margin:0 0 .7rem;color:var(--muted);font-size:.78rem;text-transform:uppercase;letter-spacing:.05em}.original{color:var(--muted);line-height:1.5}.card blockquote{margin:1rem 0;padding-left:1rem;border-left:3px solid var(--brand);font:500 1.25rem/1.55 Newsreader,serif;white-space:pre-line}.actions{display:flex;gap:.5rem}.actions button,.pagination a,.cta a{border:1px solid var(--border);border-radius:3px;background:transparent;color:var(--text);padding:.55rem .75rem;text-decoration:none;cursor:pointer;font-weight:700}.pagination{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem;margin-top:2rem;color:var(--muted);font-size:.9rem}.pagination a:last-child{justify-self:end}.cta{text-align:center;margin-top:3rem}.cta a{display:inline-flex;background:var(--brand);border-color:var(--brand);color:#102b19;padding:.75rem 1rem}.error{padding:1rem;border-left:3px solid #b45309;background:var(--panel)}.empty,.status{text-align:center;color:var(--muted)}@media(max-width:600px){.pagination{grid-template-columns:1fr;text-align:center}.pagination a{justify-self:center!important}}
</style>
