---
import EnglishSiteLayout from "../../layouts/EnglishSiteLayout.astro";

const groups = [
  {
    title: "Editorial",
    links: [
      ["English home", "/en/"],
      ["News", "/en/news/"],
      ["Policy", "/en/policy/"],
      ["CBD", "/en/cbd/"],
      ["Hemp", "/en/hemp/"],
      ["All English articles", "/en/blog/"],
      ["Search", "/en/search/"],
    ],
  },
  {
    title: "Canapalandia",
    links: [
      ["About us", "/en/about/"],
      ["Contact", "/en/contact/"],
      ["Support us", "/en/support/"],
      ["Advertising and collaborations", "/en/advertising/"],
      ["Canapalandia Lab", "/en/lab/"],
      ["AI Reframer", "/en/ribaltatore/"],
      ["Reframed phrases", "/en/frasi-ribaltate/"],
      ["Shop experiment", "/en/bottega/"],
    ],
  },
  {
    title: "Legal and privacy",
    links: [
      ["Disclaimer", "/en/disclaimer/"],
      ["Privacy Policy", "/en/privacy/"],
      ["Cookie Policy", "/en/cookies/"],
      ["Terms and Conditions", "/en/terms/"],
    ],
  },
];
---
<EnglishSiteLayout
  title="English sitemap | Canapalandia"
  description="Main pages and sections of Canapalandia's English edition."
  canonical="/en/sitemap/"
  alternateIt="/mappa-del-sito/"
>
  <section class="en-sitemap">
    <p class="eyebrow">Sitemap</p>
    <h1>Explore Canapalandia in English</h1>
    <p class="intro">The main editorial, informational and legal pages of the English edition.</p>
    <div class="groups">
      {groups.map((group) => (
        <section>
          <h2>{group.title}</h2>
          <ul>
            {group.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
          </ul>
        </section>
      ))}
    </div>
  </section>
</EnglishSiteLayout>
<style>
  .en-sitemap{max-width:1000px;margin:0 auto;padding:2.5rem 0 5rem}.eyebrow{color:var(--brand);font:700 .78rem/1.2 Archivo,sans-serif;letter-spacing:.1em;text-transform:uppercase}h1{margin:.35rem 0 .7rem;font:500 clamp(3rem,7vw,5.5rem)/.95 Newsreader,serif}.intro{color:var(--muted);max-width:60ch;line-height:1.6}.groups{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.2rem;margin-top:2.5rem}.groups section{border-top:1px solid var(--border);padding-top:1rem}.groups h2{font:500 1.7rem/1.1 Newsreader,serif}.groups ul{list-style:none;padding:0;margin:0;display:grid;gap:.65rem}.groups a{color:inherit;text-decoration:none}.groups a:hover{color:var(--brand)}@media(max-width:760px){.groups{grid-template-columns:1fr}}
</style>
