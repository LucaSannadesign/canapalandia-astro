---
import EnglishSiteLayout from "../../layouts/EnglishSiteLayout.astro";
---

<EnglishSiteLayout
  title="Proposal received | Canapalandia"
  description="Your editorial collaboration proposal has been sent to Canapalandia."
  canonical="/en/thanks-collaboration/"
  robots="noindex,follow"
>
  <section class="thanks">
    <p class="eyebrow">Proposal received</p>
    <h1>Thank you. We will review it manually.</h1>
    <p>Your collaboration proposal has reached the Canapalandia editorial inbox. Submission does not guarantee publication; we will reply if the proposal fits the project and requires a next step.</p>
    <div><a class="primary" href="/en/">English home</a><a href="/en/collaborate/">Collaboration criteria</a></div>
  </section>
</EnglishSiteLayout>
<style>
  .thanks{max-width:760px;margin:0 auto;padding:5rem 0 7rem;text-align:center}.eyebrow{color:var(--brand);font:700 .76rem/1.2 Archivo,sans-serif;letter-spacing:.1em;text-transform:uppercase}.thanks h1{margin:.5rem 0 1rem;font:500 clamp(3rem,7vw,5rem)/.95 Newsreader,serif}.thanks>p:nth-of-type(2){color:var(--muted);line-height:1.65}.thanks div{display:flex;flex-wrap:wrap;justify-content:center;gap:.65rem;margin-top:1.5rem}.thanks a{border:1px solid var(--border);border-radius:3px;padding:.7rem .9rem;text-decoration:none;font-weight:700}.thanks .primary{background:var(--brand);border-color:var(--brand);color:#102b19}
</style>
