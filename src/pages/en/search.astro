---
export const prerender = false;

import { getCollection } from "astro:content";
import CardPost from "../../components/CardPost.astro";
import EnglishSiteLayout from "../../layouts/EnglishSiteLayout.astro";
import { blogPublishDate } from "../../lib/blogVisibility";
import {
  SEARCH_MAX_QUERY_LENGTH,
  SEARCH_RESULTS_LIMIT,
  postHref,
  postImageSrc,
  readSearchQuery,
  searchPosts,
  searchablePosts,
  tokenizeSearchQuery,
} from "../../lib/search";

const q = readSearchQuery(Astro.url);
const tokens = tokenizeSearchQuery(q);

// Same source and editorial gate as the blog listings: published English posts only.
const posts = searchablePosts(await getCollection("blog"), "en");
const resultPosts = tokens.length
  ? searchPosts(posts, tokens).slice(0, SEARCH_RESULTS_LIMIT)
  : posts.slice(0, 12);

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const dateLabel = (entry: (typeof posts)[number]) => {
  const d = blogPublishDate(entry);
  return d ? dateFormatter.format(d) : "";
};

const canonical = `${import.meta.env.SITE || "https://canapalandia.com"}/en/search/`;
---

<EnglishSiteLayout
  title="Search Canapalandia in English"
  description="Search English-language Canapalandia articles by topic or keyword."
  canonical={canonical}
  robots="noindex,follow"
  alternateIt="/cerca/"
>
  <section class="en-search">
    <header>
      <p class="eyebrow">Search</p>
      <h1>Search the English edition</h1>
      <p>Find articles by topic, keyword or subject.</p>
      <form method="get" action="/en/search/" role="search">
        <label class="sr-only" for="en-q">Search</label>
        <input
          id="en-q"
          name="q"
          type="search"
          placeholder="Search…"
          value={q}
          maxlength={SEARCH_MAX_QUERY_LENGTH}
          autocomplete="off"
          enterkeyhint="search"
        />
        <button type="submit">Search</button>
      </form>
    </header>

    <section aria-live="polite">
      <div class="results-head">
        <h2>{tokens.length ? (resultPosts.length ? "Results" : "No results") : q ? "Query too short" : "Latest English articles"}</h2>
        {tokens.length && resultPosts.length ? <p>Articles ordered by relevance.</p> : null}
        {tokens.length && !resultPosts.length ? <p>No matches were found for <strong>{q}</strong>.</p> : null}
        {q && !tokens.length ? <p>Type at least two letters to search. Latest articles are shown below.</p> : null}
      </div>

      <div class="results-grid">
        {resultPosts.map((entry) => (
          <CardPost
            href={postHref(entry)}
            img={postImageSrc(entry) || undefined}
            date={dateLabel(entry)}
            publishDate={entry.data.publishDate}
            updatedDate={entry.data.updatedDate}
            title={entry.data.title}
            excerpt={entry.data.description}
            category={entry.data.category || null}
          />
        ))}
      </div>
    </section>
  </section>
</EnglishSiteLayout>

<style>
  .en-search { max-width: 1180px; margin: 0 auto; padding: 2.25rem 1rem 4rem; }
  .en-search header { max-width: 760px; margin-bottom: 2.5rem; }
  .eyebrow { color: var(--brand); font: 700 .78rem/1.2 Archivo,sans-serif; letter-spacing: .1em; text-transform: uppercase; }
  h1 { margin: .3rem 0 .7rem; font: 500 clamp(2.8rem,6vw,5rem)/.96 Newsreader,serif; }
  header > p:last-of-type { color: var(--muted); }
  form { display:flex; gap:.6rem; margin-top:1.2rem; }
  form input {
    flex:1;
    min-width:0;
    min-height:44px;
    font-size:16px;
    padding:.85rem .9rem;
    border:1px solid var(--border);
    border-radius:3px;
    background:var(--panel);
    color:var(--text);
  }
  form button {
    min-height:44px;
    border:0;
    border-radius:3px;
    padding:.85rem 1.1rem;
    background:var(--brand);
    color:#102b19;
    font-weight:800;
    cursor:pointer;
  }
  .results-head { margin-bottom: 1.1rem; }
  .results-head h2 { margin: 0 0 .4rem; font: 500 2rem/1 Newsreader,serif; }
  .results-head p { margin: 0; color: var(--muted); }
  .results-grid {
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:1.5rem;
    align-items: stretch;
  }
  .sr-only {
    position:absolute;
    width:1px;
    height:1px;
    padding:0;
    margin:-1px;
    overflow:hidden;
    clip:rect(0,0,0,0);
    white-space:nowrap;
    border:0;
  }
  @media(max-width:850px){
    .results-grid{grid-template-columns:repeat(2,minmax(0,1fr));}
  }
  @media(max-width:600px){
    form{flex-direction:column}
    form button{width:100%}
    .results-grid{grid-template-columns:1fr;gap:1.1rem}
  }
</style>
