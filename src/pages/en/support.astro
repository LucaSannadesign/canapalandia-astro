---
import EnglishSiteLayout from "../../layouts/EnglishSiteLayout.astro";

const BENEFICIARY = "Luca Sanna";
const IBAN = "IT70T0366901600142404006713";
const IBAN_DISPLAY = "IT70 T036 6901 6001 4240 4006 713";
const BIC = "REVOITM2";
const PAYMENT_REFERENCE = "Sostegno Canapalandia";

const impact = [
  ["01", "Sources and verification", "More time to check laws, official documents and studies before publication."],
  ["02", "Updates", "Reviewing important pages when rules, evidence or context change."],
  ["03", "Independence", "More room for useful content without turning every article into a promotion."],
] as const;
---

<EnglishSiteLayout
  title="Support Canapalandia | Independent information"
  description="Support Canapalandia and help keep an independent editorial project on hemp, CBD, regulation, research and culture available."
  canonical="/en/support/"
  alternateIt="/sostieni-la-nostra-causa/"
  shell={false}
>
  <div class="support-page">
    <nav class="support-crumbs" aria-label="Breadcrumb">
      <div class="support-wrap"><a href="/en/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Support Canapalandia</span></div>
    </nav>

    <section class="support-hero" aria-labelledby="support-title">
      <div class="support-wrap support-hero__grid">
        <div>
          <p class="support-kicker">Support Canapalandia</p>
          <h1 id="support-title">Freer information grows with the people who support it.</h1>
          <p class="support-lead">Canapalandia is an independent editorial project. Your contribution helps us verify sources more carefully, update content and keep the project accessible.</p>
          <div class="support-actions">
            <a class="support-btn support-btn--primary" href="#bank-transfer">View bank details</a>
            <a class="support-btn support-btn--ghost" href="/en/blog/">Explore the English archive</a>
          </div>
        </div>
        <aside class="support-manifesto" aria-label="Editorial principle">
          <p class="support-overline">Why it matters</p>
          <blockquote>“It is not only about hemp. It is about freedom, justice and truth.”</blockquote>
          <p>Every action is a seed. Plant it with us.</p>
        </aside>
      </div>
    </section>

    <section class="support-impact" aria-labelledby="impact-title">
      <div class="support-wrap">
        <header class="support-section-head">
          <div>
            <p class="support-overline">What you make possible</p>
            <h2 id="impact-title">A stronger, more verifiable project.</h2>
          </div>
          <p>The support is used for editorial work, updates and the infrastructure that keeps Canapalandia online.</p>
        </header>
        <div class="support-impact__grid">
          {impact.map(([num, heading, text]) => (
            <article><span>{num}</span><h3>{heading}</h3><p>{text}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section id="bank-transfer" class="support-payment" aria-labelledby="payment-title">
      <div class="support-wrap support-payment__grid">
        <div>
          <p class="support-overline">Direct support</p>
          <h2 id="payment-title">Bank transfer</h2>
          <p>To receive contributions, we publish only the information strictly necessary to make a bank transfer. No additional personal or banking data are exposed.</p>
          <div class="support-note">
            <strong>Editorial transparency</strong>
            <span>Support is voluntary and does not entitle the contributor to advertising, favourable coverage or preferential editorial treatment.</span>
          </div>
        </div>

        <div class="support-bank-card" aria-label="Bank transfer details">
          <header><div><p class="support-overline">Revolut</p><h3>Bank details</h3></div><span>EUR</span></header>
          <dl>
            <div><dt>Beneficiary</dt><dd>{BENEFICIARY}</dd></div>
            <div><dt>IBAN</dt><dd><code>{IBAN_DISPLAY}</code><button type="button" data-copy={IBAN} data-label="IBAN">Copy</button></dd></div>
            <div><dt>BIC / SWIFT</dt><dd><code>{BIC}</code><button type="button" data-copy={BIC} data-label="BIC">Copy</button></dd></div>
            <div><dt>Suggested payment reference</dt><dd><span>{PAYMENT_REFERENCE}</span><button type="button" data-copy={PAYMENT_REFERENCE} data-label="Payment reference">Copy</button></dd></div>
          </dl>
          <p class="support-help">The BIC/SWIFT code is needed only if your bank asks for it. The suggested payment reference is intentionally kept in Italian so it matches the current account instructions.</p>
          <p class="copy-status" aria-live="polite"></p>
        </div>
      </div>
    </section>

    <section class="support-trust" aria-labelledby="trust-title">
      <div class="support-wrap support-trust__grid">
        <div><p class="support-overline">Independence first</p><h2 id="trust-title">Support does not buy visibility.</h2></div>
        <div><p>Commercial collaborations follow a separate process and are disclosed transparently.</p><a href="/en/advertising/">Advertising and partnerships →</a></div>
      </div>
    </section>

    <section class="support-final">
      <div class="support-wrap"><div class="support-final__panel"><p class="support-overline">Canapalandia</p><h2>Thank you for helping independent information stay available.</h2><a class="support-btn support-btn--light" href="#bank-transfer">Bank details</a></div></div>
    </section>
  </div>

  <script>
    const status = document.querySelector('.copy-status');
    document.querySelectorAll('[data-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        const value = button.getAttribute('data-copy') || '';
        const label = button.getAttribute('data-label') || 'Value';
        try {
          await navigator.clipboard.writeText(value);
          if (status) status.textContent = `${label} copied to clipboard.`;
          button.textContent = 'Copied';
          window.setTimeout(() => {
            button.textContent = 'Copy';
            if (status) status.textContent = '';
          }, 1600);
        } catch {
          if (status) status.textContent = `Copy manually: ${value}`;
        }
      });
    });
  </script>
</EnglishSiteLayout>

<style>
  .support-page{overflow:clip}.support-wrap{width:min(1120px,calc(100% - 2.5rem));margin-inline:auto}.support-crumbs{padding:.9rem 0;border-bottom:1px solid var(--border)}.support-crumbs .support-wrap{display:flex;gap:.6rem;color:var(--muted);font-size:.84rem}.support-crumbs a{color:inherit;text-decoration:none}.support-hero{padding:clamp(3.2rem,6vw,5.4rem) 0}.support-hero__grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr);gap:clamp(2.5rem,5vw,4.5rem);align-items:center}.support-kicker,.support-overline{margin:0 0 .9rem;color:var(--brand);font:700 .75rem/1.2 Archivo,sans-serif;letter-spacing:.13em;text-transform:uppercase}.support-hero h1{max-width:14ch;margin:0;font:500 clamp(2.9rem,5vw,5rem)/1 Newsreader,serif;letter-spacing:-.04em}.support-lead{max-width:58ch;margin:1.5rem 0 0;color:var(--muted);font-size:1.1rem;line-height:1.62}.support-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.7rem}.support-btn{display:inline-flex;align-items:center;justify-content:center;padding:.75rem 1.1rem;border:1px solid transparent;border-radius:999px;font-weight:800;text-decoration:none}.support-btn--primary{background:var(--brand);color:#102b19}.support-btn--ghost{border-color:var(--border);color:var(--text)}.support-manifesto{padding:1.6rem;border:1px solid var(--border);border-radius:20px;background:var(--panel)}.support-manifesto blockquote{margin:0;font:500 clamp(1.4rem,2vw,1.85rem)/1.22 Newsreader,serif}.support-manifesto>p:last-child{margin:1.1rem 0 0;color:var(--muted);font-style:italic}.support-impact,.support-trust{padding:clamp(3.5rem,6vw,5.6rem) 0;border-top:1px solid var(--border)}.support-section-head,.support-trust__grid{display:grid;grid-template-columns:1.05fr .95fr;gap:2.5rem;align-items:end}.support-section-head h2,.support-payment h2,.support-trust h2,.support-final h2{margin:0;font:500 clamp(2.1rem,4vw,3.6rem)/1.04 Newsreader,serif}.support-section-head>p,.support-trust__grid>div:last-child{color:var(--muted);line-height:1.65}.support-impact__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:2rem}.support-impact__grid article{padding:1.5rem;border:1px solid var(--border);border-radius:16px;background:var(--panel)}.support-impact__grid article>span{color:var(--muted);font-size:.75rem}.support-impact__grid h3{margin:1.6rem 0 .55rem}.support-impact__grid p{margin:0;color:var(--muted);line-height:1.58}.support-payment{scroll-margin-top:84px;padding:clamp(3.8rem,6vw,5.8rem) 0;background:#f5f1e8;color:#173b29}.support-payment__grid{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(2.5rem,5vw,4.5rem);align-items:start}.support-payment .support-overline{color:#557062}.support-payment__grid>div:first-child>p:not(.support-overline){color:#557062;line-height:1.65}.support-note{display:grid;gap:.25rem;margin-top:1.4rem;padding:1rem 1.1rem;border-left:3px solid #d6b56d;background:rgba(255,255,255,.5);color:#557062}.support-note strong{color:#173b29}.support-bank-card{padding:1.5rem;border:1px solid rgba(23,59,41,.16);border-radius:20px;background:#fffdf8;box-shadow:0 16px 38px rgba(23,59,41,.07)}.support-bank-card header{display:flex;justify-content:space-between;gap:1rem;padding-bottom:1rem;border-bottom:1px solid rgba(23,59,41,.13)}.support-bank-card h3{margin:0;font-size:1.5rem}.support-bank-card header>span{font-weight:800}.support-bank-card dl{margin:0}.support-bank-card dl>div{display:grid;grid-template-columns:180px 1fr;gap:1rem;padding:1rem 0;border-bottom:1px solid rgba(23,59,41,.1)}.support-bank-card dt{color:#557062;font-weight:700}.support-bank-card dd{margin:0;display:flex;flex-wrap:wrap;gap:.55rem;align-items:center;justify-content:space-between}.support-bank-card code{color:#173b29;background:transparent;font-weight:700}.support-bank-card button{border:1px solid rgba(23,59,41,.22);border-radius:999px;background:white;padding:.4rem .7rem;cursor:pointer}.support-help,.copy-status{color:#557062;font-size:.85rem;line-height:1.5}.support-trust a{color:var(--brand);font-weight:700}.support-final{padding:4rem 0 5rem}.support-final__panel{padding:clamp(2rem,5vw,4rem);border-radius:24px;background:#173b29;color:#fff}.support-final__panel .support-overline{color:#d6b56d}.support-final__panel h2{max-width:16ch}.support-btn--light{margin-top:1.5rem;background:#fff;color:#173b29}@media(max-width:800px){.support-hero__grid,.support-section-head,.support-payment__grid,.support-trust__grid{grid-template-columns:1fr}.support-impact__grid{grid-template-columns:1fr}.support-bank-card dl>div{grid-template-columns:1fr}.support-bank-card dd{justify-content:flex-start}}
</style>
