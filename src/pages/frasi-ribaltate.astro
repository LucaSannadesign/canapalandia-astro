---
/**
 * Pagina archivio Frasi Ribaltate
 * Replica ESATTAMENTE il comportamento del PHP page-frasi-ribaltate.php
 * 
 * Comportamento:
 * - Lista paginata (20 per pagina)
 * - Ordine DESC (più recenti in alto)
 * - Card per ogni frase con copy e share
 * - Controlli paginazione (Prev/Next + indicazione pagina)
 */
import SiteLayout from "@/layouts/SiteLayout.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import { listRibaltate } from "@/lib/repositories/ribaltatoreRepo";
import { cleanPhrase } from "@/lib/utils";

// Forza SSR (non prerender)
export const prerender = false;

// Variabili env SSR-safe (definite nel frontmatter)
const isDev = import.meta.env.DEV;

const pageSize = 20;
const currentPage = Number(Astro.url.searchParams.get("page")) || 1;

let items: any[] = [];
let totalPages = 0;
let total = 0;
let errorMessage: string | null = null;

try {
  const result = await listRibaltate({ page: currentPage, pageSize });
  items = result.items || [];
  totalPages = result.totalPages || 0;
  total = result.total || 0;
} catch (err: any) {
  console.error("[frasi-ribaltate] Errore DB:", err);
  errorMessage = err?.message || "Errore nel caricamento dei dati";
  // In sviluppo, mostra l'errore anche nella pagina
  if (isDev) {
    console.error("[frasi-ribaltate] Dettagli errore:", {
      message: err?.message,
      stack: err?.stack,
      code: err?.code,
    });
  }
}

const title = "🧠 Frasi Ribaltate | Canapalandia";
const canonical = `${import.meta.env.SITE || "https://canapalandia.com"}/frasi-ribaltate/`;
const SITE = Astro.site?.origin ?? "https://canapalandia.com";
---

<SiteLayout title={title} canonical={canonical}>
  <main id="contenuto">
    <div class="container">
      <div class="frasi-page">
        <h1 class="frasi-title">🧠 Frasi Ribaltate</h1>
        <p class="frasi-subtitle">
          Qui trovi una raccolta delle frasi ribaltate generate dall'intelligenza satirica del nostro Ribaltatore AI.<br />
          Copiale, condividile, e aiutaci a diffondere la verità con ironia!
        </p>

        {errorMessage ? (
          <div class="frasi-error">
            <p>⚠️ Errore nel caricamento: {errorMessage}</p>
            {isDev && (
              <p style="font-size: 0.85rem; color: var(--muted); margin-top: 8px;">
                Verifica che SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY siano configurate in .env
              </p>
            )}
          </div>
        ) : items.length > 0 ? (
          <>
            {items.map((frase, index) => {
              const url = `/ribaltate-ai/${frase.id}/`;
              
              // Pulisci frasi da caratteri escapati
              const fraseOriginale = cleanPhrase(frase.frase_originale);
              const fraseRibaltata = cleanPhrase(frase.frase_ribaltata, true); // Preserva newline per formattazione
              
              // Anteprima ribaltata (max 3 righe)
              const righe = fraseRibaltata.split(/\n/).filter((r: string) => r.trim() !== "");
              const anteprima = righe.slice(0, 3).join(" ").slice(0, 200);
              const mostraAnteprima = fraseRibaltata.length > 200 || righe.length > 3;
              
              // Anchor ID: usa frase.id se disponibile, altrimenti index
              const anchorId = frase.id ? `r-${frase.id}` : `r-${index + 1}`;
              
              // URL assoluto con anchor per condivisione
              const shareUrl = `${SITE}/frasi-ribaltate/#${anchorId}`;
              
              return (
                <article id={anchorId} class="frasi-card">
                  <div class="frasi-card__header">
                    <p class="frasi-card__meta">
                      {new Date(frase.created_at).toLocaleDateString("it-IT", {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                      })}
                    </p>
                  </div>

                  <p class="frasi-card__originale">
                    <strong>Proibizionista:</strong> <em>{fraseOriginale}</em>
                  </p>

                  <div class="frasi-card__ribaltata-preview">
                    <p class="frasi-card__ribaltata-text">
                      {mostraAnteprima ? anteprima + "…" : fraseRibaltata}
                    </p>
                  </div>

                  {/* Pulsanti di condivisione */}
                  <ShareButtons url={shareUrl} text={fraseRibaltata} />

                  <div class="frasi-card__actions">
                    <a href={url} class="frasi-card__link-btn">
                      Apri →
                    </a>
                  </div>
                </article>
              );
            })}

            {totalPages > 1 && (
              <div class="frasi-pagination">
                {currentPage > 1 && (
                  <a
                    href={`/frasi-ribaltate/?page=${currentPage - 1}`}
                    class="frasi-pagination__link"
                    aria-label="Pagina precedente"
                  >
                    « Indietro
                  </a>
                )}
                <span class="frasi-pagination__info">
                  Pagina {currentPage} di {totalPages} ({total} frasi)
                </span>
                {currentPage < totalPages && (
                  <a
                    href={`/frasi-ribaltate/?page=${currentPage + 1}`}
                    class="frasi-pagination__link"
                    aria-label="Pagina successiva"
                  >
                    Avanti »
                  </a>
                )}
              </div>
            )}
          </>
        ) : (
          <p class="frasi-empty">Ancora nessuna frase ribaltata trovata.</p>
        )}

        <div class="frasi-cta">
          <a href="/ribaltatore/" class="frasi-button">
            🔥 Prova anche tu il Ribaltatore
          </a>
        </div>
      </div>
    </div>
  </main>
</SiteLayout>

<style>
  .frasi-page {
    max-width: 950px;
    margin: 60px auto;
    padding: 0 var(--gutter, 24px);
  }

  .frasi-title {
    text-align: center;
    font-size: clamp(1.8rem, 4vw, 2rem);
    margin-bottom: 20px;
    line-height: 1.2;
  }

  .frasi-subtitle {
    text-align: center;
    font-size: 1.1rem;
    margin-bottom: 40px;
    color: var(--muted);
    line-height: 1.6;
  }

  .frasi-card {
    border: 1px solid var(--border);
    padding: 20px 24px;
    border-radius: 12px;
    background: var(--panel);
    margin-bottom: 20px;
    font-size: 0.95rem;
  }

  .frasi-card__header {
    margin-bottom: 12px;
  }

  .frasi-card__meta {
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .frasi-card__originale {
    margin: 0 0 16px;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .frasi-card__originale strong {
    font-weight: 600;
    margin-right: 6px;
  }

  .frasi-card__originale em {
    font-style: italic;
    color: var(--muted);
  }

  .frasi-card__ribaltata-preview {
    margin-bottom: 16px;
  }

  .frasi-card__ribaltata-text {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text);
    font-weight: 500;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .frasi-card__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .frasi-card__link-btn {
    padding: 10px 20px;
    background: var(--brand);
    color: white;
    border: none;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: background 0.2s ease, transform 0.1s ease;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
  }

  .frasi-card__link-btn:hover {
    background: var(--gold);
    color: var(--gold-ink);
    transform: translateY(-1px);
  }

  .frasi-pagination {
    text-align: center;
    margin-top: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .frasi-pagination__link {
    padding: 10px 20px;
    background: var(--brand);
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: background 0.2s ease;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .frasi-pagination__link:hover {
    background: var(--gold);
    color: var(--gold-ink);
  }

  .frasi-pagination__info {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .frasi-empty {
    text-align: center;
    padding: 60px 20px;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .frasi-error {
    text-align: center;
    padding: 24px;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 8px;
    color: #ef4444;
    margin: 20px 0;
  }

  .frasi-error {
    text-align: center;
    padding: 24px;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 8px;
    color: #ef4444;
    margin: 20px 0;
  }

  .frasi-cta {
    margin-top: 60px;
    text-align: center;
  }

  .frasi-button {
    background: var(--brand);
    color: white;
    padding: 12px 28px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.2s ease;
    display: inline-block;
    min-height: 44px;
  }

  .frasi-button:hover {
    background: var(--gold);
    color: var(--gold-ink);
  }

  @media (max-width: 767px) {
    .frasi-page {
      margin: 40px auto;
      padding: 0 var(--gutter, 10px);
    }

    .frasi-card {
      padding: 16px 18px;
    }

    .frasi-card__ribaltata-text {
      font-size: 1rem;
    }

    .frasi-card__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .frasi-card__link-btn {
      width: 100%;
      justify-content: center;
    }

    .frasi-pagination {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
