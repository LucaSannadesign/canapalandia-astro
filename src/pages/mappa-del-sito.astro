---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

const categoryLabels: Record<string, string> = {
  'cannabis-news-it': 'Notizie sulla cannabis',
  'normativa': 'Normativa',
  'cbd-alimentazione': 'CBD e alimentazione',
  'canapa-e-ambiente': 'Canapa e ambiente',
  'salute-benessere': 'Salute e benessere',
  'cbd-bellezza-cura-pelle': 'CBD, bellezza e cura della pelle',
  'cannabis-legalization': 'Legalizzazione cannabis',
};

function formatCategoryLabel(value: string): string {
  const normalized = String(value || 'Articoli').trim();
  const key = normalized.toLowerCase();
  if (categoryLabels[key]) return categoryLabels[key];

  return normalized
    .replace(/[-_]+/g, ' ')
    .replace(/\s+/g, ' ')
    .replace(/^./, (letter) => letter.toUpperCase());
}

const sortedPosts = posts
  .filter(post => !post.data.draft && post.data.editorialStatus !== 'legacy-review')
  .sort((a, b) => {
    const dateA = new Date(a.data.publishDate || a.data.date || a.data.pubDate || '1970-01-01');
    const dateB = new Date(b.data.publishDate || b.data.date || b.data.pubDate || '1970-01-01');
    return dateB.getTime() - dateA.getTime();
  });

const groupedPosts = sortedPosts.reduce((acc, post) => {
  const category = formatCategoryLabel(post.data.category || 'Articoli');
  if (!acc[category]) acc[category] = [];
  acc[category].push(post);
  return acc;
}, {} as Record<string, typeof sortedPosts>);
---

<SiteLayout title="Mappa del sito | Canapalandia" description="Naviga facilmente tra sezioni, strumenti, pagine informative e articoli di Canapalandia.">
  <style>
    .sitemap-hero {
      background: linear-gradient(135deg, var(--bg) 0%, var(--panel) 100%);
      color: var(--text);
      padding: 4rem 2rem;
      text-align: center;
      margin-bottom: 3rem;
    }
    .sitemap-hero h1 { font-size: 2.5rem; margin-bottom: 1rem; font-weight: 700; }
    .sitemap-hero p { font-size: 1.2rem; margin-bottom: 2rem; opacity: 0.9; }
    .search-input {
      width: 100%; max-width: 400px; padding: 0.75rem 1rem;
      border: 2px solid var(--brand); border-radius: var(--r-md); font-size: 1rem;
      background: var(--panel); color: var(--text); margin: 0 auto; display: block;
    }
    .search-input::placeholder { color: var(--muted); }
    .search-input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-subtle); }
    .sitemap-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem; padding: 0 2rem; max-width: 1200px; margin: 0 auto;
    }
    .sitemap-card, .accordion {
      background: var(--card-bg); border-radius: var(--r-md); box-shadow: var(--shadow-sm);
      overflow: hidden; transition: transform 0.2s ease;
    }
    .sitemap-card:hover, .accordion:hover { transform: translateY(-2px); }
    .sitemap-card h2, .accordion-summary {
      background: var(--brand); color: var(--text); padding: 1.5rem; margin: 0;
      font-size: 1.5rem; font-weight: 600;
    }
    .accordion-summary {
      cursor: pointer; list-style: none; display: flex; justify-content: space-between;
      align-items: center; gap: 1rem; border: none; width: 100%; text-align: left;
      font-size: 1.15rem; line-height: 1.35;
    }
    .accordion-summary > span:first-child { min-width: 0; overflow-wrap: anywhere; }
    .accordion-summary > span:nth-child(2) { white-space: nowrap; font-size: 0.95rem; }
    .accordion-summary::-webkit-details-marker { display: none; }
    .accordion-summary::after { content: '▼'; font-size: 1rem; transition: transform 0.2s ease; flex: 0 0 auto; }
    .accordion[open] .accordion-summary::after { transform: rotate(180deg); }
    .sitemap-list { list-style: none; padding: 0; margin: 0; }
    .sitemap-item { border-bottom: 1px solid var(--border); transition: background-color 0.2s ease; }
    .sitemap-item:last-child { border-bottom: none; }
    .sitemap-item:hover { background-color: var(--brand-subtle); }
    .sitemap-link {
      display: flex; justify-content: space-between; align-items: center;
      padding: 1rem 1.5rem; text-decoration: none; color: var(--text); font-weight: 500;
    }
    .sitemap-link:hover { color: var(--brand); }
    .sitemap-link:focus-visible { outline: none; box-shadow: 0 0 0 3px var(--brand-subtle); }
    .sitemap-date { color: var(--muted); font-size: 0.9rem; font-weight: 400; }
    .hidden { display: none; }
    @media (max-width: 768px) {
      .sitemap-hero { padding: 3rem 1rem; }
      .sitemap-hero h1 { font-size: 2rem; }
      .sitemap-hero p { font-size: 1rem; }
      .sitemap-grid { grid-template-columns: 1fr; padding: 0 1rem; }
    }
  </style>

  <section class="sitemap-hero">
    <h1>Mappa del sito</h1>
    <p>Sezioni, strumenti, informazioni sul progetto e archivio editoriale di Canapalandia</p>
    <input type="text" id="search-input" class="search-input" placeholder="Cerca articoli...">
  </section>

  <div class="sitemap-grid">
    <div class="sitemap-card">
      <h2>Sezioni principali</h2>
      <ul class="sitemap-list">
        <li class="sitemap-item"><a href="/" class="sitemap-link">Home</a></li>
        <li class="sitemap-item"><a href="/blog/" class="sitemap-link">Blog</a></li>
        <li class="sitemap-item"><a href="/lab/" class="sitemap-link">Canapalandia Lab</a></li>
        <li class="sitemap-item"><a href="/ribaltatore/" class="sitemap-link">Ribaltatore AI</a></li>
        <li class="sitemap-item"><a href="/frasi-ribaltate/" class="sitemap-link">Frasi ribaltate</a></li>
        <li class="sitemap-item"><a href="/cerca/" class="sitemap-link">Cerca</a></li>
        <li class="sitemap-item"><a href="/sostieni-la-nostra-causa/" class="sitemap-link">Sostieni Canapalandia</a></li>
        <li class="sitemap-item"><a href="/rss.xml" class="sitemap-link">RSS</a></li>
      </ul>
    </div>

    <div class="sitemap-card">
      <h2>Progetto e trasparenza</h2>
      <ul class="sitemap-list">
        <li class="sitemap-item"><a href="/chi-siamo/" class="sitemap-link">Chi siamo</a></li>
        <li class="sitemap-item"><a href="/chi-siamo/missione/" class="sitemap-link">Missione</a></li>
        <li class="sitemap-item"><a href="/contatti/" class="sitemap-link">Contatti</a></li>
        <li class="sitemap-item"><a href="/collabora-con-canapalandia/" class="sitemap-link">Collabora con Canapalandia</a></li>
        <li class="sitemap-item"><a href="/pubblicita/" class="sitemap-link">Pubblicità e sponsorizzazioni</a></li>
        <li class="sitemap-item"><a href="/disclaimer-legale-canapalandia/" class="sitemap-link">Disclaimer legale</a></li>
        <li class="sitemap-item"><a href="/privacy-policy/" class="sitemap-link">Privacy Policy</a></li>
        <li class="sitemap-item"><a href="/cookie-policy/" class="sitemap-link">Cookie Policy</a></li>
        <li class="sitemap-item"><a href="/termini-e-condizioni/" class="sitemap-link">Termini e condizioni</a></li>
      </ul>
    </div>

    {Object.entries(groupedPosts).map(([category, posts], index) => (
      <details class="accordion" data-category={category} open={index === 0}>
        <summary class="accordion-summary">
          <span>{category}</span>
          <span>({posts.length} articoli)</span>
        </summary>
        <ul class="sitemap-list">
          {posts.map(post => {
            const date = new Date(post.data.publishDate || post.data.date || post.data.pubDate).toLocaleDateString('it-IT');
            return (
              <li class="sitemap-item" data-title={post.data.title.toLowerCase()}>
                <a href={`/blog/${(post.data?.slug || post.id?.replace(/\.mdx?$/, '')).trim()}/`} class="sitemap-link">
                  <span>{post.data.title}</span>
                  <span class="sitemap-date">{date}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </details>
    ))}
  </div>

  <script>
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const items = document.querySelectorAll('.sitemap-item[data-title]');
    const accordions = document.querySelectorAll('.accordion[data-category]');

    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
      items.forEach(item => {
        const title = item.getAttribute('data-title') || '';
        item.classList.toggle('hidden', !title.includes(query));
      });
      accordions.forEach(accordion => {
        const visibleItems = accordion.querySelectorAll('.sitemap-item:not(.hidden)');
        const hasMatches = visibleItems.length > 0;
        accordion.classList.toggle('hidden', !hasMatches);
        if (hasMatches && query) (accordion as HTMLDetailsElement).open = true;
      });
    });
  </script>
</SiteLayout>