---
import Layout from "../layouts/MigratedLayout.astro";

const title = "Collabora con Canapalandia";
const description =
  "Proponi una collaborazione editoriale, un guest post o un contenuto sponsorizzato su Canapalandia: spazio indipendente su canapa, CBD, cannabis light e normativa.";

const canonical = "https://canapalandia.com/collabora-con-canapalandia/";

const metadata = {
  title: "Collabora con Canapalandia | Guest Post e Collaborazioni Editoriali",
  description:
    "Proponi una collaborazione editoriale, un guest post o un contenuto sponsorizzato su Canapalandia, spazio indipendente dedicato a canapa, CBD, cannabis light e normativa.",
  canonical,
  robots: {
    index: true,
    follow: true,
  },
  openGraph: {
    title: "Collabora con Canapalandia | Guest Post e Collaborazioni Editoriali",
    description:
      "Proponi una collaborazione editoriale su Canapalandia: guest post, contenuti sponsorizzati, interviste e approfondimenti selezionati sul mondo della canapa.",
    type: "website",
    url: canonical,
    siteName: "Canapalandia",
  },
  twitter: {
    card: "summary_large_image",
    title: "Collabora con Canapalandia | Collaborazioni Editoriali",
    description:
      "Proponi guest post, contenuti sponsorizzati o collaborazioni editoriali su Canapalandia, spazio indipendente su canapa, CBD e normativa.",
  },
};

const contactEmail = "info@canapalandia.com";
const contactSubject = "Proposta collaborazione editoriale Canapalandia";
const mailtoHref = `mailto:${contactEmail}?subject=${encodeURIComponent(contactSubject)}`;
---

<Layout metadata={metadata}>
  <main class="bg-[#f7f3e8] text-stone-900">
    <!-- HERO -->
    <section class="bg-[#173f2d] px-6 py-28 text-white md:py-36">
      <div class="mx-auto max-w-3xl">
        <p class="inline-flex rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-green-100 ring-1 ring-white/15">
          Collaborazioni editoriali selezionate
        </p>

        <h1 class="mt-10 text-4xl font-black leading-[1.05] tracking-tight md:text-6xl">
          Collabora con Canapalandia
        </h1>

        <p class="mt-10 text-xl leading-9 text-green-50 md:text-2xl md:leading-10">
          Proponi un <strong>guest post</strong>, un contenuto sponsorizzato, un’intervista o un approfondimento editoriale su canapa, CBD, cannabis light, normativa e filiera.
        </p>

        <div class="mt-14 flex flex-col gap-4 sm:flex-row">
          <a
            href="#form-collaborazione"
            class="inline-flex items-center justify-center rounded-full bg-amber-100 px-8 py-4 text-base font-bold text-[#173f2d] transition hover:bg-amber-200"
          >
            Contattaci per una collaborazione
          </a>

          <a
            href="#come-funziona"
            class="inline-flex items-center justify-center rounded-full border-2 border-white/30 px-8 py-4 text-base font-semibold text-white transition hover:bg-white/10"
          >
            Scopri come funziona
          </a>
        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="px-6 py-28 md:py-36">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-3xl font-black leading-tight text-[#173f2d] md:text-5xl">
          Uno spazio editoriale indipendente sulla canapa
        </h2>

        <div class="mt-12 space-y-8 text-lg leading-9 text-stone-700 md:text-xl md:leading-10">
          <p>
            Canapalandia racconta <strong>canapa, CBD, cannabis light, normativa, sostenibilità e cultura antiproibizionista</strong> con un linguaggio chiaro, critico e accessibile.
          </p>

          <p>
            Valutiamo collaborazioni con aziende, associazioni, professionisti, brand e realtà della filiera che abbiano qualcosa di utile da raccontare.
          </p>

          <p>
            Ogni proposta viene letta e valutata prima della pubblicazione. Non pubblichiamo contenuti automaticamente e non accettiamo testi pensati solo per ottenere link.
          </p>
        </div>
      </div>
    </section>

    <!-- IN SINTESI -->
    <section class="border-t border-black/5 bg-white px-6 py-28 md:py-36">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-3xl font-black leading-tight text-[#173f2d] md:text-5xl">
          In sintesi
        </h2>

        <div class="mt-12 space-y-6">
          <div class="rounded-3xl bg-[#f7f3e8] p-7 ring-1 ring-black/5 md:p-8">
            <p class="text-lg leading-9 text-stone-700 md:text-xl md:leading-10">
              <strong>Ogni proposta viene valutata</strong> prima della pubblicazione.
            </p>
          </div>

          <div class="rounded-3xl bg-[#f7f3e8] p-7 ring-1 ring-black/5 md:p-8">
            <p class="text-lg leading-9 text-stone-700 md:text-xl md:leading-10">
              <strong>Nessun prezzo pubblico:</strong> le condizioni vengono inviate solo dopo una prima valutazione.
            </p>
          </div>

          <div class="rounded-3xl bg-[#f7f3e8] p-7 ring-1 ring-black/5 md:p-8">
            <p class="text-lg leading-9 text-stone-700 md:text-xl md:leading-10">
              <strong>No link building pura:</strong> il contenuto deve essere utile per i lettori.
            </p>
          </div>

          <div class="rounded-3xl bg-[#f7f3e8] p-7 ring-1 ring-black/5 md:p-8">
            <p class="text-lg leading-9 text-stone-700 md:text-xl md:leading-10">
              <strong>Linea prudente:</strong> niente claim medici non verificabili o inviti ad aggirare la legge.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- COSA PUOI PROPORRE -->
    <section class="border-t border-black/5 px-6 py-28 md:py-36">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-3xl font-black leading-tight text-[#173f2d] md:text-5xl">
          Cosa puoi proporre
        </h2>

        <p class="mt-12 text-lg leading-9 text-stone-700 md:text-xl md:leading-10">
          Accettiamo contenuti coerenti con la linea editoriale di Canapalandia. La proposta deve essere chiara, originale e utile per chi legge.
        </p>

        <div class="mt-16 space-y-12">
          <article>
            <h3 class="text-2xl font-black leading-tight text-[#173f2d] md:text-3xl">
              Guest post
            </h3>

            <p class="mt-6 text-lg leading-9 text-stone-700">
              Articoli informativi già scritti, da valutare e revisionare prima della pubblicazione.
            </p>
          </article>

          <article>
            <h3 class="text-2xl font-black leading-tight text-[#173f2d] md:text-3xl">
              Contenuti sponsorizzati
            </h3>

            <p class="mt-6 text-lg leading-9 text-stone-700">
              Contenuti realizzati in collaborazione con aziende o progetti del settore, sempre dichiarati con trasparenza.
            </p>
          </article>

          <article>
            <h3 class="text-2xl font-black leading-tight text-[#173f2d] md:text-3xl">
              Interviste
            </h3>

            <p class="mt-6 text-lg leading-9 text-stone-700">
              Approfondimenti dedicati a realtà, professionisti, associazioni o progetti legati alla canapa.
            </p>
          </article>

          <article>
            <h3 class="text-2xl font-black leading-tight text-[#173f2d] md:text-3xl">
              Approfondimenti tematici
            </h3>

            <p class="mt-6 text-lg leading-9 text-stone-700">
              Contenuti su normativa, filiera, sostenibilità, ricerca, tracciabilità, certificazioni e cultura antiproibizionista.
            </p>
          </article>
        </div>

        <div class="mt-16">
          <a
            href="#form-collaborazione"
            class="inline-flex items-center justify-center rounded-full bg-[#173f2d] px-8 py-4 text-base font-bold text-white transition hover:bg-[#20543d]"
          >
            Contattaci per proporre un contenuto
          </a>
        </div>
      </div>
    </section>

    <!-- COSA NON ACCETTIAMO -->
    <section class="border-t border-black/5 bg-white px-6 py-28 md:py-36">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-3xl font-black leading-tight text-[#173f2d] md:text-5xl">
          Cosa non accettiamo
        </h2>

        <p class="mt-12 text-lg leading-9 text-stone-700 md:text-xl md:leading-10">
          Per proteggere i lettori e la credibilità del progetto, non pubblichiamo contenuti contrari alla nostra linea editoriale.
        </p>

        <ul class="mt-12 space-y-6 text-lg leading-9 text-stone-700">
          <li class="rounded-2xl bg-[#f7f3e8] p-6 ring-1 ring-black/5">
            Promesse terapeutiche non dimostrate o claim medici non verificabili.
          </li>

          <li class="rounded-2xl bg-[#f7f3e8] p-6 ring-1 ring-black/5">
            Inviti a violare, aggirare o ignorare la normativa vigente.
          </li>

          <li class="rounded-2xl bg-[#f7f3e8] p-6 ring-1 ring-black/5">
            Testi copiati, superficiali, fuorvianti o generati senza revisione.
          </li>

          <li class="rounded-2xl bg-[#f7f3e8] p-6 ring-1 ring-black/5">
            Contenuti pensati esclusivamente per ottenere link.
          </li>
        </ul>
      </div>
    </section>

    <!-- TRASPARENZA -->
    <section class="border-t border-black/5 px-6 py-28 md:py-36">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-3xl font-black leading-tight text-[#173f2d] md:text-5xl">
          Trasparenza editoriale
        </h2>

        <div class="mt-12 space-y-8 text-lg leading-9 text-stone-700 md:text-xl md:leading-10">
          <p>
            Quando un contenuto nasce da una collaborazione commerciale, viene indicato in modo chiaro.
          </p>

          <p>
            La collaborazione non implica automaticamente raccomandazione, certificazione o approvazione dei prodotti o servizi citati.
          </p>

          <p>
            Canapalandia si riserva la possibilità di rifiutare proposte non coerenti, modificare anchor text troppo promozionali, limitare il numero di link o richiedere modifiche prima della pubblicazione.
          </p>
        </div>
      </div>
    </section>

    <!-- COME FUNZIONA -->
    <section id="come-funziona" class="scroll-mt-24 border-t border-black/5 bg-[#173f2d] px-6 py-28 text-white md:py-36">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-3xl font-black leading-tight md:text-5xl">
          Come proporre una collaborazione
        </h2>

        <p class="mt-12 text-lg leading-9 text-green-50 md:text-xl md:leading-10">
          Scrivici raccontando chi sei, cosa vorresti pubblicare e perché pensi che il contenuto sia adatto a Canapalandia.
        </p>

        <div class="mt-12 rounded-3xl bg-white/10 p-8 ring-1 ring-white/15 md:p-10">
          <h3 class="text-2xl font-black">
            Nel messaggio indica:
          </h3>

          <ul class="mt-8 space-y-5 text-lg leading-8 text-green-50">
            <li>Nome dell’azienda, brand o progetto.</li>
            <li>Sito web ufficiale.</li>
            <li>Tipo di contenuto proposto.</li>
            <li>Argomento e obiettivo della pubblicazione.</li>
            <li>Eventuale bozza già disponibile.</li>
            <li>Link da sottoporre a valutazione.</li>
          </ul>
        </div>

        <div class="mt-16">
          <a
            href="#form-collaborazione"
            class="inline-flex items-center justify-center gap-3 rounded-full bg-[#173f2d] px-8 py-4 text-base font-bold text-white shadow-lg transition hover:bg-[#20543d] focus:outline-none focus:ring-4 focus:ring-[#173f2d]/25"
          >
            Vai al modulo
            <span aria-hidden="true" class="text-xl leading-none">↓</span>
          </a>
        </div>
      </div>
    </section>

    <!-- NOTA EDITORIALE -->
    <section class="border-t border-black/5 bg-[#f7f3e8] px-6 py-14 md:py-16">
      <div class="mx-auto max-w-3xl">
        <div class="rounded-3xl bg-white p-6 ring-1 ring-black/5 md:p-8">
          <h2 class="text-base font-extrabold text-stone-700 md:text-lg">
            Nota editoriale
          </h2>

          <p class="mt-8 text-sm leading-7 text-stone-600 md:text-base md:leading-8">
            Canapalandia è uno spazio informativo indipendente. I contenuti pubblicati non costituiscono consulenza legale, medica o commerciale. Ogni collaborazione viene valutata caso per caso e può essere rifiutata se non coerente con la linea editoriale del progetto.
          </p>
        </div>
      </div>
    </section>

    <!-- FORM COLLABORAZIONE -->
    <section id="form-collaborazione" class="scroll-mt-24 border-t-2 border-black/10 bg-[#f7f3e8] px-6 pt-20 pb-28 md:pt-28 md:pb-36">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-3xl font-black leading-tight text-[#173f2d] md:text-5xl">
          Invia la tua proposta editoriale
        </h2>

        <p class="mt-10 text-lg leading-9 text-stone-700 md:mt-12 md:text-xl md:leading-10">
          Compila il modulo con le informazioni principali sul tuo progetto. Valuteremo la proposta e ti risponderemo se sarà coerente con la linea editoriale di Canapalandia.
        </p>

        <form
          class="collaboration-form mt-14 md:mt-16"
          method="POST"
          action="/api/collaborazione"
        >
          <input
            class="honeypot-field"
            type="text"
            name="_gotcha"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />


          <p class="form-note">
            I campi contrassegnati con * sono obbligatori.
          </p>

          <div class="form-grid">
            <div class="field-group">
              <label for="collab-nome">
                Nome e cognome <span class="text-red-700">*</span>
              </label>
              <input
                id="collab-nome"
                name="nome_cognome"
                type="text"
                autocomplete="name"
                required
              />
            </div>

            <div class="field-group">
              <label for="collab-email">
                Email <span class="text-red-700">*</span>
              </label>
              <input
                id="collab-email"
                name="email"
                type="email"
                autocomplete="email"
                required
              />
            </div>

            <div class="field-group">
              <label for="collab-azienda">
                Azienda, brand o progetto <span class="text-red-700">*</span>
              </label>
              <input
                id="collab-azienda"
                name="azienda"
                type="text"
                required
              />
            </div>

            <div class="field-group">
              <label for="collab-sito">
                Sito web <span class="text-red-700">*</span>
              </label>
              <input
                id="collab-sito"
                name="sito_web"
                type="text"
                inputmode="url"
                placeholder="https://esempio.com"
                required
              />
            </div>

            <div class="field-group">
              <label for="collab-tipo">
                Tipo di contenuto <span class="text-red-700">*</span>
              </label>
              <select
                id="collab-tipo"
                name="tipo_contenuto"
                required
              >
                <option value="" disabled selected>Seleziona un’opzione</option>
                <option value="Guest post">Guest post</option>
                <option value="Contenuto sponsorizzato">Contenuto sponsorizzato</option>
                <option value="Intervista">Intervista</option>
                <option value="Approfondimento tematico">Approfondimento tematico</option>
                <option value="Altro">Altro</option>
              </select>
            </div>

            <div class="field-group">
              <label for="collab-argomento">
                Argomento proposto <span class="text-red-700">*</span>
              </label>
              <input
                id="collab-argomento"
                name="argomento"
                type="text"
                required
              />
            </div>

            <div class="field-group field-full">
              <label for="collab-link">
                Link da valutare <span class="text-red-700">*</span>
              </label>
              <input
                id="collab-link"
                name="link"
                type="text"
                inputmode="url"
                placeholder="https://esempio.com/pagina"
                required
              />
            </div>
          </div>

          <div class="field-group">
            <label for="collab-messaggio">
              Messaggio <span class="text-red-700">*</span>
            </label>
            <textarea
              id="collab-messaggio"
              name="messaggio"
              rows="7"
              required
            ></textarea>
          </div>

          <div class="privacy-box">
            <label>
              <input
                type="checkbox"
                name="privacy"
                value="accettata"
                required
              />
              <span>
                Dichiaro di aver letto e accettato <a
                  href="/privacy-policy/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-extrabold text-[#86efac] underline decoration-[#86efac]/70 decoration-2 underline-offset-4 transition hover:text-[#bbf7d0] hover:decoration-[#bbf7d0]"
                >l’informativa privacy</a> e acconsento al trattamento dei dati per la valutazione della proposta editoriale. <span class="text-red-700">*</span>
              </span>
            </label>
          </div>

          <div class="form-actions">
            <button type="submit">
              Invia la proposta
            </button>
          </div>
        </form>
      </div>
    </section>
  </main>
</Layout>

<style>
  .collaboration-form {
    margin-top: 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    border-radius: var(--r-lg);
    background: #173f2d;
    color: #f7f3e8;
    padding: 2rem;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  @media (min-width: 768px) {
    .collaboration-form {
      padding: 3rem;
    }
  }

  .collaboration-form .form-note {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(247, 243, 232, 0.78);
  }

  .collaboration-form .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .collaboration-form .form-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem;
    }

    .collaboration-form .field-full {
      grid-column: 1 / -1;
    }
  }

  .collaboration-form .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .collaboration-form label {
    display: block;
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fef3c7;
  }

  .collaboration-form .honeypot-field {
    position: absolute !important;
    left: -9999px !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
    padding: 0 !important;
    border: 0 !important;
    margin: 0 !important;
  }

  .collaboration-form input:not(.honeypot-field),
  .collaboration-form select,
  .collaboration-form textarea {
    width: 100%;
    box-sizing: border-box;
    border-radius: var(--r-md);
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: #f7f3e8 !important;
    color: #1c1917 !important;
    padding: 1rem 1.1rem;
    font-size: 1rem;
    line-height: 1.5;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    outline: none;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      background-color 160ms ease;
  }

  .collaboration-form input:not(.honeypot-field)::placeholder,
  .collaboration-form textarea::placeholder {
    color: #78716c;
  }

  .collaboration-form input:not(.honeypot-field):focus,
  .collaboration-form select:focus,
  .collaboration-form textarea:focus {
    border-color: #f5d98b;
    background: #fffaf0 !important;
    box-shadow: 0 0 0 4px rgba(245, 217, 139, 0.24);
  }

  .collaboration-form textarea {
    min-height: 12rem;
    resize: vertical;
  }

  .collaboration-form select {
    appearance: auto;
  }

  .collaboration-form .privacy-box {
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.08);
    padding: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .collaboration-form .privacy-box label {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.95rem;
    line-height: 1.7;
    font-weight: 500;
    color: rgba(247, 243, 232, 0.9);
  }

  .collaboration-form input[type="checkbox"] {
    width: 1.15rem;
    height: 1.15rem;
    min-width: 1.15rem;
    margin-top: 0.25rem;
    accent-color: #f5d98b;
  }

  .collaboration-form .form-actions {
    padding-top: 0.75rem;
  }

  .collaboration-form button {
    display: inline-flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--r-md);
    background: #fef3c7;
    color: #173f2d;
    padding: 1rem 2rem;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.22);
    transition:
      transform 160ms ease,
      background-color 160ms ease,
      box-shadow 160ms ease;
  }

  .collaboration-form button:hover {
    background: #f5d98b;
    transform: translateY(-1px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
  }

  .collaboration-form button:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 4px rgba(245, 217, 139, 0.28),
      0 18px 40px rgba(0, 0, 0, 0.28);
  }

  @media (min-width: 640px) {
    .collaboration-form button {
      width: auto;
    }
  }
</style>
