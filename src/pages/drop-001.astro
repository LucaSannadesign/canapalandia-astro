---
import Layout from "../layouts/MigratedLayout.astro";

const creativeVersion = "neutral-format-v1";

const products = [
  {
    id: "tshirt",
    eyebrow: "01 · Wear",
    name: "T-shirt Bella+Canvas 3001",
    concept: "CONCEPT 01",
    price: "€29,90",
    launchPrice: "€26,90",
    saving: "Risparmi €3,00",
    note: "Stampa frontale. Nel demand test il visual è un placeholder neutro: misuriamo soprattutto formato e fascia prezzo.",
  },
  {
    id: "poster",
    eyebrow: "02 · Print",
    name: "Poster 21 × 30 cm",
    concept: "CONCEPT 02",
    price: "€19,90",
    launchPrice: "€17,90",
    saving: "Risparmi €2,00",
    note: "Manifesto editoriale compatto. Il visual definitivo verrà progettato solo dopo i controlli IP e compliance.",
  },
  {
    id: "tote",
    eyebrow: "03 · Carry",
    name: "Tote BagBase W101",
    concept: "CONCEPT 03",
    price: "€24,90",
    launchPrice: "€21,90",
    saving: "Risparmi €3,00",
    note: "Shopper 38 × 42 cm. L'area DTF definitiva sarà validata nel Product Designer prima di qualunque produzione.",
  },
];
---

<Layout
  title="Drop 001 — Test di interesse | Canapalandia"
  description="Test sperimentale di formato e prezzo per tre prodotti editoriali. Nessun checkout, ordine o pagamento."
  canonical="/drop-001/"
  robots="noindex,nofollow,noarchive"
  newsletter={false}
>
  <main class="drop-page">
    <section class="drop-hero" aria-labelledby="drop-title">
      <p class="kicker">DROP 001 · FORMAT / PRICE TEST</p>
      <h1 id="drop-title">Drop 001</h1>
      <p class="lead">
        Tre formati, tre fasce prezzo, nessun checkout. Questo test misura solo l'interesse prima di progettare un prodotto reale.
      </p>
      <div class="status-note" role="note">
        <strong>Prototype / not for sale.</strong>
        I visual sono placeholder neutri: non rappresentano marchi o slogan destinati alla vendita. Nessun pagamento, ordine o impegno di acquisto.
      </div>
    </section>

    <section class="intro" aria-labelledby="intro-title">
      <p class="index">001 / INTEREST TEST</p>
      <div>
        <h2 id="intro-title">Quale formato compreresti più facilmente?</h2>
        <p>
          Confrontiamo intenzione di acquisto, fascia prezzo e formato. Per non anticipare la clearance IP, i tre visual mostrano soltanto identificatori neutri e non testano slogan, marchi o riferimenti a cannabis, marijuana o 420.
        </p>
        <div class="launch-rule">
          <strong>Vantaggio waitlist:</strong> se in futuro un prodotto reale supererà tutti i gate, la lista riceverà l'eventuale comunicazione di lancio e il prezzo dedicato.
        </div>
      </div>
    </section>

    <section class="product-grid" aria-label="Prodotti candidati Drop 001">
      {products.map((product) => (
        <article class="product-card" data-product-card={product.id}>
          <div class="artwork" aria-label={`Placeholder grafico ${product.concept}`}>
            <span class="artwork-series">DROP 001 / FORMAT TEST</span>
            <strong>{product.concept}</strong>
            <span class="artwork-foot">NEUTRAL PLACEHOLDER · NOT FOR SALE</span>
          </div>

          <div class="product-body">
            <p class="product-eyebrow">{product.eyebrow}</p>
            <h3>{product.name}</h3>

            <div class="pricing">
              <p class="reference-price">
                <span>Prezzo previsto</span>
                <strong>{product.price}</strong>
              </p>
              <p class="launch-price">
                {product.launchPrice}
                <span>prezzo indicativo waitlist</span>
              </p>
              <p class="saving">{product.saving}</p>
            </div>

            <p class="product-note">{product.note}</p>
            <button
              class="interest-button"
              type="button"
              data-product={product.id}
              data-product-name={product.name}
              data-concept={product.concept}
            >
              Mi interessa questo formato
            </button>
          </div>
        </article>
      ))}
    </section>

    <section class="waitlist" id="waitlist" aria-labelledby="waitlist-title">
      <div class="waitlist-copy">
        <p class="index">002 / WAITLIST</p>
        <h2 id="waitlist-title">Segnala il tuo interesse</h2>
        <p>
          L'email serve a misurare una preferenza reale e, se il progetto passerà tutti i gate, ad avvisarti dell'eventuale evoluzione del test. Non viene effettuato alcun ordine.
        </p>
        <p class="selected-copy" id="selectedCopy">Seleziona prima uno dei tre prodotti.</p>
      </div>

      <form class="waitlist-form" id="dropWaitlistForm" method="post" action="/api/newsletter">
        <input type="hidden" name="campaign" value="drop-001" />
        <input type="hidden" name="creativeVersion" value={creativeVersion} />
        <input type="hidden" name="preference" id="preference" value="" />

        <div class="hp-field" aria-hidden="true">
          <label for="hp">Non compilare questo campo</label>
          <input id="hp" name="hp" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required placeholder="nome@email.it" />

        <label class="consent-row">
          <input type="checkbox" name="consent" required />
          <span>
            Accetto il trattamento dei dati secondo la <a href="/privacy-policy/">Privacy Policy</a> e l'iscrizione alla lista di aggiornamento Canapalandia.
          </span>
        </label>

        <button class="submit-button" type="submit" disabled>Entra nella waitlist</button>
        <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
      </form>
    </section>

    <section class="method" aria-labelledby="method-title">
      <p class="index">003 / GATE</p>
      <div>
        <h2 id="method-title">Cosa succede dopo il test</h2>
        <p>
          La waitlist non apre automaticamente la vendita. Un eventuale GO richiede ancora clearance IP del brand e del visual definitivo, chiusura dei gate fiscali/previdenziali, preflight Fourthwall e controllo compliance finale.
        </p>
      </div>
    </section>
  </main>
</Layout>

<script define:vars={{ creativeVersion }}>
  const buttons = Array.from(document.querySelectorAll(".interest-button"));
  const cards = Array.from(document.querySelectorAll("[data-product-card]"));
  const preference = document.querySelector("#preference");
  const selectedCopy = document.querySelector("#selectedCopy");
  const submitButton = document.querySelector(".submit-button");
  const form = document.querySelector("#dropWaitlistForm");
  const status = document.querySelector("#formStatus");

  function pushAnalytics(event, product, concept) {
    if (Array.isArray(window.dataLayer)) {
      window.dataLayer.push({
        event,
        product,
        concept,
        creative_version: creativeVersion,
      });
    }
  }

  function selectProduct(product, productName, concept) {
    if (!preference || !selectedCopy || !submitButton) return;

    preference.value = product;
    selectedCopy.textContent = `Hai scelto: ${productName}. Il visual mostrato è il placeholder neutro ${concept}.`;
    submitButton.disabled = false;

    cards.forEach((card) => {
      card.classList.toggle("is-selected", card.dataset.productCard === product);
    });

    buttons.forEach((button) => {
      const selected = button.dataset.product === product;
      button.setAttribute("aria-pressed", selected ? "true" : "false");
      button.textContent = selected ? "Formato selezionato" : "Mi interessa questo formato";
    });

    pushAnalytics("drop_001_product_interest", product, concept);
    document.querySelector("#waitlist")?.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  buttons.forEach((button) => {
    button.setAttribute("aria-pressed", "false");
    button.addEventListener("click", () => {
      const product = button.dataset.product;
      const productName = button.dataset.productName;
      const concept = button.dataset.concept;
      if (product && productName && concept) selectProduct(product, productName, concept);
    });
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status || !preference || !preference.value || !submitButton) return;

    const data = new FormData(form);
    status.textContent = "Invio in corso…";
    submitButton.disabled = true;

    try {
      const response = await fetch("/api/newsletter", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: data.get("email"),
          consent: data.get("consent"),
          hp: data.get("hp"),
          campaign: "drop-001",
          preference: preference.value,
          creativeVersion,
        }),
      });

      const payload = await response.json().catch(() => ({ message: "Risposta non valida" }));
      if (!response.ok && response.status !== 409) {
        throw new Error(payload.message || "Errore durante l'iscrizione");
      }

      status.textContent = response.status === 409
        ? "Sei già nella lista. La preferenza è stata aggiornata."
        : "Grazie. Interesse registrato: nessun ordine è stato effettuato.";

      const selectedButton = buttons.find((button) => button.dataset.product === preference.value);
      pushAnalytics(
        "drop_001_waitlist_signup",
        preference.value,
        selectedButton?.dataset.concept || "",
      );
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : "Errore durante l'iscrizione. Riprova.";
      submitButton.disabled = false;
    }
  });
</script>

<style>
  .drop-page {
    --paper: #f3efe3;
    --ink: #171914;
    --muted: #686b62;
    --line: rgba(23, 25, 20, 0.22);
    --accent: #49613d;
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(32px, 7vw, 88px) 22px 96px;
  }

  .kicker,
  .index,
  .product-eyebrow,
  .artwork-series,
  .artwork-foot {
    font-family: Arial, Helvetica, sans-serif;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }

  .drop-hero {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: clamp(42px, 8vw, 92px) 0 clamp(36px, 6vw, 68px);
  }

  .drop-hero h1 {
    margin: 14px 0 18px;
    font-size: clamp(4.2rem, 13vw, 10rem);
    line-height: 0.84;
    letter-spacing: -0.065em;
    font-weight: 600;
  }

  .lead {
    max-width: 820px;
    margin: 0;
    font-size: clamp(1.25rem, 2.7vw, 2rem);
    line-height: 1.28;
  }

  .status-note {
    max-width: 800px;
    margin-top: 30px;
    border-left: 3px solid var(--accent);
    padding: 12px 16px;
    color: var(--muted);
    line-height: 1.5;
  }

  .intro,
  .method {
    display: grid;
    grid-template-columns: minmax(140px, 0.7fr) minmax(0, 2fr);
    gap: 32px;
    padding: 54px 0;
    border-bottom: 1px solid var(--line);
  }

  .intro h2,
  .waitlist h2,
  .method h2 {
    margin: 0 0 14px;
    font-size: clamp(1.8rem, 4vw, 3.4rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .intro > div > p,
  .method p:last-child,
  .waitlist-copy > p:not(.index):not(.selected-copy) {
    max-width: 720px;
    color: var(--muted);
    font-size: 1.06rem;
    line-height: 1.65;
  }

  .launch-rule {
    max-width: 720px;
    margin-top: 22px;
    border: 1px solid var(--line);
    padding: 14px 16px;
    line-height: 1.5;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border-bottom: 1px solid var(--line);
  }

  .product-card {
    background: var(--paper);
    padding: 18px;
  }

  .product-card.is-selected {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .artwork {
    aspect-ratio: 4 / 5;
    background: #1c211b;
    color: #f1ead7;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px;
  }

  .artwork strong {
    max-width: 10ch;
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 0.94;
    letter-spacing: -0.05em;
    font-weight: 650;
  }

  .artwork-foot {
    opacity: 0.72;
  }

  .product-body {
    padding: 23px 3px 4px;
  }

  .product-body h3 {
    margin: 8px 0 10px;
    font-size: 1.35rem;
    line-height: 1.15;
  }

  .pricing {
    margin: 15px 0 18px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .reference-price {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin: 0 0 5px;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .reference-price strong {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .launch-price {
    display: flex;
    align-items: baseline;
    gap: 9px;
    margin: 0;
    font-size: 2rem;
    letter-spacing: -0.04em;
    font-weight: 700;
  }

  .launch-price span {
    font-size: 0.72rem;
    letter-spacing: 0;
    color: var(--muted);
    font-weight: 500;
  }

  .saving {
    display: inline-block;
    margin: 7px 0 0;
    padding: 4px 7px;
    background: var(--accent);
    color: var(--paper);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .product-note {
    min-height: 7em;
    color: var(--muted);
    line-height: 1.55;
  }

  .interest-button,
  .submit-button {
    width: 100%;
    border: 1px solid var(--ink);
    background: transparent;
    color: inherit;
    padding: 13px 15px;
    cursor: pointer;
    font: inherit;
    font-weight: 700;
  }

  .interest-button:hover,
  .interest-button[aria-pressed="true"],
  .submit-button:not(:disabled):hover {
    background: var(--ink);
    color: var(--paper);
  }

  .waitlist {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    gap: clamp(36px, 7vw, 92px);
    padding: clamp(64px, 10vw, 112px) 0;
    border-bottom: 1px solid var(--line);
  }

  .selected-copy {
    margin-top: 24px;
    font-weight: 700;
  }

  .waitlist-form {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .waitlist-form > label:not(.consent-row) {
    font-size: 0.82rem;
    font-weight: 700;
  }

  .waitlist-form input[type="email"] {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--ink);
    background: transparent;
    color: inherit;
    padding: 14px;
    font: inherit;
  }

  .consent-row {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 9px;
    align-items: start;
    margin: 8px 0 3px;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .submit-button {
    background: var(--ink);
    color: var(--paper);
  }

  .submit-button:disabled {
    cursor: not-allowed;
    opacity: 0.42;
  }

  .form-status {
    min-height: 1.5em;
    margin: 0;
    font-size: 0.9rem;
  }

  .hp-field {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 820px) {
    .product-grid,
    .intro,
    .method,
    .waitlist {
      grid-template-columns: 1fr;
    }

    .product-note {
      min-height: 0;
    }
  }
</style>
