---
import Layout from "../layouts/MigratedLayout.astro";

const products = [
  {
    id: "tshirt",
    eyebrow: "01 · Wear",
    name: "T-shirt Bella+Canvas 3001",
    price: "circa €30",
    note: "Stampa frontale. Il master finale sarà ottimizzato per restare leggibile anche sulle taglie più piccole.",
    artwork: "EDITORIAL / 001",
  },
  {
    id: "poster",
    eyebrow: "02 · Print",
    name: "Poster 21 × 30 cm",
    price: "circa €20",
    note: "Formato editoriale compatto, pensato come manifesto della serie e non come semplice merchandising.",
    artwork: "CULTURE / POLICY",
  },
  {
    id: "tote",
    eyebrow: "03 · Carry",
    name: "Tote BagBase W101",
    price: "circa €25",
    note: "Shopper 38 × 42 cm. Area di stampa finale da verificare nel Product Designer Fourthwall.",
    artwork: "INFORMATION / FREEDOM",
  },
];
---

<Layout
  title="Drop 001 — Test di interesse | Canapalandia"
  description="Anteprima sperimentale della Canapalandia Editorial Series. Nessun checkout: scegli il formato che ti interessa e iscriviti alla waitlist."
  canonical="/drop-001/"
  robots="noindex,nofollow"
  newsletter={false}
>
  <main class="drop-page">
    <section class="drop-hero" aria-labelledby="drop-title">
      <div class="drop-kicker">CANAPALANDIA · EDITORIAL SERIES</div>
      <h1 id="drop-title">Drop 001</h1>
      <p class="drop-lead">
        Non è ancora uno shop. Stiamo testando quali oggetti meritano davvero di essere prodotti prima di aprire qualsiasi vendita.
      </p>
      <div class="drop-status" role="note">
        <strong>Test senza checkout.</strong> Nessun pagamento, nessun ordine e nessun impegno di acquisto.
      </div>
    </section>

    <section class="drop-intro" aria-labelledby="drop-intro-title">
      <p class="drop-index">001 / INTEREST TEST</p>
      <div>
        <h2 id="drop-intro-title">Tre formati. Una sola domanda: quale vorresti vedere realizzato?</h2>
        <p>
          I prezzi sono indicativi e servono a misurare interesse reale, non curiosità astratta. Seleziona il prodotto che compreresti più facilmente a quella fascia di prezzo.
        </p>
      </div>
    </section>

    <section class="product-grid" aria-label="Prodotti candidati Drop 001">
      {products.map((product) => (
        <article class="product-card" data-product-card={product.id}>
          <div class="artwork" aria-hidden="true">
            <span class="artwork-series">CANAPALANDIA</span>
            <strong>{product.artwork}</strong>
            <span class="artwork-foot">DROP 001 · PROTOTYPE</span>
          </div>
          <div class="product-body">
            <p class="product-eyebrow">{product.eyebrow}</p>
            <h3>{product.name}</h3>
            <p class="product-price">{product.price} <span>indicativi</span></p>
            <p class="product-note">{product.note}</p>
            <button class="interest-button" type="button" data-product={product.id} data-product-name={product.name}>
              Mi interessa questo
            </button>
          </div>
        </article>
      ))}
    </section>

    <section class="waitlist" id="waitlist" aria-labelledby="waitlist-title">
      <div class="waitlist-copy">
        <p class="drop-index">002 / WAITLIST</p>
        <h2 id="waitlist-title">Segnala il tuo interesse</h2>
        <p>
          Useremo questa lista soltanto per capire se il Drop 001 ha abbastanza domanda per passare alla fase successiva e, se lo desideri, per avvisarti quando ci saranno novità.
        </p>
        <p class="selected-copy" id="selectedCopy">Seleziona prima uno dei tre prodotti.</p>
      </div>

      <form class="waitlist-form" id="dropWaitlistForm" method="post" action="/api/newsletter">
        <input type="hidden" name="campaign" value="drop-001" />
        <input type="hidden" name="preference" id="preference" value="" />

        <div class="hp-field" aria-hidden="true">
          <label for="hp">Non compilare questo campo</label>
          <input id="hp" name="hp" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required placeholder="nome@email.it" />

        <label class="consent-row">
          <input type="checkbox" name="consent" required />
          <span>
            Accetto il trattamento dei dati secondo la <a href="/privacy-policy/">Privacy Policy</a> e l'iscrizione alla lista di aggiornamento Canapalandia.
          </span>
        </label>

        <button class="submit-button" type="submit" disabled>Entra nella waitlist</button>
        <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
      </form>
    </section>

    <section class="method" aria-labelledby="method-title">
      <p class="drop-index">003 / CRITERIO</p>
      <div>
        <h2 id="method-title">Cosa misuriamo</h2>
        <p>
          Visualizzazioni della pagina, scelta del prodotto e iscrizioni alla waitlist. La vendita resta bloccata finché i gate fiscali, previdenziali e di compliance non saranno chiusi.
        </p>
      </div>
    </section>
  </main>
</Layout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".interest-button"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-product-card]"));
  const preference = document.querySelector<HTMLInputElement>("#preference");
  const selectedCopy = document.querySelector<HTMLElement>("#selectedCopy");
  const submitButton = document.querySelector<HTMLButtonElement>(".submit-button");
  const form = document.querySelector<HTMLFormElement>("#dropWaitlistForm");
  const status = document.querySelector<HTMLElement>("#formStatus");

  function selectProduct(product: string, productName: string) {
    if (!preference || !selectedCopy || !submitButton) return;

    preference.value = product;
    selectedCopy.textContent = `Hai scelto: ${productName}.`;
    submitButton.disabled = false;

    cards.forEach((card) => {
      card.classList.toggle("is-selected", card.dataset.productCard === product);
    });

    buttons.forEach((button) => {
      const selected = button.dataset.product === product;
      button.setAttribute("aria-pressed", selected ? "true" : "false");
      button.textContent = selected ? "Selezionato" : "Mi interessa questo";
    });

    const win = window as typeof window & { dataLayer?: unknown[] };
    if (Array.isArray(win.dataLayer)) {
      win.dataLayer.push({
        event: "drop_001_product_interest",
        product,
      });
    }

    document.querySelector("#waitlist")?.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  buttons.forEach((button) => {
    button.setAttribute("aria-pressed", "false");
    button.addEventListener("click", () => {
      const product = button.dataset.product;
      const productName = button.dataset.productName;
      if (product && productName) selectProduct(product, productName);
    });
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status || !preference || !preference.value) return;

    const data = new FormData(form);
    status.textContent = "Invio in corso…";
    submitButton?.setAttribute("disabled", "true");

    try {
      const response = await fetch("/api/newsletter", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: data.get("email"),
          consent: data.get("consent"),
          hp: data.get("hp"),
          campaign: "drop-001",
          preference: preference.value,
        }),
      });

      const payload = await response.json().catch(() => ({ message: "Risposta non valida" }));
      if (!response.ok && response.status !== 409) {
        throw new Error(payload.message || "Errore durante l'iscrizione");
      }

      status.textContent = response.status === 409
        ? "Sei già nella lista. Abbiamo registrato la preferenza aggiornata."
        : "Grazie. Interesse registrato: nessun ordine è stato effettuato.";

      const win = window as typeof window & { dataLayer?: unknown[] };
      if (Array.isArray(win.dataLayer)) {
        win.dataLayer.push({
          event: "drop_001_waitlist_signup",
          product: preference.value,
        });
      }
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : "Errore durante l'iscrizione. Riprova.";
      submitButton?.removeAttribute("disabled");
    }
  });
</script>

<style>
  .drop-page {
    --paper: #f3efe3;
    --ink: #171914;
    --muted: #686b62;
    --line: rgba(23, 25, 20, 0.22);
    --accent: #49613d;
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(32px, 7vw, 88px) 22px 96px;
  }

  .drop-hero {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: clamp(42px, 8vw, 92px) 0 clamp(36px, 6vw, 68px);
  }

  .drop-kicker,
  .drop-index,
  .product-eyebrow,
  .artwork-series,
  .artwork-foot {
    font-family: Arial, Helvetica, sans-serif;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }

  .drop-hero h1 {
    margin: 14px 0 18px;
    font-size: clamp(4.2rem, 13vw, 10rem);
    line-height: 0.84;
    letter-spacing: -0.065em;
    font-weight: 600;
  }

  .drop-lead {
    max-width: 780px;
    margin: 0;
    font-size: clamp(1.25rem, 2.7vw, 2rem);
    line-height: 1.28;
  }

  .drop-status {
    margin-top: 30px;
    display: inline-block;
    border: 1px solid var(--line);
    padding: 11px 14px;
    font-size: 0.92rem;
  }

  .drop-intro,
  .method {
    display: grid;
    grid-template-columns: minmax(140px, 0.7fr) minmax(0, 2fr);
    gap: 32px;
    padding: 54px 0;
    border-bottom: 1px solid var(--line);
  }

  .drop-intro h2,
  .waitlist h2,
  .method h2 {
    margin: 0 0 14px;
    font-size: clamp(1.8rem, 4vw, 3.4rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .drop-intro p:last-child,
  .method p:last-child,
  .waitlist-copy > p:not(.drop-index):not(.selected-copy) {
    max-width: 720px;
    color: var(--muted);
    font-size: 1.06rem;
    line-height: 1.65;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border-bottom: 1px solid var(--line);
  }

  .product-card {
    background: var(--paper);
    padding: 18px;
    transition: background 150ms ease, outline-color 150ms ease;
  }

  .product-card.is-selected {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .artwork {
    aspect-ratio: 4 / 5;
    background: #1c211b;
    color: #f1ead7;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px;
  }

  .artwork strong {
    max-width: 9ch;
    font-size: clamp(2rem, 4.4vw, 4.5rem);
    line-height: 0.91;
    letter-spacing: -0.055em;
    font-weight: 600;
  }

  .artwork-foot {
    opacity: 0.72;
  }

  .product-body {
    padding: 23px 3px 4px;
  }

  .product-body h3 {
    margin: 8px 0 10px;
    font-size: 1.35rem;
    line-height: 1.15;
  }

  .product-price {
    margin: 0 0 18px;
    font-size: 1.8rem;
    letter-spacing: -0.035em;
  }

  .product-price span {
    font-size: 0.75rem;
    letter-spacing: 0;
    color: var(--muted);
  }

  .product-note {
    min-height: 6.5em;
    color: var(--muted);
    line-height: 1.55;
  }

  .interest-button,
  .submit-button {
    width: 100%;
    border: 1px solid var(--ink);
    background: transparent;
    color: inherit;
    padding: 13px 15px;
    cursor: pointer;
    font: inherit;
    font-weight: 700;
  }

  .interest-button:hover,
  .interest-button[aria-pressed="true"],
  .submit-button:not(:disabled):hover {
    background: var(--ink);
    color: var(--paper);
  }

  .waitlist {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    gap: clamp(36px, 7vw, 92px);
    padding: clamp(64px, 10vw, 112px) 0;
    border-bottom: 1px solid var(--line);
  }

  .selected-copy {
    margin-top: 24px;
    font-weight: 700;
  }

  .waitlist-form {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .waitlist-form > label:not(.consent-row) {
    font-size: 0.82rem;
    font-weight: 700;
  }

  .waitlist-form input[type="email"] {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--ink);
    background: transparent;
    color: inherit;
    padding: 14px;
    font: inherit;
  }

  .consent-row {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 9px;
    align-items: start;
    margin: 8px 0 3px;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .submit-button {
    background: var(--ink);
    color: var(--paper);
  }

  .submit-button:disabled {
    cursor: not-allowed;
    opacity: 0.42;
  }

  .form-status {
    min-height: 1.5em;
    margin: 0;
    font-size: 0.9rem;
  }

  .hp-field {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 820px) {
    .product-grid {
      grid-template-columns: 1fr;
    }

    .product-note {
      min-height: 0;
    }

    .drop-intro,
    .method,
    .waitlist {
      grid-template-columns: 1fr;
    }
  }
</style>
