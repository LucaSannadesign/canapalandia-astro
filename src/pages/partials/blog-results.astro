---
import CardPost from "../../components/CardPost.astro";
import postsJson from "../../../data/wp/out/posts.json";
import { toParams } from "../../lib/wp";

export const prerender = false;

// Protezione SEO: endpoint tecnico non indicizzabile
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Cache-Control", "public, max-age=60");

// 1. Helpers (copiati da blog.astro per consistenza)
const posts = Array.isArray(postsJson) ? postsJson : [];
const postTitle = (p: any) => p?.title?.rendered || p?.title || "";
const stripHtml = (s: any) =>
    String(s || "")
        .replace(/<[^>]*>/g, " ")
        .replace(/\s+/g, " ")
        .trim();
import { getExcerpt } from "../../lib/utils";

const excerpt = (p: any) =>
    getExcerpt(p?.excerpt, p?.content?.rendered || p?.content, 180);
const sortDesc = (a: any, b: any) =>
    (Date.parse(b?.date || b?.modified || "") || 0) -
    (Date.parse(a?.date || a?.modified || "") || 0);
const og = (p: any) =>
    p?.yoast_head_json?.og_image?.[0]?.url ||
    p?.yoast_head_json?.og_image?.[0]?.src ||
    "";
const href = (p: any) => {
    const url = p?.yoast_head_json?.canonical || p?.link || p?.slug || "";
    const path = toParams(url);
    return path ? `/${path}/` : "/";
};
const fmt = (iso: any) =>
    iso
        ? new Date(iso).toLocaleDateString("it-IT", {
              year: "numeric",
              month: "long",
              day: "2-digit",
          })
        : "";

function categoriesOf(p: any): { slug: string; name: string }[] {
    const wpTerm = p?._embedded?.["wp:term"];
    if (!Array.isArray(wpTerm)) return [];
    const flat = wpTerm.flat().flat();
    return flat
        .filter(
            (t: any) =>
                t &&
                t.taxonomy === "category" &&
                typeof t.slug === "string" &&
                typeof t.name === "string",
        )
        .map((t: any) => ({ slug: String(t.slug), name: String(t.name) }));
}

// 2. Filter & Pagination Logic
const url = Astro.url;
const cat = (url.searchParams.get("cat") || "").trim();
const pageParam = parseInt(url.searchParams.get("page") || "1", 10);
const page = isNaN(pageParam) || pageParam < 1 ? 1 : pageParam;
const PER_PAGE = 12;

// Sort
const allSorted = posts.slice().sort(sortDesc);

// Filter
let filtered = allSorted;
if (cat) {
    filtered = filtered.filter((p: any) =>
        categoriesOf(p).some((c) => c.slug === cat),
    );
}

// Paginate
const start = (page - 1) * PER_PAGE;
const end = start + PER_PAGE;
const chunk = filtered.slice(start, end);

// Se non ci sono risultati per questa pagina, ritorno vuoto
if (!chunk.length) {
    return new Response(null, { status: 404 });
}
---

{
    chunk.map((p: any) => {
        const cats = categoriesOf(p);
        const firstCategory = cats.length > 0 ? cats[0].name : null;
        return (
            <CardPost
                href={href(p)}
                img={og(p)}
                date={fmt(p?.date || p?.modified)}
                title={postTitle(p)}
                excerpt={excerpt(p)}
                category={firstCategory}
            />
        );
    })
}
