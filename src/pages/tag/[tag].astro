---
export const prerender = false;

import { getCollection, type CollectionEntry } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CardPost from "../../components/CardPost.astro";
// tagIndexPolicy: usata solo slugifyTagForUrl; tagArchiveShouldIndex non si applica (tutti i tag restano noindex).
import { slugifyTagForUrl } from "../../lib/tagIndexPolicy";

const tag = String(Astro.params.tag ?? "").trim();
const tagKey = slugifyTagForUrl(tag) || tag.toLowerCase().trim();

// Helper per formattare data
const formatDate = (value: Date | string | number | null | undefined): string => {
  if (!value) return "";
  const d = value instanceof Date ? value : new Date(String(value));
  if (Number.isNaN(d.getTime())) return "";
  return d.toLocaleDateString("it-IT", { year: "numeric", month: "long", day: "numeric" });
};

function dateOf(entry: CollectionEntry<"blog">): Date | null {
  const raw = entry.data.publishDate ?? entry.data.updatedDate;
  if (!raw) return null;
  const d = raw instanceof Date ? raw : new Date(String(raw));
  return Number.isNaN(d.getTime()) ? null : d;
}

// Helper per ottenere immagine post
function getPostImage(entry: CollectionEntry<"blog">): string | undefined {
  const img = entry.data.image || entry.data.coverImage;
  if (!img || typeof img !== "string" || !img.trim()) return undefined;
  const trimmed = img.trim();
  
  if (/^https?:\/\//i.test(trimmed)) {
    return trimmed;
  }
  
  let normalized = trimmed.startsWith("public/") ? trimmed.slice(7) : trimmed;
  return normalized.startsWith("/") ? normalized : `/${normalized}`;
}

// Carica tutti i post
let postsAll: CollectionEntry<"blog">[] = [];
try {
  postsAll = await getCollection(
    "blog",
    ({ data }) => data.draft !== true && data.status !== "draft",
  );
} catch (err) {
  console.warn("[tag] Nessun contenuto trovato in Content Collections");
}

// Filtra per tag (slug coerente con link interni: spazi → -, come BlogSidebar)
const posts = postsAll
  .filter((p) => {
    const tags = p.data.tags || [];
    return tags.some((t) => slugifyTagForUrl(String(t)) === tagKey);
  })
  .sort((a, b) => {
    const da = dateOf(a);
    const db = dateOf(b);
    const ta = da ? da.getTime() : 0;
    const tb = db ? db.getTime() : 0;
    return tb - ta;
  });

// Nome leggibile: prima etichetta in frontmatter che collima con questo slug URL
const tagName = posts.length > 0
  ? posts[0].data.tags?.find((t) => slugifyTagForUrl(String(t)) === tagKey)
  : undefined;

const displayName = tagName || tagKey.replace(/-/g, " ");

const metadata = {
  title: `Tag: ${displayName} | Canapalandia`,
  description: `Articoli Canapalandia filtrati per il tag “${displayName}”.`,
  canonical: `/tag/${tagKey}/`,
  /**
   * Sempre noindex,follow: nessun tag va indicizzato (nessuna eccezione per volume o allowlist).
   * In produzione SiteLayout usa questo valore; non passare yoastHeadHtml che sovrascriva robots.
   */
  robots: { index: false, follow: true },
};
---

<SiteLayout metadata={metadata}>
  <main class="container page-shell">
    {posts.length === 0 ? (
      <div class="card">
        <h1>Nessun articolo trovato</h1>
        <p>Nessun articolo trovato per questo tag.</p>
        <p>
          <a href="/blog/">Torna al blog</a>
        </p>
      </div>
    ) : (
      <>
        <Breadcrumbs
          items={[
            { label: "Home", href: "/" },
            { label: "Blog", href: "/blog/" },
            { label: displayName, isCurrent: true },
          ]}
        />

        <div class="section-head">
          <h1>Tag: {displayName}</h1>
          <p class="section-lead">
            {posts.length} {posts.length === 1 ? "articolo" : "articoli"}
          </p>
        </div>

        <div class="grid">
          {posts.map((p) => (
            (() => {
              const safeSlug = String(p.data.slug || p.id || "").trim();
              const safeHref = safeSlug ? `/blog/${safeSlug}/` : "/blog/";
              return (
            <CardPost
              href={safeHref}
              img={getPostImage(p)}
              date={formatDate(dateOf(p))}
              title={p.data.title}
              excerpt={p.data.description}
              category={p.data.category || null}
            />
              );
            })()
          ))}
        </div>
      </>
    )}
  </main>
</SiteLayout>
