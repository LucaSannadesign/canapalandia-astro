---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import postsJson from "../../../data/wp/out/posts.json";
import tagsJson from "../../../data/wp/out/tags.json";
import { toParams } from "../../lib/wp";
import { getExcerpt } from "../../lib/utils";

export const prerender = false;

const slug = Astro.params.slug || "";
const posts = Array.isArray(postsJson) ? postsJson : [];
const tags = Array.isArray(tagsJson) ? tagsJson : [];

const stripHtml = (s: string) => String(s || "").replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
const postTitle = (p: any) => stripHtml(p?.title?.rendered || p?.title || "");
const excerpt = (p: any) => getExcerpt(p?.excerpt, p?.content?.rendered || p?.content, 180);
const sortDesc = (a: any, b: any) => (Date.parse(b?.date || b?.modified || "") || 0) - (Date.parse(a?.date || a?.modified || "") || 0);
const og = (p: any) => p?.yoast_head_json?.og_image?.[0]?.url || p?.yoast_head_json?.og_image?.[0]?.src || "";
const href = (p: any) => {
  const url = p?.yoast_head_json?.canonical || p?.link || p?.slug || "";
  const path = toParams(url);
  return path ? `/${path}/` : "/";
};
const fmt = (iso: string) => (iso ? new Date(iso).toLocaleDateString("it-IT", { year:"numeric", month:"long", day:"2-digit" }) : "");

const tag = tags.find((t) => String(t?.slug || "") === slug);
const tagId = tag?.id;

const filtered = tagId
  ? posts.filter((p) => Array.isArray(p?.tags) && p.tags.includes(tagId)).slice().sort(sortDesc)
  : [];

const title = tag ? `Tag: ${stripHtml(tag.name)} — Canapalandia` : "Tag — Canapalandia";
const description = tag 
  ? `Articoli con tag "${stripHtml(tag.name)}" su Canapalandia`
  : "Tag — Canapalandia";
const canonical = `${import.meta.env.SITE || "https://canapalandia.com"}/tag/${slug}/`;

// Robots noindex,follow per evitare index bloat dei tag
const metadata = {
  title,
  description,
  canonical,
  robots: { index: false, follow: true },
};
---

<SiteLayout metadata={metadata}>
  <main class="container page-shell">
    {!tag || filtered.length === 0 ? (
      <section class="card">
        <h1>Tag non trovato</h1>
        <p>Il tag richiesto non esiste o non ha articoli associati.</p>
        <p>
          <a href="/blog/">Vai al Blog</a>
        </p>
      </section>
    ) : (
      <>
        <Breadcrumbs
          items={[
            { label: "Home", href: "/" },
            { label: "Blog", href: "/blog/" },
            { label: "Tag", href: "/tag/" },
            { label: stripHtml(tag.name), isCurrent: true },
          ]}
        />

        <div class="section-head">
          <h1>Tag: {stripHtml(tag.name)}</h1>
          <p class="section-lead">{filtered.length} {filtered.length === 1 ? "articolo" : "articoli"}</p>
        </div>

        {filtered.length > 0 ? (
          <div class="grid">
            {filtered.map((p: any) => {
              const img = og(p);
              return (
                <article class="card post-card">
                  <a class="cardLink" href={href(p)}>
                    {img ? (
                      <div class="thumb">
                        <img src={img} alt={postTitle(p)} loading="lazy" decoding="async" />
                      </div>
                    ) : null}
                    <div class="cardBody">
                      <p class="cardMeta">{fmt(p?.date || p?.modified || "")}</p>
                      <h3 class="cardTitle">{postTitle(p)}</h3>
                      {excerpt(p) ? (
                        <p class="cardExcerpt">{excerpt(p)}</p>
                      ) : null}
                      <div class="cardCta">Leggi →</div>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="card">
            <p>Nessun articolo trovato per questo tag.</p>
            <p>
              <a href="/blog/">Vai al Blog</a>
            </p>
          </div>
        )}
      </>
    )}
  </main>
</SiteLayout>