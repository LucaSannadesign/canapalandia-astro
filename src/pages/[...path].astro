  }

  .internal-linking__title {
    margin: 0 0 0.75rem 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text);
  }

  .internal-linking__text {
    margin: 0 0 1rem 0;
    color: var(--muted, rgba(255, 255, 255, 0.7));
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .internal-linking__btn {
    display: inline-block;
    padding: 0.75rem 1.25rem;
    background: var(--brand, #22c55e);
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }

  .internal-linking__btn:hover {
    background: var(--brand-hover, #16a34a);
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(34, 197, 94, 0.3);
  }

  @media (max-width: 640px) {
    .internal-linking__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Featured image: limit max-height for large images */
  .post-hero {
    margin: 1.5rem 0 1.5rem;
    border-radius: 12px;
    overflow: hidden;
  }

  .post-hero img {
    width: 100%;
    max-height: clamp(300px, 45vh, 600px);
    object-fit: cover;
    object-position: center;
    display: block;
  }

  @media (max-width: 768px) {
    .post-hero {
      margin: 1rem 0 1rem;
    }

    .post-hero img {
      max-height: clamp(200px, 35vh, 400px);
    }
  }

  /* Reduce spacing between sections */
  .post-main .wp-page > div[style*="margin"] {
    margin: 1.5rem 0 !important;
  }

  .internal-linking {
    margin: 2rem 0;
  }

  .post-cta {
    margin: 2rem 0;
  }

  /* Related posts: responsive grid */
  .related {
    margin: 2.5rem 0;
    padding-top: 2rem;
    border-top: 1px solid var(--border, rgba(255, 255, 255, 0.1));
  }

  .related__title {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0 0 1.5rem 0;
    color: var(--text);
  }

  .related__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  /* Tablet: 2 columns */
  @media (min-width: 640px) {
    .related__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Desktop: 3 columns */
  @media (min-width: 1024px) {
    .related__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Related post card images: consistent sizing */
  .related .thumb img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    object-position: center;
  }

  @media (min-width: 640px) {
    .related .thumb img {
      height: 220px;
    }
  }

  /* Sticky sidebar: gestito globalmente in app.css */
  /* Rimossi stili duplicati per evitare conflitti */

  /* Reduce vertical spacing for post layout */
  .post-layout {
    gap: 2rem;
  }

  @media (max-width: 1023px) {
    .post-layout {
      gap: 1.5rem;
    }
  }
</style>
