---
// UPDATED BLOCKS: 
// - findRelatedPosts(): score-based algorithm (category +10, tag +3, recency bonus)
// - related section: responsive grid (3/2/1 columns) + min 3 posts condition
// - sidebar-ad__sticky: position sticky on desktop (>=1024px) with top: 96px
// - post-hero: max-height constraint for featured image
// - spacing: reduced margins between sections

import SiteLayout from "../layouts/SiteLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import ShareBar from "../components/ShareBar.astro";
import BlogSidebar from "../components/blog/BlogSidebar.astro";
import { ADS_SLOT_ARTICLE, ADS_SLOT_SIDEBAR } from "../lib/consts";
import { loadWp, type WpEntry } from "../lib/wp";
import {
  stripHtml,
  ensureNoTrailingSlash,
  ensureLeadingSlash,
  normalizeSlugLikePath,
  getExcerpt,
} from "../lib/utils";
import postsJson from "../../data/wp/out/posts.json";
import pagesJson from "../../data/wp/out/pages.json";
import categoriesJson from "../../data/wp/out/categories.json";
import tagsJson from "../../data/wp/out/tags.json";

/* ========= Config CTA (cambia qui se il link è diverso) ========= */
// Assicura che i link siano sempre assoluti (iniziano con /)
const SUPPORT_URL = "/sostieni-la-nostra-causa/"; // <-- se nel tuo sito è diverso, modifica SOLO questa riga
// const PARTNER_URL = "/partner-selezionati/"; // Disattivato temporaneamente
const PARTNER_URL = "/blog/"; // Redirect a blog

/* ---------------------------
   Utils
--------------------------- */
function normalizePathParam(input: unknown): string {
  if (Array.isArray(input)) return input.filter(Boolean).join("/").trim();
  if (typeof input === "string") return input.trim();
  return "";
}

/* ---------------------------
   Types
--------------------------- */

type WPFeaturedMedia = {
  source_url?: string;
  alt_text?: string;
  media_details?: {
    sizes?: Record<
      string,
      { source_url?: string; width?: number; height?: number }
    >;
  };
};

type WPItemRaw = {
  id: number;
  slug: string;
  link?: string;
  title: { rendered: string };
  excerpt?: { rendered: string };
  content: { rendered: string };
  categories?: number[];
  _embedded?: { 
    "wp:featuredmedia"?: WPFeaturedMedia[];
    "wp:term"?: any[][];
  };
  yoast_head_json?: {
    og_image?: Array<{ url?: string; src?: string; width?: any; height?: any; type?: any }>;
  };
};

type HeroImage = {
  desktop: { src: string; alt: string };
  mobile?: { src: string; alt: string };
};

type CardPost = {
  href: string;
  title: string;
  excerpt: string;
  dateLabel?: string;
  img?: { src: string; alt: string };
  category?: string;
};

function safeInternalHref(input: unknown): string {
  if (typeof input !== "string") return "/";
  const raw = input.trim();
  if (!raw || raw === "undefined" || raw === "/undefined/") return "/";
  if (/^(https?:|mailto:|tel:)/i.test(raw)) return raw;
  return raw.startsWith("/") ? raw : `/${raw}`;
}

/* ---------------------------
   Resolve requested path
--------------------------- */
const raw = normalizePathParam(Astro.params.path);
const requested = normalizeSlugLikePath(raw);
const requestedPath = requested || "";

/* ---------------------------
   Load and find entry from JSON
--------------------------- */
const { entries } = await loadWp();

// Normalizza il path richiesto per il confronto (senza leading/trailing slash)
// normalizeSlugLikePath già rimuove leading/trailing slash, quindi requestedPath è già normalizzato
const targetPathForMatch = requestedPath || "";

// Cerca l'entry confrontando il pathname derivato dal campo `link`
function findEntryByPath(pathToFind: string): WpEntry | null {
  // Gestione home: se path vuoto o "/", cerca entry con path vuoto
  if (!pathToFind || pathToFind === "/") {
    const homeEntry = entries.find(
      (e) => !e.path || e.path === "" || e.path === "home"
    );
    if (homeEntry) return homeEntry;
  }

  // Cerca per path normalizzato (senza leading/trailing slash)
  const found = entries.find((e) => {
    const entryPath = e.path || "";
    return entryPath === pathToFind;
  });

  if (found) return found;

  // Fallback: cerca anche confrontando il link completo
  // Estrai pathname dal link e normalizzalo
  for (const entry of entries) {
    if (!entry.link) continue;
    try {
      const entryUrl = new URL(entry.link);
      const entryPathname = entryUrl.pathname;
      // Normalizza: rimuovi leading/trailing slash
      const normalizedEntryPath = entryPathname.replace(/^\/+|\/+$/g, "");
      const normalizedRequested = pathToFind.replace(/^\/+|\/+$/g, "");
      
      if (normalizedEntryPath === normalizedRequested) {
        return entry;
      }
    } catch {
      // Ignora URL non validi
    }
  }

  return null;
}

// Blocca temporaneamente /partner-selezionati/ e /go/*
if (targetPathForMatch === "partner-selezionati" || targetPathForMatch.startsWith("go/")) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

// Gestione query params tecnici (mailpoet, captcha, etc.)
// Rimuovi solo parametri tecnici che causano URL duplicati in GSC
const url = Astro.url;
// Solo parametri tecnici/problematici, NON rimuovere utm_* o ref (tracking legittimo)
const techParams = ["mailpoet_page", "captcha", "wpnonce", "_wpnonce", "action", "doing_wp_cron"];
const hasTechParam = techParams.some((param) => url.searchParams.has(param));

// Se ci sono query params tecnici su pagine migrate, rimuovili con redirect 301
if (hasTechParam && targetPathForMatch) {
  // Rimuovi solo i parametri tecnici, mantieni gli altri (es. utm_*, ref)
  const cleanUrl = new URL(url);
  techParams.forEach((param) => cleanUrl.searchParams.delete(param));
  // Se non ci sono più query params, rimuovi il ?
  if (cleanUrl.search === "?") {
    cleanUrl.search = "";
  }
  // Redirect 301 permanente per consolidare URL in GSC
  return Astro.redirect(cleanUrl.pathname + cleanUrl.search, 301);
}

const foundEntry = findEntryByPath(targetPathForMatch);

// Se non trovato, restituisci 404 vero (non redirect)
if (!foundEntry) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

// TS narrowing helper (Astro SSR guard already returned above)
const entry = foundEntry;

/* ---------------------------
   Get raw WP data for featured image and related posts
--------------------------- */
const allItems = [
  ...(Array.isArray(postsJson) ? postsJson : []),
  ...(Array.isArray(pagesJson) ? pagesJson : []),
] as any[];

const rawItem = allItems.find((item) => item.id === entry.id) || null;

/* ---------------------------
   SEO metadata
--------------------------- */
const title = entry.title || stripHtml(rawItem?.title?.rendered || "") || "Contenuto";
const description =
  entry.excerpt || stripHtml(rawItem?.excerpt?.rendered || "") || "";

// Usa il path normalizzato per il canonical, ma aggiungi trailing slash per output
const canonicalPath = entry.path
  ? `/${entry.path}/`
  : "/";

const metadata = {
  title,
  description,
  canonical: canonicalPath,
  robots: { index: true, follow: true },
};

/* ---------------------------
   Featured image resolver
--------------------------- */
function pickWpSizeUrl(
  fm: WPFeaturedMedia | undefined,
  preferred: string[],
): string | null {
  const sizes = fm?.media_details?.sizes;
  if (!sizes) return fm?.source_url ?? null;

  for (const key of preferred) {
    const u = sizes?.[key]?.source_url;
    if (u) return u;
  }

  const all = Object.values(sizes)
    .filter((s) => s?.source_url)
    .sort((a, b) => (b.width ?? 0) - (a.width ?? 0));

  return all?.[0]?.source_url ?? fm?.source_url ?? null;
}

function getWpHeroImage(item: WPItemRaw | null): HeroImage | null {
  if (!item) return null;

  // Prova prima da _embedded
  const fm = item._embedded?.["wp:featuredmedia"]?.[0];
  if (fm) {
    const alt =
      fm?.alt_text ||
      stripHtml(item.title?.rendered || "") ||
      "Immagine in evidenza";
    const desktopSrc = pickWpSizeUrl(fm, [
      "2048x2048",
      "1536x1536",
      "large",
      "full",
    ]);
    if (!desktopSrc) return null;
    const mobileSrc = pickWpSizeUrl(fm, ["medium_large", "medium", "large"]);

    return {
      desktop: { src: desktopSrc, alt },
      mobile: mobileSrc ? { src: mobileSrc, alt } : undefined,
    };
  }

  // Fallback a yoast og_image
  const ogImage = item.yoast_head_json?.og_image?.[0];
  if (ogImage) {
    const src = ogImage.url || ogImage.src;
    if (src) {
      const alt = stripHtml(item.title?.rendered || "") || "Immagine in evidenza";
      return {
        desktop: { src, alt },
      };
    }
  }

  // Usa featuredImage da WpEntry se disponibile
  if ((entry as any).featuredImage) {
    return {
      desktop: (entry as any).featuredImage,
    };
  }

  return null;
}

const hero = getWpHeroImage(rawItem);

/* ---------------------------
   Related posts (max 6) by category
--------------------------- */
function getCategoryName(categoryId: number): string | undefined {
  const categories = Array.isArray(categoriesJson) ? categoriesJson : [];
  const category = categories.find((c: any) => c.id === categoryId);
  return category?.name ? stripHtml(category.name) : undefined;
}

function getFirstTagName(item: WPItemRaw): string | undefined {
  const embedded = item._embedded as any;
  const wpTerm = embedded?.["wp:term"] as any;
  if (!Array.isArray(wpTerm)) return undefined;
  const flat = wpTerm.flat().flat();
  const tags = flat.filter(
    (t: any) =>
      t &&
      t.taxonomy === "post_tag" &&
      typeof t.name === "string",
  );
  if (tags.length > 0) {
    return stripHtml(tags[0].name);
  }
  return undefined;
}

function toCardFromWp(item: WPItemRaw, entry: WpEntry): CardPost {
  const fm = item._embedded?.["wp:featuredmedia"]?.[0];
  const imgSrc = fm
    ? pickWpSizeUrl(fm, ["medium_large", "large", "full"])
    : null;

  // Usa il path dall'entry normalizzato, aggiungi trailing slash per href
  // Assicura che href sia sempre assoluto (inizia con /)
  const rawPath = entry.path || entry.slug || "";
  const normalizedPath = rawPath.replace(/^\/+|\/+$/g, "").trim();
  const href = normalizedPath ? `/${normalizedPath}/` : "/";

  // Estrai categoria: prima categoria disponibile, fallback a primo tag
  let categoryName: string | undefined;
  if (item.categories && item.categories.length > 0) {
    categoryName = getCategoryName(item.categories[0]);
  }
  if (!categoryName) {
    categoryName = getFirstTagName(item);
  }

  return {
    href,
    title: stripHtml(item.title?.rendered || ""),
    excerpt: getExcerpt(item.excerpt, item.content?.rendered || item.content, 180),
    img: imgSrc
      ? {
          src: imgSrc,
          alt: fm?.alt_text || stripHtml(item.title?.rendered || ""),
        }
      : undefined,
    category: categoryName,
  };
}

/* ---------------------------
   Related posts: Score-based algorithm (category + tag + recency)
--------------------------- */
// Estrai e normalizza categorie/tag dal post corrente
function extractCurrentTaxonomies(currentEntry: WpEntry, currentRaw: WPItemRaw | null): {
  categories: number[];
  tags: string[];
} {
  const categories: number[] = [];
  const tags: string[] = [];
  
  // Categorie da currentRaw (WP)
  if (currentRaw?.categories && Array.isArray(currentRaw.categories)) {
    categories.push(...currentRaw.categories.filter((id) => typeof id === "number"));
  }
  
  // Tag da currentRaw._embedded (WP)
  if (currentRaw?._embedded) {
    const embedded = currentRaw._embedded as any;
    const wpTerm = embedded?.["wp:term"] as any;
    if (Array.isArray(wpTerm)) {
      const flat = wpTerm.flat().flat();
      const tagTerms = flat.filter(
        (t: any) => t && t.taxonomy === "post_tag" && typeof t.name === "string"
      );
      tags.push(...tagTerms.map((t: any) => String(t.name).trim().toLowerCase()).filter(Boolean));
    }
  }
  
  return { categories, tags };
}

// Calcola score per un post
function calculatePostScore(
  post: any,
  currentCategories: number[],
  currentTags: string[],
  postsJson: any[]
): { score: number; recency: number } {
  let score = 0;
  
  // +10 per ogni categoria condivisa
  const postCategories = Array.isArray(post.categories) ? post.categories : [];
  const commonCategories = currentCategories.filter((catId) => postCategories.includes(catId));
  score += commonCategories.length * 10;
  
  // +3 per ogni tag condiviso
  const postTags: string[] = [];
  if (post._embedded) {
    const embedded = post._embedded as any;
    const wpTerm = embedded?.["wp:term"] as any;
    if (Array.isArray(wpTerm)) {
      const flat = wpTerm.flat().flat();
      const tagTerms = flat.filter(
        (t: any) => t && t.taxonomy === "post_tag" && typeof t.name === "string"
      );
      postTags.push(...tagTerms.map((t: any) => String(t.name).trim().toLowerCase()).filter(Boolean));
    }
  }
  
  const commonTags = currentTags.filter((tag) => postTags.includes(tag));
  score += commonTags.length * 3;
  
  // Recency bonus: calcola timestamp dalla data (per ordinamento secondario)
  const dateStr = post.date || post.modified || "";
  const recency = dateStr ? Date.parse(String(dateStr)) || 0 : 0;
  
  return { score, recency };
}

function findRelatedPosts(currentEntry: WpEntry, currentRaw: WPItemRaw | null): CardPost[] {
  // Solo per posts, non per pages
  if (currentEntry.kind !== "post") {
    return [];
  }
  
  const currentId = currentEntry.id;
  const { categories: currentCategories, tags: currentTags } = extractCurrentTaxonomies(currentEntry, currentRaw);
  
  // Se non ci sono né categorie né tag, usa fallback
  if (currentCategories.length === 0 && currentTags.length === 0) {
    // Fallback: ultimi post (escludendo corrente)
    const posts = Array.isArray(postsJson) ? postsJson : [];
    const fallback = posts
      .filter((p) => p.id !== currentId)
      .sort((a, b) => {
        const dateA = Date.parse(String(a.date || a.modified || "")) || 0;
        const dateB = Date.parse(String(b.date || b.modified || "")) || 0;
        return dateB - dateA;
      })
      .slice(0, 6);
    
    return fallback
      .map((post) => {
        const postEntry = entries.find((e) => e.id === post.id && e.kind === "post");
        return postEntry ? toCardFromWp(post, postEntry) : null;
      })
      .filter((card): card is CardPost => card !== null)
      .slice(0, 6);
  }
  
  const posts = Array.isArray(postsJson) ? postsJson : [];
  
  // Calcola score per ogni post
  type ScoredPost = { post: any; entry: WpEntry; score: number; recency: number };
  const scored: ScoredPost[] = [];
  
  for (const post of posts) {
    if (post.id === currentId) continue;
    
    const postEntry = entries.find((e) => e.id === post.id && e.kind === "post");
    if (!postEntry) continue;
    
    const { score, recency } = calculatePostScore(post, currentCategories, currentTags, posts);
    
    // Includi anche post senza score (per fallback finale)
    scored.push({ post, entry: postEntry, score, recency });
  }
  
  // Ordina per score DESC, poi per recency DESC
  scored.sort((a, b) => {
    if (a.score !== b.score) return b.score - a.score;
    return b.recency - a.recency;
  });
  
  // Prendi i migliori (min 3, max 6)
  const topScored = scored.slice(0, 6);
  
  // Se abbiamo meno di 3 con score > 0, completa con i più recenti
  const withScore = topScored.filter((s) => s.score > 0);
  if (withScore.length < 3) {
    // Prendi i più recenti tra quelli senza score o con score basso
    const remaining = scored
      .filter((s) => !withScore.includes(s))
      .sort((a, b) => b.recency - a.recency)
      .slice(0, 6 - withScore.length);
    
    const result = [...withScore, ...remaining]
      .slice(0, 6)
      .map((s) => toCardFromWp(s.post, s.entry));
    
    // Se ancora sotto 3, completa fino a 3
    if (result.length < 3 && result.length > 0) {
      return result; // Accetta anche se meno di 3
    }
    
    return result.slice(0, 6);
  }
  
  return topScored
    .slice(0, 6)
    .map((s) => toCardFromWp(s.post, s.entry));
}

const relatedPosts: CardPost[] = findRelatedPosts(entry, rawItem);

/* ---------------------------
   Extract tags for sidebar
--------------------------- */
function extractTags(item: WPItemRaw | null | undefined): { slug: string; name: string }[] {
  if (!item) return [];
  // Type assertion per accedere a wp:term che non è nel tipo stretto
  const embedded = item._embedded as any;
  const wpTerm = embedded?.["wp:term"] as any;
  if (!Array.isArray(wpTerm)) return [];
  const flat = wpTerm.flat().flat();
  return flat
    .filter(
      (t: any) =>
        t &&
        t.taxonomy === "post_tag" &&
        typeof t.slug === "string" &&
        typeof t.name === "string",
    )
    .map((t: any) => ({ slug: String(t.slug), name: String(t.name) }));
}

const postTags = extractTags(rawItem);

/* ---------------------------
   Internal Linking: Generate seed phrases and keywords
--------------------------- */
// Genera frase precompilata per Ribaltatore da titolo/categoria
function generateSeedPhrase(item: WPItemRaw | null, entry: WpEntry): string {
  if (!item) return "";
  
  // Prova prima il titolo (primi 50 caratteri)
  const title = stripHtml(item.title?.rendered || "");
  if (title && title.length > 10) {
    // Prendi prime parole significative (max 8 parole)
    const words = title.split(/\s+/).slice(0, 8).join(" ");
    return words.length > 50 ? words.slice(0, 47) + "..." : words;
  }
  
  // Fallback: usa prima categoria
  if (item.categories && item.categories.length > 0) {
    const catName = getCategoryName(item.categories[0]);
    if (catName) return catName;
  }
  
  // Fallback: usa primo tag
  const tagName = getFirstTagName(item);
  if (tagName) return tagName;
  
  return "";
}

// Genera keyword tema per ricerca
function generateThemeKeyword(item: WPItemRaw | null, entry: WpEntry): string {
  if (!item) return "";
  
  // Prova prima categoria
  if (item.categories && item.categories.length > 0) {
    const catName = getCategoryName(item.categories[0]);
    if (catName) return catName;
  }
  
  // Fallback: primo tag
  const tagName = getFirstTagName(item);
  if (tagName) return tagName;
  
  // Fallback: prime parole del titolo (max 3)
  const title = stripHtml(item.title?.rendered || "");
  if (title) {
    const words = title.split(/\s+/).slice(0, 3).join(" ");
    return words;
  }
  
  return "";
}

const seedPhrase = entry.kind === "post" ? generateSeedPhrase(rawItem || null, entry) : "";
const themeKeyword = entry.kind === "post" ? generateThemeKeyword(rawItem || null, entry) : "";
const ribaltatoreUrl = seedPhrase ? `/ribaltatore/?q=${encodeURIComponent(seedPhrase)}` : "/ribaltatore/";
const cercaUrl = themeKeyword ? `/cerca/?q=${encodeURIComponent(themeKeyword)}` : "/cerca/";

/* ---------------------------
   Esclusione CTA per pagina sostegno
--------------------------- */
// Verifica se siamo sulla pagina "sostieni-la-nostra-causa"
const isSupportPage = entry.path === "sostieni-la-nostra-causa" || 
                      entry.slug === "sostieni-la-nostra-causa" ||
                      requestedPath === "sostieni-la-nostra-causa" ||
                      Astro.url.pathname.includes("/sostieni-la-nostra-causa");

/* ---------------------------
   Sidebar content logic
--------------------------- */
// Determina se la sidebar ha contenuti da mostrare
// Per ora: ShareBar + AdSlot sono sempre presenti per i post
// Tags sono opzionali
const hasSidebarContent = entry.kind === "post";

/* ---------------------------
   Post URL and title for ShareBar
--------------------------- */
// Usa Astro.url.origin per URL dinamico (adatta a localhost/preview/prod)
const baseUrl = Astro.url.origin;
const postUrl = entry.link || `${baseUrl}${canonicalPath}`;
const postTitleForShare = title || "";

/* ---------------------------
   Render content
--------------------------- */
let contentHtml = entry.html || rawItem?.content?.rendered || "";
const titleHtml = entry.title || rawItem?.title?.rendered || "";

/* ---------------------------
   Rimuovi CTA dal contenuto se siamo sulla pagina sostegno
--------------------------- */
if (isSupportPage && contentHtml) {
  // Rimuovi blocchi CTA comuni dal contenuto HTML
  // Pattern: div/section con classi CTA, bottoni di donazione, link mailto per donazioni
  contentHtml = contentHtml
    // Rimuovi div/section con classi CTA comuni
    .replace(/<div[^>]*class="[^"]*\b(cta|donation|support|sostieni|sostegno)[^"]*"[^>]*>[\s\S]*?<\/div>/gi, "")
    .replace(/<section[^>]*class="[^"]*\b(cta|donation|support|sostieni|sostegno)[^"]*"[^>]*>[\s\S]*?<\/section>/gi, "")
    // Rimuovi bottoni con testo "Dona", "Sostieni", "Unisciti", "Supporta"
    .replace(/<a[^>]*href="[^"]*(mailto:|donazione|donate|sostieni|support)[^"]*"[^>]*>[\s\S]*?<\/a>/gi, "")
    .replace(/<button[^>]*>[\s\S]*?(Dona|Sostieni|Unisciti|Supporta|Fai una donazione)[\s\S]*?<\/button>/gi, "")
    // Rimuovi heading H2/H3 con testo CTA
    .replace(/<h[23][^>]*>[\s\S]*?(Unisciti|Sostieni|Dona|Supporta|Fai una donazione)[\s\S]*?<\/h[23]>/gi, "")
    // Pulisci spazi multipli e righe vuote eccessive
    .replace(/\n{3,}/g, "\n\n")
    .replace(/\s{3,}/g, " ");
}
---

<SiteLayout metadata={metadata}>
  <main class="container page-shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol class="breadcrumbs__list">
        <li class="breadcrumbs__item">
          <a class="breadcrumbs__link" href="/">
            Home
          </a>
        </li>
        <li class="breadcrumbs__item">
          <span class="breadcrumbs__current">{title}</span>
        </li>
      </ol>
    </nav>

    {hero ? (
      <figure class="post-hero not-prose">
        <picture>
          {hero.mobile ? (
            <source media="(max-width: 768px)" srcset={hero.mobile.src} />
          ) : null}
          <img
            src={hero.desktop.src}
            alt={hero.desktop.alt}
            loading="eager"
            decoding="async"
          />
        </picture>
      </figure>
    ) : null}

    <div class={`post-layout ${!hasSidebarContent ? "no-sidebar" : ""}`}>
      <article class="post-main wp-page">
        <h1 set:html={titleHtml} />
        <div set:html={contentHtml} />

        <div style="margin: 1.5rem 0;">
          <AdSlot slot={ADS_SLOT_ARTICLE} label="Pubblicità" />
        </div>

        {/* Internal Linking Boxes - Solo per post */}
        {foundEntry.kind === "post" && (seedPhrase || themeKeyword) ? (
          <section class="internal-linking" aria-label="Esplora contenuti correlati">
            <div class="internal-linking__grid">
              {seedPhrase ? (
                <div class="internal-linking__box">
                  <h3 class="internal-linking__title">🧠 Prova il Ribaltatore</h3>
                  <p class="internal-linking__text">
                    Ribalta questa frase proibizionista con l'AI e scopri l'ironia dietro lo slogan.
                  </p>
                  <a href={ribaltatoreUrl} class="internal-linking__btn">
                    Ribalta "{seedPhrase.slice(0, 30)}..."
                  </a>
                </div>
              ) : null}
              
              {themeKeyword ? (
                <div class="internal-linking__box">
                  <h3 class="internal-linking__title">🔍 Frasi Correlate</h3>
                  <p class="internal-linking__text">
                    Cerca altre frasi e contenuti su questo tema nel nostro archivio.
                  </p>
                  <a href={cercaUrl} class="internal-linking__btn">
                    Cerca "{themeKeyword}"
                  </a>
                </div>
              ) : null}
            </div>
          </section>
        ) : null}

        {/* CTA tra post e correlati - Esclusa per pagina sostegno */}
        {!isSupportPage ? (
          <section class="post-cta" aria-label="Supporta Canapalandia">
            <h2 class="post-cta__title">Supporta Canapalandia</h2>
            <p class="post-cta__text">
              Se questo contenuto ti è stato utile, puoi sostenerci: ci aiuta a
              mantenere il progetto indipendente e aggiornato.
            </p>
            <div class="post-cta__actions">
              <a class="btn primary" href={SUPPORT_URL}>
                Sostieni il progetto
              </a>
              <a class="btn ghost" href={PARTNER_URL}>
                Scopri i partner
              </a>
            </div>
          </section>
        ) : null}

        {relatedPosts?.length >= 3 ? (
          <section class="related" aria-label="Articoli correlati">
            <h2 class="related__title">Articoli correlati</h2>
            <div class="related__grid">
              {relatedPosts.map((p) => (
                <article class="post-card">
                  <a class="cardLink" href={safeInternalHref(p.href)}>
                    <div class="thumb">
                      {p.img ? (
                        <img
                          src={p.img.src}
                          alt={p.img.alt}
                          loading="lazy"
                          decoding="async"
                        />
                      ) : null}
                    </div>
                    <div class="cardBody">
                      {p.category ? (
                        <span class="cardCategory">{p.category}</span>
                      ) : null}
                      <h3 class="cardTitle">{p.title}</h3>
                      <p class="cardExcerpt">{p.excerpt}</p>
                      <span class="cardCta">Leggi →</span>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </section>
        ) : null}
      </article>

      {hasSidebarContent ? (
        <aside class="post-sidebar">
          <div class="sidebar-section">
            <h3 class="sidebar-title">Condividi</h3>
            <ShareBar url={postUrl} title={postTitleForShare} />
          </div>

          {postTags.length > 0 ? (
            <div class="sidebar-section">
              <h3 class="sidebar-title">Tag</h3>
              <div class="post-tags">
                {postTags.map((tag) => (
                  <a href={`/tag/${tag.slug}/`} class="tag-link">
                    {tag.name}
                  </a>
                ))}
              </div>
            </div>
          ) : null}

          <BlogSidebar />
        </aside>
      ) : null}
    </div>
  </main>
</SiteLayout>

