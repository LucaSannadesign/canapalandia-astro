---
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import EnglishSiteLayout from "../../layouts/EnglishSiteLayout.astro";
import PostMeta from "../../components/PostMeta.astro";
import PostShare from "../../components/PostShare.astro";
import SupportCTA from "../../components/SupportCTA.astro";
import Reactions from "../../components/Reactions.astro";
import BlogSidebar from "../../components/blog/BlogSidebar.astro";
import EnglishBlogSidebar from "../../components/blog/EnglishBlogSidebar.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import PostBodyH1 from "../../components/PostBodyH1.astro";
import PostAttachments from "../../components/PostAttachments.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import { isReachableBlogEntry } from "../../lib/blogVisibility";
import { FEATURES } from "../../lib/consts";
import {
  languageFromCategory,
  translationAlternates,
  type SiteLanguage,
} from "../../lib/localization";

export const prerender = false;

const slug = String(Astro.params.slug ?? "").trim();
if (!slug) return new Response(null, { status: 404 });

let entry = await getEntry("blog", slug);
if (!entry) {
  const all = await getCollection("blog");
  entry = all.find((e) => (e.data?.slug || e.id || "").trim() === slug) ?? undefined;
}
if (!entry) return new Response(null, { status: 404 });

const publicSlug = (entry.data?.slug || entry.id || "").trim();
if (!publicSlug || publicSlug !== slug) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

if (!isReachableBlogEntry(entry)) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const isLegacyReview = entry.data.editorialStatus === "legacy-review";
const lang: SiteLanguage = languageFromCategory(entry.data.category);
const isEnglish = lang === "en";
const PageLayout = isEnglish ? EnglishSiteLayout : SiteLayout;
const { Content } = await render(entry);

function normalizeImgSrc(src: unknown): string {
  const s = typeof src === "string" ? src.trim() : "";
  if (!s) return "";
  if (s.startsWith("http://") || s.startsWith("https://")) return s;
  if (s.startsWith("/")) return s;
  return `/${s}`;
}

function normalizeImage(entry: CollectionEntry<"blog">): string {
  const raw = entry.data.image || entry.data.coverImage || "";
  let srcValue: unknown = raw;
  if (raw && typeof raw === "object" && raw !== null && "src" in raw) {
    srcValue = (raw as { src?: unknown }).src;
  }
  return normalizeImgSrc(srcValue);
}

function toDate(value: Date | string | number | null | undefined): Date | null {
  if (!value) return null;
  if (value instanceof Date) return Number.isNaN(value.getTime()) ? null : value;
  const d = new Date(String(value));
  return Number.isNaN(d.getTime()) ? null : d;
}

const rawCover = entry.data.image || entry.data.coverImage || "";
const coverSrc = normalizeImgSrc(rawCover);
const postImage = normalizeImage(entry);
const SITE_URL = import.meta.env.SITE || "https://canapalandia.com";
const alternates = translationAlternates(slug, SITE_URL);

const hreflangHead = alternates
  ? [
      `<link rel="alternate" hreflang="it" href="${alternates.it}" />`,
      `<link rel="alternate" hreflang="en" href="${alternates.en}" />`,
      `<link rel="alternate" hreflang="x-default" href="${alternates.xDefault}" />`,
    ].join("\n")
  : "";

const metadata = {
  title: entry.data.title,
  description: entry.data.description || "",
  canonical: `${SITE_URL}/blog/${slug}/`,
  robots: { index: !isLegacyReview, follow: true },
  ogType: "article",
  ogSiteName: "Canapalandia",
  ogImage: postImage || undefined,
  twitterCard: "summary_large_image",
};

const canonicalUrl = metadata.canonical;
const postTitle = entry.data.title;
const showShare = entry.data.showShare !== false;
const showSupportCta = entry.data.showSupportCta !== false;

const canonicalAbs = metadata.canonical;
const imageAbs = postImage ? new URL(postImage, SITE_URL).toString() : undefined;
const publishedISO = toDate(entry.data.publishDate)?.toISOString();
const modifiedRaw = toDate(entry.data.updatedDate)?.toISOString();
const modifiedISO =
  modifiedRaw && publishedISO && Date.parse(modifiedRaw) >= Date.parse(publishedISO)
    ? modifiedRaw
    : publishedISO;

const jsonLd = !isLegacyReview
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "@id": `${canonicalAbs}#article`,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonicalAbs },
      headline: entry.data.title,
      description: entry.data.description || "",
      ...(imageAbs ? { image: [imageAbs] } : {}),
      datePublished: publishedISO,
      dateModified: modifiedISO,
      author: {
        "@type": "Organization",
        name: "Canapalandia",
        url: `${SITE_URL.replace(/\/+$/, "")}/`,
      },
      publisher: {
        "@type": "Organization",
        name: "Canapalandia",
        url: `${SITE_URL.replace(/\/+$/, "")}/`,
        logo: {
          "@type": "ImageObject",
          url: new URL("/favicons/favicon-192.png", SITE_URL).toString(),
        },
      },
      inLanguage: isEnglish ? "en" : "it-IT",
      keywords: Array.isArray(entry.data.tags) ? entry.data.tags.join(", ") : undefined,
    }
  : null;
---

<PageLayout metadata={metadata} yoastHeadHtml={hreflangHead} newsletter={!isEnglish}>
  {jsonLd ? (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
  ) : null}

  <div class="container page-shell">
    <div class="post-layout">
      <article class="post-main">
        {alternates ? (
          <LanguageSwitcher
            currentLanguage={lang}
            italianUrl={alternates.it}
            englishUrl={alternates.en}
          />
        ) : null}

        <h1>{entry.data.title}</h1>

        <div class="post-meta-row">
          <PostMeta
            publishDate={entry.data.publishDate}
            updatedDate={entry.data.updatedDate}
            slug={slug}
            lang={lang}
          />
          <p class="post-author" aria-label={isEnglish ? "Article author" : "Autore articolo"}>
            {isEnglish ? "By" : "Di"} <strong>Canapalandia</strong>
          </p>
        </div>

        {isLegacyReview ? (
          <aside
            class="post-legacy-warning"
            aria-label={isEnglish ? "Archive article under editorial review" : "Articolo d'archivio in revisione"}
          >
            <strong>
              {isEnglish ? "Archive article under editorial review" : "Articolo d'archivio in revisione editoriale"}
            </strong>
            <p>
              {isEnglish
                ? "This historical content is being reviewed against current sources. The previous text has been temporarily withdrawn from consultation and indexing. Do not use this page for medical or therapeutic decisions."
                : "Questo contenuto storico conteneva formulazioni o indicazioni che richiedono una verifica con fonti aggiornate. Il testo precedente è stato temporaneamente ritirato dalla consultazione e dall'indicizzazione. Non usare questa pagina per decisioni sanitarie o terapeutiche."}
              <a href={isEnglish ? "/en/disclaimer/" : "/disclaimer-legale-canapalandia/"}>
                {isEnglish ? " Read the legal disclaimer." : " Consulta il disclaimer."}
              </a>
            </p>
          </aside>
        ) : null}

        {!isLegacyReview && coverSrc ? (
          <figure class="post-hero">
            <img
              class="post-hero__img"
              src={coverSrc}
              alt={entry.data.coverAlt || entry.data.title || ""}
              loading="eager"
              decoding="async"
              referrerpolicy="no-referrer"
              onerror="this.onerror=null;this.src='/images/placeholder.svg';"
            />
          </figure>
        ) : null}

        {isLegacyReview ? (
          <div class="post-content post-content--legacy" data-post-content>
            <p>
              {isEnglish
                ? "The editorial team is reviewing this article's sources, wording and context before making it available again."
                : "La redazione sta riesaminando fonti, formulazioni e contesto di questo articolo prima di renderlo nuovamente disponibile. Nel frattempo puoi consultare gli articoli più recenti del sito e il disclaimer editoriale."}
            </p>
          </div>
        ) : (
          <div class="post-content" data-post-content>
            <Content components={{ h1: PostBodyH1 }} />
          </div>
        )}

        {!isLegacyReview ? <PostAttachments attachments={entry.data.attachments} lang={lang} /> : null}

        <aside class="post-editorial-note" aria-label={isEnglish ? "Editorial note" : "Nota editoriale"}>
          <p>
            {isEnglish ? (
              <>
                Canapalandia is an independent editorial project covering hemp, CBD, cannabis and policy.
                Its content is for information only and does not constitute legal or medical advice.
                <a href="/en/disclaimer/"> Read the legal disclaimer.</a>
              </>
            ) : (
              <>
                Canapalandia è un progetto editoriale indipendente dedicato a canapa, CBD, cannabis light e
                normativa in Italia. I contenuti hanno finalità informative e non costituiscono consulenza
                legale o medica.
                <a href="/disclaimer-legale-canapalandia/"> Leggi il disclaimer legale.</a>
              </>
            )}
          </p>
        </aside>

        <hr class="post-separator" aria-hidden="true" />

        {!isLegacyReview && !isEnglish && FEATURES.REACTIONS && <Reactions slug={slug} />}

        {!isLegacyReview ? (
          <PostShare url={canonicalUrl} title={postTitle} showShare={showShare} lang={lang} />
        ) : null}

        {!isLegacyReview && !isEnglish ? (
          <SupportCTA supportUrl="/sostieni-la-nostra-causa/" showSupportCta={showSupportCta} />
        ) : null}

        <RelatedPosts
          currentSlug={slug}
          category={entry.data.category}
          tags={entry.data.tags}
        />
      </article>

      <aside class="post-sidebar">
        {isEnglish ? (
          <EnglishBlogSidebar currentSlug={slug} category={entry.data.category} tags={entry.data.tags} />
        ) : (
          <BlogSidebar />
        )}
      </aside>
    </div>
  </div>
</PageLayout>

<style>
  .post-hero {
    width: 100%;
    border-radius: var(--r-sm);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
    margin: 1.5rem 0 2rem;
  }

  .post-hero__img {
    width: 100%;
    height: auto;
    display: block;
  }

  .post-separator {
    margin: 3rem 0 2.5rem;
    border: none;
    border-top: 1px solid var(--border);
    opacity: 0.5;
  }

  .post-main .post-content {
    max-width: 72ch;
    width: 100%;
    line-height: 1.7;
    font-size: clamp(1.0625rem, 0.4vw + 1rem, 1.1875rem);
  }

  .post-main .post-content--legacy { margin-top: 1.25rem; }
  .post-main .post-content > * + * { margin-top: 1.15rem; }

  .post-main .post-content p {
    margin: 0 0 1.35rem;
    line-height: 1.7;
  }

  .post-main .post-content :global(h2) {
    margin-top: 40px !important;
    margin-bottom: 0.9rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    scroll-margin-top: 96px;
  }

  .post-main .post-content :global(h2:first-child) { margin-top: 40px !important; }

  .post-main .post-content h3 {
    margin: 2.6rem 0 0.65rem;
    line-height: 1.25;
    scroll-margin-top: 96px;
  }

  .post-main .post-content h2 + p,
  .post-main .post-content h2 + ul,
  .post-main .post-content h2 + ol,
  .post-main .post-content h3 + p,
  .post-main .post-content h3 + ul,
  .post-main .post-content h3 + ol { margin-top: 0.25rem; }

  .post-main .post-content ul,
  .post-main .post-content ol {
    margin: 0 0 1.1rem;
    padding-left: 1.25rem;
  }

  .post-main .post-content li { margin: 0.35rem 0; }
  .post-main .post-content li > p { margin: 0.55rem 0; }

  .post-main .post-content blockquote {
    margin: 1.4rem 0;
    padding: 0.85rem 1rem;
    border-left: 3px solid var(--border);
  }

  .post-main .post-content details {
    margin: 1.1rem 0;
    padding: 0.15rem 0;
  }

  .post-main .post-content summary { cursor: pointer; line-height: 1.35; }
  .post-main .post-content details[open] > summary { margin-bottom: 0.55rem; }
  .post-main .post-content details p { margin-bottom: 0.9rem; }

  .post-main .post-content hr {
    margin: 1.6rem 0;
    border: none;
    border-top: 1px solid var(--border);
    opacity: 0.5;
  }

  .post-main .post-content :global(img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 2rem 0;
    border-radius: var(--r-sm);
    object-fit: cover;
  }

  .post-main .post-content :global(a[href]) {
    color: #a7f3d0 !important;
    text-decoration: underline;
    text-decoration-color: rgba(167, 243, 208, 0.7);
    text-underline-offset: 0.18em;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .post-main .post-content :global(a[href]:hover) {
    color: #ecfccb !important;
    text-decoration-color: currentColor;
  }

  :global(html[data-theme="light"]) .post-main .post-content :global(a[href]) {
    color: #169c48 !important;
    text-decoration-color: rgba(22, 156, 72, 0.45);
  }

  :global(html[data-theme="light"]) .post-main .post-content :global(a[href]:hover) {
    color: #15803d !important;
    text-decoration-color: currentColor;
  }

  @media (max-width: 640px) {
    .post-main .post-content { line-height: 1.7; }
    .post-main .post-content h3 { margin-top: 1.8rem; }
  }

  .post-main h1 {
    line-height: 1.08;
    margin-bottom: 1rem;
  }

  .post-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.2rem;
    margin: 0 0 1.15rem;
  }

  .post-meta-row :global(.post-meta) { margin: 0; padding: 0; }

  .post-author {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.45;
    white-space: nowrap;
  }

  .post-author strong {
    color: var(--text);
    font-weight: var(--font-semibold);
  }

  .post-meta-row :global(.post-meta__date) { white-space: nowrap; }

  @media (max-width: 640px) {
    .post-meta-row {
      align-items: flex-start;
      gap: 0.5rem 1rem;
      margin-bottom: 1rem;
    }
  }

  .post-legacy-warning {
    margin: 0 0 1.5rem;
    padding: 1rem 1.1rem;
    border: 1px solid color-mix(in oklab, #c58a2a 55%, var(--border));
    border-left-width: 4px;
    border-radius: var(--r-md);
    background: color-mix(in oklab, #c58a2a 12%, var(--panel));
  }

  .post-legacy-warning strong {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--text);
  }

  .post-legacy-warning p {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .post-legacy-warning a {
    color: var(--brand);
    font-weight: var(--font-medium);
  }

  .post-editorial-note {
    margin: 2rem 0 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-md);
    background: color-mix(in oklab, var(--panel) 78%, transparent);
  }

  .post-editorial-note p {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .post-editorial-note a {
    color: var(--brand);
    font-weight: var(--font-medium);
  }

  :global(html[data-theme="light"]) .post-sidebar :global(.promo-card__cta) {
    background: #0f6f3b;
    color: #ffffff !important;
  }

  :global(html[data-theme="light"]) .post-sidebar :global(.promo-card__cta:hover) {
    background: #0d5f34;
    color: #ffffff !important;
  }

  :global(html[data-theme="dark"]) .post-sidebar :global(.promo-card__cta) {
    background: #f6e7a1;
    color: #12351f !important;
  }

  :global(html[data-theme="dark"]) .post-sidebar :global(.promo-card__cta:hover) {
    background: #fff2b8;
    color: #0d2a18 !important;
    box-shadow: 0 8px 20px rgba(246, 231, 161, 0.2);
  }

  @media (min-width: 1024px) {
    .post-sidebar {
      align-self: stretch;
      overflow: visible;
    }

    .post-sidebar :global(.editorial-sidebar) {
      min-height: 100%;
      align-content: start;
      overflow: visible;
    }

    .post-sidebar :global(.promo-card) {
      position: sticky;
      top: var(--post-sticky-top, calc(var(--nav-h, 76px) + 16px));
      z-index: 2;
      align-self: start;
    }
  }

  @media (max-width: 1023px) {
    .post-sidebar :global(.promo-card) {
      position: relative;
      top: auto;
      z-index: auto;
    }
  }
</style>
