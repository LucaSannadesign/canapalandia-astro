---
import { getEntryBySlug, type CollectionEntry } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import PostMeta from "../../components/PostMeta.astro";
import PostShare from "../../components/PostShare.astro";
import SupportCTA from "../../components/SupportCTA.astro";
import Reactions from "../../components/Reactions.astro";
import BlogSidebar from "../../components/blog/BlogSidebar.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import { FEATURES, ADS_SLOT_ARTICLE } from "../../lib/consts";

export const prerender = false;

const slug = String(Astro.params.slug ?? "").trim();
if (!slug) return new Response(null, { status: 404 });

const entry = await (getEntryBySlug as any)("blog", slug);
if (!entry) return new Response(null, { status: 404 });

const { Content } = await (entry as any).render();

// Helper per normalizzare URL/path immagine
function normalizeImgSrc(src: unknown): string {
  const s = typeof src === "string" ? src.trim() : "";
  if (!s) return "";
  if (s.startsWith("http://") || s.startsWith("https://")) return s;
  if (s.startsWith("/")) return s;
  return `/${s}`;
}

// Helper per normalizzare immagine post (supporta ImageMetadata objects)
function normalizeImage(entry: CollectionEntry<"blog">): string {
  const raw = entry.data.image || entry.data.coverImage || "";
  let srcValue: unknown = raw;

  if (raw && typeof raw === "object" && raw !== null && "src" in raw) {
    const srcObj = raw as { src?: unknown };
    srcValue = srcObj.src;
  }

  return normalizeImgSrc(srcValue);
}

// Helper per convertire Date/string/number/null/undefined in Date | null
function toDate(value: Date | string | number | null | undefined): Date | null {
  if (!value) return null;
  if (value instanceof Date) {
    return Number.isNaN(value.getTime()) ? null : value;
  }
  const d = new Date(String(value));
  return Number.isNaN(d.getTime()) ? null : d;
}

// Calcola cover image
const rawCover = (entry as any).data.image || (entry as any).data.coverImage || "";
const coverSrc = normalizeImgSrc(rawCover);

// Calcola og:image dal post (coverImage o image)
const postImage = normalizeImage(entry);
const SITE_URL = import.meta.env.SITE || "https://canapalandia.com";

const metadata = {
  title: (entry as any).data.title,
  description: (entry as any).data.description || "",
  canonical: `${SITE_URL}/blog/${slug}/`,
  robots: { index: true, follow: true },
  ogType: "article",
  ogSiteName: "Canapalandia",
  ogImage: postImage || undefined,
  twitterCard: "summary_large_image",
};

// URL canonico per condivisione
const canonicalUrl = metadata.canonical;
const postTitle = (entry as any).data.title;

// Opzioni frontmatter per disabilitare blocchi
const showShare = (entry as any).data.showShare !== false; // default: true
const showSupportCta = (entry as any).data.showSupportCta !== false; // default: true

// JSON-LD (Schema.org) - BlogPosting
const canonicalAbs = metadata.canonical; // già assoluto
const imageAbs = postImage ? new URL(postImage, SITE_URL).toString() : undefined;

const publishedISO = toDate((entry as any).data.publishDate)?.toISOString();
const modifiedISO =
  toDate((entry as any).data.updatedDate)?.toISOString() || publishedISO;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${canonicalAbs}#article`,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalAbs },

  headline: (entry as any).data.title,
  description: (entry as any).data.description || "",

  ...(imageAbs ? { image: [imageAbs] } : {}),

  datePublished: publishedISO,
  dateModified: modifiedISO,

  author: {
    "@type": "Organization",
    name: (entry as any).data.author || "Canapalandia",
  },
  publisher: {
    "@type": "Organization",
    name: "Canapalandia",
    logo: {
      "@type": "ImageObject",
      url: new URL("/favicons/favicon-192.png", SITE_URL).toString(),
    },
  },

  inLanguage: "it-IT",
  keywords: Array.isArray((entry as any).data.tags)
    ? (entry as any).data.tags.join(", ")
    : undefined,
};
---

<SiteLayout metadata={metadata}>
  <main class="container page-shell">
    <div class="post-layout">
      <article class="post-main">
        <h1>{(entry as any).data.title}</h1>

        <PostMeta
          publishDate={(entry as any).data.publishDate}
          updatedDate={(entry as any).data.updatedDate}
          slug={slug}
        />

        {coverSrc ? (
          <figure class="post-hero">
            <img
              class="post-hero__img"
              src={coverSrc}
              alt={(entry as any).data.title || ""}
              loading="eager"
              decoding="async"
              referrerpolicy="no-referrer"
              onerror="this.onerror=null;this.src='/images/placeholder.svg';"
            />
          </figure>
        ) : null}

        {/* Contenuto articolo (SCOPED) */}
        <div class="post-content" data-post-content>
          <Content />
        </div>

        {/* Separatore */}
        <hr class="post-separator" aria-hidden="true" />

        {/* Reazioni */}
        {FEATURES.REACTIONS && <Reactions slug={slug} />}

        {/* Social Share */}
        <PostShare url={canonicalUrl} title={postTitle} showShare={showShare} />

        {/* Post-end Ad */}
        <div class="post-end-ad" aria-label="Pubblicità">
          <AdSlot slot={ADS_SLOT_ARTICLE} label="Pubblicità" />
        </div>

        {/* CTA Sostienici */}
        <SupportCTA supportUrl="/sostieni-la-nostra-causa/" showSupportCta={showSupportCta} />

        {/* Articoli correlati */}
        <RelatedPosts
          currentSlug={slug}
          category={(entry as any).data.category}
          tags={(entry as any).data.tags}
        />
      </article>

      <aside class="post-sidebar">
        <BlogSidebar />
      </aside>
    </div>
  </main>

</SiteLayout>

<style>
  .post-hero {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
    margin: 1.5rem 0 2rem;
  }

  .post-hero__img {
    width: 100%;
    height: clamp(220px, 32vw, 520px);
    object-fit: cover;
    object-position: center;
    display: block;
  }

  @media (max-width: 640px) {
    .post-hero__img {
      height: clamp(180px, 38vw, 320px);
    }
  }

  /* Separatore dopo contenuto post */
  .post-separator {
    margin: 3rem 0 2.5rem;
    border: none;
    border-top: 1px solid var(--border);
    opacity: 0.5;
  }

  /* =========================================================
     BLOG POST — TYPOGRAPHY (solo contenuto articolo)
     Scope: .post-main .post-content
     ========================================================= */

  .post-main .post-content {
    line-height: 1.75;
    font-size: clamp(1rem, 0.25vw + 0.95rem, 1.08rem);
    max-width: 72ch; /* leggibilità */
  }

  /* Spazio verticale consistente tra blocchi */
  .post-main .post-content > * + * {
    margin-top: 0.9rem;
  }

  /* Paragrafi: margini azzerati */
  .post-main .post-content p {
    margin: 0;
  }

  /* Titoli: più spazio sopra (capitoli), meno sotto */
  .post-main .post-content h2 {
    margin: 2.2rem 0 0.9rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    scroll-margin-top: 96px;
  }

  .post-main .post-content h3 {
    margin: 1.6rem 0 0.75rem;
    line-height: 1.25;
    scroll-margin-top: 96px;
  }

  /* Titolo seguito da testo/lista: avvicina leggermente */
  .post-main .post-content h2 + p,
  .post-main .post-content h2 + ul,
  .post-main .post-content h2 + ol,
  .post-main .post-content h3 + p,
  .post-main .post-content h3 + ul,
  .post-main .post-content h3 + ol {
    margin-top: 0.35rem;
  }

  /* Liste: più respirazione e indent corretto */
  .post-main .post-content ul,
  .post-main .post-content ol {
    margin: 0 0 1.1rem;
    padding-left: 1.25rem;
  }

  .post-main .post-content li {
    margin: 0.35rem 0;
  }

  .post-main .post-content li > p {
    margin: 0.55rem 0;
  }

  /* Blockquote (se presenti) */
  .post-main .post-content blockquote {
    margin: 1.2rem 0;
    padding: 0.85rem 1rem;
    border-left: 3px solid var(--border);
  }

  /* FAQ <details>: spaziatura e leggibilità */
  .post-main .post-content details {
    margin: 0.9rem 0;
    padding: 0.15rem 0;
  }

  .post-main .post-content summary {
    cursor: pointer;
    line-height: 1.35;
  }

  .post-main .post-content details[open] > summary {
    margin-bottom: 0.55rem;
  }

  .post-main .post-content details p {
    margin-bottom: 0.9rem;
  }

  /* HR dentro contenuto (se usato nel markdown) */
  .post-main .post-content hr {
    margin: 1.6rem 0;
    border: none;
    border-top: 1px solid var(--border);
    opacity: 0.5;
  }

  /* Tighten post title leading and header spacing */
  .post-main h1 {
    line-height: 1.08;
    margin-bottom: 1rem;
  }

  .post-meta {
    margin-bottom: 1rem;
  }
</style>