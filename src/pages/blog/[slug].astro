---
// MODIFICA 1: Importato getEntry e render al posto di getEntryBySlug
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import AdSlot from "../../components/AdSlot.astro";
import PostMeta from "../../components/PostMeta.astro";
import PostShare from "../../components/PostShare.astro";
import SupportCTA from "../../components/SupportCTA.astro";
import Reactions from "../../components/Reactions.astro";
import BlogSidebar from "../../components/blog/BlogSidebar.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import { FEATURES, ADS_SLOT_ARTICLE } from "../../lib/consts";

export const prerender = false;

const slug = String(Astro.params.slug ?? "").trim();
if (!slug) return new Response(null, { status: 404 });

let entry = await getEntry("blog", slug);
if (!entry) {
  const all = await getCollection("blog");
  entry =
    all.find((e) => (e.data?.slug || e.id || "").trim() === slug) ?? undefined;
}
if (!entry) return new Response(null, { status: 404 });

const publicSlug = (entry.data?.slug || entry.id || "").trim();
if (!publicSlug || publicSlug !== slug) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

// MODIFICA 3: Usata la nuova funzione render(entry)
const { Content } = await render(entry);

// Helper per normalizzare URL/path immagine
function normalizeImgSrc(src: unknown): string {
  const s = typeof src === "string" ? src.trim() : "";
  if (!s) return "";
  if (s.startsWith("http://") || s.startsWith("https://")) return s;
  if (s.startsWith("/")) return s;
  return `/${s}`;
}

// Helper per normalizzare immagine post (supporta ImageMetadata objects)
function normalizeImage(entry: CollectionEntry<"blog">): string {
  const raw = entry.data.image || entry.data.coverImage || "";
  let srcValue: unknown = raw;

  if (raw && typeof raw === "object" && raw !== null && "src" in raw) {
    const srcObj = raw as { src?: unknown };
    srcValue = srcObj.src;
  }

  return normalizeImgSrc(srcValue);
}

// Helper per convertire Date/string/number/null/undefined in Date | null
function toDate(value: Date | string | number | null | undefined): Date | null {
  if (!value) return null;
  if (value instanceof Date) {
    return Number.isNaN(value.getTime()) ? null : value;
  }
  const d = new Date(String(value));
  return Number.isNaN(d.getTime()) ? null : d;
}

// Calcola cover image
const rawCover = entry.data.image || entry.data.coverImage || "";
const coverSrc = normalizeImgSrc(rawCover);

// Calcola og:image dal post (coverImage o image)
const postImage = normalizeImage(entry);
const SITE_URL = import.meta.env.SITE || "https://canapalandia.com";

const metadata = {
  title: entry.data.title,
  description: entry.data.description || "",
  canonical: `${SITE_URL}/blog/${slug}/`,
  robots: { index: true, follow: true },
  ogType: "article",
  ogSiteName: "Canapalandia",
  ogImage: postImage || undefined,
  twitterCard: "summary_large_image",
};

// URL canonico per condivisione
const canonicalUrl = metadata.canonical;
const postTitle = entry.data.title;

// Opzioni frontmatter per disabilitare blocchi
const showShare = entry.data.showShare !== false; // default: true
const showSupportCta = entry.data.showSupportCta !== false; // default: true

// JSON-LD (Schema.org) - BlogPosting
const canonicalAbs = metadata.canonical; // già assoluto
const imageAbs = postImage ? new URL(postImage, SITE_URL).toString() : undefined;

const publishedISO = toDate(entry.data.publishDate)?.toISOString();
const modifiedISO =
  toDate(entry.data.updatedDate)?.toISOString() || publishedISO;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${canonicalAbs}#article`,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalAbs },

  headline: entry.data.title,
  description: entry.data.description || "",

  ...(imageAbs ? { image: [imageAbs] } : {}),

  datePublished: publishedISO,
  dateModified: modifiedISO,

  author: {
    "@type": "Organization",
    name: entry.data.author || "Canapalandia",
  },
  publisher: {
    "@type": "Organization",
    name: "Canapalandia",
    logo: {
      "@type": "ImageObject",
      url: new URL("/favicons/favicon-192.png", SITE_URL).toString(),
    },
  },

  inLanguage: "it-IT",
  keywords: Array.isArray(entry.data.tags)
    ? entry.data.tags.join(", ")
    : undefined,
};
---

<SiteLayout metadata={metadata}>
  <main class="container page-shell">
    <div class="post-layout">
      <article class="post-main">
        <h1>{entry.data.title}</h1>

        <div class="post-meta-row">
          <PostMeta
            publishDate={entry.data.publishDate}
            updatedDate={entry.data.updatedDate}
            slug={slug}
          />
          <p class="post-author" aria-label="Autore articolo">
            Di <strong>{entry.data.author || "Canapalandia"}</strong>
          </p>
        </div>

        {coverSrc ? (
          <figure class="post-hero">
            <img
              class="post-hero__img"
              src={coverSrc}
              alt={entry.data.title || ""}
              loading="eager"
              decoding="async"
              referrerpolicy="no-referrer"
              onerror="this.onerror=null;this.src='/images/placeholder.svg';"
            />
          </figure>
        ) : null}

        {/* Contenuto articolo (SCOPED) */}
        <div class="post-content" data-post-content>
          <Content />
        </div>

        <aside class="post-editorial-note" aria-label="Nota editoriale">
          <p>
            Canapalandia è un progetto editoriale indipendente dedicato a canapa, CBD, cannabis light e
            normativa in Italia. I contenuti hanno finalità informative e non costituiscono consulenza
            legale o medica.
            <a href="/disclaimer-legale-canapalandia/"> Leggi il disclaimer legale.</a>
          </p>
        </aside>

        {/* Separatore */}
        <hr class="post-separator" aria-hidden="true" />

        {/* Reazioni */}
        {FEATURES.REACTIONS && <Reactions slug={slug} />}

        {/* Social Share */}
        <PostShare url={canonicalUrl} title={postTitle} showShare={showShare} />

        {/* Post-end Ad */}
        <div class="post-end-ad" aria-label="Pubblicità">
          <AdSlot slot={ADS_SLOT_ARTICLE} label="Pubblicità" />
        </div>

        {/* CTA Sostienici */}
        <SupportCTA supportUrl="/sostieni-la-nostra-causa/" showSupportCta={showSupportCta} />

        {/* Articoli correlati */}
        <RelatedPosts
          currentSlug={slug}
          category={entry.data.category}
          tags={entry.data.tags}
        />
      </article>

      <aside class="post-sidebar">
        <BlogSidebar />
      </aside>
    </div>
  </main>

</SiteLayout>

<style>
  .post-hero {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
    margin: 1.5rem 0 2rem;
  }

  .post-hero__img {
    width: 100%;
     height: clamp(220px,34vw,520px);
    object-fit: cover;
    object-position: center;
    display: block;
  }

  @media (max-width: 640px) {
    .post-hero__img {
      height: clamp(180px, 38vw, 320px);
    }
  }

  /* Separatore dopo contenuto post */
  .post-separator {
    margin: 3rem 0 2.5rem;
    border: none;
    border-top: 1px solid var(--border);
    opacity: 0.5;
  }

  /* =========================================================
     BLOG POST — TYPOGRAPHY (solo contenuto articolo)
     Scope: .post-main .post-content
     ========================================================= */

  .post-main .post-content {
    max-width: 72ch;
    width: 100%;
    line-height: 1.75;
    font-size: clamp(1rem, 0.25vw + 0.95rem, 1.08rem);
  }

  /* Spazio verticale consistente tra blocchi */
  .post-main .post-content > * + * {
    margin-top: 1.15rem;
  }

  /* Paragrafi: ritmo regolare e leggibile */
  .post-main .post-content p {
    margin: 0 0 1.2rem;
    line-height: 1.75;
  }

  /* Titoli: più spazio sopra (capitoli), meno sotto */
  .post-main .post-content h2 {
    margin: 4rem 0 0.9rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    scroll-margin-top: 96px;
  }

  .post-main .post-content > h2:first-child {
    margin-top: 2.2rem;
  }

  .post-main .post-content h3 {
    margin: 2.6rem 0 0.65rem;
    line-height: 1.25;
    scroll-margin-top: 96px;
  }

  /* Titolo seguito da testo/lista: avvicina leggermente */
  .post-main .post-content h2 + p,
  .post-main .post-content h2 + ul,
  .post-main .post-content h2 + ol,
  .post-main .post-content h3 + p,
  .post-main .post-content h3 + ul,
  .post-main .post-content h3 + ol {
    margin-top: 0.25rem;
  }

  /* Liste: più respirazione e indent corretto */
  .post-main .post-content ul,
  .post-main .post-content ol {
    margin: 0 0 1.1rem;
    padding-left: 1.25rem;
  }

  .post-main .post-content li {
    margin: 0.35rem 0;
  }

  .post-main .post-content li > p {
    margin: 0.55rem 0;
  }

  /* Blockquote (se presenti) */
  .post-main .post-content blockquote {
    margin: 1.4rem 0;
    padding: 0.85rem 1rem;
    border-left: 3px solid var(--border);
  }

  /* FAQ <details>: spaziatura e leggibilità */
  .post-main .post-content details {
    margin: 1.1rem 0;
    padding: 0.15rem 0;
  }

  .post-main .post-content summary {
    cursor: pointer;
    line-height: 1.35;
  }

  .post-main .post-content details[open] > summary {
    margin-bottom: 0.55rem;
  }

  .post-main .post-content details p {
    margin-bottom: 0.9rem;
  }

  /* HR dentro contenuto (se usato nel markdown) */
  .post-main .post-content hr {
    margin: 1.6rem 0;
    border: none;
    border-top: 1px solid var(--border);
    opacity: 0.5;
  }

  .post-main .post-content :global(img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 2rem 0;
    border-radius: 16px;
    object-fit: cover;
  }

  .post-main .post-content :global(a[href]) {
    color: #169c48 !important;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    transition: color 160ms ease;
  }

  .post-main .post-content :global(a[href]:hover) {
    color: #22c55e !important;
  }

  .dark .post-main .post-content :global(a[href]) {
    color: #bbf7d0 !important;
  }

  .dark .post-main .post-content :global(a[href]:hover) {
    color: #dcfce7 !important;
  }

  @media (max-width: 640px) {
    .post-main .post-content {
      line-height: 1.7;
    }

    .post-main .post-content h2 {
      margin-top: 2.3rem;
    }

    .post-main .post-content h3 {
      margin-top: 1.8rem;
    }
  }

  /* Tighten post title leading and header spacing */
  .post-main h1 {
    line-height: 1.08;
    margin-bottom: 1rem;
  }

  .post-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.2rem;
    margin: 0 0 1.15rem;
  }

  .post-meta-row :global(.post-meta) {
    margin: 0;
    padding: 0;
  }

  .post-author {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.45;
    white-space: nowrap;
  }

  .post-author strong {
    color: var(--text);
    font-weight: var(--font-semibold);
  }

  .post-meta-row :global(.post-meta__date) {
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .post-meta-row {
      align-items: flex-start;
      gap: 0.5rem 1rem;
      margin-bottom: 1rem;
    }
  }

  .post-editorial-note {
    margin: 2rem 0 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-md);
    background: color-mix(in oklab, var(--panel) 78%, transparent);
  }

  .post-editorial-note p {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .post-editorial-note a {
    color: var(--brand);
    font-weight: var(--font-medium);
  }
</style>
