---
/**
 * Route di paginazione blog: /blog/page/[page]/
 * Compatibilità WordPress: assorbe URL storici /blog/page/2/, /blog/page/3/, ecc.
 * 
 * Requisiti:
 * - page=1 canonicalizza a /blog/ (redirect 301)
 * - page>=2: status 200, robots index,follow, canonical self
 * - Se page eccede il massimo: 404 vero
 */
import SiteLayout from "../../../layouts/SiteLayout.astro";
import CardPost from "../../../components/CardPost.astro";
import postsJson from "../../../../data/wp/out/posts.json";
import { toParams } from "../../../lib/wp";

export const prerender = false;

const pageParam = Astro.params.page;
const pageNum = pageParam ? parseInt(pageParam, 10) : 1;

// Validazione: page deve essere intero >= 1
if (isNaN(pageNum) || pageNum < 1) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

// page=1 canonicalizza a /blog/
if (pageNum === 1) {
  return Astro.redirect("/blog/", 301);
}

// Helpers (coerenti con blog.astro)
const posts = Array.isArray(postsJson) ? postsJson : [];
const postTitle = (p: any) => p?.title?.rendered || p?.title || "";
const stripHtml = (s: any) =>
  String(s || "")
    .replace(/<[^>]*>/g, " ")
    .replace(/\s+/g, " ")
    .trim();
const excerpt = (p: any) =>
  stripHtml(p?.excerpt?.rendered || p?.excerpt || "").slice(0, 180);
const sortDesc = (a: any, b: any) =>
  (Date.parse(b?.date || b?.modified || "") || 0) -
  (Date.parse(a?.date || a?.modified || "") || 0);
const og = (p: any) =>
  p?.yoast_head_json?.og_image?.[0]?.url ||
  p?.yoast_head_json?.og_image?.[0]?.src ||
  "";
const href = (p: any) => {
  const url = p?.yoast_head_json?.canonical || p?.link || p?.slug || "";
  const path = toParams(url);
  return path ? `/${path}/` : "/";
};
const fmt = (iso: any) =>
  iso
    ? new Date(iso).toLocaleDateString("it-IT", {
        year: "numeric",
        month: "long",
        day: "2-digit",
      })
    : "";

// Paginazione: 12 post per pagina (coerente con blog.astro)
const PER_PAGE = 12;
const allSorted = posts.slice().sort(sortDesc);
const totalPosts = allSorted.length;
const totalPages = Math.ceil(totalPosts / PER_PAGE);

// Se la pagina richiesta eccede il massimo, 404
if (pageNum > totalPages) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

// Calcola slice per questa pagina
const start = (pageNum - 1) * PER_PAGE;
const end = start + PER_PAGE;
const pagePosts = allSorted.slice(start, end);

// Metadata
const title = pageNum > 1 ? `Blog — Pagina ${pageNum} — Canapalandia` : "Blog — Canapalandia";
const canonical = `${Astro.url.origin}/blog/page/${pageNum}/`;

const metadata = {
  title,
  description: "Articoli e guide su cannabis light, CBD e canapa legale in Italia.",
  canonical,
  robots: { index: true, follow: true },
};
---

<SiteLayout metadata={metadata}>
  <main class="container page-shell">
    <section class="hero">
      <div class="container hero-inner">
        <p class="kicker">Blog</p>
        <h1>Articoli e guide</h1>
        <p class="lead">Pagina {pageNum} di {totalPages}</p>
      </div>
    </section>

    {pagePosts.length > 0 ? (
      <div class="grid">
        {pagePosts.map((p: any) => (
          <CardPost
            href={href(p)}
            img={og(p)}
            date={fmt(p?.date || p?.modified)}
            title={postTitle(p)}
            excerpt={excerpt(p)}
          />
        ))}
      </div>
    ) : (
      <div class="card">
        <p>Nessun post trovato.</p>
      </div>
    )}

    {/* Paginazione */}
    <nav class="pagination" aria-label="Paginazione">
      {pageNum > 1 && (
        <a href={pageNum === 2 ? "/blog/" : `/blog/page/${pageNum - 1}/`} class="btn">
          « Pagina precedente
        </a>
      )}
      <span class="pagination-info">
        Pagina {pageNum} di {totalPages}
      </span>
      {pageNum < totalPages && (
        <a href={`/blog/page/${pageNum + 1}/`} class="btn">
          Pagina successiva »
        </a>
      )}
    </nav>
  </main>
</SiteLayout>
