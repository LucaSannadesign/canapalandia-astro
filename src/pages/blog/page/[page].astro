---
import { getCollection, type CollectionEntry } from "astro:content";
import CardPost from "../../../components/CardPost.astro";
import Layout from "../../../layouts/MigratedLayout.astro";

export const prerender = true;

// Helper per formattare data
const formatDate = (value: Date | string | number | null | undefined): string => {
  if (!value) return "";
  const d = value instanceof Date ? value : new Date(String(value));
  if (Number.isNaN(d.getTime())) return "";
  return d.toLocaleDateString("it-IT", { year: "numeric", month: "long", day: "numeric" });
};

function postHref(entry: CollectionEntry<"blog">): string {
  const slug = entry?.slug ?? entry?.data?.slug ?? "";
  if (!slug) throw new Error("Missing slug for post link");
  return `/blog/${slug}/`;
}

function dateOf(entry: CollectionEntry<"blog">): Date | null {
  const raw = entry.data.updatedDate ?? entry.data.publishDate;
  if (!raw) return null;
  const d = raw instanceof Date ? raw : new Date(String(raw));
  return Number.isNaN(d.getTime()) ? null : d;
}

// Helper per normalizzare immagine post
function normalizeImage(entry: CollectionEntry<"blog">): string {
  const img: unknown = entry.data.image || entry.data.coverImage || "";
  
  let srcValue: string | null = null;
  
  if (img && typeof img === "object" && img !== null && "src" in img) {
    const srcObj = img as { src?: unknown };
    if (typeof srcObj.src === "string") {
      srcValue = srcObj.src.trim();
    }
  } else if (typeof img === "string") {
    srcValue = img.trim();
  }
  
  if (!srcValue) return "";
  
  if (/^https?:\/\//i.test(srcValue)) {
    return srcValue;
  }
  
  return srcValue.startsWith("/") ? srcValue : `/${srcValue}`;
}

// Genera paths statici per tutte le pagine (2, 3, 4, ...)
export async function getStaticPaths() {
  const PAGE_SIZE = 10;

  // Filtro per post italiani (definito dentro getStaticPaths per evitare problemi di scope)
  function isItalianPost(entry: CollectionEntry<"blog">): boolean {
    const data = entry.data as any;
    
    // Se esiste data.lang, escludi "en"
    if (data.lang !== undefined) {
      return data.lang === "it";
    }
    
    // Se esiste data.locale, escludi "en"
    if (data.locale !== undefined) {
      return data.locale === "it";
    }
    
    // Altrimenti escludi tutti i post con slug che inizia con "en/"
    const slug = entry.slug || "";
    return !slug.startsWith("en/");
  }

  // Carica tutti i post dalla collection
  let postsAll: CollectionEntry<"blog">[] = [];
  try {
    postsAll = await getCollection("blog");
  } catch (err) {
    console.warn("[blog/page] Nessun contenuto trovato in Content Collections");
  }

  // Filtra solo post italiani
  const italianPosts = postsAll.filter(isItalianPost);

  // Ordina per publishDate (fallback updatedDate) DESC
  const sortedPosts = italianPosts
    .slice()
    .sort((a, b) => {
      const da = a.data.publishDate ?? a.data.updatedDate;
      const db = b.data.publishDate ?? b.data.updatedDate;
      const ta = da ? (da instanceof Date ? da.getTime() : new Date(da).getTime()) : 0;
      const tb = db ? (db instanceof Date ? db.getTime() : new Date(db).getTime()) : 0;
      return tb - ta;
    });

  const totalPosts = sortedPosts.length;
  const totalPages = Math.ceil(totalPosts / PAGE_SIZE);

  const paths = [];
  for (let page = 2; page <= totalPages; page++) {
    paths.push({
      params: { page: page.toString() },
    });
  }
  return paths;
}

const pageParam = Astro.params.page;
const pageNum = pageParam ? parseInt(pageParam, 10) : 1;

// Validazione: page deve essere intero >= 2 (page 1 è /blog/)
if (isNaN(pageNum) || pageNum < 2) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

// Filtro per post italiani (helper per rendering pagina)
function isItalianPost(entry: CollectionEntry<"blog">): boolean {
  const data = entry.data as any;
  
  // Se esiste data.lang, escludi "en"
  if (data.lang !== undefined) {
    return data.lang === "it";
  }
  
  // Se esiste data.locale, escludi "en"
  if (data.locale !== undefined) {
    return data.locale === "it";
  }
  
  // Altrimenti escludi tutti i post con slug che inizia con "en/"
  const slug = entry.slug || "";
  return !slug.startsWith("en/");
}

const PAGE_SIZE = 10;

// Carica tutti i post dalla collection (per questa pagina specifica)
let postsAll: CollectionEntry<"blog">[] = [];
try {
  postsAll = await getCollection("blog");
} catch (err) {
  console.warn("[blog/page] Nessun contenuto trovato in Content Collections");
}

// Filtra solo post italiani
const italianPosts = postsAll.filter(isItalianPost);

// Ordina per publishDate (fallback updatedDate) DESC
const sortedPosts = italianPosts
  .slice()
  .sort((a, b) => {
    const da = a.data.publishDate ?? a.data.updatedDate;
    const db = b.data.publishDate ?? b.data.updatedDate;
    const ta = da ? (da instanceof Date ? da.getTime() : new Date(da).getTime()) : 0;
    const tb = db ? (db instanceof Date ? db.getTime() : new Date(db).getTime()) : 0;
    return tb - ta;
  });

const totalPosts = sortedPosts.length;
const totalPages = Math.ceil(totalPosts / PAGE_SIZE);

// Se la pagina richiesta eccede il massimo, 404
if (pageNum > totalPages) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

// Calcola slice per questa pagina
const start = (pageNum - 1) * PAGE_SIZE;
const end = start + PAGE_SIZE;
const pagePosts = sortedPosts.slice(start, end);

// Metadata
const title = `Blog — Pagina ${pageNum} — Canapalandia`;
const canonical = `${import.meta.env.SITE || "https://canapalandia.com"}/blog/page/${pageNum}/`;
const robots = { index: false, follow: true };
---

<Layout title={title} canonical={canonical} robots={robots}>
  <section class="hero">
    <div class="container hero-inner">
      <p class="kicker">Blog</p>
      <h1>Articoli e guide</h1>
      <p class="lead">Pagina {pageNum} di {totalPages}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {pagePosts.length > 0 ? (
        <>
          <div class="grid">
            {pagePosts.map((p) => {
              const imgSrc = normalizeImage(p);
              return (
                <CardPost
                  href={postHref(p)}
                  img={imgSrc || undefined}
                  date={formatDate(dateOf(p))}
                  title={p.data.title}
                  excerpt={p.data.description}
                  category={p.data.category || null}
                />
              );
            })}
          </div>

          {/* Navigazione paginazione */}
          <div style="margin-top: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            {/* Link "Pagina precedente" */}
            {pageNum > 1 && (
              <a 
                href={pageNum === 2 ? "/blog/" : `/blog/page/${pageNum - 1}/`} 
                class="btn"
              >
                « Pagina precedente
              </a>
            )}
            
            {/* Info paginazione */}
            <span style="color: var(--muted);">
              Pagina {pageNum} di {totalPages}
            </span>

            {/* Bottone "Carica altri" se ci sono più pagine */}
            {pageNum < totalPages && (
              <a href={`/blog/page/${pageNum + 1}/`} class="btn">
                Carica altri »
              </a>
            )}
          </div>
        </>
      ) : (
        <div class="card" style="padding:18px;">
          <h2 style="margin:0 0 6px;">Nessun post trovato</h2>
          <p style="margin:0; color: var(--muted);">
            Nessun contenuto disponibile per questa pagina.
          </p>
        </div>
      )}
    </div>
  </section>
</Layout>
