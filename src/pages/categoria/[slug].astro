---
export const prerender = false;

import SiteLayout from "../../layouts/SiteLayout.astro";
import { WP_API_BASE } from "@/lib/consts";
import { getExcerpt } from "../../lib/utils";

const slug = String(Astro.params.slug ?? "").trim();

function stripHtml(html = "") {
  return html.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
}

function getFeatured(item) {
  const fm = item?._embedded?.["wp:featuredmedia"]?.[0];
  const src =
    fm?.media_details?.sizes?.large?.source_url ||
    fm?.media_details?.sizes?.medium_large?.source_url ||
    fm?.source_url;

  const alt = fm?.alt_text || stripHtml(item?.title?.rendered || "") || "Immagine";
  return src ? { src, alt } : null;
}

// 1) recupero categoria per slug
let category = null;
let posts = [];

if (slug) {
  const catRes = await fetch(`${WP_API_BASE}/categories?slug=${encodeURIComponent(slug)}`, {
    headers: { Accept: "application/json" },
  });

  if (catRes.ok) {
    const cats = await catRes.json();
    category = Array.isArray(cats) && cats.length ? cats[0] : null;
  }

  // 2) recupero post della categoria
  if (category?.id) {
    const postsRes = await fetch(
      `${WP_API_BASE}/posts?categories=${category.id}&per_page=24&_embed=1`,
      { headers: { Accept: "application/json" } }
    );

    if (postsRes.ok) {
      posts = await postsRes.json();
    }
  }
}

const metadata = {
  title: category ? `Categoria: ${stripHtml(category.name)}` : "Categoria",
  description: category ? stripHtml(category.description || "") : "",
  canonical: `/categoria/${slug}/`,
  robots: { index: true, follow: true },
};
---

<SiteLayout metadata={metadata}>
  <main class="container page-shell">
    {!category ? (
      <div class="card">
        <h1>Categoria non trovata</h1>
        <p>Slug richiesto: <code>{slug}</code></p>
      </div>
    ) : (
      <>
        <div class="section-head">
          <h1>Categoria: {stripHtml(category.name)}</h1>
          {category.description ? <p class="section-lead">{stripHtml(category.description)}</p> : null}
        </div>

        {posts?.length ? (
          <div class="grid">
            {posts.map((p) => {
              const img = getFeatured(p);
              return (
                <article class="card post-card">
                  <a class="cardLink" href={p.slug ? `/${p.slug}/` : "/"}>
                    <div class="thumb">
                      {img ? <img src={img.src} alt={img.alt} loading="lazy" decoding="async" /> : null}
                    </div>
                    <div class="cardBody">
                      <p class="cardMeta">{new Date(p.date).toLocaleDateString("it-IT")}</p>
                      <h3 class="cardTitle" set:html={p.title.rendered}></h3>
                      {(() => {
                        const excerptText = getExcerpt(p.excerpt, p.content?.rendered || p.content, 180);
                        return excerptText ? (
                          <p class="cardExcerpt">{excerptText}</p>
                        ) : null;
                      })()}
                      <div class="cardCta">Leggi →</div>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="card">
            <p>Nessun post trovato in questa categoria.</p>
          </div>
        )}
      </>
    )}
  </main>
</SiteLayout>