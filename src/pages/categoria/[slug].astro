---
export const prerender = false;

import { getCollection, type CollectionEntry } from "astro:content";
import { isCategoryIndexAllowed } from "../../lib/categoryIndexAllowlist";
import { normalizeCategorySlug } from "../../lib/categoryUrl";
import { isPublishedBlogEntry } from "../../lib/blogVisibility";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CardPost from "../../components/CardPost.astro";

const slug = String(Astro.params.slug ?? "").trim();

const canonicalSlug = normalizeCategorySlug(slug);
if (slug !== canonicalSlug) {
  return Astro.redirect(`/categoria/${canonicalSlug}/`, 301);
}

const formatDate = (value: Date | string | number | null | undefined): string => {
  if (!value) return "";
  const d = value instanceof Date ? value : new Date(String(value));
  if (Number.isNaN(d.getTime())) return "";
  return d.toLocaleDateString("it-IT", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

function dateOf(entry: CollectionEntry<"blog">): Date | null {
  const raw = entry.data.publishDate ?? entry.data.updatedDate;
  if (!raw) return null;
  const d = raw instanceof Date ? raw : new Date(String(raw));
  return Number.isNaN(d.getTime()) ? null : d;
}

function getPostImage(entry: CollectionEntry<"blog">): string | undefined {
  const img = entry.data.image || entry.data.coverImage;
  if (!img || typeof img !== "string" || !img.trim()) return undefined;

  const trimmed = img.trim();
  if (/^https?:\/\//i.test(trimmed)) return trimmed;

  const normalized = trimmed.startsWith("public/") ? trimmed.slice(7) : trimmed;
  return normalized.startsWith("/") ? normalized : `/${normalized}`;
}

function postHref(entry: CollectionEntry<"blog">): string {
  const postSlug = (entry.id || entry.data.slug || "").trim();
  if (!postSlug || postSlug === "undefined") return "/blog/";
  return `/blog/${postSlug}/`;
}

let postsAll: CollectionEntry<"blog">[] = [];
try {
  postsAll = await getCollection("blog");
} catch {
  console.warn("[categoria] Nessun contenuto trovato in Content Collections");
}

const now = new Date();
const posts = postsAll
  .filter(
    (post) =>
      isPublishedBlogEntry(post, now) &&
      normalizeCategorySlug(post.data.category || "") === canonicalSlug,
  )
  .sort((a, b) => {
    const ta = dateOf(a)?.getTime() ?? 0;
    const tb = dateOf(b)?.getTime() ?? 0;
    return tb - ta;
  });

if (posts.length === 0) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

const categoryName = posts[0]?.data.category
  ? posts[0].data.category
      .split("-")
      .map((word: string) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(" ")
  : canonicalSlug
      .split("-")
      .map((word: string) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(" ");

const HUBS: Record<
  string,
  {
    label: string;
    eyebrow: string;
    title: string;
    description: string;
    seoTitle: string;
    seoDescription: string;
  }
> = {
  "cannabis-news-it": {
    label: "Notizie Italia",
    eyebrow: "Notizie",
    title: "Cannabis in Italia: notizie e contesto",
    description:
      "Aggiornamenti e approfondimenti sul dibattito italiano: norme, mercato, politica e società, per seguire i fatti senza perdere il contesto.",
    seoTitle: "Notizie Italia: cannabis light, CBD, referendum e norme | Canapalandia",
    seoDescription:
      "Archivio Notizie Italia: analisi su cannabis light, CBD, filiera e politica. Verifica sempre leggi, decreti e comunicati ufficiali.",
  },
  normativa: {
    label: "Normativa",
    eyebrow: "Normativa",
    title: "Normativa su cannabis, CBD e canapa",
    description:
      "Norme, provvedimenti e aggiornamenti che incidono sulla cannabis light, sul CBD e sulla filiera della canapa in Italia.",
    seoTitle: "Normativa cannabis, CBD e canapa in Italia | Canapalandia",
    seoDescription:
      "Leggi, decreti, sentenze e aggiornamenti su cannabis light, CBD e canapa in Italia, con attenzione alle fonti e al quadro europeo.",
  },
  "cbd-alimentazione": {
    label: "CBD",
    eyebrow: "CBD",
    title: "CBD: prodotti, regole e approfondimenti",
    description:
      "Articoli su CBD, mercato, regolazione e ricerca, con attenzione alle fonti e ai cambiamenti che riguardano consumatori e operatori.",
    seoTitle: "CBD in Italia: regole, sicurezza e approfondimenti | Canapalandia",
    seoDescription:
      "Approfondimenti sul CBD in Italia: regole, sicurezza, mercato, ricerca e aggiornamenti per orientarsi tra fonti e cambiamenti normativi.",
  },
  "canapa-e-ambiente": {
    label: "Canapa",
    eyebrow: "Canapa",
    title: "Canapa e ambiente: filiera, materiali e sostenibilità",
    description:
      "Approfondimenti sulla canapa industriale, sugli impieghi dei materiali, sulla filiera e sul rapporto tra coltivazione e ambiente.",
    seoTitle: "Canapa industriale e ambiente: filiera e sostenibilità | Canapalandia",
    seoDescription:
      "Canapa industriale, materiali, agricoltura e sostenibilità: articoli sulla filiera, sugli impieghi e sul rapporto tra canapa e ambiente.",
  },
};

const hub = HUBS[canonicalSlug];
const displayName = hub?.label ?? categoryName;
const categoryShouldIndex = isCategoryIndexAllowed(canonicalSlug);

const metadata = {
  title: hub?.seoTitle ?? `Categoria: ${categoryName}`,
  description: hub?.seoDescription ?? `Articoli nella categoria ${categoryName}.`,
  canonical: `/categoria/${canonicalSlug}/`,
  robots: categoryShouldIndex
    ? { index: true, follow: true }
    : { index: false, follow: true },
};
---

<SiteLayout metadata={metadata}>
  <Breadcrumbs
    items={[
      { label: "Home", href: "/" },
      { label: "Blog", href: "/blog/" },
      { label: "Categoria", href: "/blog/" },
      { label: displayName, isCurrent: true },
    ]}
  />

  <section class:list={["category-hero", { "category-hero--hub": Boolean(hub) }]}>
    <div class="category-hero__copy">
      <p class="category-hero__eyebrow">{hub?.eyebrow ?? "Categoria"}</p>
      <h1>{hub?.title ?? categoryName}</h1>
      <p class="category-hero__lead">
        {hub?.description ?? `Esplora gli articoli dedicati a ${categoryName}.`}
      </p>
    </div>

    <div class="category-hero__stat" aria-label={`${posts.length} articoli`}>
      <strong>{posts.length}</strong>
      <span>{posts.length === 1 ? "articolo" : "articoli"}</span>
    </div>
  </section>

  <section class="category-feed" aria-labelledby="category-feed-title">
    <div class="category-feed__head">
      <div>
        <p class="category-feed__eyebrow">Archivio</p>
        <h2 id="category-feed-title">Ultimi articoli</h2>
      </div>
      <a class="category-feed__all" href="/blog/">Tutto il blog →</a>
    </div>

    <div class="grid category-grid">
      {posts.map((post) => (
        <CardPost
          href={postHref(post)}
          img={getPostImage(post)}
          date={formatDate(dateOf(post))}
          title={post.data.title}
          excerpt={post.data.description}
          category={displayName}
        />
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .category-hero {
    margin: 0.5rem 0 0;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    border: 1px solid var(--border-subtle);
    border-radius: clamp(1rem, 2vw, 1.5rem);
    background:
      radial-gradient(circle at 92% 15%, rgba(34, 197, 94, 0.11), transparent 34%),
      color-mix(in oklab, var(--panel), transparent 8%);
    overflow: hidden;
  }

  .category-hero__copy {
    min-width: 0;
  }

  .category-hero__eyebrow,
  .category-feed__eyebrow {
    margin: 0 0 0.6rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand);
  }

  .category-hero h1 {
    max-width: 19ch;
    margin: 0;
    font-size: clamp(2.1rem, 4.2vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .category-hero__lead {
    max-width: 68ch;
    margin: 1rem 0 0;
    font-family: var(--font-editorial);
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    line-height: 1.65;
    color: var(--muted);
  }

  .category-hero__stat {
    min-width: 112px;
    padding: 1rem 1.15rem;
    display: grid;
    gap: 0.15rem;
    align-self: end;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--panel-2), transparent 10%);
    font-family: var(--font-ui);
  }

  .category-hero__stat strong {
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    line-height: 1;
    color: var(--text);
  }

  .category-hero__stat span {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .category-feed {
    margin-top: clamp(2.25rem, 5vw, 4rem);
  }

  .category-feed__head {
    margin-bottom: 1.25rem;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .category-feed__head h2 {
    margin: 0;
    font-size: clamp(1.65rem, 3vw, 2.35rem);
    line-height: 1.1;
  }

  .category-feed__all {
    flex: 0 0 auto;
    padding-bottom: 0.15rem;
    font-family: var(--font-ui);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--brand) !important;
  }

  .category-grid {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  @media (max-width: 700px) {
    .category-hero {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .category-hero h1 {
      max-width: none;
    }

    .category-hero__stat {
      width: fit-content;
      min-width: 104px;
    }

    .category-feed__head {
      align-items: start;
      flex-direction: column;
    }
  }
</style>