---
export const prerender = false;

import { getCollection, type CollectionEntry } from "astro:content";
import { CATEGORY_INDEX_ALLOWLIST } from "../../lib/categoryIndexAllowlist";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CardPost from "../../components/CardPost.astro";

const slug = String(Astro.params.slug ?? "").trim();

// Helper per formattare data (accetta Date/string/number/null/undefined, non crasha mai)
const formatDate = (value: Date | string | number | null | undefined): string => {
  if (!value) return "";
  const d = value instanceof Date ? value : new Date(String(value));
  if (Number.isNaN(d.getTime())) return "";
  return d.toLocaleDateString("it-IT", { year: "numeric", month: "long", day: "numeric" });
};

function dateOf(entry: CollectionEntry<"blog">): Date | null {
  const raw = entry.data.publishDate ?? entry.data.updatedDate;
  if (!raw) return null;
  const d = raw instanceof Date ? raw : new Date(String(raw));
  return Number.isNaN(d.getTime()) ? null : d;
}

// Helper per ottenere immagine post: usa entry.data.image con fallback a coverImage
function getPostImage(entry: CollectionEntry<"blog">): string | undefined {
  const img = entry.data.image || entry.data.coverImage;
  if (!img || typeof img !== "string" || !img.trim()) return undefined;
  const trimmed = img.trim();
  
  // Se è un URL assoluto (http:// o https://), NON modificarlo
  if (/^https?:\/\//i.test(trimmed)) {
    return trimmed; // Restituisci URL assoluto così com'è
  }
  
  // Normalizza path locale: rimuovi "public/" se presente e assicura che inizi con "/"
  let normalized = trimmed.startsWith("public/") ? trimmed.slice(7) : trimmed;
  return normalized.startsWith("/") ? normalized : `/${normalized}`;
}

function postHref(entry: CollectionEntry<"blog">): string {
  const slug = (entry.id || entry.data.slug || "").trim();
  // Protezione minima: evita sempre /blog/undefined/
  if (!slug || slug === "undefined") return "/blog/";
  return `/blog/${slug}/`;
}

// Carica tutti i post dalla collection
let postsAll: CollectionEntry<"blog">[] = [];
try {
  postsAll = await getCollection("blog");
} catch (err) {
  // Se non ci sono contenuti, postsAll rimane vuoto
  console.warn("[categoria] Nessun contenuto trovato in Content Collections");
}

// Filtra per categoria
const posts = postsAll
  .filter((p) => (p.data.category || "") === slug)
  .sort((a, b) => {
    const da = dateOf(a);
    const db = dateOf(b);
    const ta = da ? da.getTime() : 0;
    const tb = db ? db.getTime() : 0;
    return tb - ta;
  });

if (posts.length === 0) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

// Estrai nome categoria dal primo post (se disponibile)
// Oppure usa slug "umanizzato" come fallback
const categoryName = posts.length > 0 && posts[0].data.category
  ? posts[0].data.category
      .split("-")
      .map((w: string) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(" ")
  : slug
      .split("-")
      .map((w: string) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(" ");

/** Hub editoriale: molti contenuti IT, URL già usato dalla home come “Notizie Italia”. */
const CANNABIS_NEWS_IT_SLUG = "cannabis-news-it";
const isCannabisNewsItHub = slug === CANNABIS_NEWS_IT_SLUG;
const breadcrumbCategoryLabel = isCannabisNewsItHub ? "Notizie Italia" : categoryName;

const categoryShouldIndex = CATEGORY_INDEX_ALLOWLIST.has(slug);

const metadata = {
  title: posts.length > 0
    ? isCannabisNewsItHub
      ? "Notizie Italia: cannabis light, CBD, referendum e norme | Canapalandia"
      : `Categoria: ${categoryName}`
    : "Categoria non trovata",
  description: posts.length > 0
    ? isCannabisNewsItHub
      ? "Archivio Notizie Italia: analisi su cannabis light, CBD, filiera e politica. Lettura giornalistica — verifica sempre leggi, decreti e comunicati ufficiali, senza trattarla come consulenza legale."
      : `Articoli nella categoria ${categoryName}.`
    : `Nessun articolo trovato per la categoria ${slug}.`,
  canonical: `/categoria/${slug}/`,
  robots: categoryShouldIndex ? { index: true, follow: true } : { index: false, follow: true },
};
---

<SiteLayout metadata={metadata}>
  <main class="container page-shell">
    {posts.length === 0 ? (
      <div class="card">
        <h1>Categoria non trovata</h1>
        <p>
          Nessun post trovato per la categoria <code>{slug}</code>.
        </p>
        <p>
          <a href="/blog/">Torna al blog</a>
        </p>
      </div>
    ) : (
      <>
        <Breadcrumbs
          items={[
            { label: "Home", href: "/" },
            { label: "Blog", href: "/blog/" },
            { label: "Categoria", href: "/blog/" },
            { label: breadcrumbCategoryLabel, isCurrent: true },
          ]}
        />

        <div class="section-head">
          {isCannabisNewsItHub ? (
            <>
              <h1>Cannabis in Italia: notizie e contesto</h1>
              <p class="section-lead">
                Raccolta di articoli sul dibattito italiano: norme, mercato, politica e società, con
                attenzione alle conseguenze concrete per cittadini e filiera.{" "}
                {posts.length} {posts.length === 1 ? "articolo" : "articoli"} in questa categoria.
              </p>
            </>
          ) : (
            <>
              <h1>Categoria: {categoryName}</h1>
              <p class="section-lead">
                {posts.length} {posts.length === 1 ? "articolo" : "articoli"} in questa categoria.
              </p>
            </>
          )}
        </div>

        {isCannabisNewsItHub ? (
          <div class="prose">
            <h2>Per chi è questa categoria</h2>
            <p>
              È pensata per chi vuole seguire l&apos;evoluzione della cannabis in Italia senza
              perdere il filo tra notizia isolata e quadro d&apos;insieme: dal referendum alle norme
              su cannabis light e CBD, fino alle discussioni su lavoro, sanità e sicurezza stradale.
            </p>
            <h2>Come leggere gli articoli qui sotto</h2>
            <p>
              Ogni pezzo resta un contributo giornalistico: integra sempre leggi e decreti al testo
              vigente, comunicati delle autorità e documentazione scientifica originale quando ti
              serve una certezza operativa.
            </p>
            <h2>Cosa non troverai in questa pagina</h2>
            <p>
              Non pubblichiamo istruzioni operative su soglie chimiche né consulenza legale o
              medica sostitutiva delle fonti istituzionali.
            </p>
          </div>
        ) : null}

        <div class="grid">
          {posts.map((p) => (
            <CardPost
              href={postHref(p)}
              img={getPostImage(p)}
              date={formatDate(dateOf(p))}
              title={p.data.title}
              excerpt={p.data.description}
              category={p.data.category || null}
            />
          ))}
        </div>
      </>
    )}
  </main>
</SiteLayout>