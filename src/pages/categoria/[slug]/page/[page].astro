---
/**
 * Route di paginazione categoria: /categoria/[slug]/page/[page]/
 * Compatibilità WordPress: assorbe URL storici /categoria/slug/page/2/, ecc.
 * 
 * Requisiti:
 * - page=1 canonicalizza a /categoria/[slug]/ (redirect 301)
 * - page>=2: status 200, robots index,follow, canonical self
 * - Se page eccede il massimo: 404 vero
 */
export const prerender = false;

import { getCollection, type CollectionEntry } from "astro:content";
import SiteLayout from "../../../../layouts/SiteLayout.astro";
import CardPost from "../../../../components/CardPost.astro";

const slug = String(Astro.params.slug ?? "").trim();
const pageParam = Astro.params.page;
const pageNum = pageParam ? parseInt(pageParam, 10) : 1;

// Validazione: page deve essere intero >= 1
if (isNaN(pageNum) || pageNum < 1) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

// page=1 canonicalizza a /categoria/[slug]/
if (pageNum === 1) {
  return Astro.redirect(`/categoria/${slug}/`, 301);
}

// Helper per formattare data
function formatDate(date: Date): string {
  return date.toLocaleDateString("it-IT", {
    year: "numeric",
    month: "long",
    day: "2-digit",
  });
}

function dateOf(p: any): Date {
  return p?.data?.publishDate ?? p?.data?.updatedDate ?? new Date(0);
}

// Carica tutti i post dalla collection
let postsAll: CollectionEntry<"blog">[] = [];
try {
  postsAll = await getCollection("blog");
} catch (err) {
  // Se non ci sono contenuti, postsAll rimane vuoto
  console.warn("[categoria/page] Nessun contenuto trovato in Content Collections");
}

// Filtra per categoria
const allPosts = postsAll
  .filter((p) => (p.data.category || "") === slug)
  .sort((a, b) => dateOf(b).getTime() - dateOf(a).getTime());

// Se categoria non esiste (0 post), 404
if (allPosts.length === 0) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

// Paginazione: 24 post per pagina
const PER_PAGE = 24;
const totalPosts = allPosts.length;
const totalPages = Math.max(1, Math.ceil(totalPosts / PER_PAGE));

// Se la pagina richiesta eccede il massimo, 404
if (pageNum > totalPages) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

// Calcola slice per questa pagina
const start = (pageNum - 1) * PER_PAGE;
const end = start + PER_PAGE;
const pagePosts = allPosts.slice(start, end);

// Estrai nome categoria dal primo post
const categoryName = allPosts[0].data.category
  ? allPosts[0].data.category
      .split("-")
      .map((w: string) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(" ")
  : slug
      .split("-")
      .map((w: string) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(" ");

const metadata = {
  title: `Categoria: ${categoryName} — Pagina ${pageNum}`,
  description: `Articoli nella categoria ${categoryName}, pagina ${pageNum} di ${totalPages}.`,
  canonical: `${import.meta.env.SITE || "https://canapalandia.com"}/categoria/${slug}/page/${pageNum}/`,
  robots: { index: true, follow: true },
};
---

<SiteLayout metadata={metadata}>
  <main class="container page-shell">
    <div class="section-head">
      <h1>Categoria: {categoryName}</h1>
      <p class="section-lead">Pagina {pageNum} di {totalPages}</p>
    </div>

    {pagePosts.length > 0 ? (
      <>
        <div class="grid">
          {pagePosts.map((p) => (
            <CardPost
              href={`/blog/${p.slug}/`}
              img={p.data.coverImage || undefined}
              date={formatDate(dateOf(p))}
              title={p.data.title}
              excerpt={p.data.description}
              category={p.data.category || null}
            />
          ))}
        </div>

        {/* Paginazione */}
        <nav class="pagination" aria-label="Paginazione">
          {pageNum > 1 && (
            <a
              href={
                pageNum === 2
                  ? `/categoria/${slug}/`
                  : `/categoria/${slug}/page/${pageNum - 1}/`
              }
              class="btn"
            >
              « Pagina precedente
            </a>
          )}
          <span class="pagination-info">
            Pagina {pageNum} di {totalPages}
          </span>
          {pageNum < totalPages && (
            <a href={`/categoria/${slug}/page/${pageNum + 1}/`} class="btn">
              Pagina successiva »
            </a>
          )}
        </nav>
      </>
    ) : (
      <div class="card">
        <p>Nessun post trovato in questa categoria.</p>
      </div>
    )}
  </main>
</SiteLayout>
