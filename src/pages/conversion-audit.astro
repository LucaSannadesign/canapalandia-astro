---
export const prerender = false;

import SiteLayout from "../layouts/SiteLayout.astro";

const hostname = Astro.url.hostname;
const isProductionHost = hostname === "canapalandia.com" || hostname === "www.canapalandia.com";
if (isProductionHost) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const metadata = {
  title: "Conversion Audit | Canapalandia",
  description: "Audit rapido delle conversioni e dei punti di ottimizzazione del sito.",
  canonical: "/conversion-audit/",
  robots: { index: false, follow: false },
};
---

<SiteLayout metadata={metadata}>
  <section class="container page-shell conversion-audit-page">
    <h1>Conversion Audit</h1>
    <p>Pagina diagnostica disponibile solo fuori dalla produzione.</p>
    <ul>
      <li>Funnel: da verificare</li>
      <li>CTA principali: da verificare</li>
      <li>Tracciamenti: da verificare</li>
    </ul>
  </section>
</SiteLayout>