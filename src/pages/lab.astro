---
import SiteLayout from "@/layouts/SiteLayout.astro";

const title = "Canapalandia Lab: capisci un certificato COA | Canapalandia";
const description =
  "Incolla i risultati di un certificato di analisi (COA) e ottieni una lettura semplice di cannabinoidi, sigle come ND, LOD e LOQ e unità di misura.";
const canonical = `${import.meta.env.SITE || "https://canapalandia.com"}/lab/`;
---

<SiteLayout
  title={title}
  description={description}
  canonical={canonical}
  shell={false}
>
  <section class="lab-page" aria-labelledby="lab-title">
    <div class="container lab-container">
      <header class="lab-hero">
        <p class="lab-kicker">CANAPALANDIA LAB · BETA</p>
        <h1 id="lab-title">Capisci meglio il tuo certificato di analisi</h1>
        <p class="lab-lead">
          Incolla qui la parte del COA con i risultati. Il Lab prova a riconoscere
          cannabinoidi, valori e sigle di laboratorio e li riscrive in modo più
          comprensibile.
        </p>
        <div class="lab-privacy" role="note">
          <span aria-hidden="true">●</span>
          L'analisi avviene nel browser: il testo incollato non viene inviato al
          server da questo strumento.
        </div>
      </header>

      <div class="lab-grid">
        <section class="lab-panel lab-input-panel" aria-labelledby="coa-input-title">
          <div class="lab-panel__head">
            <div>
              <p class="lab-step">1 · INCOLLA</p>
              <h2 id="coa-input-title">Risultati del COA</h2>
            </div>
            <button class="lab-link-button" id="load-example" type="button">
              Usa un esempio
            </button>
          </div>

          <label class="sr-only" for="coa-input">Testo del certificato di analisi</label>
          <textarea
            id="coa-input"
            rows="13"
            spellcheck="false"
            placeholder="Esempio:\nCBD 12,4 %\nCBDA 0,8 %\nΔ9-THC < LOQ\nCBG 0,18 %\nCBN ND"
          ></textarea>

          <p class="lab-help">
            Funziona meglio se copi una riga per ciascun analita. Sono riconosciuti
            CBD, CBDA, THC/Δ9-THC, THCA, CBG, CBGA, CBC e CBN.
          </p>

          <div class="lab-actions">
            <button class="lab-primary" id="analyze-coa" type="button">
              Leggi i risultati
            </button>
            <button class="lab-secondary" id="clear-coa" type="button">
              Pulisci
            </button>
          </div>
        </section>

        <section
          class="lab-panel lab-results-panel"
          aria-labelledby="coa-results-title"
          aria-live="polite"
        >
          <div class="lab-panel__head">
            <div>
              <p class="lab-step">2 · CAPIRE</p>
              <h2 id="coa-results-title">Lettura semplice</h2>
            </div>
          </div>

          <div id="coa-empty" class="lab-empty">
            <div class="lab-empty__mark" aria-hidden="true">COA</div>
            <p>
              Incolla i risultati e premi <strong>Leggi i risultati</strong>.
            </p>
          </div>

          <div id="coa-output" class="lab-output" hidden>
            <div id="coa-summary" class="lab-summary"></div>
            <div id="coa-results" class="lab-result-list"></div>
            <div id="coa-terms" class="lab-terms"></div>
          </div>
        </section>
      </div>

      <section class="lab-explainer" aria-labelledby="lab-explainer-title">
        <div>
          <p class="lab-step">COSA FA DAVVERO</p>
          <h2 id="lab-explainer-title">Un traduttore, non un verdetto</h2>
        </div>
        <div class="lab-explainer__copy">
          <p>
            Un COA può essere difficile da leggere perché usa abbreviazioni,
            soglie analitiche e unità diverse. Questo strumento serve a orientarsi
            nei dati riportati dal laboratorio.
          </p>
          <p>
            <strong>Non certifica</strong> la legalità, la sicurezza, la qualità o
            l'idoneità al consumo di un prodotto e non sostituisce il laboratorio,
            un professionista sanitario o un parere legale.
          </p>
        </div>
      </section>

      <section class="lab-glossary" aria-labelledby="lab-glossary-title">
        <div class="lab-glossary__head">
          <p class="lab-step">MINI GLOSSARIO</p>
          <h2 id="lab-glossary-title">Tre sigle che compaiono spesso</h2>
        </div>
        <div class="lab-glossary__grid">
          <article>
            <span>ND</span>
            <h3>Non rilevato</h3>
            <p>
              In molti referti indica che il laboratorio non ha rilevato
              l'analita secondo il proprio metodo. La definizione precisa va
              sempre verificata nella legenda del certificato.
            </p>
          </article>
          <article>
            <span>LOD</span>
            <h3>Limite di rilevazione</h3>
            <p>
              È la soglia sotto la quale il metodo non riesce a distinguere con
              sufficiente affidabilità la presenza dell'analita.
            </p>
          </article>
          <article>
            <span>LOQ</span>
            <h3>Limite di quantificazione</h3>
            <p>
              È la soglia sotto la quale il laboratorio può non essere in grado
              di attribuire una quantità sufficientemente affidabile.
            </p>
          </article>
        </div>
      </section>
    </div>
  </section>
</SiteLayout>

<script>
  type ParsedResult = {
    key: string;
    label: string;
    raw: string;
    value: number | null;
    unit: string | null;
    status: "measured" | "nd" | "lod" | "loq" | "unknown";
  };

  const input = document.querySelector<HTMLTextAreaElement>("#coa-input");
  const analyzeButton = document.querySelector<HTMLButtonElement>("#analyze-coa");
  const clearButton = document.querySelector<HTMLButtonElement>("#clear-coa");
  const exampleButton = document.querySelector<HTMLButtonElement>("#load-example");
  const emptyState = document.querySelector<HTMLElement>("#coa-empty");
  const output = document.querySelector<HTMLElement>("#coa-output");
  const summary = document.querySelector<HTMLElement>("#coa-summary");
  const resultsContainer = document.querySelector<HTMLElement>("#coa-results");
  const termsContainer = document.querySelector<HTMLElement>("#coa-terms");

  const analytes = [
    { key: "THCA", label: "THCA", pattern: /\bTHCA\b/i },
    {
      key: "THC",
      label: "Δ9-THC",
      pattern: /(?:Δ\s*9|DELTA\s*[- ]?9|D\s*9)?\s*[- ]?THC\b|\bTHC\b/i,
    },
    { key: "CBDA", label: "CBDA", pattern: /\bCBDA\b/i },
    { key: "CBD", label: "CBD", pattern: /\bCBD\b/i },
    { key: "CBGA", label: "CBGA", pattern: /\bCBGA\b/i },
    { key: "CBG", label: "CBG", pattern: /\bCBG\b/i },
    { key: "CBC", label: "CBC", pattern: /\bCBC\b/i },
    { key: "CBN", label: "CBN", pattern: /\bCBN\b/i },
  ];

  const descriptions: Record<string, string> = {
    CBD: "Cannabidiolo, uno dei cannabinoidi più frequentemente riportati nei COA.",
    CBDA: "Acido cannabidiolico, forma acida precursore del CBD.",
    THC: "Delta-9-tetraidrocannabinolo, normalmente riportato separatamente dal THCA.",
    THCA: "Acido tetraidrocannabinolico, forma acida precursore del THC.",
    CBG: "Cannabigerolo, cannabinoide spesso presente in quantità inferiori rispetto a CBD o THC.",
    CBGA: "Acido cannabigerolico, precursore biosintetico di diversi cannabinoidi.",
    CBC: "Cannabicromene, cannabinoide minore che alcuni laboratori includono nel pannello.",
    CBN: "Cannabinolo, cannabinoide che può comparire nei pannelli analitici anche a basse concentrazioni.",
  };

  function normalizeNumber(value: string): number | null {
    const normalized = value.replace(/\s/g, "").replace(",", ".");
    const parsed = Number.parseFloat(normalized);
    return Number.isFinite(parsed) ? parsed : null;
  }

  function normalizeUnit(unit: string | undefined): string | null {
    if (!unit) return null;
    return unit
      .replace(/μ/g, "µ")
      .replace(/UG/gi, "µg")
      .replace(/\s+/g, "")
      .toLowerCase()
      .replace("mg/g", "mg/g")
      .replace("mg/ml", "mg/ml");
  }

  function parseStatus(line: string): ParsedResult["status"] {
    if (/<\s*LOQ\b|\bBELOW\s+LOQ\b/i.test(line)) return "loq";
    if (/<\s*LOD\b|\bBELOW\s+LOD\b/i.test(line)) return "lod";
    if (/\b(?:ND|N\.D\.|NOT\s+DETECTED)\b/i.test(line)) return "nd";
    return "unknown";
  }

  function parseLine(line: string): ParsedResult | null {
    const analyte = analytes.find((candidate) => candidate.pattern.test(line));
    if (!analyte) return null;

    const status = parseStatus(line);
    const numeric = line.match(
      /(?:^|\s|[:=])([0-9]+(?:[.,][0-9]+)?)\s*(%|mg\s*\/\s*g|mg\s*\/\s*ml|µg\s*\/\s*g|μg\s*\/\s*g|ug\s*\/\s*g|ppm)(?=\s|$)/i,
    );

    if (numeric) {
      return {
        key: analyte.key,
        label: analyte.label,
        raw: line.trim(),
        value: normalizeNumber(numeric[1]),
        unit: normalizeUnit(numeric[2]),
        status: "measured",
      };
    }

    if (status !== "unknown") {
      return {
        key: analyte.key,
        label: analyte.label,
        raw: line.trim(),
        value: null,
        unit: null,
        status,
      };
    }

    return null;
  }

  function parseCoa(text: string): ParsedResult[] {
    const seen = new Set<string>();
    const parsed: ParsedResult[] = [];

    for (const line of text.split(/\r?\n/)) {
      const result = parseLine(line);
      if (!result || seen.has(result.key)) continue;
      seen.add(result.key);
      parsed.push(result);
    }

    return parsed;
  }

  function statusText(result: ParsedResult): string {
    if (result.status === "measured" && result.value !== null) {
      return `${result.value.toLocaleString("it-IT", { maximumFractionDigits: 4 })}${result.unit ? ` ${result.unit}` : ""}`;
    }
    if (result.status === "loq") return "Sotto il limite di quantificazione (LOQ)";
    if (result.status === "lod") return "Sotto il limite di rilevazione (LOD)";
    if (result.status === "nd") return "Non rilevato (ND)";
    return "Valore non interpretato";
  }

  function statusClass(result: ParsedResult): string {
    if (result.status === "measured") return "is-measured";
    if (result.status === "nd") return "is-nd";
    return "is-threshold";
  }

  function renderResult(result: ParsedResult): HTMLElement {
    const article = document.createElement("article");
    article.className = `lab-result ${statusClass(result)}`;

    const top = document.createElement("div");
    top.className = "lab-result__top";

    const title = document.createElement("h3");
    title.textContent = result.label;

    const badge = document.createElement("span");
    badge.className = "lab-result__value";
    badge.textContent = statusText(result);

    const description = document.createElement("p");
    description.textContent = descriptions[result.key] || "Cannabinoide riportato nel certificato.";

    const source = document.createElement("p");
    source.className = "lab-result__source";
    source.textContent = `Riga letta: ${result.raw}`;

    top.append(title, badge);
    article.append(top, description, source);
    return article;
  }

  function renderTerms(text: string) {
    if (!termsContainer) return;
    termsContainer.innerHTML = "";

    const foundTerms: Array<{ term: string; text: string }> = [];
    if (/\bLOQ\b/i.test(text)) {
      foundTerms.push({
        term: "LOQ",
        text: "Il valore è vicino o sotto la soglia alla quale il metodo riesce a quantificare con sufficiente affidabilità.",
      });
    }
    if (/\bLOD\b/i.test(text)) {
      foundTerms.push({
        term: "LOD",
        text: "Indica la soglia di rilevazione del metodo. Sotto questa soglia la presenza dell'analita può non essere distinguibile con sufficiente affidabilità.",
      });
    }
    if (/\b(?:ND|N\.D\.|NOT\s+DETECTED)\b/i.test(text)) {
      foundTerms.push({
        term: "ND",
        text: "Di solito significa “non rilevato”, ma il significato esatto dipende dalla legenda e dal metodo del laboratorio.",
      });
    }

    if (!foundTerms.length) return;

    const heading = document.createElement("h3");
    heading.textContent = "Sigle trovate nel testo";
    termsContainer.appendChild(heading);

    for (const item of foundTerms) {
      const row = document.createElement("div");
      row.className = "lab-term";
      const strong = document.createElement("strong");
      strong.textContent = item.term;
      const copy = document.createElement("p");
      copy.textContent = item.text;
      row.append(strong, copy);
      termsContainer.appendChild(row);
    }
  }

  function showMessage(message: string, isError = false) {
    if (!emptyState || !output) return;
    emptyState.hidden = false;
    output.hidden = true;
    emptyState.classList.toggle("is-error", isError);
    const paragraph = emptyState.querySelector("p");
    if (paragraph) paragraph.textContent = message;
  }

  function analyze() {
    if (!input || !output || !emptyState || !summary || !resultsContainer) return;
    const text = input.value.trim();

    if (!text) {
      showMessage("Incolla prima alcune righe del certificato.", true);
      input.focus();
      return;
    }

    const parsed = parseCoa(text);
    if (!parsed.length) {
      showMessage(
        "Non sono riuscito a riconoscere valori leggibili. Prova a copiare le righe con nome del cannabinoide, valore e unità (per esempio: CBD 12,4 %).",
        true,
      );
      return;
    }

    emptyState.hidden = true;
    emptyState.classList.remove("is-error");
    output.hidden = false;
    resultsContainer.innerHTML = "";

    const measuredCount = parsed.filter((item) => item.status === "measured").length;
    const thresholdCount = parsed.length - measuredCount;
    summary.innerHTML = `
      <strong>${parsed.length} ${parsed.length === 1 ? "voce riconosciuta" : "voci riconosciute"}</strong>
      <span>${measuredCount} con valore numerico${thresholdCount ? ` · ${thresholdCount} con soglia o ND` : ""}</span>
    `;

    for (const item of parsed) resultsContainer.appendChild(renderResult(item));
    renderTerms(text);
  }

  analyzeButton?.addEventListener("click", analyze);

  clearButton?.addEventListener("click", () => {
    if (!input) return;
    input.value = "";
    showMessage("Incolla i risultati e premi Leggi i risultati.");
    input.focus();
  });

  exampleButton?.addEventListener("click", () => {
    if (!input) return;
    input.value = [
      "CBD 12,40 %",
      "CBDA 0,82 %",
      "Δ9-THC < LOQ",
      "THCA 0,05 %",
      "CBG 0,18 %",
      "CBN ND",
    ].join("\n");
    analyze();
  });
</script>

<style>
  .lab-page {
    --lab-accent: var(--brand, #2f7d4a);
    --lab-accent-soft: color-mix(in srgb, var(--lab-accent) 14%, transparent);
    --lab-copy: color-mix(in srgb, var(--text) 78%, transparent);
    padding: clamp(44px, 6vw, 76px) 0 84px;
  }

  .lab-container {
    max-width: 1180px;
  }

  .lab-hero {
    max-width: 880px;
    margin-bottom: 34px;
  }

  .lab-kicker,
  .lab-step {
    margin: 0 0 10px;
    font: 700 0.76rem/1.2 "Archivo", sans-serif;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand);
  }

  .lab-hero h1 {
    margin: 0;
    max-width: 780px;
    font-size: clamp(2.35rem, 5.4vw, 4.65rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .lab-lead {
    max-width: 740px;
    margin: 22px 0 18px;
    color: var(--lab-copy);
    font-size: clamp(1.08rem, 2vw, 1.26rem);
    line-height: 1.62;
  }

  .lab-privacy {
    display: inline-flex;
    align-items: flex-start;
    gap: 9px;
    max-width: 660px;
    padding: 9px 12px;
    border: 1px solid color-mix(in srgb, var(--brand) 24%, var(--border));
    border-radius: 9px;
    background: color-mix(in srgb, var(--panel) 90%, transparent);
    color: var(--lab-copy);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .lab-privacy span {
    color: var(--brand);
    font-size: 0.8rem;
    transform: translateY(0.2em);
  }

  .lab-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: 22px;
    align-items: stretch;
  }

  .lab-panel {
    border: 1px solid var(--border);
    border-radius: 18px;
    background: color-mix(in srgb, var(--panel) 94%, var(--bg));
    padding: clamp(20px, 3vw, 32px);
    min-width: 0;
  }

  .lab-input-panel {
    border-color: color-mix(in srgb, var(--brand) 38%, var(--border));
    box-shadow: 0 18px 54px color-mix(in srgb, var(--bg) 72%, transparent);
  }

  .lab-results-panel {
    display: flex;
    flex-direction: column;
    background: color-mix(in srgb, var(--panel) 86%, var(--bg));
  }

  .lab-panel__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 20px;
  }

  .lab-panel h2,
  .lab-explainer h2,
  .lab-glossary h2 {
    margin: 0;
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.12;
  }

  .lab-link-button {
    flex: none;
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--brand);
    font: 700 0.82rem/1 "Archivo", sans-serif;
    cursor: pointer;
    padding: 7px 0;
    border-bottom: 1px solid currentColor;
  }

  #coa-input {
    width: 100%;
    min-height: 310px;
    resize: vertical;
    border: 1px solid color-mix(in srgb, var(--text) 16%, var(--border));
    border-radius: 12px;
    background: color-mix(in srgb, var(--bg) 72%, var(--panel));
    color: var(--text);
    padding: 18px;
    font: 500 0.98rem/1.65 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  #coa-input:focus {
    border-color: var(--brand);
    background: color-mix(in srgb, var(--bg) 82%, var(--panel));
    box-shadow: 0 0 0 3px var(--lab-accent-soft);
  }

  .lab-help {
    margin: 12px 0 0;
    color: var(--lab-copy);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .lab-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .lab-primary,
  .lab-secondary {
    min-height: 50px;
    border-radius: 9px;
    padding: 0 22px;
    font: 700 0.92rem/1 "Archivo", sans-serif;
    cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }

  .lab-primary {
    min-width: 190px;
    border: 1px solid var(--brand);
    background: var(--brand);
    color: #fff;
    box-shadow: 0 9px 24px color-mix(in srgb, var(--brand) 28%, transparent);
  }

  .lab-primary:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--gold-ink);
    transform: translateY(-1px);
  }

  .lab-secondary {
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
  }

  .lab-secondary:hover {
    border-color: var(--brand);
  }

  .lab-empty {
    min-height: 350px;
    flex: 1;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 16px;
    text-align: center;
    color: var(--lab-copy);
    border: 1px dashed color-mix(in srgb, var(--text) 18%, var(--border));
    border-radius: 12px;
    padding: 30px;
  }

  .lab-empty.is-error {
    color: var(--text);
    border-color: color-mix(in srgb, var(--gold) 55%, var(--border));
  }

  .lab-empty p {
    max-width: 470px;
    margin: 0;
    line-height: 1.6;
  }

  .lab-empty__mark {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--lab-accent-soft);
    color: var(--brand);
    font: 800 0.92rem/1 "Archivo", sans-serif;
    letter-spacing: 0.08em;
  }

  .lab-output {
    display: grid;
    gap: 16px;
  }

  .lab-summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 15px;
    border-bottom: 1px solid var(--border);
  }

  .lab-summary strong {
    font-size: 1rem;
  }

  .lab-summary span {
    color: var(--lab-copy);
    font-size: 0.82rem;
  }

  .lab-result-list {
    display: grid;
    gap: 10px;
  }

  .lab-result {
    padding: 14px 15px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: color-mix(in srgb, var(--panel) 90%, var(--bg));
  }

  .lab-result__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .lab-result h3 {
    margin: 0;
    font: 800 0.98rem/1.2 "Archivo", sans-serif;
  }

  .lab-result__value {
    border-radius: 999px;
    padding: 5px 9px;
    background: var(--lab-accent-soft);
    color: var(--text);
    font: 700 0.76rem/1.2 "Archivo", sans-serif;
    text-align: right;
  }

  .lab-result p {
    margin: 9px 0 0;
    color: var(--lab-copy);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .lab-result__source {
    opacity: 0.76;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.73rem !important;
    overflow-wrap: anywhere;
  }

  .lab-terms {
    display: grid;
    gap: 9px;
    margin-top: 4px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .lab-terms:empty {
    display: none;
  }

  .lab-terms h3 {
    margin: 0 0 3px;
    font-size: 0.94rem;
  }

  .lab-term {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 10px;
    align-items: start;
  }

  .lab-term strong {
    color: var(--brand);
    font: 800 0.82rem/1.5 "Archivo", sans-serif;
  }

  .lab-term p {
    margin: 0;
    color: var(--lab-copy);
