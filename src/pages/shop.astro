---
import SiteLayout from "../layouts/SiteLayout.astro";
import SpreadshopHostedLink from "../components/commerce/SpreadshopHostedLink.astro";
import { isCommerceIndexable, isSpreadshopHostedReady } from "../config/commerce";
import { commerceProducts } from "../data/commerce-products";

const SITE = import.meta.env.SITE || "https://canapalandia.com";
const canonical = `${SITE}/shop/`;
const robots = isCommerceIndexable
  ? "index,follow"
  : "noindex,nofollow,noarchive";

const isDedicatedStagingHost =
  Astro.url.hostname.startsWith("canapalandia-staging") &&
  Astro.url.hostname.endsWith(".vercel.app");

// Production remains fail-closed until a real hosted Spreadshop storefront exists.
// Dedicated staging may render the non-transactional preview before provider onboarding.
if (!isSpreadshopHostedReady && !isDedicatedStagingHost) {
  return Astro.redirect("/blog/", 301);
}

const visibleProducts = isDedicatedStagingHost
  ? commerceProducts
  : commerceProducts.filter((product) => product.status === "frozen");

const productCopy = {
  tshirt: {
    index: "01",
    label: "T-shirt",
    description:
      "Il capo hero del primo drop: silhouette oversize, costruzione premium accessibile e applicazione Canapalandia immediatamente riconoscibile.",
    note: "Modello e area di stampa da congelare nel Partner Area.",
  },
  tote: {
    index: "02",
    label: "Tote",
    description:
      "Una tote strutturata e quotidiana, pensata come supporto editoriale sobrio: brand-first, leggibile, senza trasformarsi in gadget promozionale.",
    note: "PT4133 è la candidata principale; dati provider finali da verificare.",
  },
  beanie: {
    index: "03",
    label: "Beanie",
    description:
      "Il pezzo più stagionale del core: applicazione compatta Canapalandia, con priorità al look premium e fallback tecnici già individuati.",
    note: "Fisherman preferred; PT3339 e PT1089 restano fallback.",
  },
} as const;
---

<SiteLayout
  title="Shop Canapalandia | Anteprima merchandise"
  description="Anteprima dello shop Canapalandia: capi e accessori editoriali in preparazione."
  canonical={canonical}
  robots={robots}
>
  <div class="shop-shell">
    {isDedicatedStagingHost ? (
      <div class="preview-bar" role="status">
        <strong>Anteprima staging</strong>
        <span>Nessun prodotto è in vendita · checkout disattivato · noindex attivo</span>
      </div>
    ) : null}

    <header class="shop-hero">
      <div class="hero-copy">
        <p class="eyebrow">Canapalandia · Editorial Series · Drop 001</p>
        <h1>Oggetti editoriali, non gadget.</h1>
        <p class="lead">
          Una piccola collezione di capi e accessori costruita intorno all’identità di
          Canapalandia. Il brand viene prima del claim: riconoscibile, sobrio e collegato
          direttamente al progetto editoriale.
        </p>
      </div>

      <div class="hero-mark" aria-hidden="true">
        <span>CANAPALANDIA</span>
        <small>EDITORIAL SERIES / 001</small>
      </div>
    </header>

    <section class="shop-intro" aria-labelledby="shop-intro-title">
      <p class="section-number">01 / COLLEZIONE</p>
      <div>
        <h2 id="shop-intro-title">Tre pezzi. Una sola identità.</h2>
        <p>
          T-shirt, Tote e Beanie sono il core operativo del primo drop. In questa fase
          restano prototipi interni: i modelli provider, i master grafici e i prezzi
          vengono congelati solo dopo le verifiche finali.
        </p>
      </div>
    </section>

    <section class="product-grid" aria-label="Anteprima catalogo Canapalandia">
      {visibleProducts.map((product) => {
        const copy = productCopy[product.id];
        const canExitToProvider =
          product.status === "frozen" && isSpreadshopHostedReady;

        return (
          <article class="product-card">
            <div class="product-visual" aria-hidden="true">
              <span class="product-index">{copy.index}</span>
              <strong>CANAPALANDIA</strong>
              <small>{copy.label.toUpperCase()} / DROP 001</small>
            </div>

            <div class="product-body">
              <div class="product-meta">
                <span>{copy.label}</span>
                <span class="status-pill">
                  {product.status === "frozen" ? "Ready" : "Prototipo"}
                </span>
              </div>

              <h2>{product.name}</h2>
              <p class="product-description">{copy.description}</p>
              <p class="product-note">{copy.note}</p>

              {canExitToProvider ? (
                <SpreadshopHostedLink
                  label="Vedi nello shop"
                  product={product.id}
                  class="shop-link"
                />
              ) : (
                <span class="disabled-cta" aria-disabled="true">In preparazione</span>
              )}
            </div>
          </article>
        );
      })}
    </section>

    <section class="brand-block" aria-labelledby="brand-block-title">
      <div class="brand-statement" aria-hidden="true">CANAPALANDIA</div>
      <div class="brand-copy">
        <p class="section-number">02 / BRAND SYSTEM</p>
        <h2 id="brand-block-title">Prima riconoscibile. Poi decorativo.</h2>
        <p>
          Il primo criterio non è riempire una superficie: è fare in modo che ogni pezzo
          sia riconducibile a Canapalandia anche senza leggere un claim. Per questo il
          percorso di sviluppo resta brand-first e wordmark-first.
        </p>
      </div>
    </section>

    <section class="process" aria-labelledby="process-title">
      <div class="process-heading">
        <p class="section-number">03 / COME FUNZIONERÀ</p>
        <h2 id="process-title">Canapalandia cura il progetto. Spreadshop gestisce l’ordine.</h2>
      </div>

      <div class="process-grid">
        <article>
          <span>01</span>
          <h3>Selezione</h3>
          <p>Canapalandia definisce prodotti, branding, copy e prezzo finale del drop.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Storefront</h3>
          <p>Il catalogo viene aperto solo quando i gate tecnici, fiscali e di compliance sono chiusi.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Ordine</h3>
          <p>Ordine, pagamento, produzione e spedizione avvengono sullo storefront del provider.</p>
        </article>
      </div>
    </section>

    <aside class="release-note" aria-labelledby="release-note-title">
      <div>
        <p class="section-number">STATO RELEASE</p>
        <h2 id="release-note-title">Shop deciso. Pubblicazione non ancora aperta.</h2>
      </div>
      <p>
        Questa pagina serve esclusivamente per costruire e verificare la versione finale.
        Nessun prodotto è acquistabile e nessuna indicizzazione viene abilitata prima del
        GO di pubblicazione.
      </p>
    </aside>
  </div>

  <script is:inline>
    (() => {
      if (!Array.isArray(window.dataLayer)) return;
      window.dataLayer.push({
        event: "commerce_shop_view",
        provider: "spreadshop",
        source: "canapalandia_shop_gateway",
      });

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest("a[data-commerce-provider='spreadshop']");
        if (!link) return;
        window.dataLayer.push({
          event: "commerce_provider_exit",
          provider: "spreadshop",
          product: link.getAttribute("data-commerce-product") || undefined,
          source: "canapalandia_shop_gateway",
        });
      });
    })();
  </script>
</SiteLayout>

<style>
  .shop-shell {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 28px 0 clamp(72px, 10vw, 132px);
  }

  .preview-bar {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 34px;
    padding: 11px 0;
    border-block: 1px solid var(--border);
    font-family: Archivo, sans-serif;
    font-size: 0.76rem;
    letter-spacing: 0.035em;
  }

  .preview-bar span {
    color: var(--muted);
    text-align: right;
  }

  .shop-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    gap: clamp(36px, 7vw, 96px);
    align-items: end;
    min-height: 62vh;
    padding: clamp(48px, 8vw, 96px) 0 clamp(56px, 8vw, 92px);
    border-bottom: 1px solid var(--border);
  }

  .hero-copy {
    max-width: 820px;
  }

  .eyebrow,
  .section-number,
  .product-meta,
  .product-visual small,
  .hero-mark small {
    font-family: Archivo, sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.105em;
    text-transform: uppercase;
  }

  .eyebrow,
  .section-number {
    margin: 0 0 16px;
    color: var(--muted);
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(3.5rem, 8.5vw, 8.2rem);
    line-height: 0.88;
    letter-spacing: -0.06em;
  }

  .lead {
    max-width: 720px;
    margin: 34px 0 0;
    font-size: clamp(1.08rem, 2vw, 1.35rem);
    line-height: 1.58;
  }

  .hero-mark {
    display: flex;
    min-height: 280px;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
    border: 1px solid var(--border);
  }

  .hero-mark span {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: Archivo, sans-serif;
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .shop-intro,
  .brand-block,
  .process,
  .release-note {
    padding: clamp(58px, 8vw, 96px) 0;
    border-bottom: 1px solid var(--border);
  }

  .shop-intro,
  .process-heading {
    display: grid;
    grid-template-columns: minmax(180px, 0.38fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 88px);
  }

  .shop-intro h2,
  .brand-copy h2,
  .process-heading h2,
  .release-note h2 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(2rem, 4.6vw, 4.8rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .shop-intro p:not(.section-number),
  .brand-copy p:not(.section-number),
  .release-note > p {
    max-width: 700px;
    margin: 24px 0 0;
    font-size: 1.04rem;
    line-height: 1.7;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 1px;
    border: 1px solid var(--border);
    background: var(--border);
  }

  .product-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    background: var(--surface, var(--paper));
  }

  .product-visual {
    display: flex;
    min-height: 340px;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .product-visual strong {
    align-self: center;
    max-width: 100%;
    font-family: Archivo, sans-serif;
    font-size: clamp(2rem, 4vw, 3.8rem);
    font-weight: 800;
    letter-spacing: -0.055em;
    transform: rotate(-6deg);
    white-space: nowrap;
  }

  .product-index {
    font-family: Archivo, sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .product-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 26px;
  }

  .product-meta {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 24px;
    color: var(--muted);
  }

  .status-pill {
    padding: 3px 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
    letter-spacing: 0.04em;
  }

  .product-card h2 {
    margin: 0;
    font-size: clamp(1.6rem, 2.4vw, 2.35rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .product-description {
    margin: 20px 0 0;
    line-height: 1.65;
  }

  .product-note {
    margin: 16px 0 26px;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .disabled-cta,
  :global(.shop-link) {
    display: inline-flex;
    width: fit-content;
    margin-top: auto;
    padding: 11px 15px;
    border: 1px solid currentColor;
    color: inherit;
    font-family: Archivo, sans-serif;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
  }

  .disabled-cta {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .brand-block {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    gap: clamp(42px, 7vw, 96px);
    align-items: center;
  }

  .brand-statement {
    padding: clamp(36px, 7vw, 76px) 10px;
    overflow: hidden;
    border-block: 1px solid var(--border);
    font-family: Archivo, sans-serif;
    font-size: clamp(3rem, 8vw, 7.5rem);
    font-weight: 800;
    letter-spacing: -0.07em;
    line-height: 0.86;
  }

  .process-heading {
    margin-bottom: 54px;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--border);
  }

  .process-grid article {
    min-height: 230px;
    padding: 24px;
    border-right: 1px solid var(--border);
  }

  .process-grid article:last-child {
    border-right: 0;
  }

  .process-grid span {
    font-family: Archivo, sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .process-grid h3 {
    margin: 56px 0 12px;
    font-size: 1.3rem;
  }

  .process-grid p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .release-note {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.62fr);
    gap: clamp(42px, 8vw, 110px);
    align-items: end;
  }

  .release-note > p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .shop-hero,
    .brand-block,
    .release-note {
      grid-template-columns: 1fr;
    }

    .hero-mark {
      min-height: 180px;
    }

    .hero-mark span {
      writing-mode: horizontal-tb;
      transform: none;
    }

    .product-grid,
    .process-grid {
      grid-template-columns: 1fr;
    }

    .process-grid article {
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }

    .process-grid article:last-child {
      border-bottom: 0;
    }
  }

  @media (max-width: 680px) {
    .preview-bar {
      flex-direction: column;
      align-items: flex-start;
    }

    .preview-bar span {
      text-align: left;
    }

    .shop-intro,
    .process-heading {
      grid-template-columns: 1fr;
    }

    .shop-hero {
      min-height: auto;
      padding-top: 44px;
    }

    .product-visual {
      min-height: 260px;
    }
  }
</style>
