---
import SiteLayout from "../layouts/SiteLayout.astro";
import SpreadshopHostedLink from "../components/commerce/SpreadshopHostedLink.astro";
import { isCommerceIndexable, isSpreadshopHostedReady } from "../config/commerce";
import { commerceProducts } from "../data/commerce-products";

const SITE = import.meta.env.SITE || "https://canapalandia.com";
const canonical = `${SITE}/shop/`;
const frozenProducts = commerceProducts.filter((product) => product.status === "frozen");
const robots = isCommerceIndexable
  ? "index,follow"
  : "noindex,nofollow,noarchive";

// Defense in depth: middleware preserves the legacy /shop/ redirect while commerce
// is disabled. This route independently refuses to expose a commerce gateway until
// a real hosted Spreadshop storefront is configured.
if (!isSpreadshopHostedReady) {
  return Astro.redirect("/blog/", 301);
}
---

<SiteLayout
  title="Shop Canapalandia | Merchandise editoriale"
  description="Merchandise ufficiale Canapalandia. Una selezione limitata di capi e accessori del progetto editoriale, realizzati tramite partner print-on-demand."
  canonical={canonical}
  robots={robots}
>
  <main class="shop-shell">
    <header class="shop-hero">
      <p class="eyebrow">Canapalandia · Editorial Series</p>
      <h1>Merchandise Canapalandia</h1>
      <p class="lead">
        Una selezione limitata di capi e accessori legati all'identità editoriale di
        Canapalandia. Nessun prodotto a base di cannabis, CBD o destinato al consumo.
      </p>
    </header>

    {frozenProducts.length > 0 ? (
      <section class="product-grid" aria-label="Catalogo Canapalandia">
        {frozenProducts.map((product) => (
          <article class="product-card">
            <p class="product-kicker">Canapalandia</p>
            <h2>{product.name}</h2>
            {typeof product.targetPriceEur === "number" ? (
              <p class="price">€ {product.targetPriceEur.toFixed(2).replace(".", ",")}</p>
            ) : null}
            <SpreadshopHostedLink
              label="Vedi nello shop"
              product={product.id}
              class="shop-link"
            />
          </article>
        ))}
      </section>
    ) : (
      <section class="catalog-pending" aria-live="polite">
        <h2>Catalogo in preparazione</h2>
        <p>
          I prodotti vengono mostrati qui solo dopo la verifica finale di modello,
          prezzo, branding e condizioni del provider.
        </p>
      </section>
    )}

    <aside class="provider-note">
      <h2>Come funziona</h2>
      <p>
        Canapalandia presenta il merchandise; selezionando un prodotto si passa allo
        storefront Spreadshop, dove avvengono ordine e checkout secondo le condizioni
        applicabili del provider.
      </p>
    </aside>
  </main>
</SiteLayout>

<script is:inline>
  (() => {
    if (!Array.isArray(window.dataLayer)) return;
    window.dataLayer.push({
      event: "commerce_shop_view",
      provider: "spreadshop",
      source: "canapalandia_shop_gateway",
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const link = target.closest("a[data-commerce-provider='spreadshop']");
      if (!link) return;
      window.dataLayer.push({
        event: "commerce_provider_exit",
        provider: "spreadshop",
        product: link.getAttribute("data-commerce-product") || undefined,
        source: "canapalandia_shop_gateway",
      });
    });
  })();
</script>

<style>
  .shop-shell {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
    padding: clamp(64px, 9vw, 120px) 0;
  }

  .shop-hero {
    max-width: 820px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--line);
  }

  .eyebrow,
  .product-kicker {
    margin: 0 0 12px;
    font-family: Archivo, sans-serif;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 9vw, 7rem);
    line-height: 0.92;
    letter-spacing: -0.055em;
  }

  .lead {
    max-width: 720px;
    margin: 28px 0 0;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.6;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 56px;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .product-card {
    min-height: 260px;
    padding: 28px;
    background: var(--paper);
  }

  .product-card h2,
  .catalog-pending h2,
  .provider-note h2 {
    margin: 0 0 14px;
  }

  .price {
    margin: 18px 0 24px;
    font-size: 1.5rem;
    font-weight: 700;
  }

  :global(.shop-link) {
    display: inline-block;
    border: 1px solid currentColor;
    padding: 11px 14px;
    color: inherit;
    font-weight: 700;
    text-decoration: none;
  }

  .catalog-pending,
  .provider-note {
    max-width: 760px;
    margin-top: 56px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .provider-note {
    margin-top: 32px;
  }

  @media (max-width: 760px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
