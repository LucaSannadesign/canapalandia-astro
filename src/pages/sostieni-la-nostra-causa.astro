---
import SiteLayout from "../layouts/SiteLayout.astro";

const SITE = import.meta.env.SITE || "https://canapalandia.com";
const title = "Sostieni Canapalandia | Informazione indipendente";
const description =
  "Sostieni Canapalandia e contribuisci a mantenere indipendente un progetto editoriale dedicato a canapa, CBD, normativa, ricerca e cultura.";
const canonical = `${SITE}/sostieni-la-nostra-causa/`;

const BENEFICIARY = "Luca Sanna";
const IBAN = "IT70T0366901600142404006713";
const IBAN_DISPLAY = "IT70 T036 6901 6001 4240 4006 713";
const BIC = "REVOITM2";
const CAUSALE = "Sostegno Canapalandia";

const impact = [
  ["01", "Fonti e verifiche", "Più tempo per controllare norme, documenti e studi prima della pubblicazione."],
  ["02", "Aggiornamenti", "Revisione delle pagine importanti quando cambiano norme, evidenze o contesto."],
  ["03", "Indipendenza", "Più spazio per contenuti utili senza trasformare ogni articolo in promozione."],
] as const;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
    { "@type": "ListItem", position: 2, name: "Sostieni Canapalandia", item: canonical },
  ],
};
---

<SiteLayout title={title} description={description} canonical={canonical} shell={false}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <div class="support-page">
    <nav class="support-crumbs" aria-label="Percorso di navigazione">
      <div class="support-wrap">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">Sostieni Canapalandia</li>
        </ol>
      </div>
    </nav>

    <section class="support-hero" aria-labelledby="support-title">
      <div class="support-wrap support-hero__grid">
        <div>
          <p class="support-kicker">Sostieni Canapalandia</p>
          <h1 id="support-title">Un’informazione più libera cresce con chi la sostiene.</h1>
          <p class="support-lead">
            Canapalandia è un progetto editoriale indipendente. Il tuo contributo ci aiuta a verificare meglio le fonti,
            aggiornare i contenuti e mantenere il progetto accessibile.
          </p>
          <div class="support-actions">
            <a class="support-btn support-btn--primary" href="#bonifico">Vai alle coordinate</a>
            <a class="support-btn support-btn--ghost" href="/blog/">Esplora il blog</a>
          </div>
        </div>

        <aside class="support-manifesto" aria-label="Principio editoriale">
          <p class="support-overline">Perché conta</p>
          <blockquote>“Non è solo una questione di canapa. È una questione di libertà, giustizia e verità.”</blockquote>
          <p>Ogni gesto è un seme. Piantalo con noi.</p>
        </aside>
      </div>
    </section>

    <section class="support-impact" aria-labelledby="impact-title">
      <div class="support-wrap">
        <header class="support-section-head">
          <div>
            <p class="support-overline">Cosa rendi possibile</p>
            <h2 id="impact-title">Un progetto più solido e verificabile.</h2>
          </div>
          <p class="support-section-intro">
            Il sostegno viene usato per il lavoro editoriale, gli aggiornamenti e l’infrastruttura che tiene online Canapalandia.
          </p>
        </header>

        <div class="support-impact__grid">
          {impact.map(([num, heading, text]) => (
            <article class="support-impact__card">
              <span aria-hidden="true">{num}</span>
              <h3>{heading}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="bonifico" class="support-payment" aria-labelledby="payment-title">
      <div class="support-wrap support-payment__grid">
        <div class="support-payment__intro">
          <p class="support-overline">Sostegno diretto</p>
          <h2 id="payment-title">Bonifico bancario</h2>
          <p>
            Per ricevere il contributo pubblichiamo solo i dati strettamente necessari al bonifico.
            Nessun dato aggiuntivo personale o bancario viene esposto.
          </p>
          <div class="support-note">
            <strong>Trasparenza editoriale</strong>
            <span>Il sostegno è volontario e non dà diritto a pubblicità o trattamenti editoriali preferenziali.</span>
          </div>
        </div>

        <div class="support-bank-card" aria-label="Dati essenziali per il bonifico">
          <header class="support-bank-card__head">
            <div>
              <p class="support-overline">Revolut</p>
              <h3>Dati essenziali</h3>
            </div>
            <span class="support-bank-badge">EUR</span>
          </header>

          <dl>
            <div class="support-bank-row">
              <dt>Beneficiario</dt>
              <dd><span>{BENEFICIARY}</span></dd>
            </div>
            <div class="support-bank-row support-bank-row--iban">
              <dt>IBAN</dt>
              <dd><code>{IBAN_DISPLAY}</code><button type="button" data-copy={IBAN} data-label="IBAN">Copia</button></dd>
            </div>
            <div class="support-bank-row">
              <dt>BIC / SWIFT</dt>
              <dd><code>{BIC}</code><button type="button" data-copy={BIC} data-label="BIC">Copia</button></dd>
            </div>
            <div class="support-bank-row">
              <dt>Causale consigliata</dt>
              <dd><span>{CAUSALE}</span><button type="button" data-copy={CAUSALE} data-label="Causale">Copia</button></dd>
            </div>
          </dl>
          <p class="support-bank-help">Il BIC/SWIFT serve solo se richiesto dalla banca del mittente.</p>
          <p class="copy-status" aria-live="polite"></p>
        </div>
      </div>
    </section>

    <section class="support-trust" aria-labelledby="trust-title">
      <div class="support-wrap support-trust__grid">
        <div>
          <p class="support-overline">Indipendenza prima di tutto</p>
          <h2 id="trust-title">Il sostegno non compra visibilità.</h2>
        </div>
        <div class="support-trust__copy">
          <p>Le collaborazioni commerciali seguono un percorso separato e vengono dichiarate con trasparenza.</p>
          <a href="/pubblicita/">Pubblicità e partnership →</a>
        </div>
      </div>
    </section>

    <section class="support-final" aria-labelledby="support-final-title">
      <div class="support-wrap">
        <div class="support-final__panel">
          <p class="support-overline">Canapalandia</p>
          <h2 id="support-final-title">Grazie per contribuire a un’informazione più libera.</h2>
          <a class="support-btn support-btn--light" href="#bonifico">Coordinate bancarie</a>
        </div>
      </div>
    </section>
  </div>

  <script>
    const status = document.querySelector('.copy-status');
    document.querySelectorAll('[data-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        const value = button.getAttribute('data-copy') || '';
        const label = button.getAttribute('data-label') || 'Dato';
        try {
          await navigator.clipboard.writeText(value);
          if (status) status.textContent = `${label} copiato negli appunti.`;
          button.textContent = 'Copiato';
          window.setTimeout(() => {
            button.textContent = 'Copia';
            if (status) status.textContent = '';
          }, 1600);
        } catch {
          if (status) status.textContent = `Copia manualmente: ${value}`;
        }
      });
    });
  </script>
</SiteLayout>

<style>
  .support-page {
    --sp-ink: #173b29;
    --sp-muted: #557062;
    --sp-paper: #f5f1e8;
    --sp-card: #fffdf8;
    --sp-gold: #d6b56d;
    color: var(--text);
    overflow: clip;
  }

  .support-wrap { width: min(1120px, calc(100% - 2.5rem)); margin-inline: auto; }
  .support-crumbs { padding: .9rem 0; border-bottom: 1px solid var(--border); }
  .support-crumbs ol { display: flex; gap: .6rem; margin: 0; padding: 0; list-style: none; color: var(--muted); font: 500 .84rem/1.4 var(--font-sans); }
  .support-crumbs a { color: inherit; text-decoration: none; }

  .support-hero { padding: clamp(3.2rem, 6vw, 5.4rem) 0 clamp(3.5rem, 6.5vw, 5.8rem); }
  .support-hero__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(300px, .85fr); gap: clamp(2.5rem, 5vw, 4.5rem); align-items: center; }
  .support-kicker, .support-overline { margin: 0 0 .9rem; color: var(--brand); font: 700 .75rem/1.2 var(--font-sans); letter-spacing: .13em; text-transform: uppercase; }
  .support-hero h1 { max-width: 14ch; margin: 0; font-size: clamp(2.9rem, 4.7vw, 5rem); line-height: 1; letter-spacing: -.04em; text-wrap: balance; color: var(--text); }
  .support-lead { max-width: 58ch; margin: 1.5rem 0 0; color: var(--muted); font-size: clamp(1.02rem, 1.25vw, 1.2rem); line-height: 1.62; }
  .support-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.7rem; }

  .support-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: .75rem 1.1rem; border: 1px solid transparent; border-radius: 999px; font: 700 .9rem/1 var(--font-sans); text-decoration: none; transition: transform .16s ease, background .16s ease, border-color .16s ease; }
  .support-btn:hover { transform: translateY(-1px); }
  .support-btn--primary { background: var(--brand); color: #fff !important; }
  .support-btn--ghost { border-color: var(--border); color: var(--text) !important; background: transparent; }

  .support-manifesto { padding: clamp(1.4rem, 2.6vw, 2rem); border: 1px solid var(--border); border-radius: 20px; background: var(--panel); }
  .support-manifesto blockquote { margin: 0; color: var(--text); font-size: clamp(1.4rem, 2vw, 1.85rem); line-height: 1.22; font-weight: 600; }
  .support-manifesto > p:last-child { margin: 1.15rem 0 0; color: var(--muted); font-style: italic; }

  .support-impact { padding: clamp(3.5rem, 6vw, 5.7rem) 0; border-top: 1px solid var(--border); }
  .support-section-head { display: grid; grid-template-columns: 1.15fr .85fr; gap: 2.5rem; align-items: end; margin-bottom: 2.2rem; }
  .support-section-head h2, .support-payment h2, .support-trust h2, .support-final h2 { margin: 0; font-size: clamp(2.1rem, 3.7vw, 3.6rem); line-height: 1.04; letter-spacing: -.035em; text-wrap: balance; }
  .support-section-intro { margin: 0; color: var(--muted); line-height: 1.65; }
  .support-impact__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .support-impact__card { padding: 1.5rem; border: 1px solid var(--border); border-radius: 16px; background: var(--panel); }
  .support-impact__card > span { display: block; margin-bottom: 1.8rem; color: var(--muted); font: 600 .75rem/1 var(--font-sans); }
  .support-impact__card h3 { margin: 0 0 .6rem; font-size: 1.2rem; }
  .support-impact__card p { margin: 0; color: var(--muted); line-height: 1.58; }

  .support-payment { scroll-margin-top: 84px; padding: clamp(3.8rem, 6.5vw, 5.8rem) 0; background: var(--sp-paper); color: var(--sp-ink); }
  .support-payment__grid { display: grid; grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); gap: clamp(2.5rem, 5vw, 4.5rem); align-items: start; }
  .support-payment h2 { color: var(--sp-ink); }
  .support-payment .support-overline { color: var(--sp-muted); }
  .support-payment__intro > p:not(.support-overline) { max-width: 50ch; margin: 1.25rem 0 0; color: var(--sp-muted); font-size: 1rem; line-height: 1.65; }
  .support-note { display: grid; gap: .25rem; margin-top: 1.4rem; padding: 1rem 1.1rem; border-left: 3px solid var(--sp-gold); background: rgba(255,255,255,.48); color: var(--sp-muted); }
  .support-note strong { color: var(--sp-ink); }

  .support-bank-card { padding: clamp(1.25rem, 2.4vw, 1.85rem); border: 1px solid rgba(23,59,41,.16); border-radius: 20px; background: var(--sp-card); color: var(--sp-ink); box-shadow: 0 16px 38px rgba(23,59,41,.07); }
  .support-bank-card__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding-bottom: 1.2rem; border-bottom: 1px solid rgba(23,59,41,.13); }
  .support-bank-card__head h3 { margin: 0; color: var(--sp-ink); font-size: 1.4rem; }
  .support-bank-badge { padding: .4rem .65rem; border-radius: 999px; background: #ece6d8; font: 700 .72rem/1 var(--font-sans); }
  .support-bank-card dl { margin: 0; }
  .support-bank-row { display: grid; grid-template-columns: 150px minmax(0,1fr); gap: 1rem; padding: .95rem 0; border-bottom: 1px solid rgba(23,59,41,.12); }
  .support-bank-row dt { color: var(--sp-muted); font: 700 .72rem/1.35 var(--font-sans); letter-spacing: .06em; text-transform: uppercase; }
  .support-bank-row dd { display: flex; align-items: center; justify-content: space-between; gap: .75rem; min-width: 0; margin: 0; color: var(--sp-ink); line-height: 1.45; }
  .support-bank-row code { overflow-wrap: anywhere; color: var(--sp-ink); background: transparent; font-size: .9rem; }
  .support-bank-row button { flex: 0 0 auto; min-height: 34px; padding: .42rem .65rem; border: 1px solid rgba(23,59,41,.2); border-radius: 999px; background: transparent; color: var(--sp-ink); font: 700 .78rem/1 var(--font-sans); cursor: pointer; }
  .support-bank-row button:hover { background: #ece6d8; }
  .support-bank-help { margin: .85rem 0 0; color: var(--sp-muted); font-size: .82rem; line-height: 1.5; }
  .copy-status { min-height: 1.2em; margin: .6rem 0 0; color: var(--sp-muted); font-size: .8rem; }

  .support-trust { padding: clamp(3.8rem, 6.5vw, 5.8rem) 0; }
  .support-trust__grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(2.5rem, 5vw, 4.5rem); align-items: end; }
  .support-trust__copy p { margin: 0 0 1rem; color: var(--muted); line-height: 1.65; }
  .support-trust__copy a { color: var(--brand); font-weight: 700; text-decoration: none; }

  .support-final { padding: 0 0 clamp(3rem, 5vw, 4.5rem); }
  .support-final__panel { padding: clamp(2.1rem, 4.5vw, 3.6rem); border-radius: 22px; background: var(--sp-ink); color: #f6f1e5; }
  .support-final__panel .support-overline { color: #cfe0d6; }
  .support-final__panel h2 { max-width: 16ch; color: #f6f1e5 !important; }
  .support-btn--light { margin-top: 1.6rem; background: #f6f1e5; color: var(--sp-ink) !important; }

  @media (max-width: 900px) {
    .support-hero__grid, .support-section-head, .support-payment__grid, .support-trust__grid { grid-template-columns: 1fr; }
    .support-hero__grid, .support-section-head { gap: 1.8rem; }
    .support-impact__grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 620px) {
    .support-wrap { width: min(100% - 1.25rem, 1120px); }
    .support-hero { padding-top: 2.8rem; }
    .support-hero h1 { font-size: clamp(2.65rem, 12vw, 3.8rem); }
    .support-actions, .support-btn { width: 100%; }
    .support-bank-card { border-radius: 16px; }
    .support-bank-row { grid-template-columns: 1fr; gap: .35rem; }
    .support-bank-row dd { align-items: flex-start; }
    .support-bank-row--iban dd { flex-direction: column; }
  }

  :global(html[data-theme="dark"]) .support-payment { background: #183b2a; color: #f5f1e8; }
  :global(html[data-theme="dark"]) .support-payment h2 { color: #f5f1e8; }
  :global(html[data-theme="dark"]) .support-payment .support-overline,
  :global(html[data-theme="dark"]) .support-payment__intro > p:not(.support-overline) { color: #c9dbd0; }
  :global(html[data-theme="dark"]) .support-note { background: rgba(255,255,255,.06); color: #c9dbd0; }
  :global(html[data-theme="dark"]) .support-note strong { color: #f5f1e8; }
</style>
