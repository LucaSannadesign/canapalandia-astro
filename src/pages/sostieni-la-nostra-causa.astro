---
import SiteLayout from "../layouts/SiteLayout.astro";

const SITE = import.meta.env.SITE || "https://canapalandia.com";
const title = "Sostieni Canapalandia | Informazione indipendente";
const description =
  "Sostieni Canapalandia e contribuisci a mantenere indipendente un progetto editoriale dedicato a canapa, CBD, normativa, ricerca e cultura.";
const canonical = `${SITE}/sostieni-la-nostra-causa/`;

const IBAN = "IT25O0200809500000421598046";
const BIC = "UNCRITMMXXX";
const BANK = "UniCredit – Buddy Bank";
const CAUSALE = "Sostegno Canapalandia";

const impact = [
  ["01", "Fonti e verifiche", "Più tempo per controllare norme, documenti, studi e fonti prima della pubblicazione."],
  ["02", "Aggiornamenti continui", "Le pagine più importanti possono essere riviste quando cambiano norme, evidenze o contesto."],
  ["03", "Indipendenza editoriale", "Il progetto può crescere senza trasformare ogni contenuto in uno spazio promozionale."],
] as const;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
    { "@type": "ListItem", position: 2, name: "Sostieni Canapalandia", item: canonical },
  ],
};
---

<SiteLayout title={title} description={description} canonical={canonical} shell={false}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <div class="support-page">
    <nav class="support-crumbs" aria-label="Percorso di navigazione">
      <div class="support-wrap">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">→</li>
          <li aria-current="page">Sostieni Canapalandia</li>
        </ol>
      </div>
    </nav>

    <section class="support-hero" aria-labelledby="support-title">
      <div class="support-wrap support-hero__grid">
        <div>
          <p class="support-kicker"><span aria-hidden="true"></span>Sostieni Canapalandia</p>
          <h1 id="support-title">L’informazione indipendente cresce con chi la legge.</h1>
          <p class="support-lead">
            Canapalandia è un progetto editoriale indipendente. Il tuo sostegno ci aiuta
            a dedicare più tempo alla verifica delle fonti, agli aggiornamenti e alla qualità dei contenuti.
          </p>
          <div class="support-actions">
            <a class="support-btn support-btn--primary" href="#bonifico">Sostieni il progetto ↓</a>
            <a class="support-btn support-btn--ghost" href="/blog/">Esplora il magazine</a>
          </div>
        </div>

        <aside class="support-manifesto" aria-label="Principio editoriale">
          <p class="support-overline">Perché conta</p>
          <blockquote>
            “Non è solo una questione di canapa. È una questione di libertà, giustizia e verità.”
          </blockquote>
          <p class="support-manifesto__end">Ogni gesto è un seme. Piantalo con noi.</p>
        </aside>
      </div>
    </section>

    <section class="support-impact" aria-labelledby="impact-title">
      <div class="support-wrap">
        <header class="support-section-head">
          <p class="support-overline">Cosa rendi possibile</p>
          <h2 id="impact-title">Un progetto più solido, utile e verificabile</h2>
        </header>

        <div class="support-impact__grid">
          {impact.map(([num, heading, text]) => (
            <article class="support-impact__card">
              <span class="support-impact__num" aria-hidden="true">{num}</span>
              <h3>{heading}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="bonifico" class="support-payment" aria-labelledby="payment-title">
      <div class="support-wrap support-payment__grid">
        <div class="support-payment__intro">
          <p class="support-overline">Sostegno diretto</p>
          <h2 id="payment-title">Bonifico bancario</h2>
          <p>
            Puoi sostenere Canapalandia con un bonifico. Non imponiamo importi minimi:
            scegli liberamente il contributo che ritieni adatto.
          </p>
          <p class="support-note">
            <strong>Trasparenza.</strong> Il sostegno è volontario e non dà diritto a
            contenuti promozionali, pubblicità o trattamenti editoriali preferenziali.
          </p>
        </div>

        <div class="support-bank-card" aria-label="Coordinate bancarie">
          <header class="support-bank-card__head">
            <div>
              <p class="support-overline">Coordinate bancarie</p>
              <h3>Per sostenere Canapalandia</h3>
            </div>
            <span>Bonifico</span>
          </header>

          <dl>
            <div class="support-bank-row support-bank-row--iban">
              <dt>IBAN</dt>
              <dd><code>{IBAN}</code><button type="button" data-copy={IBAN} data-label="IBAN">Copia</button></dd>
            </div>
            <div class="support-bank-row">
              <dt>Banca</dt>
              <dd>{BANK}</dd>
            </div>
            <div class="support-bank-row">
              <dt>SWIFT / BIC</dt>
              <dd><code>{BIC}</code><button type="button" data-copy={BIC} data-label="BIC">Copia</button></dd>
            </div>
            <div class="support-bank-row">
              <dt>Causale consigliata</dt>
              <dd><span>{CAUSALE}</span><button type="button" data-copy={CAUSALE} data-label="Causale">Copia</button></dd>
            </div>
          </dl>
          <p class="copy-status" aria-live="polite"></p>
        </div>
      </div>
    </section>

    <section class="support-trust" aria-labelledby="trust-title">
      <div class="support-wrap support-trust__grid">
        <div>
          <p class="support-overline">Indipendenza prima di tutto</p>
          <h2 id="trust-title">Sostegno e pubblicità restano due cose diverse</h2>
        </div>
        <div class="support-trust__copy">
          <p>
            Il sostegno al progetto non compra visibilità editoriale. Le collaborazioni commerciali
            seguono un percorso separato e vengono dichiarate con trasparenza.
          </p>
          <a href="/pubblicita/">Scopri come gestiamo pubblicità e partnership →</a>
        </div>
      </div>
    </section>

    <section class="support-final" aria-labelledby="support-final-title">
      <div class="support-wrap">
        <div class="support-final__panel">
          <p class="support-overline">Canapalandia</p>
          <h2 id="support-final-title">Grazie per contribuire a far crescere un’informazione più libera.</h2>
          <a class="support-btn support-btn--light" href="#bonifico">Vai alle coordinate bancarie</a>
        </div>
      </div>
    </section>
  </div>

  <script>
    const status = document.querySelector('.copy-status');
    document.querySelectorAll('[data-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        const value = button.getAttribute('data-copy') || '';
        const label = button.getAttribute('data-label') || 'Dato';
        try {
          await navigator.clipboard.writeText(value);
          if (status) status.textContent = `${label} copiato negli appunti.`;
          button.textContent = 'Copiato';
          window.setTimeout(() => {
            button.textContent = 'Copia';
            if (status) status.textContent = '';
          }, 1800);
        } catch {
          if (status) status.textContent = `Copia manualmente: ${value}`;
        }
      });
    });
  </script>
</SiteLayout>

<style>
  .support-page {
    --sp-ink: #143d2a;
    --sp-ink-soft: #426451;
    --sp-paper: #f2eee4;
    --sp-paper-card: #fffdf8;
    --sp-gold: #d8b66c;
    color: var(--text);
    overflow: clip;
  }

  .support-wrap { width: min(1180px, calc(100% - 2rem)); margin-inline: auto; }

  .support-crumbs { padding: 1rem 0; border-bottom: 1px solid var(--border); }
  .support-crumbs ol { display: flex; flex-wrap: wrap; gap: .65rem; margin: 0; padding: 0; list-style: none; color: var(--muted); font: 500 .86rem/1.4 var(--font-sans); }
  .support-crumbs a { color: inherit; text-decoration: none; }
  .support-crumbs a:hover { color: var(--brand); }

  .support-hero { padding: clamp(4rem, 8vw, 8rem) 0 clamp(4rem, 7vw, 7rem); }
  .support-hero__grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(290px, .75fr); gap: clamp(2rem, 6vw, 6rem); align-items: end; }

  .support-kicker, .support-overline { margin: 0 0 1rem; color: var(--brand); font: 700 .76rem/1.2 var(--font-sans); letter-spacing: .13em; text-transform: uppercase; }
  .support-kicker { display: flex; align-items: center; gap: .65rem; }
  .support-kicker span { width: 2.1rem; height: 1px; background: currentColor; }

  .support-hero h1 { max-width: 12ch; margin: 0; font-size: clamp(3.25rem, 7.4vw, 7.5rem); line-height: .92; letter-spacing: -.045em; text-wrap: balance; }
  .support-lead { max-width: 63ch; margin: 2rem 0 0; color: var(--muted); font-size: clamp(1.1rem, 1.65vw, 1.4rem); line-height: 1.6; }
  .support-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }

  .support-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: .75rem 1.1rem; border: 1px solid transparent; border-radius: 999px; font: 700 .93rem/1 var(--font-sans); text-decoration: none; transition: transform .16s ease, background .16s ease; }
  .support-btn:hover { transform: translateY(-1px); }
  .support-btn--primary { background: var(--brand); color: #fff !important; }
  .support-btn--ghost { border-color: var(--border); color: var(--text) !important; }

  .support-manifesto { padding: 2rem 0 0 2rem; border-left: 1px solid var(--border); }
  .support-manifesto blockquote { margin: 0; font-size: clamp(1.6rem, 2.8vw, 2.55rem); line-height: 1.15; font-weight: 600; }
  .support-manifesto__end { margin: 1.8rem 0 0; color: var(--muted); font-style: italic; }

  .support-impact { padding: clamp(4rem, 7vw, 7rem) 0; border-top: 1px solid var(--border); }
  .support-section-head { display: grid; grid-template-columns: .8fr 1.7fr; gap: 2rem; margin-bottom: 3rem; }
  .support-section-head h2, .support-payment h2, .support-trust h2, .support-final h2 { margin: 0; font-size: clamp(2.2rem, 5vw, 4.8rem); line-height: .98; letter-spacing: -.035em; text-wrap: balance; }
  .support-impact__grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--border); }
  .support-impact__card { min-height: 245px; padding: 2rem; border-right: 1px solid var(--border); }
  .support-impact__card:first-child { border-left: 1px solid var(--border); }
  .support-impact__num { display: block; margin-bottom: 3.2rem; color: var(--muted); font: 500 .78rem/1 var(--font-sans); }
  .support-impact__card h3 { margin: 0 0 .7rem; font-size: 1.4rem; }
  .support-impact__card p { margin: 0; color: var(--muted); line-height: 1.6; }

  .support-payment { padding: clamp(4rem, 8vw, 8rem) 0; background: var(--sp-paper); color: var(--sp-ink); }
  .support-payment__grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(420px, 1.1fr); gap: clamp(2rem, 7vw, 7rem); align-items: start; }
  .support-payment .support-overline { color: var(--sp-ink-soft); }
  .support-payment__intro > p:not(.support-overline) { max-width: 52ch; margin: 1.6rem 0 0; color: var(--sp-ink-soft); font-size: 1.05rem; line-height: 1.65; }
  .support-note { padding: 1rem 1.1rem; border-left: 3px solid var(--sp-gold); background: rgba(255,255,255,.4); }

  .support-bank-card { padding: clamp(1.35rem, 3vw, 2.1rem); border: 1px solid rgba(20,61,42,.17); border-radius: 24px; background: var(--sp-paper-card); color: var(--sp-ink); box-shadow: 0 22px 60px rgba(20,61,42,.1); }
  .support-bank-card__head { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(20,61,42,.14); }
  .support-bank-card__head h3 { margin: 0; font-size: 1.55rem; color: var(--sp-ink); }
  .support-bank-card__head > span { height: fit-content; padding: .42rem .7rem; border-radius: 999px; background: #ece6d8; font: 700 .72rem/1 var(--font-sans); }
  .support-bank-card dl { margin: 0; }
  .support-bank-row { display: grid; grid-template-columns: 145px 1fr; gap: 1rem; padding: 1.15rem 0; border-bottom: 1px solid rgba(20,61,42,.14); }
  .support-bank-row dt { color: var(--sp-ink-soft); font: 700 .75rem/1.3 var(--font-sans); letter-spacing: .07em; text-transform: uppercase; }
  .support-bank-row dd { display: flex; align-items: center; justify-content: space-between; gap: .8rem; min-width: 0; margin: 0; color: var(--sp-ink); }
  .support-bank-row code { overflow-wrap: anywhere; color: var(--sp-ink); background: transparent; font-size: .93rem; }
  .support-bank-row button { flex: 0 0 auto; min-height: 36px; padding: .45rem .7rem; border: 1px solid rgba(20,61,42,.22); border-radius: 999px; background: transparent; color: var(--sp-ink); font: 700 .8rem/1 var(--font-sans); cursor: pointer; }
  .support-bank-row button:hover { background: #ece6d8; }
  .copy-status { min-height: 1.2em; margin: .9rem 0 0; color: var(--sp-ink-soft); font-size: .82rem; }

  .support-trust { padding: clamp(4rem, 8vw, 8rem) 0; }
  .support-trust__grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(2rem, 6vw, 6rem); align-items: end; }
  .support-trust__copy p { margin: 0 0 1.1rem; color: var(--muted); font-size: 1.08rem; line-height: 1.65; }
  .support-trust__copy a { color: var(--brand); font-weight: 700; text-decoration: none; }

  .support-final { padding: 0 0 clamp(3rem, 6vw, 6rem); }
  .support-final__panel { padding: clamp(2.2rem, 6vw, 5rem); border-radius: 28px; background: var(--sp-ink); color: #f6f1e5; }
  .support-final__panel .support-overline { color: #d7e6dd; }
  .support-final h2 { max-width: 15ch; }
  .support-btn--light { margin-top: 2rem; background: #f6f1e5; color: var(--sp-ink) !important; }

  @media (max-width: 900px) {
    .support-hero__grid, .support-section-head, .support-payment__grid, .support-trust__grid { grid-template-columns: 1fr; }
    .support-manifesto { padding: 2rem 0 0; border-left: 0; border-top: 1px solid var(--border); }
    .support-impact__grid { grid-template-columns: 1fr; border-inline: 1px solid var(--border); }
    .support-impact__card, .support-impact__card:first-child { min-height: 0; border-left: 0; border-right: 0; border-bottom: 1px solid var(--border); }
    .support-impact__num { margin-bottom: 1.4rem; }
  }

  @media (max-width: 620px) {
    .support-wrap { width: min(100% - 1.25rem, 1180px); }
    .support-hero { padding-top: 3.4rem; }
    .support-hero h1 { font-size: clamp(3rem, 16vw, 4.6rem); }
    .support-actions, .support-btn { width: 100%; }
    .support-bank-card { border-radius: 18px; }
    .support-bank-row { grid-template-columns: 1fr; gap: .4rem; }
    .support-bank-row dd { align-items: flex-start; }
    .support-bank-row--iban dd { flex-direction: column; }
  }

  :global(html[data-theme="dark"]) .support-payment { background: #183b2a; color: #f5f1e8; }
  :global(html[data-theme="dark"]) .support-payment .support-overline,
  :global(html[data-theme="dark"]) .support-payment__intro > p:not(.support-overline) { color: #c9dbd0; }
  :global(html[data-theme="dark"]) .support-note { background: rgba(255,255,255,.06); }
</style>